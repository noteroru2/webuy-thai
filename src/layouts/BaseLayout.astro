---
import { getSiteOrigin } from '../lib/site';
import LandingNav from '../components/landing/LandingNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteAnalytics from '../components/analytics/SiteAnalytics.astro';
import { LINE_OA_URL } from '../lib/site-line';
import '../styles/fonts.css';
import '../styles/tailwind.css';
interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogImageAlt?: string;
	pathname?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
	noindex?: boolean;
	/** Override self-canonical (path with trailing slash, e.g. /รับซื้อคอม/) */
	canonicalPath?: string;
}

const {
	title,
	description: descriptionProp,
	keywords,
	ogImage,
	ogImageAlt,
	pathname = Astro.url.pathname,
	type = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
	noindex = false,
	canonicalPath,
} = Astro.props;

const defaultDescription =
	typeof import.meta.env.PUBLIC_SITE_DESCRIPTION === 'string'
		? import.meta.env.PUBLIC_SITE_DESCRIPTION
		: 'เว็บไซต์ Astro';
const description = descriptionProp ?? defaultDescription;

const site = new URL(getSiteOrigin());
const resolvedCanonicalPath = canonicalPath ?? pathname;
const canonicalUrl = new URL(resolvedCanonicalPath, site).toString();
const defaultImage = '/og-default.png';
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const imageUrl = new URL(ogImage ?? defaultImage, site).toString();
const resolvedOgImageAlt = ogImageAlt ?? siteName;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const locale = import.meta.env.PUBLIC_SITE_LOCALE ?? 'th_TH';
const twitterSite = import.meta.env.PUBLIC_TWITTER_SITE;
const robotsContent = noindex
	? 'noindex, nofollow, noarchive'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo-we-buy.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#f97316" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="author" content={orgName} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="th" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={resolvedOgImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={resolvedOgImageAlt} />
		{twitterSite && <meta name="twitter:site" content={twitterSite} />}
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{type === 'article' && <meta property="article:author" content={orgName} />}
		<title>{title}</title>
		<SiteAnalytics />
		<slot name="head" />
		{jsonLd &&
			(Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((item) => (
				<script type="application/ld+json" set:html={JSON.stringify(item)} />
			))}
		<style is:global>
			:root {
				--bg: #fafbfd;
				--bg-warm: #fff8f3;
				--surface: #ffffff;
				--ink: #0f172a;
				--text: #141414;
				--muted: #525252;
				--accent: #f97316;
				--accent-bright: #ff7a00;
				--accent-dim: #ea580c;
				--accent-soft: rgba(255, 140, 0, 0.12);
				--accent-soft-strong: rgba(255, 140, 0, 0.18);
				--accent-glow: rgba(255, 149, 0, 0.22);
				--radius: 14px;
				--font: 'IBM Plex Sans Thai', 'IBM Plex Fallback', system-ui, sans-serif;
				--font-mono: 'IBM Plex Mono', ui-monospace, 'Cascadia Code', 'SF Mono', Menlo, monospace;
				--shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
				--shadow-md: 0 10px 40px rgba(15, 23, 42, 0.07);
				--shadow-tech: 0 0 0 1px rgba(255, 140, 0, 0.08), 0 12px 40px rgba(15, 23, 42, 0.06);
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				font-family: var(--font);
				color: var(--text);
				line-height: 1.6;
				background-color: var(--bg);
				background-image: linear-gradient(180deg, var(--bg-warm) 0%, transparent 38%),
					radial-gradient(ellipse 120% 70% at 50% -35%, var(--accent-glow) 0%, transparent 58%),
					linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
					linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
				background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
				background-position: 0 0, 0 0, 0 0, 0 0;
			}
			a {
				color: var(--accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			.container {
				width: min(960px, 92vw);
				margin-inline: auto;
				padding-block: 2rem 4rem;
			}
			.skip-link {
				position: absolute;
				left: 12px;
				top: 12px;
				transform: translateY(-140%);
				background: var(--surface);
				color: var(--text);
				border: 2px solid var(--accent);
				border-radius: 12px;
				padding: 0.55rem 0.8rem;
				font-weight: 700;
				z-index: 100;
				box-shadow: 0 10px 24px rgba(20, 30, 45, 0.18);
			}
			.skip-link:focus {
				transform: translateY(0);
			}
			.line-float {
				position: fixed;
				right: max(14px, env(safe-area-inset-right));
				bottom: max(14px, env(safe-area-inset-bottom));
				z-index: 70;
				display: none;
				align-items: center;
				gap: 0.45rem;
				padding: 0.62rem 0.82rem;
				border-radius: 999px;
				background: #0a8a46;
				color: #fff;
				box-shadow: 0 8px 20px rgba(6, 120, 53, 0.34);
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
			}
			.line-float:hover {
				background: #087a3e;
				text-decoration: none;
			}
			.line-dot {
				display: inline-block;
				width: 8px;
				height: 8px;
				border-radius: 999px;
				background: #dfffe8;
			}
			/* โทรศัพท์: ซ่อนปุ่มลอย — แท็บเล็ตค่อยแสดงทางลัด */
			@media (min-width: 768px) and (max-width: 1023px) {
				.line-float {
					display: inline-flex;
				}
			}
			@media (min-width: 1024px) {
				.line-float {
					display: none;
				}
			}
			.site-footer {
				border-top: 1px solid rgba(255, 140, 0, 0.2);
				background: linear-gradient(180deg, #fffaf5 0%, #ffffff 100%);
				margin-top: 2rem;
			}
			.site-footer .container {
				padding-block: 2rem;
				display: grid;
				gap: 1rem;
			}
			.footer-main {
				display: grid;
				gap: 0.6rem;
			}
			.footer-title {
				margin: 0;
				font-size: 1rem;
				font-weight: 700;
			}
			.footer-text {
				margin: 0;
				color: var(--muted);
				max-width: 68ch;
				font-size: 0.95rem;
			}
			.footer-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem 1rem;
				font-size: 0.92rem;
			}
			.footer-links a {
				color: var(--muted);
				font-weight: 600;
			}
			.footer-links a:hover {
				color: var(--accent);
				text-decoration: none;
			}
			.footer-bottom {
				padding-top: 0.7rem;
				border-top: 1px dashed rgba(15, 23, 42, 0.12);
				color: var(--muted);
				font-size: 0.8rem;
				font-family: var(--font-mono);
				letter-spacing: 0.03em;
			}
			#main-content {
				position: relative;
			}
			.tech-eyebrow {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent-dim);
			}
			.tech-eyebrow--dark {
				color: rgba(30, 24, 18, 0.88);
				text-shadow: 0 1px 0 rgba(255, 255, 255, 0.2);
			}
			.tech-h2 {
				position: relative;
				padding-bottom: 0.65rem;
			}
			.tech-h2::after {
				content: '';
				position: absolute;
				left: 0;
				bottom: 0;
				width: 3rem;
				height: 3px;
				border-radius: 3px;
				background: linear-gradient(90deg, var(--accent-bright), transparent);
			}
			.tech-card {
				position: relative;
				padding-left: 1.15rem;
				background: linear-gradient(165deg, #ffffff 0%, #f8fafc 100%);
				border: 1px solid rgba(15, 23, 42, 0.07);
				border-radius: var(--radius);
				box-shadow: var(--shadow-tech);
			}
			.tech-card::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.85rem;
				bottom: 0.85rem;
				width: 3px;
				border-radius: 0 4px 4px 0;
				background: linear-gradient(180deg, var(--accent-bright), var(--accent-dim));
				opacity: 0.9;
			}
			.prose :global(code) {
				font-family: var(--font-mono);
				font-size: 0.9em;
				padding: 0.12em 0.4em;
				background: rgba(15, 23, 42, 0.05);
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 6px;
				color: var(--ink);
			}
			.prose {
				max-width: 65ch;
			}
			.prose :global(img) {
				max-width: 100%;
				width: auto;
				height: auto;
				border-radius: var(--radius);
				display: block;
				box-sizing: border-box;
			}
			.prose :global(figure) {
				max-width: 100%;
				width: auto !important;
				margin: 1.25rem 0;
				box-sizing: border-box;
			}
			.prose :global(figcaption) {
				font-size: 0.9rem;
				color: var(--muted);
				margin-top: 0.5rem;
			}
			.prose :global(.wp-block-image),
			.prose :global(.wp-caption) {
				max-width: 100% !important;
				width: auto !important;
				box-sizing: border-box;
			}
			.prose :global(.aligncenter) {
				margin-left: auto;
				margin-right: auto;
			}
			.prose :global(p) {
				margin-block: 1em;
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 1.5em;
				color: var(--text);
			}
		</style>
	</head>
	<body>
		<a class="skip-link" href="#main-content">ข้ามไปเนื้อหา</a>
		<LandingNav />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
		<a
			class="line-float"
			href={LINE_OA_URL}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="แอดไลน์ @webuy ตลอด 24 ชั่วโมง"
		>
			<span class="line-dot"></span>
			<span>LINE @webuy</span>
		</a>
		<SiteFooter />
	</body>
</html>
