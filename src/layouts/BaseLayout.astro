---
import { getSiteOrigin } from '../lib/site';
import LandingNav from '../components/landing/LandingNav.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import SiteAnalytics from '../components/analytics/SiteAnalytics.astro';
import { LINE_OA_URL } from '../lib/site-line';
import '../styles/fonts.css';
import '../styles/design-system.css';
import '../styles/tailwind.css';
interface Props {
	title: string;
	description?: string;
	keywords?: string;
	ogImage?: string;
	ogImageAlt?: string;
	pathname?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	modifiedTime?: string;
	jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
	noindex?: boolean;
	/** Override self-canonical (path with trailing slash, e.g. /รับซื้อคอม/) */
	canonicalPath?: string;
}

const {
	title,
	description: descriptionProp,
	keywords,
	ogImage,
	ogImageAlt,
	pathname = Astro.url.pathname,
	type = 'website',
	publishedTime,
	modifiedTime,
	jsonLd,
	noindex = false,
	canonicalPath,
} = Astro.props;

const defaultDescription =
	typeof import.meta.env.PUBLIC_SITE_DESCRIPTION === 'string'
		? import.meta.env.PUBLIC_SITE_DESCRIPTION
		: 'เว็บไซต์ Astro';
const description = descriptionProp ?? defaultDescription;

const site = new URL(getSiteOrigin());
const resolvedCanonicalPath = canonicalPath ?? pathname;
const canonicalUrl = new URL(resolvedCanonicalPath, site).toString();
const defaultImage = '/og-default.png';
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const imageUrl = new URL(ogImage ?? defaultImage, site).toString();
const resolvedOgImageAlt = ogImageAlt ?? siteName;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const locale = import.meta.env.PUBLIC_SITE_LOCALE ?? 'th_TH';
const twitterSite = import.meta.env.PUBLIC_TWITTER_SITE;
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = businessPhone.replace(/^\+66/, '0').replace(/-/g, '');
const phoneHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;
const robotsContent = noindex
	? 'noindex, nofollow, noarchive'
	: 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const cleanPath = pathname.replace(/\/$/, '') || '/';
const isHome = cleanPath === '/';
const isContact = cleanPath === '/contact';
const isTrust = cleanPath === '/ความน่าเชื่อถือ';
const showLocalBusiness = isHome || isContact || isTrust;

const globalOrganizationSchema = {
	"@context": "https://schema.org",
	"@type": "Organization",
	"@id": `${site.origin}/#organization`,
	"name": orgName,
	"url": site.origin + '/',
	"logo": {
		"@type": "ImageObject",
		"url": new URL('/logo-we-buy.png', site).toString()
	},
	"contactPoint": {
		"@type": "ContactPoint",
		"telephone": businessPhone,
		"contactType": "customer service",
		"areaServed": "TH",
		"availableLanguage": "Thai"
	}
};

const addressLocality = 'อุบลราชธานี';
const addressRegion = 'อุบลราชธานี';
const postalCode = '34000';
const geoLat = import.meta.env.PUBLIC_GEO_LAT ?? '15.266426660367209';
const geoLon = import.meta.env.PUBLIC_GEO_LON ?? '104.8417777109199';

const localBusinessSchema = {
	"@context": "https://schema.org",
	"@type": "LocalBusiness",
	"@id": `${site.origin}/#localbusiness`,
	"name": orgName,
	"image": imageUrl,
	"url": site.origin + '/',
	"telephone": businessPhone,
	"priceRange": "$$",
	"address": {
		"@type": "PostalAddress",
		"streetAddress": "740/8 ถนนชยางกูร ต.ในเมือง อ.เมืองอุบลราชธานี",
		"addressLocality": addressLocality,
		"addressRegion": addressRegion,
		"postalCode": postalCode,
		"addressCountry": "TH"
	},
	"geo": {
		"@type": "GeoCoordinates",
		"latitude": Number(geoLat),
		"longitude": Number(geoLon)
	},
	"areaServed": [
		{ "@type": "State", "name": "กรุงเทพมหานคร" },
		{ "@type": "State", "name": "อุบลราชธานี" },
		{ "@type": "State", "name": "ขอนแก่น" },
		{ "@type": "State", "name": "นครราชสีมา" },
		{ "@type": "State", "name": "อุดรธานี" }
	],
	"openingHoursSpecification": [
		{
			"@type": "OpeningHoursSpecification",
			"dayOfWeek": [
				"Monday",
				"Tuesday",
				"Wednesday",
				"Thursday",
				"Friday",
				"Saturday",
				"Sunday"
			],
			"opens": "00:00",
			"closes": "23:59"
		}
	],
	"parentOrganization": {
		"@type": "Organization",
		"@id": `${site.origin}/#organization`
	}
};
---

<!doctype html>
<html lang="th">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo-we-buy.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0B1F3A" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		<meta name="author" content={orgName} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="alternate" hreflang="th" href={canonicalUrl} />
		<link rel="alternate" hreflang="x-default" href={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content={locale} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:image:alt" content={resolvedOgImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageUrl} />
		<meta name="twitter:image:alt" content={resolvedOgImageAlt} />
		{twitterSite && <meta name="twitter:site" content={twitterSite} />}
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		{type === 'article' && <meta property="article:author" content={orgName} />}
		<title>{title}</title>
		<SiteAnalytics />
		<slot name="head" />
		{jsonLd &&
			(Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((item) => (
				<script type="application/ld+json" set:html={JSON.stringify(item)} />
			))}
		<script type="application/ld+json" set:html={JSON.stringify(globalOrganizationSchema)} />
		{showLocalBusiness && (
			<script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
		)}
		<style is:global>
			:root {
				--bg: var(--color-bg);
				--bg-warm: var(--color-bg-warm);
				--surface: var(--color-card);
				--text: var(--color-text);
				--muted: var(--color-text-muted);
				/* Consolidate to Brand Navy and Brand Orange */
				--accent: var(--color-orange-dark);
				--accent-bright: var(--color-orange);
				--accent-dim: var(--color-orange-dark);
				--accent-soft: rgba(245, 158, 11, 0.08);
				--accent-soft-strong: rgba(245, 158, 11, 0.14);
				--accent-glow: rgba(245, 158, 11, 0.1);
				--radius: var(--radius-lg);
				--font: var(--font-sans);
				--font-mono: var(--font-mono);
				--shadow-sm: var(--shadow-sm);
				--shadow-md: var(--shadow-md);
				--shadow-tech: var(--shadow-card);
			}
			*,
			*::before,
			*::after {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				font-family: var(--font);
				color: var(--text);
				line-height: 1.6;
				background-color: var(--bg);
				background-image: linear-gradient(180deg, var(--bg-warm) 0%, transparent 38%),
					radial-gradient(ellipse 120% 70% at 50% -35%, var(--accent-glow) 0%, transparent 58%),
					linear-gradient(rgba(15, 23, 42, 0.035) 1px, transparent 1px),
					linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1px, transparent 1px);
				background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;
				background-position: 0 0, 0 0, 0 0, 0 0;
			}
			/* Global accessibility keyboard focus outline */
			*:focus-visible {
				outline: var(--focus-ring);
				outline-offset: var(--focus-ring-offset);
			}
			a {
				color: var(--accent);
				text-decoration: none;
			}
			a:hover {
				text-decoration: underline;
			}
			.container {
				width: min(960px, 92vw);
				margin-inline: auto;
				padding-block: 2rem 4rem;
			}
			.skip-link {
				position: absolute;
				left: 12px;
				top: 12px;
				transform: translateY(-140%);
				background: var(--surface);
				color: var(--text);
				border: 2px solid var(--accent);
				border-radius: 12px;
				padding: 0.55rem 0.8rem;
				font-weight: 700;
				z-index: 100;
				box-shadow: 0 10px 24px rgba(20, 30, 45, 0.18);
			}
			.skip-link:focus {
				transform: translateY(0);
			}
			.line-float {
				position: fixed;
				right: max(14px, env(safe-area-inset-right));
				bottom: max(14px, env(safe-area-inset-bottom));
				z-index: 70;
				display: none;
				align-items: center;
				gap: 0.45rem;
				padding: 0.62rem 0.82rem;
				border-radius: var(--radius-full);
				background: var(--color-line);
				color: #fff;
				box-shadow: 0 8px 20px rgba(4, 120, 87, 0.25);
				font-size: 0.9rem;
				font-weight: 700;
				text-decoration: none;
				transition: background-color var(--transition-fast), transform var(--transition-fast);
			}
			.line-float:hover {
				background: var(--color-line-hover);
				text-decoration: none;
				transform: translateY(-1px);
			}
			.line-dot {
				display: inline-block;
				width: 8px;
				height: 8px;
				border-radius: var(--radius-full);
				background: var(--color-line-soft);
			}
			.mobile-contact-bar {
				position: fixed;
				left: max(12px, env(safe-area-inset-left));
				right: max(12px, env(safe-area-inset-right));
				bottom: max(12px, env(safe-area-inset-bottom));
				z-index: 80;
				display: flex;
				gap: 0.75rem;
				padding: 0.7rem;
				border: 1px solid var(--color-gray-200);
				border-radius: var(--radius-xl);
				background: rgba(255, 255, 255, 0.96);
				box-shadow: 0 14px 40px rgba(11, 31, 58, 0.12);
				backdrop-filter: blur(12px);
			}
			.mobile-contact-link {
				flex: 1 1 0;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				min-height: 3rem;
				padding: 0.8rem 0.95rem;
				border-radius: var(--radius-lg);
				font-size: 0.95rem;
				font-weight: 800;
				text-decoration: none;
				text-align: center;
				letter-spacing: 0.01em;
				transition: background-color var(--transition-fast), transform var(--transition-fast);
			}
			.mobile-contact-link:hover {
				text-decoration: none;
			}
			.mobile-contact-link--line {
				background: linear-gradient(180deg, var(--color-line) 0%, var(--color-line-hover) 100%);
				color: #fff;
				box-shadow: 0 10px 20px rgba(4, 120, 87, 0.2);
			}
			.mobile-contact-link--phone {
				background: #fff;
				color: var(--color-navy-soft);
				border: 1.5px solid var(--color-orange);
			}
			/* โทรศัพท์: ซ่อนปุ่มลอย — แท็บเล็ตค่อยแสดงทางลัด */
			@media (max-width: 767px) {
				body {
					padding-bottom: calc(6.25rem + env(safe-area-inset-bottom));
				}
			}
			@media (min-width: 768px) and (max-width: 1023px) {
				.line-float {
					display: inline-flex;
				}
				.mobile-contact-bar {
					display: none;
				}
			}
			@media (min-width: 1024px) {
				.line-float {
					display: none;
				}
				.mobile-contact-bar {
					display: none;
				}
			}
			.site-footer {
				border-top: 1px solid rgba(2, 132, 199, 0.12);
				background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
				margin-top: 2rem;
			}
			.site-footer .container {
				padding-block: 2rem;
				display: grid;
				gap: 1rem;
			}
			.footer-main {
				display: grid;
				gap: 0.6rem;
			}
			.footer-title {
				margin: 0;
				font-size: 1rem;
				font-weight: 700;
			}
			.footer-text {
				margin: 0;
				color: var(--muted);
				max-width: 68ch;
				font-size: 0.95rem;
			}
			.footer-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem 1rem;
				font-size: 0.92rem;
			}
			.footer-links a {
				color: var(--muted);
				font-weight: 600;
			}
			.footer-links a:hover {
				color: var(--accent);
				text-decoration: none;
			}
			.footer-bottom {
				padding-top: 0.7rem;
				border-top: 1px dashed rgba(15, 23, 42, 0.12);
				color: var(--muted);
				font-size: 0.8rem;
				font-family: var(--font-mono);
				letter-spacing: 0.03em;
			}
			#main-content {
				position: relative;
			}
			.tech-eyebrow {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 600;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--accent-dim);
			}
			.tech-eyebrow--dark {
				color: rgba(30, 24, 18, 0.88);
				text-shadow: 0 1px 0 rgba(255, 255, 255, 0.2);
			}
			.tech-h2 {
				position: relative;
				padding-bottom: 0.65rem;
			}
			.tech-h2::after {
				content: '';
				position: absolute;
				left: 0;
				bottom: 0;
				width: 3rem;
				height: 3px;
				border-radius: 3px;
				background: linear-gradient(90deg, var(--accent-bright), transparent);
			}
			.tech-card {
				position: relative;
				padding-left: 1.15rem;
				background: linear-gradient(165deg, #ffffff 0%, #f8fafc 100%);
				border: 1px solid rgba(15, 23, 42, 0.07);
				border-radius: var(--radius);
				box-shadow: var(--shadow-tech);
			}
			.tech-card::before {
				content: '';
				position: absolute;
				left: 0;
				top: 0.85rem;
				bottom: 0.85rem;
				width: 3px;
				border-radius: 0 4px 4px 0;
				background: linear-gradient(180deg, var(--accent-bright), var(--accent-dim));
				opacity: 0.9;
			}
			.prose :global(code) {
				font-family: var(--font-mono);
				font-size: 0.9em;
				padding: 0.12em 0.4em;
				background: rgba(15, 23, 42, 0.05);
				border: 1px solid rgba(15, 23, 42, 0.08);
				border-radius: 6px;
				color: var(--ink);
			}
			.prose {
				max-width: 65ch;
			}
			.prose :global(img) {
				max-width: 100%;
				width: auto;
				height: auto;
				border-radius: var(--radius);
				display: block;
				box-sizing: border-box;
			}
			.prose :global(figure) {
				max-width: 100%;
				width: auto !important;
				margin: 1.25rem 0;
				box-sizing: border-box;
			}
			.prose :global(figcaption) {
				font-size: 0.9rem;
				color: var(--muted);
				margin-top: 0.5rem;
			}
			.prose :global(.wp-block-image),
			.prose :global(.wp-caption) {
				max-width: 100% !important;
				width: auto !important;
				box-sizing: border-box;
			}
			.prose :global(.aligncenter) {
				margin-left: auto;
				margin-right: auto;
			}
			.prose :global(p) {
				margin-block: 1em;
			}
			.prose :global(h2),
			.prose :global(h3) {
				margin-top: 1.5em;
				color: var(--text);
			}
		</style>
	</head>
	<body>
		<a class="skip-link" href="#main-content">ข้ามไปเนื้อหา</a>
		<LandingNav />
		<main id="main-content" tabindex="-1">
			<slot />
		</main>
			<a
				class="line-float"
				href={LINE_OA_URL}
			target="_blank"
			rel="noopener noreferrer"
			aria-label="แอดไลน์ @webuy ตลอด 24 ชั่วโมง"
			>
				<span class="line-dot"></span>
				<span>LINE @webuy</span>
			</a>
			<div class="mobile-contact-bar" aria-label="ติดต่อด่วนผ่านไลน์หรือโทรศัพท์">
				<a
					class="mobile-contact-link mobile-contact-link--line"
					href={LINE_OA_URL}
					target="_blank"
					rel="noopener noreferrer"
				>
					LINE @webuy
				</a>
				<a class="mobile-contact-link mobile-contact-link--phone" href={phoneHref}>
					โทร {phoneDisplay}
				</a>
			</div>
			<SiteFooter />
		</body>
	</html>
