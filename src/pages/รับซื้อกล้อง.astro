---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อกล้อง/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'Mirrorless ระดับโปร (Sony A7RV, Canon R5 II)', price: '60,000 - 100,000+ บาท', note: 'อิงตาม Shutter Count และสภาพเซ็นเซอร์' },
	{ model: 'Mirrorless ระดับกลาง (Sony A7IV, Fuji X-T5)', price: '30,000 - 55,000 บาท', note: 'ราคาจะสูงขึ้นถ้าขายพร้อมเลนส์คิทหรือเลนส์เกรดโปร' },
	{ model: 'กล้อง DSLR และ Mirrorless รุ่นเริ่มต้น', price: '5,000 - 20,000 บาท', note: 'รับประเมินแม้กล้องเก่าหรือมีตำหนิยางลอก' },
	{ model: 'เลนส์กล้อง (Lenses)', price: '1,000 - 40,000+ บาท', note: 'ราคาตกยากหากไม่มีรา ฝ้า และระบบโฟกัสทำงานปกติ' },
	{ model: 'Action Camera (GoPro Hero 11-13 / DJI)', price: '3,000 - 12,000 บาท', note: 'ประเมินจากสภาพเลนส์และการทำงานของแบตเตอรี่' },
];

const faqItems = [
	{ q: 'รับซื้อกล้องประเภทไหนบ้าง?', a: 'รับซื้อกล้อง DSLR, Mirrorless, Compact, Action Camera, กล้องฟิล์ม, เลนส์ทุกประเภท และอุปกรณ์เสริม เช่น แฟลช ขาตั้ง กิมบอล กระเป๋ากล้อง โดยประเมินจากรุ่น สภาพ และการทำงานจริง' },
	{ q: 'กล้องมีตำหนิเล็กน้อยขายได้ไหม?', a: 'ขายได้ เช่น รอยถลอกที่บอดี้ ยางกริปเสื่อม ฝุ่นภายนอก หรือชัตเตอร์สูง แต่ต้องแจ้งตามจริงเพื่อให้ประเมินราคาได้แม่นยำ กล้องที่มีปัญหาเซ็นเซอร์หรือบอร์ดเสียก็ยังรับประเมินได้เช่นกัน' },
	{ q: 'เลนส์มีราหรือฝ้าขายได้ไหม?', a: 'รับประเมินได้ แต่ราจะกระทบราคามากกว่าฝ้า เพราะราลุกลามได้และกระทบคุณภาพภาพถ่ายโดยตรง ฝ้าบางระดับอาจไม่มีผลต่อภาพเลย ทีมงานจะอธิบายเหตุผลราคาอย่างชัดเจน' },
	{ q: 'ต้องเตรียมอะไรบ้างก่อนขายกล้อง?', a: 'เตรียมตัวกล้อง เลนส์ แบตเตอรี่ ที่ชาร์จ สายคล้อง ฝาบอดี้ ฝาเลนส์ ฮูด ฟิลเตอร์ กล่องเดิม และใบเสร็จ (ถ้ามี) พร้อมถ่ายภาพสภาพทุกมุมและภาพทดสอบจากกล้อง' },
	{ q: 'ขายผ่านช่องทางไหนเร็วที่สุด?', a: 'แนะนำส่งรายละเอียดผ่าน Line @webuy เพราะแนบรูปและวิดีโอทดสอบได้สะดวก ทีมงานตอบกลับเร็วและประเมินได้ภายในไม่กี่ชั่วโมง หรือโทร 064-257-9353 เพื่อสอบถามเบื้องต้น' },
	{ q: 'รับซื้อกล้องฟิล์มไหม?', a: 'รับซื้อกล้องฟิล์มหลายประเภท ทั้ง SLR, Rangefinder, Point & Shoot และ Medium Format โดยเฉพาะรุ่นยอดนิยมอย่าง Nikon FM2, Canon AE-1, Olympus OM-1, Contax T2 รวมถึงเลนส์ Manual Focus ยุคเก่าที่ยังเป็นที่ต้องการของตลาด' },
	{ q: 'จำนวนชัตเตอร์มีผลต่อราคาแค่ไหน?', a: 'มีผลค่อนข้างมาก เพราะชัตเตอร์มีอายุการใช้งานจำกัด กล้องที่ชัตเตอร์ต่ำจะได้ราคาดีกว่า เช่น กล้อง Mirrorless ระดับกลางที่ชัตเตอร์ต่ำกว่า 30,000 ครั้งถือว่าน้อยมาก ส่วนกล้อง Pro ที่เกิน 200,000 ครั้งอาจต้องเผื่อค่าเปลี่ยนชัตเตอร์' },
	{ q: 'อยู่ต่างจังหวัดขายได้ไหม?', a: 'ได้ครับ รับประเมินออนไลน์ผ่าน Line @webuy สำหรับพื้นที่ให้บริการรับถึงที่ ครอบคลุมกรุงเทพฯ ปริมณฑล และจังหวัดหลักในภาคอีสาน สำหรับจังหวัดอื่นสามารถจัดส่งผ่านขนส่งได้ โดยทีมงานจะแนะนำวิธีแพ็กที่ปลอดภัย' },
	{ q: 'ใช้เวลาประเมินราคานานแค่ไหน?', a: 'หากส่งข้อมูลครบ (รุ่น, ชัตเตอร์, ภาพสภาพ, ภาพทดสอบ) ทีมงานมักตอบกลับช่วงราคาภายใน 1-3 ชั่วโมง ในกรณีที่ต้องตรวจสอบรุ่นหายากหรือกล้องฟิล์มเฉพาะทางอาจใช้เวลาเพิ่มเล็กน้อย' },
	{ q: 'GoPro หรือ Action Camera รับซื้อไหม?', a: 'รับซื้อครับ ทั้ง GoPro Hero ทุกรุ่น, DJI Action, Insta360 รวมถึงอุปกรณ์เสริมอย่างเคสกันน้ำ แบตเสริม และไม้เซลฟี่ โดยประเมินจากรุ่น สภาพเลนส์ สภาพหน้าจอ และการทำงานของระบบกันสั่น' },
	{
		q: 'เช็กราคากล้องมือสองก่อนขายต้องส่งอะไร?',
		a: 'หน้าเช็กราคาก่อนขายมีรายการรุ่น ชัตเตอร์คาวน์ รูปสภาพ และภาพทดสอบที่แนะนำ ส่งผ่าน Line @webuy เพื่อรับช่วงราคาเบื้องต้น',
	},
	{
		q: 'WE BUY ประเมินราคากล้องโปร่งใสไหม?',
		a: 'ประเมินจากรุ่น เลนส์ ชัตเตอร์และสภาพจริง อธิบายเหตุผลเมื่อราคาต่างจากเบื้องต้น — อ่านขั้นตอนและนโยบายที่หน้าความน่าเชื่อถือ',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อกล้องมือสอง',
		description:
			'บริการรับซื้อกล้องมือสอง DSLR Mirrorless Compact กล้องฟิล์ม เลนส์ และอุปกรณ์เสริมทุกยี่ห้อ Canon Nikon Sony Fujifilm Panasonic Olympus Leica GoPro ประเมินราคาฟรี จ่ายเงินทันที',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อกล้อง | รับซื้อกล้องมือสอง DSLR Mirrorless ทุกยี่ห้อ ราคาดี',
		description:
			'บริการรับซื้อกล้องมือสอง DSLR Mirrorless Compact กล้องฟิล์ม เลนส์ และอุปกรณ์เสริมทุกยี่ห้อ Canon Nikon Sony Fujifilm Panasonic Olympus Leica GoPro ประเมินราคาฟรี จ่ายเงินทันที',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', name: orgName },
		publisher: { '@type': 'Organization', name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-03-24',
		keywords:
			'รับซื้อกล้อง, ขายกล้องมือสอง, รับซื้อกล้องดิจิตอล, รับซื้อกล้อง DSLR, รับซื้อกล้อง Mirrorless, รับซื้อเลนส์, รับซื้อกล้องฟิล์ม, รับซื้อ Canon, รับซื้อ Nikon, รับซื้อ Sony, รับซื้อ Fujifilm, รับซื้อ GoPro, ขายกล้องราคาดี, ประเมินราคากล้อง',
		image: [new URL('/og-default.png', site).toString()],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อกล้อง', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อกล้อง',
		description:
			'บริการรับซื้อกล้องมือสอง DSLR Mirrorless Compact ทุกยี่ห้อ Canon Nikon Sony Fujifilm พร้อมเลนส์และอุปกรณ์เสริม ประเมินราคาโปร่งใส จ่ายเงินทันที',
		provider: { '@type': 'Organization', name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อกล้องมือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขายกล้องมือสองกับ WE BUY',
		description: 'ขั้นตอนง่าย ๆ ในการขายกล้องมือสองให้ได้ราคาดี',
		step: [
			{
				'@type': 'HowToStep',
				name: 'ส่งข้อมูลกล้อง',
				text: 'แอดไลน์ @webuy แล้วส่งรูปกล้อง เลนส์ รุ่น Shutter Count และสภาพ',
			},
			{
				'@type': 'HowToStep',
				name: 'รับราคาประเมิน',
				text: 'ทีมงานผู้เชี่ยวชาญตรวจสอบและแจ้งราคาประเมิน',
			},
			{
				'@type': 'HowToStep',
				name: 'ยืนยันและนัดรับ',
				text: 'ตกลงราคา นัดหมายจุดรับ-ส่ง หรือจัดส่ง',
			},
			{
				'@type': 'HowToStep',
				name: 'รับเงินทันที',
				text: 'ตรวจสอบอุปกรณ์จริงและรับเงินทันที',
			},
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อกล้องมือสอง')}
	description="WE BUY รับซื้อกล้องมือสอง DSLR Mirrorless Compact ทุกยี่ห้อ Canon Nikon Sony Fujifilm พร้อมเลนส์ ประเมินราคาโปร่งใสตามสภาพจริง ติดต่อ Line @webuy"
	pathname="/รับซื้อกล้อง/"
	type="article"
	jsonLd={articleJsonLd}
>
	<div class="page">
		<header class="header">
			<h1>รับซื้อกล้อง เลนส์ และอุปกรณ์ถ่ายภาพมือสอง</h1>
			<p class="subtitle">
				หากคุณมีกล้องถ่ายรูปที่ถูกเก็บทิ้งไว้ในตู้กันชื้นจนแทบไม่ได้หยิบออกมาใช้งาน ไม่ว่าจะเป็นกล้อง DSLR คู่ใจที่เคยใช้รับงาน กล้อง Mirrorless ตัวท็อปที่ซื้อมาแล้วอยากอัปเกรดข้ามค่าย เลนส์ซูมระยะไกลที่ไม่ตอบโจทย์ไลฟ์สไตล์อีกต่อไป หรือแม้แต่กล้องฟิล์มคลาสสิกที่ตกทอดมาจากครอบครัว อย่าปล่อยให้อุปกรณ์เหล่านี้เสื่อมสภาพไปตามกาลเวลาและมูลค่าลดลงไปทุกวัน WE BUY คือจุดหมายปลายทางอันดับหนึ่งสำหรับช่างภาพและผู้รักการถ่ายภาพที่ต้องการเปลี่ยนอุปกรณ์คู่ใจให้กลายเป็นเงินทุน เรารับซื้อกล้องดิจิตอล เลนส์ และอุปกรณ์เสริมจากทุกค่ายชั้นนำ ไม่ว่าจะเป็น Canon, Nikon, Sony, Fujifilm, Panasonic Lumix, Olympus ไปจนถึงแบรนด์ระดับพรีเมียมอย่าง Leica ด้วยทีมงานที่มีความรู้ลึกซึ้งและประสบการณ์ตรงในวงการภาพถ่าย เราจึงสามารถประเมินราคาได้อย่างแม่นยำ อิงตามสเปก สภาพการใช้งาน จำนวนชัตเตอร์ และกลไกของตลาดมือสองในปัจจุบัน คุณสามารถมั่นใจได้ว่าจะได้รับข้อเสนอที่คุ้มค่าที่สุด โดยไม่ต้องเสียเวลาลงประกาศขายเอง ไม่ต้องเสี่ยงกับการต่อรองราคาหน้างาน และที่สำคัญคือเราพร้อมโอนเงินหรือจ่ายเงินสดให้คุณทันทีแบบเต็มจำนวน
			</p>
		</header>

		<section class="content">
			
			<TrustBadges className="mb-12 mt-8" />
			<RecentTradesSlider />
			<h2>ความโปร่งใสในขั้นตอนการประเมินราคากลางกล้องและเลนส์</h2>
			<p>กล้องและเลนส์มือสองเป็นสินค้าเฉพาะทางที่มีรายละเอียดซับซ้อน ปัจจัยหลักที่มีผลต่อราคารุ่นกล้อง เช่น จำนวนการกดชัตเตอร์ (Shutter Count), สภาพความสมบูรณ์ของเซนเซอร์รับภาพ (ไม่มีรา, ฝุ่น หรือรอยขีดข่วน), ระบบโฟกัส และยางรอบตัวบอดี้ ที่ WE BUY เราประเมินตามสภาพและความสมบูรณ์ของอุปกรณ์เสริมจริงอย่างโปร่งใสตามราคากลางของตลาด</p>
			
			<p>เราช่วยให้ผู้ที่ต้องการเปลี่ยนหรือโละอุปกรณ์ถ่ายภาพเดิม สามารถทำธุรกรรมได้สะดวกรวดเร็ว เพียงส่งรูปเครื่อง และข้อมูลรายละเอียด ชัตเตอร์ มาทาง Line @webuy เราจะประเมินช่วงราคากลางเบื้องต้นให้ และโอนเงินเข้าบัญชีทันทีหลังจากการตรวจสอบสภาพจริงเรียบร้อย</p>

			<h2>รับประเมินราคากล้อง Mirrorless และ DSLR ทุกแบรนด์</h2>
			<p><strong>Mirrorless:</strong> รับประเมินค่ายยอดนิยม เช่น Sony, Fujifilm, Canon, Nikon และ Lumix อ้างอิงตามสภาพเซนเซอร์และฟังก์ชันการทำงาน</p>
			<p><strong>DSLR:</strong> ประเมินราคากลางตามรุ่น ยุคสมัย และความสมบูรณ์ของตัวกล้อง</p>
			<p><strong>เลนส์ (Lenses):</strong> รับประเมินเลนส์แยกชิ้นส่วน ทั้งเลนส์ค่ายและเลนส์อิสระ เช็คสภาพชิ้นเลนส์ ไร้ฝ้า ไร้รา</p>

			<ComparisonTable />
			<StepCards />
