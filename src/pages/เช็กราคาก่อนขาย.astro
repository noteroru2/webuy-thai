---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/landing/ButtonLink.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = businessPhone.replace(/^\+66/, '0').replace(/-/g, '');
const telHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;
const lineUrl = 'https://line.me/R/ti/p/@webuy';
const pagePath = '/เช็กราคาก่อนขาย/';

const pageDescription =
	'WE BUY เช็กราคาก่อนขายไอทีมือสอง — ส่งรุ่น สภาพ รูปจริง โน๊ตบุ๊ค iPhone MacBook iPad คอม กล้อง Apple Watch ประเมินโปร่งใส ทัก Line @webuy';

const productGuides = [
	{
		title: 'โน๊ตบุ๊ค',
		href: '/รับซื้อโน๊ตบุ๊ค/',
		items: [
			'รุ่น แบรนด์ และปีที่ซื้อ',
			'CPU, RAM, SSD/HDD และการ์ดจอ (ถ้ามี)',
			'สภาพจอ แบตเตอรี่ คีย์บอร์ด และทัชแพด',
			'รูปหน้าจอ DxDiag หรือสติกเกอร์สเปก',
			'อุปกรณ์ครบ (สายชาร์จ กล่อง) ถ้ามี',
		],
	},
	{
		title: 'iPhone',
		href: '/รับซื้อไอโฟน/',
		items: [
			'รุ่น ความจุ และสี',
			'สุขภาพแบตเตอรี่ (%) ใน Settings',
			'สภาพจอ ตัวเครื่อง และ Face ID / Touch ID',
			'สถานะ iCloud / Find My (ต้องออกจากบัญชีก่อนนัดรับ)',
			'รูปหน้าจอ About และด้านหลังเครื่อง',
		],
	},
	{
		title: 'MacBook',
		href: '/รับซื้อแมคบุ๊ค/',
		items: [
			'รุ่น (Air / Pro), ชิป และความจุ',
			'RAM, SSD และจำนวนรอบชาร์จแบต (ถ้าดูได้)',
			'สภาพจอ คีย์บอร์ด และ Trackpad',
			'สถานะ Apple ID / Activation Lock',
			'รูป About This Mac และมุมตัวเครื่อง',
		],
	},
	{
		title: 'iPad',
		href: '/รับซื้อไอแพด/',
		items: [
			'รุ่น ความจุ Wi‑Fi หรือ Cellular',
			'สภาพจอ ตัวเครื่อง และ Apple Pencil (ถ้ามี)',
			'สุขภาพแบตเตอรี่',
			'สถานะ iCloud / Find My',
			'รูปหน้าจอ Settings และด้านหลัง',
		],
	},
	{
		title: 'คอมพิวเตอร์',
		href: '/รับซื้อคอม/',
		items: [
			'ประเภท: คอมประกอบ / แบรนด์เนม / Gaming PC',
			'CPU, RAM, การ์ดจอ, SSD/HDD',
			'สภาพเคส พัดลม และอุณหภูมิ (ถ้าทราบ)',
			'รูปสเปกใน BIOS หรือ System Information',
			'จอ คีย์บอร์ด เมาส์ ที่ขายพร้อมเครื่อง',
		],
	},
	{
		title: 'กล้อง',
		href: '/รับซื้อกล้อง/',
		items: [
			'ยี่ห้อ รุ่น และเลนส์ที่แนบมา',
			'จำนวนชัตเตอร์ (Shutter count) ถ้าดูได้',
			'สภาพเลนส์ เซ็นเซอร์ และจอ LCD/EVF',
			'อุปกรณ์เสริม (แบต สาย กระเป๋า)',
			'รูปตัวเครื่องและเลนส์หลายมุม',
		],
	},
	{
		title: 'Apple Watch',
		href: '/รับซื้อ-apple-watch/',
		items: [
			'รุ่น Series / SE / Ultra และขนาด',
			'สภาพตัวเรือน จอ และสาย',
			'สุขภาพแบตเตอรี่',
			'สถานะ iCloud / Activation Lock',
			'รูปหน้าปัด About และด้านหลัง',
		],
	},
];

const faqItems = [
	{
		question: 'ต้องส่งข้อมูลอะไรเพื่อเช็กราคาก่อนขาย?',
		answer:
			'ส่งรุ่น สเปกหรือความจุ สภาพจริง และรูปถ่ายชัด ๆ ผ่าน LINE @webuy ทีมงาน WE BUY จะตอบช่วงราคาเบื้องต้นก่อนนัดตรวจเครื่อง',
	},
	{
		question: 'ใช้เวลาประเมินราคานานแค่ไหน?',
		answer:
			'ถ้าข้อมูลครบ มักได้ช่วงราคาเบื้องต้นภายในเวลาทำการ การนัดรับและตรวจเครื่องจริงใช้เวลาประมาณ 15–30 นาที',
	},
	{
		question: 'ต้องมีกล่องและใบเสร็จไหม?',
		answer:
			'ไม่บังคับ แต่ของครบช่วยให้ราคาดีขึ้น แจ้งของที่มีจริงในแชทเพื่อไม่ให้ราคาเปลี่ยนหน้างาน',
	},
	{
		question: 'เครื่องติดบัญชีหรือล็อก iCloud ขายได้ไหม?',
		answer:
			'ต้องออกจาก Apple ID / Find My หรือบัญชีผู้ใช้ก่อนรับซื้อ ทีมงานจะแนะนำขั้นตอนล้างข้อมูลอย่างปลอดภัยก่อนส่งมอบ',
	},
	{
		question: 'นัดรับเครื่องที่ไหนได้บ้าง?',
		answer:
			'นัดรับตามจุดสะดวกในพื้นที่ให้บริการ หรือส่งรูปและสเปกมาก่อนเพื่อเช็กราคาเบื้องต้น แล้วค่อยนัดวันรับ',
	},
	{
		question: 'รับซื้อสินค้าไอทีประเภทไหนบ้าง?',
		answer:
			'รับซื้อโน๊ตบุ๊ค iPhone MacBook iPad คอมพิวเตอร์ กล้อง Apple Watch และอุปกรณ์ไอทีมือสองอื่น ๆ ตามสภาพและสเปกจริง',
	},
];

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${site}${pagePath}#webpage`,
		name: formatPageTitle('เช็กราคาก่อนขาย'),
		description: pageDescription,
		url: `${site}${pagePath}`,
		inLanguage: 'th-TH',
		isPartOf: { '@type': 'WebSite', url: `${site}/` },
		about: {
			'@type': 'Thing',
			name: 'การประเมินราคารับซื้อสินค้าไอทีมือสอง',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'เช็กราคาก่อนขาย', item: `${site}${pagePath}` },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${site}${pagePath}#faq`,
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.question,
			acceptedAnswer: {
				'@type': 'Answer',
				text: item.answer,
			},
		})),
	},
];
---

<BaseLayout
	title={formatPageTitle('เช็กราคาก่อนขาย')}
	description={pageDescription}
	pathname={pagePath}
	jsonLd={jsonLd}
>
	<div class="font-sans bg-[#FAFAFA] text-text antialiased">
		<section class="border-b border-gray-200 bg-white">
			<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
				<nav class="text-sm text-text-muted" aria-label="breadcrumb">
					<ol class="flex flex-wrap items-center gap-1.5">
						<li><a class="hover:text-brand-700" href="/">หน้าแรก</a></li>
						<li aria-hidden="true">/</li>
						<li class="font-medium text-text" aria-current="page">เช็กราคาก่อนขาย</li>
					</ol>
				</nav>
				<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-brand-700">คู่มือก่อนขาย · {orgName}</p>
				<h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">เช็กราคาก่อนขาย — ส่งข้อมูลอะไรบ้าง?</h1>
				<p class="mt-5 max-w-3xl text-lg leading-[1.75] text-text-muted">
					<strong class="font-semibold text-text">คำตอบสั้น:</strong> ส่งรุ่น สเปก สภาพจริง และรูปถ่ายชัด ๆ ผ่าน LINE
					<a class="font-semibold text-brand-700 hover:underline" href={lineUrl} target="_blank" rel="noopener noreferrer"
						>@webuy</a
					>
					ทีมงาน WE BUY จะตอบช่วงราคาเบื้องต้นก่อนนัดตรวจเครื่องและจ่ายหลังตรวจสอบ
				</p>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer">
						ทัก LINE @webuy
					</ButtonLink>
					<ButtonLink href={telHref} variant="secondary">โทร {phoneDisplay}</ButtonLink>
				</div>
			</div>
		</section>

		<section class="py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">ข้อมูลพื้นฐานที่ควรส่งทุกครั้ง</h2>
				<ul class="mt-4 grid gap-2 text-text-muted sm:grid-cols-2">
					<li class="flex gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> รุ่น / แบรนด์ / ความจุ</li>
					<li class="flex gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> สภาพตามจริง (จอ แบต ตัวเครื่อง)</li>
					<li class="flex gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> รูปถ่ายหลายมุม ไม่เบลอ</li>
					<li class="flex gap-2"><span class="text-brand-600" aria-hidden="true">✓</span> อุปกรณ์ที่มี (สาย กล่อง ใบเสร็จ)</li>
					<li class="flex gap-2 sm:col-span-2"><span class="text-brand-600" aria-hidden="true">✓</span> แจ้งปัญหาเพิ่ม เช่น ติดบัญชี จอเป็นเส้น แบตเสื่อม</li>
				</ul>
				<p class="mt-6 text-sm leading-relaxed text-text-muted sm:text-base">
					ยังไม่แน่ใจว่าขายได้ไหมหรือราคาประมาณเท่าไร? ดู
					<a class="font-semibold text-brand-700 hover:underline" href="/คู่มือก่อนขาย/">เช็กก่อนขาย: ขายได้ไหม ขายได้กี่บาท</a>
					และเรื่องความปลอดภัยก่อนส่งมอบ
				</p>
			</div>
		</section>

		<section class="border-t border-gray-200 bg-white py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">เช็กลิสต์ตามประเภทสินค้า</h2>
				<p class="mt-3 max-w-2xl text-text-muted">
					เลือกหมวดที่ตรงกับเครื่องของคุณ แล้วส่งข้อมูลตามรายการ — ดูรายละเอียดบริการรับซื้อแต่ละหมวดได้จากลิงก์ด้านล่าง
				</p>
				<div class="mt-8 grid gap-6 sm:grid-cols-2">
					{
						productGuides.map((cat) => (
							<article class="rounded-2xl border border-gray-200 bg-[#FAFAFA] p-5 shadow-sm">
								<h3 class="text-lg font-bold">
									<a class="text-brand-800 hover:text-brand-600 hover:underline" href={cat.href}>
										{cat.title}
									</a>
								</h3>
								<ul class="mt-3 space-y-2 text-sm leading-relaxed text-text-muted">
									{cat.items.map((item) => (
										<li class="flex gap-2">
											<span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
											{item}
										</li>
									))}
								</ul>
							</article>
						))
					}
				</div>
			</div>
		</section>

		<section class="py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">ขั้นตอนเช็กราคาจนจบดีล</h2>
				<ol class="mt-6 space-y-4">
					<li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">1</span>
						<div>
							<h3 class="font-semibold">ส่งข้อมูลและรูปใน LINE</h3>
							<p class="mt-1 text-sm text-text-muted">แจ้งรุ่น สภาพ และรูปจริง — ได้ช่วงราคาเบื้องต้น</p>
						</div>
					</li>
					<li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">2</span>
						<div>
							<h3 class="font-semibold">นัดรับหรือนำเครื่องมาตรวจ</h3>
							<p class="mt-1 text-sm text-text-muted">ตรวจสเปกและสภาพตรงหน้างาน ไม่กดราคาเมื่อตรงที่แจ้ง</p>
						</div>
					</li>
					<li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-4 shadow-sm">
						<span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">3</span>
						<div>
							<h3 class="font-semibold">ยืนยันราคาและรับเงิน</h3>
							<p class="mt-1 text-sm text-text-muted">จ่ายหลังตรวจเครื่องเสร็จ ตามที่ตกลงกัน</p>
						</div>
					</li>
				</ol>
			</div>
		</section>

		<section class="border-t border-gray-200 bg-white py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">คำถามที่พบบ่อย</h2>
				<div class="mt-6 divide-y divide-gray-200 rounded-2xl border border-gray-200 bg-[#FAFAFA]">
					{
						faqItems.map((item) => (
							<details class="group px-5 py-4">
								<summary class="cursor-pointer list-none font-semibold text-text marker:content-none group-open:text-brand-800">
									{item.question}
								</summary>
								<p class="mt-3 text-sm leading-relaxed text-text-muted">{item.answer}</p>
							</details>
						))
					}
				</div>
			</div>
		</section>

		<section class="border-t border-brand-500/20 bg-gradient-to-b from-brand-50/80 to-white py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">พร้อมเช็กราคาแล้ว?</h2>
				<p class="mx-auto mt-3 max-w-xl text-text-muted">
					ส่งรูปและสเปกมาได้เลย ทีมงาน WE BUY ประเมินโปร่งใส ไม่มีค่าใช้จ่ายสำหรับการเช็กราคาเบื้องต้น
				</p>
				<div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
					<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer">
						แชท LINE @webuy
					</ButtonLink>
					<ButtonLink href={telHref} variant="primary">โทร {phoneDisplay}</ButtonLink>
					<ButtonLink href="/contact/" variant="secondary">ดูช่องทางติดต่อ</ButtonLink>
				</div>
			</div>
		</section>
	</div>
</BaseLayout>
