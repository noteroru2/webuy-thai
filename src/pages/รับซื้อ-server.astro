---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อ-server/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,เชียงใหม่,สงขลา';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'Rack Server High-End (Dual Xeon, 256GB RAM+)', price: '30,000 - 120,000+ บาท', note: 'Dell PowerEdge R740/R840, HP ProLiant DL380/DL560 Gen10' },
	{ model: 'Rack Server Mid-Range (Single Xeon, 64-128GB RAM)', price: '8,000 - 35,000 บาท', note: 'Dell R620/R630, HP DL360 G8/G9, Lenovo SR630' },
	{ model: 'Tower Server สำนักงาน', price: '3,000 - 15,000 บาท', note: 'Dell T340/T440, HP ML350, Lenovo ST250' },
	{ model: 'Server ซาก/เสีย หรือชิ้นส่วน', price: '500 - 8,000 บาท', note: 'ประเมินตามสภาพของ CPU, RAM, HDD/SSD และ Chassis' },
	{ model: 'Blade Server + Chassis', price: '5,000 - 80,000 บาท', note: 'HP BladeSystem c7000, Dell PowerEdge M1000e' },
];

const serverLocalPages = [
	{ href: '/รับซื้อ-server-เชียงใหม่/', label: 'รับซื้อ Server เชียงใหม่', caption: 'B2B ภาคเหนือ ออกเอกสาร จ่ายทันที' },
	{ href: '/รับซื้อ-server-ขอนแก่น/', label: 'รับซื้อ Server ขอนแก่น', caption: 'B2B ภาคอีสาน ประเมินรวมล็อต' },
	{ href: '/รับซื้อ-server-อุบลราชธานี/', label: 'รับซื้อ Server อุบลราชธานี', caption: 'B2B อีสานใต้ รับทุกยี่ห้อ' },
	{ href: '/รับซื้อ-server-นครราชสีมา/', label: 'รับซื้อ Server นครราชสีมา', caption: 'B2B โคราช ราคาดีสุดในตลาด' },
	{ href: '/รับซื้อ-server-กรุงเทพมหานคร/', label: 'รับซื้อ Server กรุงเทพ', caption: 'B2B กรุงเทพและปริมณฑล' },
];

const serverBrandPages = [
	{ href: '/รับซื้อ-server-dell/', label: 'รับซื้อ Server Dell PowerEdge' },
	{ href: '/รับซื้อ-server-hp/', label: 'รับซื้อ Server HP ProLiant' },
	{ href: '/รับซื้อ-server-lenovo/', label: 'รับซื้อ Server Lenovo ThinkSystem' },
	{ href: '/รับซื้อ-server-ibm/', label: 'รับซื้อ Server IBM Power' },
	{ href: '/รับซื้อ-server-supermicro/', label: 'รับซื้อ Server Supermicro' },
	{ href: '/รับซื้อ-server-huawei/', label: 'รับซื้อ Server Huawei FusionServer' },
	{ href: '/รับซื้อ-server-hitachi/', label: 'รับซื้อ Server Hitachi' },
	{ href: '/รับซื้อ-server-เสีย/', label: 'รับซื้อ Server เสีย/ซาก' },
];

const faqItems = [
	{
		q: 'รับซื้อ Server ยี่ห้อและรุ่นไหนบ้าง?',
		a: 'รับซื้อ Server ทุกยี่ห้อครับ ทั้ง Dell PowerEdge, HP ProLiant, Lenovo ThinkSystem, IBM Power, Supermicro, Fujitsu, Huawei FusionServer และยี่ห้ออื่น ๆ รับทั้งแบบ Tower, Rack-mount และ Blade Server ทุกรุ่น ทุกสเปก',
	},
	{
		q: 'Server เสียหรือเปิดไม่ติดรับซื้อไหม?',
		a: 'รับครับ เราประเมินราคาตามสภาพจริงของชิ้นส่วนที่ยังมีมูลค่า เช่น CPU, RAM, HDD/SSD, PSU และ Chassis แม้ Server จะเปิดไม่ติดหรือมีปัญหา ก็ยังสามารถประเมินราคาซากได้',
	},
	{
		q: 'ปลดระวาง Server ทั้งองค์กร ยกล็อตได้ไหม?',
		a: 'ได้ครับ WE BUY รับประเมินรวมเป็นล็อต ทีมงานสามารถนัดเข้าสำรวจสถานที่และประเมินราคารวมทั้งหมดได้ พร้อมออกเอกสารรับซื้ออย่างเป็นทางการสำหรับบันทึกทางบัญชีขององค์กร',
	},
	{
		q: 'Server มีข้อมูลสำคัญอยู่ต้องทำอย่างไรก่อนขาย?',
		a: 'ควรสำรองข้อมูลสำคัญและทำการล้าง Drive ให้เรียบร้อยก่อนครับ หากต้องการความมั่นใจสูงสุด สามารถทำ Secure Erase หรือ Degauss HDD ก่อนส่งมอบ ทีมงาน WE BUY ไม่สามารถรับผิดชอบข้อมูลที่อยู่บน Drive ได้หลังรับมอบแล้ว',
	},
	{
		q: 'ราคารับซื้อ Server พิจารณาจากอะไร?',
		a: 'พิจารณาจาก 1) ยี่ห้อและรุ่น 2) สเปก CPU (จำนวน Socket, รุ่น Xeon) 3) ปริมาณ RAM ที่ติดมา 4) จำนวนและขนาด HDD/SSD 5) สภาพ PSU และ Chassis 6) อายุรุ่นและ End of Life Status',
	},
	{
		q: 'มีเอกสารรับซื้ออย่างเป็นทางการไหม?',
		a: 'มีครับ WE BUY ออกเอกสารรับซื้ออย่างเป็นทางการพร้อม Serial Number ทุกรายการ สำหรับบันทึกทางบัญชีและการตรวจสอบทรัพย์สินขององค์กร',
	},
	{
		q: 'ติดต่อช่องทางไหนตอบเร็วที่สุด?',
		a: 'Line @webuy ครับ สามารถส่งรายการ Server พร้อมสเปกและรูปได้ทันที ทีมงานจะประเมินราคาเบื้องต้นและนัดหมายเข้าสำรวจได้ภายในวันเดียวกัน',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อ Server มือสอง ทุกยี่ห้อ ทุกรุ่น จ่ายเงินทันที',
		description: 'WE BUY รับซื้อ Server มือสองทุกยี่ห้อ Dell HP Lenovo IBM Supermicro ทั้ง Tower Rack Blade รับทั้งล็อตองค์กร ออกเอกสาร จ่ายเงินทันที',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อ Server มือสอง | คู่มือปลดระวาง Server และประเมินราคา',
		description: 'รวมข้อมูลการรับซื้อ Server มือสอง ตั้งแต่วิธีประเมินราคา ปัจจัยที่มีผลต่อมูลค่า ขั้นตอนปลดระวางสำหรับองค์กร และบริการรับเหมายกล็อต',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: { '@type': 'WebPage', '@id': `${pageUrl}#webpage` },
		datePublished: '2026-06-05',
		dateModified: '2026-06-05',
		image: [new URL('/og-default.png', site).toString()],
		keywords: 'รับซื้อ server, รับซื้อ server มือสอง, ขาย server, ปลดระวาง server, รับซื้อ server dell, รับซื้อ server hp, รับซื้อ server lenovo, รับเหมาอุปกรณ์ไอที',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อ Server', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อ Server มือสอง',
		description: 'บริการรับซื้อ Server มือสองทุกยี่ห้อ ทุกรุ่น รับทั้งรายชิ้นและยกล็อตองค์กร ออกเอกสาร จ่ายเงินทันที',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อ Server มือสอง',
		url: pageUrl,
	},
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อ Server มือสอง')}
	description="WE BUY รับซื้อ Server มือสองทุกยี่ห้อ Dell, HP, Lenovo, IBM, Supermicro ทั้ง Tower, Rack, Blade รับทั้งรายชิ้นและยกล็อตองค์กร ออกเอกสาร จ่ายเงินทันที Line @webuy"
	pathname="/รับซื้อ-server/"
	type="article"
	jsonLd={articleJsonLd}
>
	<article class="container longform">

		<header class="article-head">
			<p class="kicker">B2B IT Asset Buyback — Server</p>
			<h1>รับซื้อ Server มือสอง ทุกยี่ห้อ ทุกรุ่น — รับยกล็อตองค์กร ออกเอกสาร จ่ายทันที</h1>
			<p class="intro">
				หากองค์กรของคุณกำลัง <strong>ปลดระวาง Server</strong> หรืออยากขาย Server ที่ไม่ได้ใช้งานแล้ว
				WE BUY คือพันธมิตรที่เข้าใจคุณค่าของอุปกรณ์ระดับ Enterprise อย่างแท้จริง
				เรารับซื้อ Server ทุกยี่ห้อ ทั้ง Dell PowerEdge, HP ProLiant, Lenovo ThinkSystem, IBM Power, Supermicro และอื่น ๆ
				รับทั้งแบบ Tower, Rack-mount และ Blade Server ทุกสเปกและทุกสภาพ
				พร้อมออกเอกสารรับซื้ออย่างเป็นทางการและจ่ายเงินสดในวันเดียวกัน
				ทักหา <a class="inline-contact" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">Line @webuy</a> หรือโทร <a class="phone-link" href="tel:0642579353">064-257-9353</a> ได้ตลอดเวลาครับ
			</p>
		</header>

		<PriceGuide title="ราคารับซื้อ Server อ้างอิง (อัปเดต 2026)" items={priceItems} />

		<section>
			<h2>ทำไมต้องเลือก WE BUY สำหรับการปลดระวาง Server</h2>
			<p>
				การขาย Server มือสองต้องการผู้รับซื้อที่มีความเชี่ยวชาญด้านอุปกรณ์ระดับ Enterprise จริง ๆ
				เพราะ Server แต่ละรุ่นมีสเปกซับซ้อน ทั้งจำนวน CPU Socket, ประเภท RAM (DDR3/DDR4/DDR5 ECC),
				ประเภท HDD (SAS/SATA/NVMe) และอายุการรับประกันที่เหลือ ซึ่งล้วนส่งผลต่อราคาอย่างมีนัยสำคัญ
			</p>

			<h3>ประเมินราคาตามสเปกจริง ไม่เหมารวม</h3>
			<p>
				เราไม่ประเมินแบบเหมาจ่ายตายตัวต่อเครื่อง แต่ดูรายละเอียดของแต่ละหน่วย:
				จำนวนและรุ่น CPU (Xeon E5/E7/Scalable), ปริมาณ RAM ที่ติดมา, จำนวนและขนาด HDD/SSD,
				สภาพ PSU และ Chassis รวมถึงรุ่นและ Generation ของ Server
			</p>

			<h3>บริการรับยกล็อตสำหรับองค์กร</h3>
