---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อ-ใกล้ฉัน/`;

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#webpage`,
		name: 'รับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดี จ่ายเงินทันที ใกล้ฉัน บริการรับถึงที่',
		description: 'ศูนย์รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง และลำโพงแบรนด์เนมมือสอง ครบวงจร ประเมินราคาด่วน 24 ชม.',
		url: pageUrl,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ ใกล้ฉัน บริการรับถึงที่', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อสินค้าไอทีมือสอง ใกล้ฉัน บริการรับถึงที่',
		description: 'รับซื้อโน้ตบุ๊ค, คอมพิวเตอร์, มือถือ และอุปกรณ์ไอทีทุกชนิด ให้ราคาสูง จ่ายเงินสดทันที',
		provider: { '@type': 'Organization', name: orgName },
		url: pageUrl,
	}
];

const preSaleLinks = [
	{
		href: '/เช็กราคาก่อนขาย/',
		title: 'เตรียมข้อมูลเช็กราคาก่อนขาย',
		desc: 'รายการข้อมูลและรูปที่ควรส่งก่อนทัก Line',
	},
	{
		href: '/ราคากลางรับซื้อ/',
		title: 'แนวราคากลางรับซื้อไอทีมือสอง',
		desc: 'ปัจจัยราคาตามหมวดสินค้า ไม่ใส่ตัวเลขมั่ว',
	},
	{
		href: '/ความน่าเชื่อถือ/',
		title: 'ศูนย์ความน่าเชื่อถือ WE BUY',
		desc: 'ขั้นตอนซื้อขายโปร่งใสและความปลอดภัยข้อมูล',
	},
];

const mainMoneyPages = [
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อ iPhone มือสอง', desc: 'ทุกรุ่น ประเมินตามสภาพจริง' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊คมือสอง', desc: 'โน้ตบุ๊คทุกยี่ห้อและสเปก' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook มือสอง', desc: 'Air / Pro ชิป Intel และ M-series' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมมือสอง', desc: 'PC ประกอบและแบรนด์เนม' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้องมือสอง', desc: 'DSLR Mirrorless และเลนส์' },
];

const categories = [
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊ค', desc: 'รับซื้อ Laptop ทุกยี่ห้อ ทั้งสายทำงาน และ Notebook เกมมิ่งแรง ๆ' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์', desc: 'PC แบรนด์เนม, All-in-One และคอมสำนักงาน' },
	{ href: '/รับซื้อคอมประกอบ/', title: 'รับซื้อคอมประกอบ', desc: 'Custom PC, Gaming PC, การ์ดจอ และอะไหล่แยกชิ้น' },
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อไอโฟน', desc: 'iPhone ทุกรุ่น ตั้งแต่รุ่นเก่าจนถึงรุ่นล่าสุด ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อไอแพด/', title: 'รับซื้อไอแพด', desc: 'iPad Pro, Air, mini และ iPad Gen ทุกรุ่น ทั้งแบบ Wi-Fi และใส่ซิม' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook', desc: 'MacBook Air / Pro ทั้งชิป Intel และตระกูล M1-M5 ให้ราคาสูง' },
	{ href: '/รับซื้อสมาร์ทโฟน-android/', title: 'รับซื้อสมาร์ทโฟน Android', desc: 'Samsung S/Z Series, ROG Phone และรุ่นเรือธงทุกค่าย' },
	{ href: '/รับซื้อ-apple-watch/', title: 'รับซื้อ Apple Watch', desc: 'Series ล่าสุด, Ultra, SE รับซื้อทุกสภาพ ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อเครื่องเกม/', title: 'รับซื้อเครื่องเกม', desc: 'PS5, Nintendo Switch, Steam Deck รับซื้อพร้อมแผ่นเกมและจอย' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้อง', desc: 'DSLR, Mirrorless, เลนส์ และอุปกรณ์ถ่ายภาพทุกประเภท' },
	{ href: '/รับซื้อลำโพง/', title: 'รับซื้อลำโพง', desc: 'Marshall, JBL และลำโพงบลูทูธแบรนด์เนมของแท้เท่านั้น' },
];
---

<BaseLayout
	title={formatPageTitle('หาร้านรับซื้อไอทีมือสอง | โน้ตบุ๊ค คอม ไอโฟน ใกล้ฉัน ประเมินฟรี รับถึงที่')}
	description="หาร้านWE BUY ศูนย์รับซื้อสินค้าไอทีมือสองครบวงจร รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง ลำโพง ประเมินราคาโปร่งใส จ่ายเงินสดทันที ติดต่อ Line @webuy 24 ชม. ใกล้ฉัน? WE BUY บริการรับซื้อถึงบ้าน จ่ายเงินสดทันที ตีราคาไวใน 15 นาที"
	pathname="/รับซื้อ-ใกล้ฉัน/"
	jsonLd={jsonLd}
>
	<div class="container page">
		<header class="head">
			<p class="tech-eyebrow">WE BUY • Buyback Categories</p>
			<h1 class="tech-h2">บริการรับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดีที่สุด จ่ายเงินสดทันที</h1>
			<p class="lead">
				เราคือผู้เชี่ยวชาญในการ <strong>รับซื้อสินค้าไอทีมือสอง</strong> ที่เน้นความโปร่งใสและยุติธรรมที่สุด 
				ไม่ว่าคุณจะมีเครื่องสภาพสวยเหมือนใหม่ หรือเครื่องที่มีตำหนิจากการใช้งาน 
				ทีมงานของเราพร้อมประเมินราคาให้คุณตามมูลค่าตลาดจริง ติดต่อเราง่าย จบไว ได้เงินชัวร์
			</p>
		</header>
        <section class="content">
			<TrustBadges className="mb-12 mt-8" />
			<RecentTradesSlider />
			<h2>กำลังหาร้านรับซื้อKW ใกล้ฉันอยู่ใช่ไหม?</h2>
			<p>ในยุคนี้ความสะดวกและรวดเร็วคือสิ่งสำคัญที่สุด ใครที่กำลังเซิร์ชหาร้านรับซื้อKW ใกล้ฉัน คุณมาถูกที่แล้วครับ เรามีทีมงานที่พร้อมพุ่งตัวไปประเมินเครื่องและรับซื้อถึงหน้าประตูบ้านคุณ ไม่ต้องเหนื่อยเดินทาง</p>
			<p>เราเข้าใจดีว่าคุณต้องการขายKWให้ได้ราคาดีที่สุดและเร็วที่สุด ทีมงานผู้เชี่ยวชาญของเราพร้อมที่จะตีราคาออนไลน์ให้คุณทราบก่อนภายใน 15 นาที หากราคาเป็นที่น่าพอใจ เราจะส่งทีมงานที่อยู่ใกล้คุณที่สุดวิ่งไปรับเครื่องทันที</p>

			<ComparisonTable />
			<StepCards />
			
			<h2>เหตุผลที่บริการรับซื้อKWใกล้บ้านเรา คือคำตอบที่ดีที่สุด</h2>
			<p>นอกจากเรื่องความสะดวกสบายแล้ว การขายKWให้กับทีมงานที่วิ่งไปรับถึงที่ยังช่วยให้คุณประหยัดค่าใช้จ่ายในการเดินทาง ทั้งค่าน้ำมัน ค่าทางด่วน หรือค่าที่จอดรถ ทุกอย่างเราเป็นคนจัดการให้ คุณเพียงแค่นั่งรอรับเงินโอนเข้าบัญชีแบบสบายๆ ในห้องแอร์</p>
			<p>เรายังมีบริการจัดการข้อมูล (Data Wipe) แบบต่อหน้าคุณ 100% ทำให้คุณมั่นใจได้ว่าข้อมูลส่วนตัว รูปภาพ หรือบัญชีต่างๆ ในKW จะไม่รั่วไหลไปไหน นี่คือบริการพรีเมียมที่ร้านทั่วไปอาจไม่มีให้</p>

			<DataPrivacyBlock />

			<h2>ขั้นตอนง่ายๆ เมื่อต้องการขายKWให้ร้านใกล้ฉัน</h2>
			<p>เริ่มต้นง่ายๆ เพียงแค่คุณทัก LINE ออฟฟิเชียลของเรา (@webuy) แล้วส่งรูปถ่ายเครื่อง KW พร้อมแจ้งสเปก รุ่น และตำหนิ (ถ้ามี) ให้ครบถ้วน ทีมงานจะใช้เวลาตรวจสอบเพียงไม่กี่นาที และแจ้งราคาประเมินเบื้องต้นกลับไปหาคุณทันที</p>
			<p>หลังจากนั้น นัดหมายสถานที่ที่คุณสะดวกที่สุดในพื้นที่ใกล้ฉัน ทีมงานจะเดินทางไปหาตรงเวลาเป๊ะ ตรวจเช็คการทำงานของเครื่องต่อหน้าคุณ ใช้เวลาไม่เกิน 15 นาที และชำระเงินสดหรือโอนผ่านแอปธนาคารทันที ยืนยันว่าคุณจะได้รับเงินชัวร์ 100% ก่อนส่งมอบเครื่อง</p>
			
			<div class="cta-row" style="margin-top: 3rem; justify-content: center; padding-bottom: 3rem;">
				<a class="btn-line" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer" style="font-size: 1.2rem; padding: 1.2rem 2.5rem;">คลิกทัก LINE ประเมินราคาใกล้คุณ!</a>
			</div>
		</section>
		<ProvincialGrid keyword="รับซื้อสินค้าไอที" slugPrefix="รับซื้อคอม" />
		</section>
	</div>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}
	.head {
		max-width: 800px;
		margin-bottom: 3rem;
	}
	.head h1 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
		font-weight: 800;
		color: var(--text);
	}
	.lead {
		margin: 0;
		color: var(--muted);
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 4rem;
	}
	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 1rem;
		text-decoration: none;
		color: var(--text);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
		transition: all 0.3s ease;
	}
	.card:hover {
		border-color: var(--accent);
		transform: translateY(-5px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		text-decoration: none;
	}
	.card h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.card p {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}
	.more {
		margin-top: 1.5rem;
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--accent);
	}

	.pre-sale-hub {
		margin-bottom: 4rem;
		padding: 2.5rem;
		background: linear-gradient(135deg, #fffbeb, #fff7ed);
		border: 1px solid rgba(180, 83, 9, 0.2);
		border-radius: 1.5rem;
	}
	.pre-sale-hub .tech-h2 {
		margin: 0 0 0.75rem;
	}
	.pre-sale-lead {
		margin: 0 0 1.75rem;
		max-width: 42rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.pre-sale-links {
		display: grid;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	@media (min-width: 768px) {
		.pre-sale-links {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.pre-sale-card {
		display: block;
		padding: 1.25rem 1.5rem;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 1rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.pre-sale-card:hover {
		border-color: var(--accent);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
		text-decoration: none;
	}
	.pre-sale-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
	}
	.pre-sale-card p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.5;
	}
	.pre-sale-sub {
		margin: 0 0 1rem;
		font-size: 1.1rem;
		font-weight: 700;
	}
	.money-links {
		display: grid;
		gap: 0.75rem;
	}
	@media (min-width: 640px) {
		.money-links {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.money-links {
			grid-template-columns: repeat(5, 1fr);
		}
	}
	.money-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.875rem 1rem;
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.2s, background 0.2s;
	}
	.money-link:hover {
		border-color: var(--accent);
		background: #fff7ed;
		text-decoration: none;
	}
	.money-link strong {
		font-weight: 700;
	}
	.money-link span {
		font-size: 0.75rem;
		color: var(--muted);
		line-height: 1.4;
	}

	.trust-signals {
		margin-bottom: 5rem;
		padding: 3rem;
		background: #f8fafc;
		border-radius: 1.5rem;
	}
	.trust-grid {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 768px) {
		.trust-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.trust-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.trust-item {
		text-align: center;
	}
	.trust-item .icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.trust-item h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}
	.trust-item p {
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.5;
	}

	.process-summary {
		margin-bottom: 5rem;
	}
	.steps {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	@media (min-width: 768px) {
		.steps {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.step {
		position: relative;
		padding: 1.5rem;
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 1rem;
	}
	.step-num {
		display: inline-block;
		width: 30px;
		height: 30px;
		background: var(--accent);
		color: #fff;
		border-radius: 50%;
		text-align: center;
		line-height: 30px;
		font-weight: 800;
		margin-bottom: 1rem;
	}

	.extra {
		padding: 2.5rem;
		background: linear-gradient(135deg, #fffbeb, #fff7ed);
		border: 1px solid rgba(180, 83, 9, 0.2);
		border-radius: 1.5rem;
	}
	.extra h2 {
		margin: 0 0 1rem;
	}
	.extra p {
