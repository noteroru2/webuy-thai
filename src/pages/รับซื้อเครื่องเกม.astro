---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อเครื่องเกม/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'PlayStation 5 (PS5) - รุ่นใส่แผ่น (Disc)', price: '10,000 - 14,000 บาท', note: 'ราคาขึ้นอยู่กับรหัสรุ่น (CFI) สภาพเครื่อง และอุปกรณ์ในกล่อง' },
	{ model: 'PlayStation 5 (PS5) - รุ่น Digital', price: '8,500 - 12,000 บาท', note: 'รับประเมินพร้อมจอยสอยหรือแผ่นเกมเพิ่มเติม' },
	{ model: 'Nintendo Switch OLED', price: '6,500 - 9,000 บาท', note: 'สภาพจอภาพและ Joy-Con มีผลต่อราคา' },
	{ model: 'Nintendo Switch V2 (กล่องแดง)', price: '4,000 - 6,000 บาท', note: 'รับซื้อครบชุดพร้อม Dock และ Grip' },
	{ model: 'Steam Deck / ROG Ally', price: '9,000 - 18,000 บาท', note: 'เครื่องเกมพกพา Handheld PC อิงตามความจุสเปก' },
];

const faqItems = [
	{
		q: 'รับซื้อเครื่องเกมรุ่นไหนบ้าง?',
		a: 'เราเน้นรับซื้อเครื่องเกมคอนโซลยอดฮิตในปัจจุบัน ได้แก่ PlayStation 5 (PS5), PlayStation 4 (PS4 Pro / Slim), Nintendo Switch (OLED, V2, Lite), รวมถึงเครื่อง Handheld PC อย่าง Steam Deck และ ROG Ally ครับ',
	},
	{
		q: 'เครื่องถูกแบน (Banned) จากออนไลน์ รับซื้อไหม?',
		a: 'ขออภัยครับ ทางเรา "ไม่รับซื้อ" เครื่องที่ถูกแบนจากระบบออนไลน์ (เช่น ถูกแบน PSN หรือ Nintendo Switch ถูกแบน) รวมถึงเครื่องที่มีการแปลงระบบสายมืด (Jailbreak/CFW) ทุกกรณีครับ',
	},
	{
		q: 'จอยคอนโทรลเลอร์ (Joy-Con / DualSense) มีอาการเดินเอง (Drift) รับซื้อไหม?',
		a: 'รับซื้อครับ! อาการอนาล็อกเดินเองเป็นปัญหาปกติที่พบได้บ่อย ทีมงานจะประเมินราคาโดยหักลบค่าซ่อมหรือค่าเปลี่ยนจอยตามจริงครับ แจ้งอาการก่อนประเมินได้เลยครับ',
	},
	{
		q: 'ขายเครื่องพร้อมแผ่นเกมได้ไหม?',
		a: 'ได้เลยครับ! หากคุณมีแผ่นเกม PS5, PS4 หรือตลับเกม Nintendo Switch สามารถนำมาขายรวมเป็นชุดได้เลย จะช่วยเพิ่มมูลค่ารวมให้ได้ราคาสูงขึ้นครับ',
	},
	{
		q: 'ก่อนขายต้องเตรียมเครื่องอย่างไร?',
		a: 'รบกวนลูกค้าลบบัญชีผู้ใช้ (Sign Out PSN Account / Nintendo Account) และทำการ Initialize / Format ตัวเครื่องให้กลับเป็นค่าเริ่มต้นโรงงาน เพื่อปกป้องข้อมูลส่วนตัวของคุณครับ',
	},
	{
		q: 'ขาดกล่องหรือขาดอุปกรณ์บางชิ้น ขายได้ไหม?',
		a: 'ขายได้ครับ แต่ราคาอาจลดลงจากราคากลางเล็กน้อยตามชิ้นส่วนที่หายไป (เช่น ขาดสาย HDMI, ขาด Dock ของ Switch) ควรแจ้งอุปกรณ์ที่มีให้ครบถ้วนตอนประเมินราคาครับ',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อเครื่องเกม PS5, Nintendo Switch มือสอง จ่ายเงินสด',
		description:
			'WE BUY รับซื้อเครื่องเล่นเกมคอนโซลมือสอง PlayStation 5 (PS5), PS4, Nintendo Switch (OLED/V2), Steam Deck ให้ราคาสูง ประเมินราคาไว จ่ายเงินทันที',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อเครื่องเกมมือสอง | PS5, Nintendo Switch, Steam Deck',
		description:
			'บริการรับซื้อเครื่องเกมคอนโซล PlayStation 5, Nintendo Switch และเครื่องเล่นเกมพกพา ให้ราคายุติธรรม รับซื้อพร้อมแผ่นเกมและจอยเสริม นัดรับรวดเร็ว',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-05-11',
		dateModified: '2026-05-11',
		image: [new URL('/og-default.png', site).toString()],
		keywords:
			'รับซื้อเครื่องเกม, รับซื้อ ps5, รับซื้อ playstation 5, รับซื้อ nintendo switch, รับซื้อ switch oled, รับซื้อ steam deck, ขายแผ่นเกม, รับซื้อจอย ps5',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อเครื่องเกม', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อเครื่องเล่นเกมมือสอง',
		description:
			'บริการรับซื้อเครื่องเกม Console และ Handheld ทุกประเภท PS5, Nintendo Switch, Steam Deck ประเมินราคาโปร่งใส จ่ายเงินสดทันที มีบริการนัดรับ',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อ Video Game Console',
		url: pageUrl,
	},
];

import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
---

<BaseLayout
	title={formatPageTitle('รับซื้อ PS5 Switch มือสอง')}
	description="WE BUY รับซื้อเครื่องเล่นเกมคอนโซลมือสอง PlayStation 5 (PS5), PS4, Nintendo Switch (OLED/V2), Steam Deck ให้ราคาสูง ประเมินราคาไว นัดรับและจ่ายเงินทันที"
	pathname="/รับซื้อเครื่องเกม/"
	type="article"
	jsonLd={articleJsonLd}
>
	<div class="page">
		<header class="header">
			<h1>รับซื้อเครื่องเกม คอนโซล PlayStation Xbox Nintendo มือสอง ประเมินราคาฟรี</h1>
			<p class="subtitle">
				สายเกมเมอร์ที่ต้องการเปลี่ยนเครื่องเกมเก่าเป็นเงินสด หรือเคลียร์พื้นที่บ้านจากคอนโซลที่ไม่ได้เล่นแล้ว เรารับซื้อเครื่องเกมทุกแบรนด์ดัง ไม่ว่าจะเป็นเครื่องยอดฮิตอย่าง PlayStation 5 (PS5), PlayStation 4, คอนโซลสายพกพา Nintendo Switch รุ่น OLED และ V2 หรือแม้แต่เครื่องเกมพีซีพกพาอย่าง Steam Deck, ROG Ally และเครื่องฝั่ง Microsoft อย่าง Xbox Series X/S เราประเมินราคาตามสเปก สภาพจริง และอุปกรณ์เสริมที่มีทั้งหมด ยิ่งมีแผ่นเกมเยอะ ยิ่งบวกราคาให้สูงขึ้น พร้อมบริการประเมินราคาฟรีผ่านระบบออนไลน์ จ่ายเงินสดโอนเข้าบัญชีทันทีเมื่อตรวจรับเครื่องเสร็จ หมดปัญหาโดนกดราคาหน้างาน
			</p>
		</header>

		<section class="content">
			
			<TrustBadges className="mb-12 mt-8" />
			<h2>ทำไม WE BUY คือตัวเลือกที่ดีที่สุดสำหรับการขายเครื่องเกม</h2>
			<p>การขายเครื่องเกมคอนโซลมือสองมักมาพร้อมกับความยุ่งยากหลายประการ ไม่ว่าจะเป็นการหาลูกค้าที่ต้องการเครื่องในรุ่นและสเปกเดียวกับที่คุณมี การเจรจาต่อรองราคาที่มักจะถูกกดลงมาจนแทบไม่เหลือมูลค่า หรือความกังวลเรื่องการโดนโกงเมื่อต้องนัดเจอคนแปลกหน้า บริการรับซื้อเครื่องเกมของเราถูกออกแบบมาเพื่อลบทุกปัญหาเหล่านี้ออกไป ให้คุณขายเครื่องเกมได้อย่างสบายใจที่สุด</p>
			<p>เรามีทีมงานที่เชี่ยวชาญด้านวงการเกมโดยเฉพาะ เข้าใจลึกซึ้งถึงมูลค่าของรหัสเครื่องแต่ละรุ่น (เช่น บอร์ดรุ่นเก่า บอร์ดรุ่นใหม่ของ PS5) ความแตกต่างของหน้าจอแต่ละประเภท รวมถึงรู้ว่าอุปกรณ์ชิ้นไหนที่เป็นที่ต้องการของตลาดจริงๆ ทำให้เราสามารถเสนอราคาประเมินที่แม่นยำและยุติธรรมที่สุด แตกต่างจากร้านรับซื้อของเก่าทั่วไปที่มักจะตีราคาเหมาๆ แบบไม่ดูรายละเอียด ซึ่งมักทำให้คุณเสียเปรียบ</p>
			<p>ความโปร่งใสคือหัวใจสำคัญในการบริการของเรา เมื่อคุณส่งข้อมูลเครื่อง รหัสรุ่น ตำหนิที่มี และอุปกรณ์เสริมทั้งหมดมาให้เราประเมิน เราจะแจ้งช่วงราคาที่ชัดเจนให้ทราบก่อนเสมอ พร้อมอธิบายเหตุผลว่าทำไมถึงได้ราคานี้ หากคุณตกลง เราก็นัดหมายดูของและจ่ายเงินตามช่วงราคาที่แจ้งไว้ ไม่มีการสร้างข้ออ้างจุกจิกเพื่อหักราคาหน้างานให้เสียความรู้สึก</p>
			<p>นอกจากนี้ เรายังช่วยคุณจัดการเรื่องความปลอดภัยของข้อมูลในเครื่องเกม ไม่ว่าจะเป็นบัญชีผู้ใช้ PSN, Nintendo Account หรือเซฟเกมต่างๆ ที่ซิงค์ไว้บนคลาวด์ เรายินดีให้คำแนะนำในการออกจากระบบ ล้างเครื่อง และคืนค่าโรงงานอย่างถูกวิธี เพื่อให้มั่นใจ 100% ว่าจะไม่มีข้อมูลบัตรเครดิตหรือข้อมูลส่วนตัวของคุณหลุดรอดไปถึงมือคนอื่น</p>
			<p>บริการนัดรับที่ครอบคลุมก็เป็นอีกหนึ่งจุดแข็ง คุณไม่จำเป็นต้องแบกเครื่องเกมเครื่องใหญ่ๆ ฝ่ารถติดไปหาที่จอดรถตามห้างสรรพสินค้า เพียงระบุสถานที่และเวลาที่คุณสะดวก ทีมงานของเราจะเดินทางไปรับเครื่อง ตรวจเช็ค และโอนเงินให้ถึงหน้าบ้าน หรือหากอยู่ต่างจังหวัด ก็มีระบบการส่งพัสดุที่ตรวจสอบรัดกุมและโอนเงินรวดเร็วทันใจ</p>

			<h2>PlayStation — PS4, PS5 ให้ราคาสูงสุดในตลาดมือสอง</h2>
			<p>ในบรรดาเครื่องเกมคอนโซลทั้งหมด แบรนด์ PlayStation จาก Sony ถือเป็นเจ้าตลาดที่มีความต้องการซื้อขายหมุนเวียนสูงสุด เรารับซื้อทั้ง PlayStation 5 (PS5) เครื่องเล่นเกมเจเนอเรชันปัจจุบันที่ได้รับความนิยมล้นหลาม และ PlayStation 4 (PS4) ที่ยังมีฐานผู้เล่นเหนียวแน่นอยู่เสมอ</p>
			<p>สำหรับ PlayStation 5 เรารับซื้อทั้งรุ่นใส่แผ่น (Disc Edition) ที่มีราคามือสองสูงกว่าเล็กน้อย และรุ่นดิจิทัล (Digital Edition) ปัจจัยหลักที่กำหนดราคา PS5 นอกเหนือจากความสมบูรณ์ของตัวเครื่องแล้ว คือ "รหัสรุ่น" หรือ Model Number เช่น รุ่นแรกเริ่ม (CFI-1000/1100 Series) กับรุ่นที่มีการปรับปรุงระบบระบายความร้อนใหม่ (CFI-1200 Series) หรือแม้แต่ PS5 Slim รุ่นล่าสุด รวมถึงพื้นที่ความจุที่มีให้ หากเครื่องของคุณเป็นโมเดลใหม่ๆ ที่ยังอยู่ในระยะเวลาประกันศูนย์ไทย ก็จะยิ่งดันราคารับซื้อให้พุ่งสูงขึ้นไปอีก</p>
			<p>ทางฝั่งของ PlayStation 4 แม้จะตกรุ่นไปแล้ว แต่ด้วยไลบรารีเกมที่มหาศาลและราคาที่เข้าถึงง่าย ทำให้ยังมีคนตามหาซื้ออยู่ตลอดเวลา เรารับซื้อทั้งรุ่นออริจินัล รุ่น Slim และรุ่น Pro โดยเฉพาะรุ่น PS4 Pro ที่รองรับความละเอียด 4K ซึ่งยังคงเป็นที่ต้องการของคนที่อยากเล่นเกมกราฟิกสวยๆ ในงบประหยัด สภาพความสะอาดของพัดลมระบายความร้อน การอ่านแผ่นที่ลื่นไหล และการไม่เคยแกะวอยด์ซ่อมบอร์ด คือสิ่งที่เราจะตรวจสอบเพื่อให้ราคาที่ดีที่สุด</p>
			<p>นอกจากตัวเครื่องแล้ว อุปกรณ์ชิ้นสำคัญที่มาคู่กับ PlayStation คือ "จอยคอนโทรลเลอร์" (DualSense สำหรับ PS5 และ DualShock 4 สำหรับ PS4) จอยสภาพสมบูรณ์ที่ไม่มีอาการอนาล็อกเดินเอง (Stick Drift) ปุ่มกดไม่จม และแบตเตอรี่ไม่เสื่อม จะช่วยให้การประเมินราคาลื่นไหลมาก หากคุณมีจอยเสริมมากกว่า 1 ตัว หรือมีจอยรุ่นพิเศษอย่าง DualSense Edge นำมาเสนอขายพร้อมกันได้เลย เราบวกราคาเพิ่มให้ทุกชิ้น</p>
			<p>อีกสิ่งหนึ่งที่เพิ่มมูลค่าได้อย่างมหาศาลคือ "แผ่นเกม" หากคุณเบื่อเล่นเครื่องแล้ว ย่อมหมายความว่าแผ่นเกมที่สะสมไว้ก็ไม่ได้ใช้เช่นกัน รวบรวมแผ่นเกม PS5 หรือ PS4 ทั้งหมดที่คุณมี ไม่ว่าจะเป็นเกม Exclusive ยอดฮิตอย่าง Spider-Man, God of War, The Last of Us หรือเกมกีฬาอย่าง FIFA, EA Sports FC ส่งรายชื่อและรูปหน้าปกแผ่นมาให้เราตีราคาเหมาเข่งได้เลย การขายพร้อมแผ่นมักจะได้ราคารวมที่คุ้มค่ากว่าการแยกขายทีละแผ่นมากๆ</p>

			
