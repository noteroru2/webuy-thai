const priceArticles = [
	{ href: '/iphone-13-มือสอง-ขายได้กี่บาท/', title: 'iPhone 13 มือสองขายได้กี่บาท', summary: 'ไม่มีราคาเดียว — ขึ้นกับรุ่นย่อย ความจุ สภาพ และตลาด ณ วันที่ประเมิน' },
	{ href: '/iphone-14-มือสอง-ขายได้กี่บาท/', title: 'iPhone 14 มือสองขายได้กี่บาท', summary: 'แยกราคาตามรุ่นย่อย Pro/Plus และสภาพจริง' },
	{ href: '/macbook-air-m1-มือสอง-ขายได้กี่บาท/', title: 'MacBook Air M1 มือสองขายได้กี่บาท', summary: 'ดู RAM SSD สภาพแบต และ Activation Lock' },
	{ href: '/macbook-pro-m1-มือสอง-ขายได้กี่บาท/', title: 'MacBook Pro M1 มือสองขายได้กี่บาท', summary: 'รุ่นจอ 13″/14″ และสเปกมีผลต่างกัน' },
	{ href: '/โน๊ตบุ๊ค-i5-มือสอง-ขายได้กี่บาท/', title: 'โน๊ตบุ๊ค i5 มือสองขายได้กี่บาท', summary: 'รุ่น i5 ไม่เท่ากัน — ต้องดูรุ่นปีของ CPU และสเปกเต็ม' },
	{ href: '/โน๊ตบุ๊คเกมมิ่ง-มือสอง-ขายได้กี่บาท/', title: 'โน๊ตบุ๊คเกมมิ่งมือสองขายได้กี่บาท', summary: 'การ์ดจอเป็นปัจจัยหลัก ตามด้วย CPU RAM SSD' },
	{ href: '/คอมเกมมิ่ง-มือสอง-ขายได้กี่บาท/', title: 'คอมเกมมิ่งมือสองขายได้กี่บาท', summary: 'CPU + GPU กำหนดช่วงราคา — ส่งสเปกและรูปในเคส' },
	{ href: '/คอมเก่า-ไม่มีการ์ดจอ-ขายได้กี่บาท/', title: 'คอมเก่าไม่มีการ์ดจอขายได้กี่บาท', summary: 'อาจขายเป็นชิ้นส่วนหรือเครื่องเปิดติดถ้ามีจอ onboard' },
	{ href: '/กล้อง-fujifilm-มือสอง-ขายได้กี่บาท/', title: 'กล้อง Fujifilm มือสองขายได้กี่บาท', summary: 'รุ่น เลนส์ ชัตเตอร์คาวน์ และสภาพเซ็นเซอร์' },
