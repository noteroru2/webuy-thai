---
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/landing/ButtonLink.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = businessPhone.replace(/^\+66/, '0').replace(/-/g, '');
const telHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;
const lineUrl = 'https://line.me/R/ti/p/@webuy';
const pagePath = '/คู่มือก่อนขาย/';

const pageDescription =
	'คู่มือก่อนขายไอทีมือสอง WE BUY — รวมบทความขายได้ไหม ราคา และความปลอดภัยก่อนขาย iPhone MacBook โน๊ตบุ๊ค คอม กล้อง iPad ทัก Line @webuy';

const problemArticles = [
	{ href: '/iphone-แบตเสื่อม-ขายได้ไหม/', title: 'iPhone แบตเสื่อมขายได้ไหม', summary: 'แบตต่ำหรือขึ้น Service ยังขายได้ในหลายกรณี — ราคาขึ้นกับสุขภาพแบตและสภาพจอ' },
	{ href: '/iphone-จอแตก-ขายได้ไหม/', title: 'iPhone จอแตกขายได้ไหม', summary: 'จอแตกไม่ได้หมายความว่าขายไม่ได้เสมอ — ขึ้นกับระดับความเสียหายและรุ่น' },
	{ href: '/iphone-ติด-icloud-ขายได้ไหม/', title: 'iPhone ติด iCloud ขายได้ไหม', summary: 'ต้องออกจากบัญชีก่อน — WE BUY ไม่รับเครื่องยืนยันเจ้าของไม่ได้' },
	{ href: '/macbook-เปิดไม่ติด-ขายได้ไหม/', title: 'MacBook เปิดไม่ติดขายได้ไหม', summary: 'บางกรณียังประเมินได้ — แจ้งอาการและสภาพจริงตั้งแต่ใน Line' },
	{ href: '/macbook-แบตเสื่อม-ขายได้ไหม/', title: 'MacBook แบตเสื่อมขายได้ไหม', summary: 'รอบชาร์จสูงหรือแบตบวมมีผลต่อราคา — ส่งภาพสถานะแบต' },
	{ href: '/โน๊ตบุ๊ค-เปิดไม่ติด-ขายได้ไหม/', title: 'โน๊ตบุ๊คเปิดไม่ติดขายได้ไหม', summary: 'ขึ้นกับสาเหตุและสเปก — แจ้งอาการและรูปไฟ/พัดลม' },
	{ href: '/โน๊ตบุ๊ค-ไม่มีที่ชาร์จ-ขายได้ไหม/', title: 'โน๊ตบุ๊คไม่มีที่ชาร์จขายได้ไหม', summary: 'พอร์ตชาร์จเสียมีผลต่อราคา — บางรุ่นยังรับประเมินได้' },
	{ href: '/คอมเก่า-10-ปี-ขายได้ไหม/', title: 'คอมเก่า 10 ปีขายได้ไหม', summary: 'บางรุ่นยังมีมูลค่าเป็นชิ้นส่วน บางรุ่นตลาดไม่รับ — ดูสเปกจริง' },
	{ href: '/คอมเปิดไม่ติด-ขายได้ไหม/', title: 'คอมเปิดไม่ติดขายได้ไหม', summary: 'ขึ้นกับว่าเปิดไม่ติดเพราะอะไร และชิ้นส่วนหลักยังใช้ได้หรือไม่' },
	{ href: '/กล้องเลนส์ขึ้นรา-ขายได้ไหม/', title: 'กล้องเลนส์ขึ้นราขายได้ไหม', summary: 'ขึ้นกับตำแหน่งรา สภาพเลนส์ และรุ่นกล้อง' },
];

const priceArticles = [
	{ href: '/iphone-13-มือสอง-ขายได้กี่บาท/', title: 'iPhone 13 มือสองขายได้กี่บาท', summary: 'ไม่มีราคาเดียว — ขึ้นกับรุ่นย่อย ความจุ สภาพ และตลาด ณ วันที่ประเมิน' },
	{ href: '/iphone-14-มือสอง-ขายได้กี่บาท/', title: 'iPhone 14 มือสองขายได้กี่บาท', summary: 'แยกราคาตามรุ่นย่อย Pro/Plus และสภาพจริง' },
	{ href: '/macbook-air-m1-มือสอง-ขายได้กี่บาท/', title: 'MacBook Air M1 มือสองขายได้กี่บาท', summary: 'ดู RAM SSD สภาพแบต และ Activation Lock' },
	{ href: '/macbook-pro-m1-มือสอง-ขายได้กี่บาท/', title: 'MacBook Pro M1 มือสองขายได้กี่บาท', summary: 'รุ่นจอ 13″/14″ และสเปกมีผลต่างกัน' },
	{ href: '/โน๊ตบุ๊ค-i5-มือสอง-ขายได้กี่บาท/', title: 'โน๊ตบุ๊ค i5 มือสองขายได้กี่บาท', summary: 'รุ่น i5 ไม่เท่ากัน — ต้องดูรุ่นปีของ CPU และสเปกเต็ม' },
	{ href: '/โน๊ตบุ๊คเกมมิ่ง-มือสอง-ขายได้กี่บาท/', title: 'โน๊ตบุ๊คเกมมิ่งมือสองขายได้กี่บาท', summary: 'การ์ดจอเป็นปัจจัยหลัก ตามด้วย CPU RAM SSD' },
	{ href: '/คอมเกมมิ่ง-มือสอง-ขายได้กี่บาท/', title: 'คอมเกมมิ่งมือสองขายได้กี่บาท', summary: 'CPU + GPU กำหนดช่วงราคา — ส่งสเปกและรูปในเคส' },
	{ href: '/คอมเก่า-ไม่มีการ์ดจอ-ขายได้กี่บาท/', title: 'คอมเก่าไม่มีการ์ดจอขายได้กี่บาท', summary: 'อาจขายเป็นชิ้นส่วนหรือเครื่องเปิดติดถ้ามีจอ onboard' },
	{ href: '/กล้อง-fujifilm-มือสอง-ขายได้กี่บาท/', title: 'กล้อง Fujifilm มือสองขายได้กี่บาท', summary: 'รุ่น เลนส์ ชัตเตอร์คาวน์ และสภาพเซ็นเซอร์' },
	{ href: '/ipad-gen-9-มือสอง-ขายได้กี่บาท/', title: 'iPad Gen 9 มือสองขายได้กี่บาท', summary: 'ความจุ Wi‑Fi/Cellular และสภาพจอแบต' },
];

const trustArticles = [
	{ href: '/ก่อนขาย-iphone-ล้างข้อมูล/', title: 'ก่อนขาย iPhone ต้องล้างข้อมูลยังไง', summary: 'Sign Out Apple ID ปิด Find My แล้วรีเซ็ตเครื่อง' },
	{ href: '/ก่อนขาย-macbook-ลบข้อมูล/', title: 'ก่อนขาย MacBook ต้องลบข้อมูลยังไง', summary: 'Erase Mac หลังออกจาก Apple ID' },
	{ href: '/ก่อนขายโน๊ตบุ๊ค-ลบข้อมูลอะไร/', title: 'ก่อนขายโน๊ตบุ๊คต้องลบข้อมูลอะไรบ้าง', summary: 'รีเซ็ต Windows หรือถอด HDD เก็บเอง' },
	{ href: '/ขายมือถือให้ร้าน-ปลอดภัยไหม/', title: 'ขายมือถือให้ร้านปลอดภัยไหม', summary: 'เลือกร้านโปร่งใส และเคลียร์บัญชีก่อนส่งมอบ' },
	{ href: '/ขายโน๊ตบุ๊คมือสอง-ใช้บัตรประชาชนไหม/', title: 'ขายโน๊ตบุ๊คมือสองต้องใช้บัตรประชาชนไหม', summary: 'ยืนยันตัวตนเจ้าของผู้ขาย — ไม่ใช่ปลดล็อกแทน' },
	{ href: '/ร้านรับซื้อไอที-ประเมินราคาจากอะไร/', title: 'ร้านรับซื้อไอทีประเมินราคาจากอะไร', summary: 'รุ่น สเปก สภาพ อุปกรณ์ และตลาด ณ วันที่ตรวจ' },
	{ href: '/ขาย-iphone-ติด-apple-id-ได้ไหม/', title: 'ขาย iPhone ติดบัญชี Apple ID ได้ไหม', summary: 'ต้องออกจากบัญชีก่อน — ไม่รับเครื่องติดล็อก' },
	{ href: '/ขาย-android-ติด-google-ได้ไหม/', title: 'ขาย Android ติดบัญชี Google ได้ไหม', summary: 'ลบบัญชี Google ก่อนรีเซ็ตเพื่อไม่ให้ติด FRP' },
	{ href: '/ขายคอมเก่า-ข้อมูลในเครื่อง-ทำยังไง/', title: 'ขายคอมเก่ามีข้อมูลในเครื่องต้องทำยังไง', summary: 'สำรอง ลบข้อมูล รีเซ็ตหรือถอดดิสก์' },
	{ href: '/ส่งเครื่องให้ร้านประเมิน-ปลอดภัยไหม/', title: 'ส่งเครื่องให้ร้านประเมินก่อนขายปลอดภัยไหม', summary: 'เช็กราคาใน Line ก่อน แล้วค่อยนัดตรวจหน้างาน' },
];

const conversionLinks = [
	{ href: '/เช็กราคาก่อนขาย/', title: 'เช็กราคาก่อนขาย', detail: 'รายการข้อมูลและรูปที่ควรส่งก่อนทัก Line' },
	{ href: '/ราคากลางรับซื้อ/', title: 'ราคากลางรับซื้อ', detail: 'ปัจจัยที่มีผลต่อราคาแต่ละประเภทสินค้า' },
	{ href: '/ความน่าเชื่อถือ/', title: 'ความน่าเชื่อถือ', detail: 'ขั้นตอนประเมิน ความปลอดภัยข้อมูล และนโยบายเครื่องติดล็อก' },
];

const moneyPages = [
	{ href: '/รับซื้อไอโฟน/', label: 'รับซื้อไอโฟน' },
	{ href: '/รับซื้อแมคบุ๊ค/', label: 'รับซื้อแมคบุ๊ค' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', label: 'รับซื้อโน๊ตบุ๊ค' },
	{ href: '/รับซื้อคอม/', label: 'รับซื้อคอม' },
	{ href: '/รับซื้อกล้อง/', label: 'รับซื้อกล้อง' },
	{ href: '/รับซื้อไอแพด/', label: 'รับซื้อ iPad' },
];

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${site}${pagePath}#webpage`,
		name: formatPageTitle('คู่มือก่อนขาย'),
		description: pageDescription,
		url: `${site}${pagePath}`,
		inLanguage: 'th-TH',
		isPartOf: { '@type': 'WebSite', url: `${site}/` },
		about: {
			'@type': 'Thing',
			name: 'คู่มือขายสินค้าไอทีมือสอง',
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'คู่มือก่อนขาย', item: `${site}${pagePath}` },
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('คู่มือก่อนขาย')}
	description={pageDescription}
	pathname={pagePath}
	jsonLd={jsonLd}
>
	<div class="font-sans bg-[#FAFAFA] text-text antialiased">
		<section class="border-b border-gray-200 bg-white">
			<div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
				<nav class="text-sm text-text-muted" aria-label="breadcrumb">
					<ol class="flex flex-wrap items-center gap-1.5">
						<li><a class="hover:text-brand-700" href="/">หน้าแรก</a></li>
						<li aria-hidden="true">/</li>
						<li class="font-medium text-text" aria-current="page">คู่มือก่อนขาย</li>
					</ol>
				</nav>
				<p class="mt-6 text-xs font-bold uppercase tracking-[0.14em] text-brand-700">Hub · {orgName}</p>
				<h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">คู่มือก่อนขายสินค้าไอทีมือสอง</h1>
				<p class="mt-5 max-w-3xl text-lg leading-[1.75] text-text-muted">
					คู่มือนี้รวมบทความสำหรับคนที่กำลังจะขาย <strong class="font-semibold text-text">iPhone, MacBook, โน๊ตบุ๊ค, คอม, กล้อง, iPad</strong>
					และสินค้าไอทีมือสองอื่น ๆ — เลือกอ่านตามคำถามที่ตรงกับเครื่องของคุณ แล้วเช็กราคาเบื้องต้นกับ WE BUY ได้
				</p>
			</div>
		</section>

		<section class="py-10 sm:py-12">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<div class="rounded-2xl border border-brand-200 bg-brand-50/60 p-6 sm:p-8">
					<p class="text-sm font-bold uppercase tracking-[0.12em] text-brand-800">คำตอบสั้น</p>
					<p class="mt-3 text-base leading-relaxed text-text sm:text-lg">
						<strong class="font-semibold text-text">ก่อนขายสินค้าไอทีมือสอง</strong> ควรรู้ว่าสินค้า<strong>ขายได้ไหม</strong>
						<strong>ราคาขึ้นกับอะไร</strong> และต้อง<strong>เตรียมข้อมูล/ล้างข้อมูล</strong>อย่างไร — WE BUY รวมคู่มือสำคัญไว้ให้ตรวจสอบก่อนทัก
						<a class="font-semibold text-brand-700 hover:underline" href={lineUrl} target="_blank" rel="noopener noreferrer">Line @webuy</a>
					</p>
				</div>
			</div>
		</section>

		<section class="border-t border-gray-200 bg-white py-12 sm:py-16" id="ขายได้ไหม">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">ขายได้ไหม</h2>
				<p class="mt-3 max-w-2xl text-text-muted">
					เครื่องมีปัญหา เช่น แบตเสื่อม จอแตก เปิดไม่ติด หรือติดบัญชี — อ่านแนวทางประเมินว่ายังขายได้ในบางกรณีหรือไม่
					(ไม่รับเครื่องที่ยืนยันเจ้าของไม่ได้)
				</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					{
						problemArticles.map((item) => (
							<li>
								<article class="h-full rounded-xl border border-gray-200 bg-[#FAFAFA] p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md">
									<h3 class="text-base font-bold leading-snug">
										<a class="text-brand-800 hover:text-brand-600 hover:underline" href={item.href}>
											{item.title}
										</a>
									</h3>
									<p class="mt-2 text-sm leading-relaxed text-text-muted">{item.summary}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="py-12 sm:py-16" id="ขายได้กี่บาท">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">ขายได้กี่บาท</h2>
				<p class="mt-3 max-w-2xl text-text-muted">
					ไม่มีราคาตายตัว — ขึ้นกับรุ่นย่อย ความจุ สภาพ อุปกรณ์ ประกัน และราคาตลาด ณ วันที่ประเมิน
					ดูแนวคิดราคาเพิ่มที่ <a class="font-medium text-brand-700 hover:underline" href="/ราคากลางรับซื้อ/">ราคากลางรับซื้อ</a>
				</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					{
						priceArticles.map((item) => (
							<li>
								<article class="h-full rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md">
									<h3 class="text-base font-bold leading-snug">
										<a class="text-brand-800 hover:text-brand-600 hover:underline" href={item.href}>
											{item.title}
										</a>
									</h3>
									<p class="mt-2 text-sm leading-relaxed text-text-muted">{item.summary}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-t border-gray-200 bg-white py-12 sm:py-16" id="ความปลอดภัยก่อนขาย">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">ความปลอดภัยก่อนขาย</h2>
				<p class="mt-3 max-w-2xl text-text-muted">
					ล้างข้อมูล ออกจากบัญชี ยืนยันตัวตน และเลือกร้านที่โปร่งใส — อ่านก่อนส่งมอบเครื่อง
				</p>
				<ul class="mt-8 grid gap-4 sm:grid-cols-2">
					{
						trustArticles.map((item) => (
							<li>
								<article class="h-full rounded-xl border border-gray-200 bg-[#FAFAFA] p-4 shadow-sm transition hover:border-brand-300 hover:shadow-md">
									<h3 class="text-base font-bold leading-snug">
										<a class="text-brand-800 hover:text-brand-600 hover:underline" href={item.href}>
											{item.title}
										</a>
									</h3>
									<p class="mt-2 text-sm leading-relaxed text-text-muted">{item.summary}</p>
								</article>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="border-t border-brand-500/20 bg-gradient-to-b from-brand-50/80 to-white py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">พร้อมเช็กราคาและขาย?</h2>
				<p class="mt-3 max-w-2xl text-text-muted">
					เลือกอ่านคู่มือด้านบนแล้วส่งข้อมูลเบื้องต้น — ราคาสุดท้ายยืนยันหลังตรวจเครื่องจริง ไม่บังคับขายหากไม่ตกลงราคา
				</p>
				<div class="mt-8 grid gap-4 sm:grid-cols-3">
					{
						conversionLinks.map((link) => (
							<a
								class="block rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition hover:border-brand-400 hover:shadow-md"
								href={link.href}
							>
								<span class="font-bold text-brand-800">{link.title}</span>
								<p class="mt-2 text-sm text-text-muted">{link.detail}</p>
							</a>
						))
					}
				</div>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer">
						ทัก LINE @webuy
					</ButtonLink>
					<ButtonLink href={telHref} variant="primary">โทร {phoneDisplay}</ButtonLink>
				</div>
			</div>
		</section>

		<section class="border-t border-gray-200 py-12 sm:py-16">
			<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
				<h2 class="text-2xl font-bold">หมวดรับซื้อหลัก</h2>
				<p class="mt-3 text-text-muted">ดูรายละเอียดบริการรับซื้อและปัจจัยราคาแต่ละประเภท</p>
				<ul class="mt-6 flex flex-wrap gap-3">
					{
						moneyPages.map((page) => (
							<li>
								<a
									class="inline-flex rounded-full border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-brand-800 shadow-sm transition hover:border-brand-400 hover:bg-brand-50"
									href={page.href}
								>
									{page.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</section>
	</div>
</BaseLayout>
