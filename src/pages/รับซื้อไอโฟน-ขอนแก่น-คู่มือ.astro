---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleFigure from '../components/longform/ArticleFigure.astro';
import ContactBox from '../components/ContactBox.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อไอโฟน-ขอนแก่น-คู่มือ/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const localCity = 'ขอนแก่น';

const priceItems = [
	{ model: 'iPhone 16 Pro / Pro Max', price: '25,000 - 35,000+ บาท', note: 'นัดรับได้ที่เซ็นทรัลขอนแก่น หรือ มข.' },
	{ model: 'iPhone 15 Series / 14 Pro', price: '16,000 - 28,000 บาท', note: 'เน้นเครื่องสภาพสวย สุขภาพแบต 90%+' },
	{ model: 'iPhone 11 / 12 / 13 Series', price: '6,000 - 15,000 บาท', note: 'รับซื้อทุกความจุ แม้เครื่องหมดประกัน' },
	{ model: 'iPhone จอแตก / แบตเสื่อม', price: '2,000 - 8,000 บาท', note: 'รับประเมินตามสภาพจริง เพื่อนำไปเป็นอะไหล่' },
];

const faqItems = [
	{
		q: `นัดรับไอโฟนใน${localCity}ได้ที่ไหนบ้าง?`,
		a: `เรามีทีมงานนัดรับที่เซ็นทรัล${localCity}, มหาวิทยาลัยขอนแก่น (มข.), ตลาดต้นตาล หรือตามคาเฟ่และปั๊มน้ำมันที่ลูกค้าสะดวกในเขตอำเภอเมืองครับ`,
	},
	{
		q: 'ขายไอโฟนที่ขอนแก่นกับ WE BUY ต่างจากขายตามตู้ในห้างยังไง?',
		a: 'เราให้ราคาที่อิงตามราคากลางตลาดมือสองกรุงเทพฯ ซึ่งส่วนใหญ่มักจะสูงกว่าราคาที่ร้านตู้รับเทิร์น และเราเน้นบริการนัดพบเพื่อความสบายใจของลูกค้า ไม่ต้องเดินหาร้านให้เหนื่อย',
	},
	{
		q: 'เครื่องนอก หรือเครื่องติดล็อกซิม รับซื้อไหม?',
		a: 'รับซื้อครับ แต่อาจมีส่วนต่างราคาเล็กน้อยเมื่อเทียบกับเครื่องศูนย์ไทย (TH/A) ทักไลน์แจ้ง Model เครื่องให้ทีมงานประเมินก่อนได้เลยครับ',
	},
	{
		q: 'ไอโฟนติด iCloud ขายได้ไหม?',
		a: 'ทางเราไม่รับซื้อเครื่องที่ติด iCloud หรือจำรหัสผ่านไม่ได้ทุกกรณีครับ ลูกค้าต้องทำการ Sign out ออกให้เรียบร้อยก่อนส่งมอบเพื่อความปลอดภัยของข้อมูลท่านเอง',
	},
	{
		q: 'นัดรับแล้วได้เงินเลยไหม?',
		a: 'ได้ทันทีครับ หลังจากทีมงานตรวจเช็คสภาพเครื่องตามขั้นตอนตรวจรับจริง จะทำการโอนเงินเข้าบัญชีหรือจ่ายเงินสดให้ท่านทันทีหน้างานครับ',
	},
	{
		q: 'ขายไอโฟนขอนแก่น ส่งรูปจากที่ไหนได้บ้าง?',
		a: 'ส่งผ่าน Line @webuy จากที่บ้าน ที่ทำงาน หรือก่อนนัดที่เซ็นทรัลขอนแก่น มข. หรือตลาดต้นตาล — ไม่ต้องเดินหาร้านก่อนประเมิน',
	},
	{
		q: 'ทำไมราคาประเมินเบื้องต้นอาจเปลี่ยนหลังนัดรับที่ขอนแก่น?',
		a: 'เพราะการตรวจหน้างานอาจพบสภาพหรือแบตที่ต่างจากรูป — อ่านเหตุผลเพิ่มที่หน้าความน่าเชื่อถือ และแจ้งตำหนิตรงตั้งแต่รอบแรกจะช่วยให้ราคานิ่งขึ้น',
	},
];

const assessmentCases = [
	{
		model: 'iPhone 15 (256GB)',
		condition: 'สภาพดี Battery Health 92% จอไม่มีรอย True Tone ปกติ',
		accessories: 'กล่อง สายชาร์จ ใบเสร็จศูนย์ (ถ้ามี)',
		factors: 'รุ่นยังเป็นที่ต้องการ, แบตดี, อุปกรณ์ครบ — นัดรับที่เซ็นทรัลขอนแก่น',
	},
	{
		model: 'iPhone 11 (64GB, เครื่องนอก LL/A)',
		condition: 'ตัวเครื่องมีรอยใช้งาน แบตประมาณ 81% ฟังก์ชันปกติ',
		accessories: 'ตัวเครื่องและสายชาร์จ',
		factors: 'เครื่องนอกมีส่วนต่างจากศูนย์ไทย, แบตใกล้เกณฑ์เสื่อม — ช่วงราคายืนยันหลังตรวจ',
	},
];

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: `รับซื้อ iPhone ขอนแก่น — คู่มือขายไอโฟนมือสองให้ได้ราคาสูง จ่ายเงินสด`,
		description: `ร้านรับซื้อ iPhone มือสองขอนแก่น ทุกรุ่น หลายสภาพตามเงื่อนไข ประเมินราคาออนไลน์เบื้องต้น นัดรับในเมืองขอนแก่น มข. ชำระเงินหลังยืนยันสภาพ ติดต่อ Line @webuy`,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
		about: { '@id': `${site}/#organization` }
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${pageUrl}#faq`,
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
]
---

<BaseLayout
	title={formatPageTitle(`รับซื้อไอโฟน ${localCity}`)}
	description={`มองหาร้านรับซื้อ iPhone ในจังหวัด${localCity}? WE BUY รับซื้อไอโฟนทุกรุ่น นัดรับในเขตเมือง มข. และเซ็นทรัล ประเมินราคาผ่านไลน์ฟรี ชำระเงินหลังยืนยันสภาพ`}
	pathname="/รับซื้อไอโฟน-ขอนแก่น-คู่มือ/"
	type="article"
	jsonLd={jsonLd}
>
	<article class="container longform">

		<header class="article-head">
			<p class="kicker">Khon Kaen Local Service</p>
			<h1>รับซื้อไอโฟน {localCity} — คู่มือขาย iPhone มือสองให้ได้ราคาดี นัดรับด่วน มข. และในเมือง</h1>
			<p class="intro">
				ชาว <strong>{localCity}</strong> ท่านใดที่กำลังวางแผนจะเปลี่ยนไอโฟนเครื่องใหม่ หรือมีเครื่องเก่าเก็บไว้ไม่ได้ใช้งาน 
				วันนี้คุณสามารถเปลี่ยนไอโฟนเป็นเงินสดได้ง่าย ๆ โดยไม่ต้องเดินทางไปตระเวนหาร้านในห้างให้เสียเวลา 
				WE BUY มีทีมงานพร้อมนัดรับและประเมินราคาไอโฟนของคุณถึงที่ในเขตเมืองขอนแก่น 
				รับประกันราคาที่เป็นธรรมตามสภาพจริง และชำระเงินหลังยืนยันสภาพหน้างาน
			</p>
		</header>

		<PriceGuide title={`ราคารับซื้อไอโฟนใน${localCity} อัปเดต`} items={priceItems} />

		<ArticleFigure
			src="/media/imported/wp.xn-c3c3a0aa6cvaf8b9dze.com/Apple-iPhone-15-Pro-04f0bd8c1f.jpg"
			alt="ภาพ iPhone ระดับ Pro ที่ใช้ประกอบการประเมินรับซื้อในขอนแก่น"
			caption="<strong>รุ่น Pro มักถูกถามเรื่องจอและแบตเป็นพิเศษ:</strong> เครื่องสวย จอเดิม และไม่ติดบัญชี จะคุยราคาง่ายกว่ามาก"
			variant="wide"
		/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>จุดนัดรับยอดนิยมในจังหวัด{localCity}</h2>
			<p>
				เราเน้นความสะดวกของลูกค้าเป็นหลัก ท่านสามารถเลือกจุดนัดพบที่ท่านมั่นใจและเดินทางสะดวกได้ ดังนี้:
			</p>
			<ul>
				<li><strong>ย่านมหาวิทยาลัยขอนแก่น (มข.):</strong> คอมเพล็กซ์ มข., ยูเซ็นเตอร์, หรือร้านกาแฟย่านหลังมอดินแดง</li>
				<li><strong>ห้างสรรพสินค้า:</strong> เซ็นทรัลขอนแก่น, ฮักซ์มอลล์ (Hugz Mall), ตึกคอมขอนแก่น</li>
				<li><strong>พื้นที่พักผ่อน:</strong> ตลาดต้นตาล, บึงแก่นนคร, หรือตามสถานีบริการน้ำมันหลักในตัวเมือง</li>
			</ul>
			<p class="mt-4 text-sm leading-relaxed text-muted">
				<a href="/พื้นที่ให้บริการ/">ดูคู่มือพื้นที่ให้บริการทั้งหมด</a>
				รวมลิงก์คู่มือรับซื้อตามจังหวัดที่ WE BUY มีหน้าไว้แล้ว
			</p>
		</section>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>ทำไมชาวขอนแก่นถึงไว้วางใจขายไอโฟนกับเรา</h2>
			<div class="highlight-box">
				<strong>จุดเด่น:</strong> บริการที่รวดเร็ว ประเมินราคาจบก่อนนัดพบ และทีมงานมืออาชีพที่เข้าใจสินค้า Apple จริง ๆ
			</div>
			
			<h3>1. ราคามาตรฐานกรุงเทพฯ แต่บริการถึงที่ขอนแก่น</h3>
			<p>
				หลายครั้งที่ร้านในต่างจังหวัดอาจให้ราคาต่ำกว่าปกติเนื่องจากมีรอบหมุนเวียนสินค้าช้า 
				แต่ WE BUY อิงราคาตามตลาดมือสองส่วนกลาง ทำให้คุณได้รับราคาที่สูงกว่าการขายตามตู้ทั่วไป
			</p>

			<h3>2. ปลอดภัยและเป็นส่วนตัว</h3>
			<p>
				เราช่วยคุณตรวจสอบการลบข้อมูล (Reset) และการ Sign out ออกจาก iCloud อย่างถูกวิธีต่อหน้า 
				เพื่อให้มั่นใจว่าข้อมูลส่วนตัวของคุณจะไม่หลุดรอดไปไหนตามขั้นตอนที่แนะนำ
			</p>

			<h3>3. ตอบเร็ว นัดไว ชำระเงินหลังยืนยันสภาพ</h3>
			<p>
				เพียงทักแชท Line <a href="https://line.me/R/ti/p/@webuy">@webuy</a> ส่งรูปและสุขภาพแบต 
				ทีมงานขอนแก่นจะรีบประสานงานเพื่อขอนัดคิวรับเครื่องภายในวันที่คุณสะดวกที่สุด
			</p>
		</section>

		<ContactBox
			heading={`คนขอนแก่นอยากขายไอโฟนด่วน?`}
			text="ส่งรูปเครื่องพร้อมระบุรุ่นและความจุมาที่ Line @webuy ได้เลยครับ ประเมินฟรี 24 ชม."
			variant="primary"
		/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>5 สิ่งที่ควรเตรียมก่อนนัดรับไอโฟนในขอนแก่น</h2>
			<p>
				ถ้าคุณอยู่ในขอนแก่นและอยากให้การขาย iPhone จบแบบไม่ต้องเสียเวลาหลายรอบ การเตรียมข้อมูลก่อนนัดรับถือว่าสำคัญมาก
				เพราะจะช่วยให้ราคาที่คุยกันในแชตใกล้เคียงราคาจริง และทำให้ทีมงานประเมินเครื่องได้เร็วขึ้น โดยเฉพาะลูกค้าที่นัดในโซน
				มข. เซ็นทรัลขอนแก่น หรือตลาดต้นตาลซึ่งมักต้องการจบงานในช่วงเวลาจำกัด
			</p>
			<ol>
				<li><strong>เช็คสุขภาพแบต:</strong> เข้าไปที่ Setting > Battery > Battery Health เพื่อดูเปอร์เซ็นต์</li>
				<li><strong>สำรองข้อมูล:</strong> Backup รูปภาพและ LINE ของคุณให้เรียบร้อย</li>
				<li><strong>ชาร์จแบตเตอรี่:</strong> เตรียมแบตให้เหลืออย่างน้อย 50% เพื่อให้ทีมงานเปิดทดสอบเครื่องได้ทันที</li>
				<li><strong>เตรียมอุปกรณ์เสริม:</strong> หากมีกล่อง ชุดชาร์จแท้ หรือใบเสร็จ จะช่วยเพิ่มราคาได้อีกครับ</li>
				<li><strong>นัดจุดที่สะดวก:</strong> เลือกสถานที่ที่คนพลุกพล่านและมีแสงสว่างเพื่อให้ตรวจสภาพเครื่องได้ชัดเจน</li>
			</ol>
			<p>
				เพิ่มเติมอีกนิดคือ ถ้าเครื่องเคยเปลี่ยนจอ เปลี่ยนแบต หรือมีอาการอย่าง Face ID ใช้ไม่ได้ กล้องสั่น ลำโพงเบา ควรแจ้งตั้งแต่รอบแรก
				เพราะข้อมูลพวกนี้มีผลกับราคาจริงพอสมควร การบอกตรง ๆ จะช่วยให้คุณไม่ต้องเจอสถานการณ์ที่ตกลงราคากันไว้แล้วแต่ต้องมาปรับกันหน้างานครับ
			</p>
		</section>

		<section>
			<h2>ปัจจัยที่ทำให้ราคา iPhone ในขอนแก่นขยับขึ้นหรือลง</h2>
			<p>
				แม้จะเป็นรุ่นเดียวกัน แต่ราคามือสองอาจต่างกันหลายพันบาทได้จากรายละเอียดไม่กี่อย่าง เราเลยอยากสรุปแบบอ่านง่าย
				เพื่อให้คุณใช้เช็กเครื่องตัวเองก่อนทักมาประเมิน
			</p>
			<h3>1. รุ่น ความจุ และความนิยมของตลาด</h3>
			<p>
				iPhone รุ่นใหม่หรือรุ่นที่ยังมีคนตามหาเยอะ เช่น 13, 14, 15 Series มักมีสภาพคล่องดีในตลาดมือสองขอนแก่น
				โดยเฉพาะรุ่นความจุ 128GB และ 256GB ที่ใช้งานง่ายกับลูกค้าทั่วไป หากเป็นรุ่น Pro หรือ Pro Max สภาพสวย
				พร้อมแบตดี ก็มีโอกาสได้ราคานิ่งและปิดดีลง่ายกว่ารุ่นเก่ามากครับ
			</p>
			<h3>2. สุขภาพแบตและความเสถียรของเครื่อง</h3>
			<p>
				แบตเตอรี่เป็นจุดที่คนซื้อปลายทางถามบ่อยที่สุด เพราะสะท้อนทั้งอายุการใช้งานและค่าใช้จ่ายหลังซื้อ
				เครื่องที่แบตต่ำกว่า 80% ยังขายได้ แต่จะมีส่วนต่างจากเครื่องที่แบต 85-90% ขึ้นไปอย่างเห็นได้ชัด
				ยิ่งถ้าเครื่องมีอาการร้อนง่าย ดับเอง หรือชาร์จช้า ราคาจะถูกคำนวณเผื่อต้นทุนซ่อมเข้าไปด้วย
			</p>
			<h3>3. หน้าจอเดิม ขอบเครื่อง และฝาหลัง</h3>
			<p>
				เครื่องที่จอเดิมไม่เคยเปลี่ยน สีตรง ทัชลื่น และไม่มีเส้นหรือจุดดำ จะได้เปรียบมากกว่าเครื่องที่เคยเปลี่ยนจอนอกศูนย์
