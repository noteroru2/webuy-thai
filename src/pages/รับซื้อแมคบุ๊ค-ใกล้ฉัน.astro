	},
	{
		q: 'MacBook คีย์บอร์ดภาษาอื่น (เช่น ญี่ปุ่น, อังกฤษล้วน) รับไหม?',
		a: 'รับครับ แต่อาจมีผลต่อราคาเล็กน้อยเทียบกับคีย์บอร์ดภาษาไทย-อังกฤษ (TH/EN) เนื่องจากตลาดมือสองในไทยมีความต้องการต่างกัน ทีมงานจะแจ้งส่วนต่างให้ทราบล่วงหน้า',
	},
	{
		q: 'อุปกรณ์ไม่ครบ เช่น ไม่มีกล่อง ไม่มีสายชาร์จ รับไหม?',
		a: 'รับซื้อครับ แต่อุปกรณ์ที่ครบถ้วน (กล่องเดิม, อะแดปเตอร์แท้, สายชาร์จ) จะช่วยเพิ่มมูลค่ารับซื้อได้ดีกว่าเครื่องที่มีแต่ตัวเครื่องเปล่า ๆ',
	},
	{
		q: 'ให้บริการวันไหนบ้าง?',
		a: 'เปิดให้บริการรับประเมินราคาและปรึกษาตลอด 24 ชั่วโมง ทุกวัน ไม่มีวันหยุด สามารถทัก Line @webuy หรือโทร 064-257-9353 ได้ทุกเมื่อ',
	},
	{
		q: 'ดูราคากลางรับซื้อ MacBook ได้ที่ไหน?',
		a: 'หน้าราคากลางรับซื้อสรุปปัจจัยที่มีผลต่อราคา MacBook เช่น รุ่นชิป RAM SSD รอบชาร์จและสภาพจอ — ไม่ใส่ตัวเลขมั่ว ราคาจริงยืนยันหลังตรวจเครื่อง',
	},
	{
		q: 'เช็กราคา MacBook ก่อนขายต้องส่งอะไรบ้าง?',
		a: 'ดูรายการแนะนำที่หน้าเช็กราคาก่อนขาย เช่น รุ่น สเปกจาก About This Mac รูปตำหนิ และสถานะ Apple ID แล้วส่งผ่าน Line @webuy',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อ MacBook มือสอง ทุกรุ่น ประเมินราคาโปร่งใส ใกล้ฉัน บริการรับถึงที่',
		description:
			'WE BUY รับซื้อ MacBook Air / Pro มือสองทุกรุ่น ทั้งชิป Intel และ M1-M5 ประเมินราคาโปร่งใสตามสเปกและรอบชาร์จ จ่ายเงินทันที บริการ 24 ชม. ติดต่อ Line @webuy',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อ MacBook มือสอง ทุกรุ่น | คู่มือการขาย MacBook ให้ได้ราคาสูง ใกล้ฉัน ให้ราคาสูง จ่ายเงินสดทันที',
		description:
			'เจาะลึกเกณฑ์การประเมินราคา MacBook มือสอง วิธีเช็กรอบชาร์จ การเตรียมเครื่องก่อนขาย และขั้นตอนการขายอย่างปลอดภัย ครอบคลุม MacBook Air, MacBook Pro ทุกรุ่น ทั่วประเทศ',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-05-27',
		image: [new URL('/og-default.png', site).toString()],
		keywords: 'รับซื้อ macbook, รับซื้อ macbook air, รับซื้อ macbook pro, ขาย macbook มือสอง, ประเมินราคา macbook, รับซื้อ macbook m1, รับซื้อ macbook m2, รับซื้อ macbook m3, รับซื้อ macbook m4, รับซื้อ macbook m5, ขายแมคบุ๊ค, รับซื้อ MacBookใกล้ฉัน, ร้านรับซื้อ MacBookใกล้บ้าน, รับซื้อถึงที่',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ ใกล้ฉัน บริการรับถึงที่', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อ MacBook ใกล้ฉัน บริการรับถึงที่', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อ MacBook มือสอง ใกล้ฉัน บริการรับถึงที่',
		description:
			'บริการรับซื้อ MacBook Air และ MacBook Pro ทุกรุ่น ทุกสภาพ ประเมินราคาโปร่งใส จ่ายเงินทันที ติดต่อ Line @webuy ตลอด 24 ชั่วโมง',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อ MacBook มือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขาย MacBook มือสองกับ WE BUY',
		description: 'ขั้นตอนง่าย ๆ ในการขาย MacBook มือสองให้ได้ราคาดีและปลอดภัย',
		step: [
			{ '@type': 'HowToStep', name: 'ส่งข้อมูลและรูปเครื่อง', text: 'แอดไลน์ @webuy ส่งรูปหน้า About This Mac และรูปเครื่องทุกมุม' },
			{ '@type': 'HowToStep', name: 'รับราคาประเมินเบื้องต้น', text: 'ทีมงานแจ้งราคาตามสเปกและสภาพภายใน 15-30 นาที' },
			{ '@type': 'HowToStep', name: 'เตรียมเครื่องก่อนส่งมอบ', text: 'สำรองข้อมูล ออกจาก Apple ID และปิด Find My Mac' },
			{ '@type': 'HowToStep', name: 'รับเงินทันที', text: 'นัดรับหรือส่งพัสดุ ตรวจสภาพเสร็จรับเงินโอนหรือเงินสดทันที' },
