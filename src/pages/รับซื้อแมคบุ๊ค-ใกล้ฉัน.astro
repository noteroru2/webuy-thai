---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';
import { isanMacbookPages } from '../lib/isanLocalHubs';

import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อแมคบุ๊ค-ใกล้ฉัน/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const macbookShowcase = [
	{
		src: '/media/notebook-showcase/macbook-air-on-box.webp',
		alt: 'ตัวอย่าง MacBook Air สำหรับประกอบการประเมินราคารับซื้อ',
		caption: 'MacBook ที่สภาพบอดี้สวยและมีกล่องเดิมครบ มักช่วยให้ปิดดีลได้ง่ายขึ้น',
	},
	{
		src: '/media/notebook-showcase/macbook-boot-screen.webp',
		alt: 'ตัวอย่าง MacBook เปิดเครื่องได้สำหรับการตรวจสภาพก่อนขาย',
		caption: 'รูปตอนเปิดเครื่องช่วยให้ดูการแสดงผลเบื้องต้นและยืนยันว่าเครื่องยังบูตใช้งานได้จริง',
	},
];

const priceItems = [
	{ model: 'MacBook Pro M4 / M5 Series', price: '45,000 - 85,000+ บาท', note: 'ราคาสูงสุดขึ้นอยู่กับจำนวน Core CPU/GPU และ RAM' },
	{ model: 'MacBook Pro M1 / M2 / M3 Pro/Max', price: '25,000 - 55,000 บาท', note: 'ประเมินจากรอบชาร์จและสภาพจอภาพ Liquid Retina XDR' },
	{ model: 'MacBook Air M2 / M3 / M4 (8GB - 24GB)', price: '18,000 - 35,000 บาท', note: 'เน้นสภาพสวย น้ำหนักเบา แบตเตอรี่เสื่อมน้อย' },
	{ model: 'MacBook Air M1 (รุ่นเริ่มต้น)', price: '12,000 - 16,000 บาท', note: 'รุ่นยอดนิยม ราคาค่อนข้างนิ่งในตลาดมือสอง' },
	{ model: 'MacBook Pro / Air รุ่น Intel (2017-2020)', price: '5,000 - 12,000 บาท', note: 'รับประเมินทุกอาการ จอแตก แบตเสื่อม ทักมาได้เลย' },
];

const faqItems = [
	{
		q: 'รับซื้อ MacBook รุ่นไหนบ้าง?',
		a: 'รับซื้อ MacBook ทุกรุ่น ทั้ง MacBook Air และ MacBook Pro ไม่ว่าจะเป็นรุ่นชิป Intel ดั้งเดิม หรือรุ่น Apple Silicon (M1, M2, M3, M4, M5) ครอบคลุมทุกขนาดหน้าจอ 11, 12, 13, 14, 15 และ 16 นิ้ว โดยพิจารณาจากสเปก สภาพ และความต้องการของตลาดเป็นหลัก',
	},
	{
		q: 'MacBook ติด Apple ID หรือ Find My Mac รับซื้อไหม?',
		a: 'จำเป็นต้องปลด Apple ID และปิด Find My Mac ก่อนส่งมอบครับ เพราะหากติด Activation Lock จะไม่สามารถโอนกรรมสิทธิ์ให้เจ้าของใหม่ได้ ซึ่งจะกระทบราคาอย่างมากหรืออาจไม่สามารถรับซื้อได้ หากไม่แน่ใจวิธีปลด ทีมงานสามารถแนะนำขั้นตอนให้ได้',
	},
	{
		q: 'รอบชาร์จ (Cycle Count) เยอะมีผลต่อราคาแค่ไหน?',
		a: 'มีผลครับ เพราะรอบชาร์จบอกถึงอายุการใช้งานแบตเตอรี่ โดยทั่วไปหากเกิน 500-800 รอบ แบตเตอรี่อาจเริ่มเสื่อม ซึ่งราคาจะปรับลงตามต้นทุนการเปลี่ยนแบตเตอรี่ใหม่เพื่อให้เครื่องพร้อมใช้งานต่อ',
	},
	{
		q: 'หน้าจอมีรอยลอก (Staingate) หรือจอชมพู รับซื้อไหม?',
		a: 'รับซื้อครับ ปัญหาหน้าจอลอกหรือจอแสดงผลผิดปกติถือเป็นตำหนิที่พบบ่อยใน MacBook รุ่นเก่า ทีมงานจะประเมินราคาโดยหักลบค่าอะไหล่จออย่างเป็นธรรม แจ้งอาการชัดเจนตั้งแต่แรกช่วยให้ประเมินได้แม่นยำขึ้น',
	},
	{
		q: 'ติดต่อช่องทางไหนตอบเร็วที่สุด?',
		a: 'แนะนำ Line @webuy ครับ เพราะคุณสามารถส่งรูปเครื่อง หน้าจอ About This Mac และรูปตำหนิได้ทันที ช่วยให้ทีมงานตีราคาได้ภายใน 15-30 นาทีในช่วงเวลาทำการ',
	},
	{
		q: 'จ่ายเงินอย่างไรหลังตกลงราคา?',
		a: 'จ่ายเงินสดทันทีหน้างาน หรือโอนเข้าบัญชีธนาคารตามที่ลูกค้าสะดวกทันทีหลังตรวจรับเครื่องเสร็จสิ้น ทุกธุรกรรมโปร่งใสและมีหลักฐานชัดเจน',
	},
	{
		q: 'อยู่ต่างจังหวัดขายได้ไหม?',
