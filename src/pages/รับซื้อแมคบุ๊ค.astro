---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อแมคบุ๊ค/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'MacBook Pro M4 / M5 Series', price: '45,000 - 85,000+ บาท', note: 'ราคาสูงสุดขึ้นอยู่กับจำนวน Core CPU/GPU และ RAM' },
	{ model: 'MacBook Pro M1 / M2 / M3 Pro/Max', price: '25,000 - 55,000 บาท', note: 'ประเมินจากรอบชาร์จและสภาพจอภาพ Liquid Retina XDR' },
	{ model: 'MacBook Air M2 / M3 / M4 (8GB - 24GB)', price: '18,000 - 35,000 บาท', note: 'เน้นสภาพสวย น้ำหนักเบา แบตเตอรี่เสื่อมน้อย' },
	{ model: 'MacBook Air M1 (รุ่นเริ่มต้น)', price: '12,000 - 16,000 บาท', note: 'รุ่นยอดนิยม ราคาค่อนข้างนิ่งในตลาดมือสอง' },
	{ model: 'MacBook Pro / Air รุ่น Intel (2017-2020)', price: '5,000 - 12,000 บาท', note: 'รับประเมินทุกอาการ จอแตก แบตเสื่อม ทักมาได้เลย' },
];

const faqItems = [
	{
		q: 'รับซื้อ MacBook รุ่นไหนบ้าง?',
		a: 'รับซื้อ MacBook ทุกรุ่น ทั้ง MacBook Air และ MacBook Pro ไม่ว่าจะเป็นรุ่นชิป Intel ดั้งเดิม หรือรุ่น Apple Silicon (M1, M2, M3, M4, M5) ครอบคลุมทุกขนาดหน้าจอ 11, 12, 13, 14, 15 และ 16 นิ้ว โดยพิจารณาจากสเปก สภาพ และความต้องการของตลาดเป็นหลัก',
	},
	{
		q: 'MacBook ติด Apple ID หรือ Find My Mac รับซื้อไหม?',
		a: 'จำเป็นต้องปลด Apple ID และปิด Find My Mac ก่อนส่งมอบครับ เพราะหากติด Activation Lock จะไม่สามารถโอนกรรมสิทธิ์ให้เจ้าของใหม่ได้ ซึ่งจะกระทบราคาอย่างมากหรืออาจไม่สามารถรับซื้อได้ หากไม่แน่ใจวิธีปลด ทีมงานสามารถแนะนำขั้นตอนให้ได้',
	},
	{
		q: 'รอบชาร์จ (Cycle Count) เยอะมีผลต่อราคาแค่ไหน?',
		a: 'มีผลครับ เพราะรอบชาร์จบอกถึงอายุการใช้งานแบตเตอรี่ โดยทั่วไปหากเกิน 500-800 รอบ แบตเตอรี่อาจเริ่มเสื่อม ซึ่งราคาจะปรับลงตามต้นทุนการเปลี่ยนแบตเตอรี่ใหม่เพื่อให้เครื่องพร้อมใช้งานต่อ',
	},
	{
		q: 'หน้าจอมีรอยลอก (Staingate) หรือจอชมพู รับซื้อไหม?',
		a: 'รับซื้อครับ ปัญหาหน้าจอลอกหรือจอแสดงผลผิดปกติถือเป็นตำหนิที่พบบ่อยใน MacBook รุ่นเก่า ทีมงานจะประเมินราคาโดยหักลบค่าอะไหล่จออย่างเป็นธรรม แจ้งอาการชัดเจนตั้งแต่แรกช่วยให้ประเมินได้แม่นยำขึ้น',
	},
	{
		q: 'ติดต่อช่องทางไหนตอบเร็วที่สุด?',
		a: 'แนะนำ Line @webuy ครับ เพราะคุณสามารถส่งรูปเครื่อง หน้าจอ About This Mac และรูปตำหนิได้ทันที ช่วยให้ทีมงานตีราคาได้ภายใน 15-30 นาทีในช่วงเวลาทำการ',
	},
	{
		q: 'จ่ายเงินอย่างไรหลังตกลงราคา?',
		a: 'จ่ายเงินสดทันทีหน้างาน หรือโอนเข้าบัญชีธนาคารตามที่ลูกค้าสะดวกทันทีหลังตรวจรับเครื่องเสร็จสิ้น ทุกธุรกรรมโปร่งใสและมีหลักฐานชัดเจน',
	},
	{
		q: 'อยู่ต่างจังหวัดขายได้ไหม?',
		a: 'ขายได้สะดวกมากครับ สามารถประเมินราคาผ่าน Line @webuy ก่อน เมื่อตกลงราคาแล้วจัดส่งเครื่องทางพัสดุ เมื่อทีมงานได้รับและตรวจสภาพเรียบร้อยจะโอนเงินให้ทันที พร้อมแนะนำวิธีแพ็กเครื่องให้ปลอดภัย',
	},
	{
		q: 'MacBook คีย์บอร์ดภาษาอื่น (เช่น ญี่ปุ่น, อังกฤษล้วน) รับไหม?',
		a: 'รับครับ แต่อาจมีผลต่อราคาเล็กน้อยเทียบกับคีย์บอร์ดภาษาไทย-อังกฤษ (TH/EN) เนื่องจากตลาดมือสองในไทยมีความต้องการต่างกัน ทีมงานจะแจ้งส่วนต่างให้ทราบล่วงหน้า',
	},
	{
		q: 'อุปกรณ์ไม่ครบ เช่น ไม่มีกล่อง ไม่มีสายชาร์จ รับไหม?',
		a: 'รับซื้อครับ แต่อุปกรณ์ที่ครบถ้วน (กล่องเดิม, อะแดปเตอร์แท้, สายชาร์จ) จะช่วยเพิ่มมูลค่ารับซื้อได้ดีกว่าเครื่องที่มีแต่ตัวเครื่องเปล่า ๆ',
	},
	{
		q: 'ให้บริการวันไหนบ้าง?',
		a: 'เปิดให้บริการรับประเมินราคาและปรึกษาตลอด 24 ชั่วโมง ทุกวัน ไม่มีวันหยุด สามารถทัก Line @webuy หรือโทร 064-257-9353 ได้ทุกเมื่อ',
	},
	{
		q: 'ดูราคากลางรับซื้อ MacBook ได้ที่ไหน?',
		a: 'หน้าราคากลางรับซื้อสรุปปัจจัยที่มีผลต่อราคา MacBook เช่น รุ่นชิป RAM SSD รอบชาร์จและสภาพจอ — ไม่ใส่ตัวเลขมั่ว ราคาจริงยืนยันหลังตรวจเครื่อง',
	},
	{
		q: 'เช็กราคา MacBook ก่อนขายต้องส่งอะไรบ้าง?',
		a: 'ดูรายการแนะนำที่หน้าเช็กราคาก่อนขาย เช่น รุ่น สเปกจาก About This Mac รูปตำหนิ และสถานะ Apple ID แล้วส่งผ่าน Line @webuy',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อ MacBook มือสอง ทุกรุ่น ประเมินราคาโปร่งใส',
		description:
			'WE BUY รับซื้อ MacBook Air / Pro มือสองทุกรุ่น ทั้งชิป Intel และ M1-M5 ประเมินราคาโปร่งใสตามสเปกและรอบชาร์จ จ่ายเงินทันที บริการ 24 ชม. ติดต่อ Line @webuy',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อ MacBook มือสอง ทุกรุ่น | คู่มือการขาย MacBook ให้ได้ราคาสูง',
		description:
			'เจาะลึกเกณฑ์การประเมินราคา MacBook มือสอง วิธีเช็กรอบชาร์จ การเตรียมเครื่องก่อนขาย และขั้นตอนการขายอย่างปลอดภัย ครอบคลุม MacBook Air, MacBook Pro ทุกรุ่น ทั่วประเทศ',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-03-24',
		image: [new URL('/og-default.png', site).toString()],
		keywords:
			'รับซื้อ macbook, รับซื้อ macbook air, รับซื้อ macbook pro, ขาย macbook มือสอง, ประเมินราคา macbook, รับซื้อ macbook m1, รับซื้อ macbook m2, รับซื้อ macbook m3, รับซื้อ macbook m4, รับซื้อ macbook m5, ขายแมคบุ๊ค',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อ MacBook', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อ MacBook มือสอง',
		description:
			'บริการรับซื้อ MacBook Air และ MacBook Pro ทุกรุ่น ทุกสภาพ ประเมินราคาโปร่งใส จ่ายเงินทันที ติดต่อ Line @webuy ตลอด 24 ชั่วโมง',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อ MacBook มือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขาย MacBook มือสองกับ WE BUY',
		description: 'ขั้นตอนง่าย ๆ ในการขาย MacBook มือสองให้ได้ราคาดีและปลอดภัย',
		step: [
			{ '@type': 'HowToStep', name: 'ส่งข้อมูลและรูปเครื่อง', text: 'แอดไลน์ @webuy ส่งรูปหน้า About This Mac และรูปเครื่องทุกมุม' },
			{ '@type': 'HowToStep', name: 'รับราคาประเมินเบื้องต้น', text: 'ทีมงานแจ้งราคาตามสเปกและสภาพภายใน 15-30 นาที' },
			{ '@type': 'HowToStep', name: 'เตรียมเครื่องก่อนส่งมอบ', text: 'สำรองข้อมูล ออกจาก Apple ID และปิด Find My Mac' },
			{ '@type': 'HowToStep', name: 'รับเงินทันที', text: 'นัดรับหรือส่งพัสดุ ตรวจสภาพเสร็จรับเงินโอนหรือเงินสดทันที' },
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อ MacBook มือสอง')}
	description="WE BUY รับซื้อ MacBook มือสองทุกรุ่น MacBook Air / Pro ทั้ง Intel และ M1-M5 ประเมินราคาโปร่งใสตามสเปกและรอบชาร์จ จ่ายเงินทันที บริการ 24 ชม. ติดต่อ Line @webuy"
	pathname="/รับซื้อแมคบุ๊ค/"
	type="article"
	jsonLd={articleJsonLd}
>
	<article class="container longform">

		<header class="article-head">
			<p class="kicker">Apple MacBook Buyback Service</p>
			<h1>รับซื้อ MacBook Air / Pro มือสอง ทุกรุ่น ทุกสภาพ — ประเมินราคาโปร่งใส จ่ายเงินทันที 24 ชม.</h1>
			<p class="intro">
				หากคุณกำลังมองหาที่ <strong>รับซื้อ MacBook</strong> ที่เข้าใจมูลค่าที่แท้จริงของอุปกรณ์ Apple ของคุณ
				คุณมาถูกที่แล้ว ไม่ว่าจะเป็น MacBook Air ที่น้ำหนักเบา หรือ MacBook Pro สเปกเทพสำหรับงานระดับโปร
				เรารับซื้อทุกรุ่น ตั้งแต่รุ่นชิป Intel ดั้งเดิม ไปจนถึงชิปตระกูล Apple Silicon รุ่นล่าสุด (M1 ถึง M5)
				เราประเมินราคาจากสเปกจริง รอบชาร์จ สุขภาพแบตเตอรี่ และสภาพภายนอกอย่างละเอียด พร้อมอธิบายเหตุผลราคาให้คุณเข้าใจ
				บทความนี้จะช่วยเตรียมความพร้อมให้คุณขาย MacBook ได้ราคาดีที่สุดและปลอดภัยที่สุด
				สนใจประเมินราคา ทัก <a class="inline-contact" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">Line @webuy</a> หรือโทร <a class="phone-link" href="tel:0642579353">064-257-9353</a> ได้ตลอดเวลาครับ
			</p>
		</header>

		<PriceGuide title="ราคารับซื้อ MacBook อ้างอิง (อัปเดต 2026)" items={priceItems} />

		<section class="eeat-note">
			<h2>บทเรียนจากการรับซื้อ MacBook จริง (รวมงานในอีสาน)</h2>
			<p>
				เมื่อลูกค้าถามว่า “ทำไมราคาต่างจากที่โพสต์ในกลุ่ม” คำตอบที่พบบ่อยคือ<strong>รอบชาร์จ (Cycle Count) สูงกว่าที่แจ้ง</strong>
				หรือยังเปิด Find My Mac อยู่ — สองอย่างนี้กระทบราคาได้ทันที
				ก่อนนัดรับ แนะนำส่งภาพ About This Mac → More Info และ Battery → Battery Health (หรือ System Information → Power)
				จะได้ช่วงราคาที่แคบลงและตรงกว่าพาเครื่องมาเปิดหน้างานครั้งแรก
			</p>
			<p>
				ในงานนัดรับที่อุบลฯ และจังหวัดใกล้เคียง ลูกค้ามักขาย MacBook Air M1/M2 หลังอัปเป็นรุ่นใหม่
				เครื่องที่จอเป็นเส้น (Staingate) ยังขายได้ แต่ควรส่งรูปหน้าจอสีขาวตั้งแต่ต้น — เราจะอธิบายส่วนหักให้ฟังก่อนตกลง
			</p>
		</section>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>ทำไมต้องขาย MacBook กับ WE BUY</h2>
			<p>
				MacBook เป็นอุปกรณ์ที่มีมูลค่าสูงและมีรายละเอียดทางเทคนิคเฉพาะตัว การขายให้กับร้านรับซื้อทั่วไปที่ไม่มีความชำนาญ
				อาจทำให้คุณถูกกดราคาจากความไม่เข้าใจในสเปก เช่น ความต่างของจำนวน Core หรือความสำคัญของสุขภาพแบตเตอรี่
				ที่ WE BUY เราเป็นผู้เชี่ยวชาญด้านสินค้า Apple เราประเมินราคาตามกลไกตลาดมือสองจริง ๆ และให้มูลค่าเพิ่มกับเครื่องที่ดูแลมาดี
			</p>

			<h3>ประเมินราคาแม่นยำด้วยข้อมูลจริง</h3>
			<p>
				เราไม่ใช้การเดา เราดูจากรุ่นปี (Model Year) ชิปประมวลผล (Processor/Chip) ขนาด RAM และ SSD
				รวมถึงรายละเอียดเล็ก ๆ อย่างรอบชาร์จ (Cycle Count) ของแบตเตอรี่ เพื่อให้ได้ราคาที่ยุติธรรมที่สุด
				ลูกค้าหลายคนประทับใจที่เราสามารถแจ้งราคาเบื้องต้นได้ทันทีผ่านรูปถ่ายหน้าจอเพียงไม่กี่รูป
			</p>

			<h3>จ่ายเงินทันที ไม่ต้องรอนาน</h3>
			<p>
