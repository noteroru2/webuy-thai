---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'AboutPage',
		name: `เกี่ยวกับเรา | ${siteName}`,
		url: `${site}/เกี่ยวกับเรา/`,
		description: `${orgName} — เน้นรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์มือสอง พร้อมบริการไอทีเสริม เน้นความโปร่งใสและการสื่อสารที่ตรวจสอบได้`,
		inLanguage: 'th-TH',
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'เกี่ยวกับเรา', item: `${site}/เกี่ยวกับเรา/` },
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('เกี่ยวกับเรา')}
	description={`รู้จัก ${orgName} (${siteName}) — แกนหลักรับซื้อโน้ตบุ๊คและรับซื้อคอมมือสอง โปร่งใส ติดต่อ LINE @webuy`}
	pathname="/เกี่ยวกับเรา/"
	jsonLd={jsonLd}
>
	<div class="font-sans bg-[#FAFAFA] text-[#111827] antialiased">
		<section class="border-b border-gray-200 bg-white py-14 sm:py-20">
			<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
				<h1 class="text-3xl font-extrabold sm:text-4xl">เกี่ยวกับเรา</h1>
				<p class="mt-6 text-lg leading-[1.75] text-[#4B5563]">
					{orgName} โฟกัสที่การ<span class="font-medium text-[#111827]">รับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์</span>มือสองเป็นหลัก
					พร้อมหมวดรับซื้ออื่น การซ่อมเบื้องต้นที่มีเหตุผล และการสนับสนุนข้อมูลให้ลูกค้าตัดสินใจได้ชัดเจน
				</p>
				<h2 class="mt-10 text-xl font-bold">สิ่งที่เราให้ความสำคัญ</h2>
				<ul class="mt-4 list-disc space-y-2 pl-5 text-[#4B5563] marker:text-[#f97316]">
					<li>แจ้งเงื่อนไขและช่วงราคาอย่างตรงไปตรงมา</li>
					<li>ใช้ช่องทางติดต่อที่ตรวจสอบย้อนหลังได้</li>
					<li>แนะนำทางเลือกเมื่อการซ่อมไม่คุ้มกับมูลค่าเครื่อง</li>
				</ul>
				<p class="mt-8">
					<a class="inline-flex rounded-full bg-[#f97316] px-6 py-3 text-sm font-semibold text-white hover:bg-[#ea580c]" href="/contact/">
						ติดต่อเรา
					</a>
				</p>
			</div>
		</section>

		<NaturalSeoSections
			theme="เกี่ยวกับทีม WE BUY และวิธีคิดในการรับซื้อไอทีมือสอง"
			audience="คนที่กำลังมองหาร้านรับซื้อที่คุยรู้เรื่อง อ่านเงื่อนไขแล้วเข้าใจ และอยากเห็นวิธีทำงานก่อนตัดสินใจ"
			geo="กรุงเทพฯ อุบลราชธานี ขอนแก่น โคราช อุดรธานี และพื้นที่ที่ลูกค้าติดต่อเข้ามาบ่อย"
			emphasis="การประเมินตามข้อมูลจริง การอธิบายเงื่อนไขแบบตรวจสอบได้ และการไม่ผลักลูกค้าให้ขายถ้ายังไม่พร้อม"
			prepareItems={[
				'ข้อมูลรุ่น สเปก ความจุ หรือรุ่นย่อยของอุปกรณ์ที่ต้องการขาย',
				'รูปจริงของเครื่อง มุมตำหนิ อุปกรณ์ที่มี และภาพหน้าจอที่ช่วยยืนยันสภาพ',
				'ข้อมูลเรื่องบัญชีผู้ใช้ การล้างข้อมูล และอาการผิดปกติที่ควรแจ้งก่อนประเมิน',
				'ความต้องการของผู้ขายว่าต้องการเช็กราคาเฉย ๆ หรือต้องการจบดีลภายในวันนั้น',
			]}
			valueFactors={[
				'ความครบของข้อมูลที่ผู้ขายส่งมาตั้งแต่รอบแรก',
				'ความชัดเจนของเงื่อนไขการรับซื้อและช่องทางการติดต่อที่ตรวจสอบย้อนหลังได้',
				'ความสามารถในการแยกแยะว่าหน้าไหนควรเป็นหน้าเสาหลัก หน้าไหนควรเป็นหน้า local และหน้าไหนควรเป็นคู่มือเสริม',
				'ความสม่ำเสมอระหว่างสิ่งที่เว็บบอกกับสิ่งที่ผู้ใช้เจอเมื่อติดต่อจริง',
			]}
			commonMistakes={[
				'มองหาร้านจากคำโฆษณาสั้น ๆ โดยไม่ดูว่ามีขั้นตอนและเงื่อนไขอธิบายไว้หรือไม่',
				'คาดหวังว่าทุกหน้าในเว็บต้องมีบทบาทเท่ากัน ทั้งที่บางหน้าควรเป็น hub และบางหน้าควรเป็นแค่ supporting page',
				'ส่งข้อมูลไม่ครบแล้วตีความว่าการประเมินกว้างคือการกดราคา ทั้งที่ต้นเหตุคือข้อมูลไม่พอ',
				'ไม่เช็กเรื่องบัญชีและข้อมูลส่วนตัวก่อนนัดขาย ทำให้ขั้นตอนจบช้ากว่าที่ควร',
			]}
			internalLinks={[
				{ href: '/ความน่าเชื่อถือ/', label: 'ศูนย์ความน่าเชื่อถือและขั้นตอนซื้อขาย' },
				{ href: '/เช็กราคาก่อนขาย/', label: 'เช็กราคาก่อนขายและข้อมูลที่ควรส่ง' },
				{ href: '/พื้นที่ให้บริการ/', label: 'ดูพื้นที่ให้บริการและหน้าคู่มือตามจังหวัด' },
			]}
			density="full"
		/>
	</div>
</BaseLayout>
