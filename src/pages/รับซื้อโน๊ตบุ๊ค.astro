---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';
import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อโน๊ตบุ๊ค/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);
const priceItems = [
	{ model: 'MacBook Pro M4 / M5 Series', price: '45,000 - 80,000+ บาท', note: 'ราคาประเมินขึ้นอยู่กับจำนวน Core CPU/GPU และ RAM' },
	{ model: 'Gaming Notebook (RTX 5060 / 5070)', price: '20,000 - 45,000 บาท', note: 'ดูแบรนด์ สเปกจอภาพ และตำหนิตัวเครื่อง' },
	{ model: 'Ultrabook (Core Ultra / i7 Gen 14-15)', price: '15,000 - 30,000 บาท', note: 'เน้นสภาพสวย น้ำหนักเบา แบตเตอรี่เสื่อมน้อย' },
	{ model: 'Notebook ทั่วไป (Core i5 / Ryzen 5)', price: '5,000 - 15,000 บาท', note: 'ประเมินตามการ์ดจอแยกและสภาพการใช้งานจริง' },
	{ model: 'Notebook สเปกเก่า หรือ มีตำหนิ', price: '1,000 - 5,000 บาท', note: 'รับประเมินตามอาการ จอแตก แบตเสื่อม ส่งรายละเอียดมาเช็กได้' },
];
const faqItems = [
	{
		q: 'รับซื้อโน๊ตบุ๊คยี่ห้ออะไรบ้าง?',
		a: 'รับซื้อหลากหลายแบรนด์ ได้แก่ Apple MacBook, Dell, HP, Lenovo, ASUS, Acer, MSI, Razer, Samsung, Microsoft Surface, Huawei MateBook และอื่น ๆ ทั้งรุ่นสายทำงาน สายเรียน และสายเกมมิง โดยพิจารณาจากสเปกและสภาพเครื่องเป็นหลัก',
	},
	{
		q: 'โน๊ตบุ๊คมีตำหนิหรือแบตเสื่อมยังขายได้ไหม?',
		a: 'ขายได้ครับ ทีมงานจะประเมินตามสภาพจริง โดยดูผลกระทบต่อการใช้งานและต้นทุนซ่อมอย่างโปร่งใส แจ้งตำหนิตรง ๆ ตั้งแต่แรกจะช่วยให้ประเมินได้รวดเร็วขึ้น',
	},
	{
		q: 'ต้องล้างข้อมูลก่อนขายไหม?',
		a: 'ควรล้างข้อมูลและออกจากระบบบัญชีต่าง ๆ ก่อนส่งมอบ โดยเฉพาะ Apple ID, Microsoft Account, Google Account และระบบ cloud sync หากไม่สะดวก ทีมงานสามารถแนะนำขั้นตอนสำรองข้อมูลและรีเซ็ตระบบอย่างปลอดภัยได้',
	},
	{
		q: 'ติดต่อช่องทางไหนเร็วที่สุด?',
		a: 'แนะนำติดต่อผ่าน Line @webuy เพราะสามารถส่งรูป สเปก และวิดีโอเครื่องได้ทันที ทำให้ประเมินได้สะดวกและครบข้อมูล หรือโทร 064-257-9353 ก็ได้เช่นกัน',
	},
	{
		q: 'ประเมินราคาใช้เวลานานไหม?',
		a: 'หากส่งข้อมูลสเปก รูปเครื่อง และตำหนิมาครบตั้งแต่ครั้งแรก ทีมงานสามารถประเมินราคาเบื้องต้นได้อย่างรวดเร็วตามลำดับคิวในช่วงเวลาทำการหลัก',
	},
	{
		q: 'จ่ายเงินอย่างไรหลังตกลงราคา?',
		a: 'โอนเงินผ่านบัญชีธนาคารทันทีที่ตรวจรับสินค้าและยืนยันเครื่องเรียบร้อย โดยทุกธุรกรรมมีหลักฐานการชำระเงินชัดเจน',
	},
	{
		q: 'อยู่ต่างจังหวัดขายได้ไหม?',
		a: 'ขายได้ครับ สามารถส่งข้อมูลผ่าน Line @webuy แล้วจัดส่งเครื่องทางพัสดุ เมื่อตรวจรับเรียบร้อยจะโอนเงินให้ โดยแนะนำให้ถ่ายวิดีโอตอนแพ็กเครื่องและบันทึกเลขพัสดุไว้เป็นหลักฐาน',
	},
	{
		q: 'MacBook ที่ยังผูก Apple ID อยู่ขายได้ไหม?',
		a: 'แนะนำให้ปลด Apple ID และปิด Find My Mac ก่อนขาย เพราะหากยังล็อกอยู่จะไม่สามารถตรวจเช็คระบบได้และอาจไม่สามารถรับซื้อได้ หากไม่แน่ใจวิธีปลด สามารถสอบถามทีมงานได้เลย',
	},
	{
		q: 'โน๊ตบุ๊คเกมมิงกับโน๊ตบุ๊คทำงานราคาต่างกันอย่างไร?',
		a: 'โน๊ตบุ๊คเกมมิงที่มี GPU แยกมักได้ราคาประเมินที่ดีเพราะมีความต้องการในตลาดมือสองสูง ส่วนโน๊ตบุ๊คทำงาน (business-class) อย่าง ThinkPad หรือ EliteBook ก็มีมูลค่าดีตามความทนทาน ราคาจริงขึ้นอยู่กับสเปก สภาพ และความต้องการของตลาดในช่วงนั้น',
	},
	{
		q: 'ให้บริการวันไหนบ้าง?',
		a: 'สามารถส่งข้อมูลรูปภาพและรายละเอียดเข้ามาทาง Line @webuy ได้ตลอดเวลา และทีมงานจะคอยตอบกลับเพื่อประเมินราคาในช่วงเวลาทำการหลัก หรือโทรสอบถามได้ที่ 064-257-9353',
	},
	{
		q: 'วิธีประเมินราคาโน๊ตบุ๊คมือสองทำอย่างไร?',
		a: 'WE BUY ดูจาก CPU RAM SSD สภาพจอ แบต และแบรนด์รุ่น อ้างอิงแนวตลาดมือสอง — อ่านปัจจัยละเอียดที่หน้าราคากลางรับซื้อ แล้วส่งสเปกและรูปมาประเมินเบื้องต้น',
	},
	{
		q: 'เช็กราคาโน๊ตบุ๊คก่อนขายต้องเตรียมอะไร?',
		a: 'หน้าเช็กราคาก่อนขายมีรายการข้อมูลและรูปที่แนะนำสำหรับโน๊ตบุ๊ค ส่งผ่าน Line @webuy เพื่อรับช่วงราคาก่อนนัดตรวจเครื่องจริง',
	},
];
const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อโน๊ตบุ๊ค มือสอง ทุกยี่ห้อ ประเมินตามสภาพจริง',
		description:
			'WE BUY รับซื้อโน๊ตบุ๊คมือสองทุกยี่ห้อ MacBook Dell HP Lenovo ASUS Acer MSI ประเมินราคาเบื้องต้นตามสภาพจริงผ่าน Line @webuy',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อโน๊ตบุ๊ค มือสอง ทุกยี่ห้อ ประเมินตามสเปกและสภาพจริง',
		description:
			'ข้อมูลสำหรับผู้ที่ต้องการขายโน๊ตบุ๊คมือสอง ครอบคลุมการประเมินราคาตาม CPU RAM SSD GPU หน้าจอ แบต แบรนด์ การเตรียมเครื่อง และขั้นตอนขายอย่างปลอดภัย รับซื้อ MacBook Dell HP Lenovo ASUS Acer MSI',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-03-24',
		image: [new URL('/og-default.png', site).toString()],
		keywords:
			'รับซื้อโน๊ตบุ๊ค, ขายโน๊ตบุ๊คมือสอง, ประเมินราคาโน๊ตบุ๊ค, รับซื้อ laptop, รับซื้อ notebook, รับซื้อ MacBook, รับซื้อโน๊ตบุ๊คเกมมิง, ขายโน๊ตบุ๊ค, นัดรับโน๊ตบุ๊ค',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อโน๊ตบุ๊ค', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อโน๊ตบุ๊คมือสอง',
		description:
			'บริการรับซื้อโน๊ตบุ๊คมือสองทุกยี่ห้อ ทุกรุ่น ประเมินราคาโปร่งใส ติดต่อ Line @webuy ได้สะดวกในช่วงเวลาทำการหลัก',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อโน๊ตบุ๊คมือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขายโน๊ตบุ๊คมือสองกับ WE BUY',
		description: 'ขั้นตอนง่าย ๆ ในการขายโน๊ตบุ๊คมือสองตามสเปกกับ WE BUY',
		step: [
			{ '@type': 'HowToStep', name: 'ส่งข้อมูลเครื่อง', text: 'แอดไลน์ @webuy แล้วส่งรูปเครื่อง รุ่น สเปก และสภาพการใช้งาน' },
			{ '@type': 'HowToStep', name: 'รับราคาประเมิน', text: 'ทีมงานตรวจสอบและแจ้งราคาประเมินเบื้องต้นตามลำดับคิว' },
			{ '@type': 'HowToStep', name: 'ยืนยันและนัดรับ', text: 'ตกลงราคา นัดหมายจุดรับ-ส่ง หรือจัดส่งทางขนส่ง' },
			{ '@type': 'HowToStep', name: 'รับเงินโอน', text: 'ตรวจสอบเครื่องจริงและรับเงินโอนหลังการตรวจสอบเสร็จสิ้น' },
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อโน๊ตบุ๊ค มือสอง ทุกยี่ห้อ')}
	description="WE BUY รับซื้อโน๊ตบุ๊คมือสองทุกยี่ห้อ MacBook Dell HP Lenovo ASUS Acer MSI ประเมินราคาเบื้องต้นตามรุ่นและสภาพจริง ติดต่อ Line @webuy"
	pathname="/รับซื้อโน๊ตบุ๊ค/"
	type="article"
	jsonLd={articleJsonLd}
>
	<div class="page">
		<header class="header">
			<h1>รับซื้อโน๊ตบุ๊คมือสอง</h1>
			<p class="subtitle">
				ศูนย์บริการรับซื้อโน๊ตบุ๊คมือสองอ้างอิงราคาตามตลาดและรุ่นสเปกจริง ไม่ว่าจะเป็น MacBook, Dell, HP, Lenovo, ASUS, Acer หรือแบรนด์ชั้นนำอื่น ๆ เราประเมินด้วยความโปร่งใสและตรงไปตรงมา พร้อมชำระเงินโอนรวดเร็วเมื่อสรุปข้อตกลงและตรวจสอบสินค้าเรียบร้อย ครอบคลุมผู้ใช้บริการทั่วประเทศด้วยกระบวนการประเมินเบื้องต้นทาง LINE
			</p>
		</header>

		<section class="content">
			<TrustBadges className="mb-12 mt-8" />
			<RecentTradesSlider />
			<h2>ความโปร่งใสในบริการรับซื้อโน๊ตบุ๊คของเรา</h2>
			<p>เมื่อถึงเวลาที่ต้องเปลี่ยนโน๊ตบุ๊คเครื่องใหม่ หรือต้องการระบายเครื่องเก่าที่ไม่ได้ใช้งาน การประเมินราคาที่สมเหตุสมผลและขั้นตอนที่รัดกุมคือสิ่งสำคัญ ที่ WE BUY เราเน้นความโปร่งใส สื่อสารตรงไปตรงมา และมีกระบวนการที่ชัดเจนเพื่อลดความกังวลในการส่งมอบอุปกรณ์ไอที</p>
			
			<p>ข้อตกลงในการทำราคารับซื้อขึ้นอยู่กับข้อมูลสเปก รุ่น สภาพ และอุปกรณ์ดั้งเดิมที่มีอยู่จริง ทีมงานจะชี้แจงปัจจัยที่เกี่ยวข้องอย่างชัดเจนเพื่อให้ได้ราคาประเมินเบื้องต้นก่อนนัดรับหรือส่งพัสดุ</p>
			
			<p>เราให้ความสำคัญกับความปลอดภัยของข้อมูลในตัวเครื่อง แนะนำให้ล้างข้อมูลหรือรีเซ็ตระบบก่อนการขาย หากต้องการคำแนะนำ ทีมงานมีกระบวนการล้างข้อมูลอย่างปลอดภัยเพื่อไม่ให้มีข้อมูลตกค้างอยู่บนเครื่องหลังเปลี่ยนมือ</p>

			<h2>รับซื้อโน๊ตบุ๊คอ้างอิงตามรุ่นและสเปกจริง</h2>
			<p>เรารับประเมินโน๊ตบุ๊คหลากหลายรุ่นย่อย ทั้ง MacBook Air, MacBook Pro (ชิป Intel และตระกูล M-Series) และโน้ตบุ๊คฝั่ง Windows ทุกแบรนด์ยอดนิยม เช่น Dell, HP, Lenovo, ASUS, Acer, MSI, Microsoft Surface และอื่น ๆ การประเมินจะอิงจากรายละเอียดคุณสมบัติภายในตัวเครื่องจริง</p>
			
			<p>ในการประเมินเบื้องต้น เราจะคำนวณจากประเภทและรุ่นของหน่วยประมวลผล (CPU), ขนาดของหน่วยความจำ (RAM), เทคโนโลยีและพื้นที่เก็บข้อมูล (SSD/HDD) รวมไปถึงการ์ดจอแยก (GPU) และสภาพภายนอกตัวเครื่องที่มีผลต่อราคากลางมือสอง</p>
			
			<p>หน้าจอภาพ (เช็คการแสดงผลว่าปกติ ไม่มีจุด Dead Pixel หรือแสงรั่ว), แบตเตอรี่, คีย์บอร์ด และชิ้นส่วนบอดี้รอบตัวเครื่อง รวมถึงอุปกรณ์เสริมแท้ที่มาพร้อมกล่อง เช่น อแดปเตอร์ชาร์จดั้งเดิม จะถูกนำมาพิจารณาประกอบการสรุปราคาประเมินจริงทั้งหมด</p>

			<h2>รับประเมินโน๊ตบุ๊คเกมมิงและคอมพิวเตอร์ประสิทธิภาพสูง</h2>
