---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อโน๊ตบุ๊ค-อุบลราชธานี-คู่มือ/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const localCity = 'อุบลราชธานี';

const priceItems = [
	{ model: 'MacBook Pro / Air (M1-M5)', price: '12,000 - 65,000+ บาท', note: 'นัดรับได้ที่เซ็นทรัลอุบล หรือสุนีย์ทาวเวอร์' },
	{ model: 'Gaming Notebook (RTX Series)', price: '15,000 - 45,000 บาท', note: 'รับซื้อด่วนแถว ม.อุบลฯ และวารินชำราบ' },
	{ model: 'Notebook ทำงาน / นักศึกษา', price: '5,000 - 15,000 บาท', note: 'สเปก Core i5/i7 เจนใหม่ ให้ราคาสูง' },
	{ model: 'โน๊ตบุ๊คเก่า / เสีย / จอแตก', price: '1,000 - 5,000 บาท', note: 'รับประเมินเพื่อนำไปเป็นอะไหล่ ไม่ทิ้งให้เสียเปล่า' },
];

const faqItems = [
	{
		q: `ร้านรับซื้อโน๊ตบุ๊คใน${localCity}อยู่ที่ไหน?`,
		a: `เราเน้นบริการแบบ On-site และนัดพบตามจุดที่สะดวกใน${localCity} เช่น เซ็นทรัลอุบลฯ, สุนีย์ทาวเวอร์, มหาวิทยาลัยอุบลราชธานี หรือตามปั๊มน้ำมันใหญ่ ๆ เพื่อความสะดวกและรวดเร็วของลูกค้า ไม่ต้องเสียเวลาเดินทางหาร้านเอง`,
	},
	{
		q: 'นัดรับที่วารินชำราบได้ไหม?',
		a: 'ได้แน่นอนครับ ทีมงานเราวิ่งรับเครื่องในเขตวารินชำราบเป็นประจำ ไม่ว่าจะเป็นโซนตลาดวาริน หรือแถว ม.อุบลฯ ทักไลน์นัดเวลาได้เลยครับ',
	},
	{
		q: 'คนอุบลฯ ขายโน๊ตบุ๊คช่องทางไหนได้ราคาดีที่สุด?',
		a: 'การขายกับผู้รับซื้อที่เข้าใจสเปกจริงอย่าง WE BUY จะช่วยให้คุณได้ราคาที่ยุติธรรมกว่าการไปเทิร์นตามตู้ในห้าง เพราะเราอิงราคาตามตลาดมือสองส่วนกลางและไม่กดราคาค่าเช่าที่',
	},
	{
		q: 'เครื่องมีปัญหาบอร์ดเสียหรือเปิดไม่ติด รับซื้อไหม?',
		a: 'รับครับ สำหรับชาวอุบลฯ ที่มีเครื่องเสียอย่าเพิ่งทิ้ง ส่งรูปและอาการมาประเมินก่อน บางเครื่องยังมีมูลค่าจากหน้าจอ, RAM หรือ SSD ทีมงานยินดีไปรับถึงที่ครับ',
	},
	{
		q: 'จ่ายเงินอย่างไร ชัวร์ไหม?',
		a: 'โอนเงินเข้าบัญชีธนาคารทันทีหลังตรวจเครื่องเสร็จต่อหน้าลูกค้า หรือจ่ายเงินสดตามสะดวกครับ มีหลักฐานแชทยืนยันราคาชัดเจน มั่นใจได้ 100%',
	},
	{
		q: 'ประเมินราคาโน๊ตบุ๊คในอุบลฯ ต้องส่งข้อมูลอะไรบ้าง?',
		a: 'แนะนำส่งรุ่น CPU RAM SSD รูปตำหนิ และภาพหน้าจอสเปก — ดูรายการครบที่หน้าเช็กราคาก่อนขาย แล้วทัก Line @webuy เพื่อรับช่วงราคาเบื้องต้นก่อนนัดรับ',
	},
	{
		q: 'ลูกค้าวารินชำราบนัดรับได้จุดไหน?',
		a: 'นัดได้ที่ตลาดวารินเจริญศรี แม็คโครวารินฯ ม.อุบลฯ หรือจุดสะดวกตามเส้นทางเมือง–วาริน — แจ้งพื้นที่ใน Line เพื่อนัดเวลาที่เหมาะ',
	},
];

const assessmentCases = [
	{
		model: 'ASUS TUF Gaming (RTX 3060, Core i5 รุ่น 12th)',
		condition: 'ตัวเครื่องมีรอยใช้งาน จอไม่เส้น เปิดเล่นเกมได้ปกติ แบตถอดปลั๊กได้ประมาณ 1 ชม.',
		accessories: 'มีสายชาร์จ ไม่มีกล่องเดิม',
		factors: 'การ์ดจอและ CPU ยังเป็นที่ต้องการ, แบตเสื่อมเล็กน้อย, นัดรับที่เซ็นทรัลอุบลฯ',
	},
	{
		model: 'Dell Latitude (Core i7, RAM 16GB, SSD 512GB)',
		condition: 'สภาพดี คีย์บอร์ดครบ จอไม่เบิร์น ไม่ติดบัญชี',
		accessories: 'กล่อง สายชาร์จ ใบเสร็จเก่า (ถ้ามี)',
		factors: 'สเปกสายทำงานยังขายต่อได้, อุปกรณ์ครบ, ลูกค้าแจ้งตำหนิตรงตั้งแต่รอบแรก — ลดการปรับราคาหน้างาน',
	},
];

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: `รับซื้อโน๊ตบุ๊ค ${localCity} — คู่มือขาย Notebook ให้ได้ราคาสูง จ่ายเงินสด`,
		description: `ศูนย์รับซื้อโน๊ตบุ๊คมือสองใน${localCity} ครอบคลุมเขตเมืองและวารินชำราบ ประเมินราคาด่วน 15 นาที นัดรับถึงที่ จ่ายเงินทันที ติดต่อ Line @webuy`,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'LocalBusiness',
		name: `WE BUY รับซื้อโน๊ตบุ๊ค ${localCity}`,
		image: [new URL('/og-default.png', site).toString()],
		'@id': `${pageUrl}#localbusiness`,
		url: pageUrl,
		telephone: '0642579353',
		address: {
			'@type': 'PostalAddress',
			addressLocality: localCity,
			addressRegion: localCity,
			addressCountry: 'TH',
		},
		geo: {
			'@type': 'GeoCoordinates',
			latitude: 15.2287,
			longitude: 104.8564
		},
		areaServed: [
			{ '@type': 'City', name: 'อำเภอเมืองอุบลราชธานี' },
			{ '@type': 'City', name: 'อำเภอวารินชำราบ' },
			{ '@type': 'City', name: localCity }
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
];
---

<BaseLayout
	title={formatPageTitle(`รับซื้อโน๊ตบุ๊ค ${localCity}`)}
	description={`หาที่ขายโน๊ตบุ๊คใน${localCity}? WE BUY รับซื้อโน๊ตบุ๊คมือสองทุกยี่ห้อ นัดรับในเขตเมือง วารินฯ และ ม.อุบลฯ ประเมินราคาออนไลน์ฟรี จ่ายเงินทันที`}
	pathname="/รับซื้อโน๊ตบุ๊ค-อุบลราชธานี-คู่มือ/"
	type="article"
	jsonLd={jsonLd}
>
	<article class="container longform">

		<header class="article-head">
			<p class="kicker">Ubon Ratchathani Local Service</p>
			<h1>รับซื้อโน๊ตบุ๊ค {localCity} — คู่มือการขาย Notebook มือสองให้ได้ราคาดี นัดรับด่วนในวันเดียว</h1>
			<p class="intro">
				สำหรับชาว <strong>{localCity}</strong> และพื้นที่ใกล้เคียงอย่างวารินชำราบ ที่ต้องการขายโน๊ตบุ๊คเครื่องเก่า 
				แต่ไมยากเสี่ยงกับการส่งพัสดุหรือโดนกดราคาจากร้านตู้ทั่วไป บริการของ WE BUY พร้อมเป็นทางเลือกที่ดีที่สุดให้คุณ 
				เรามีทีมงานประจำพื้นที่ที่เข้าใจตลาดโน๊ตบุ๊คมือสองในอุบลราชธานีอย่างดี 
				รับซื้อทั้งเครื่องสภาพสวยและเครื่องมีตำหนิ จบดีลไว รับเงินสด/โอนทันทีหน้างาน 
				มาดูกันว่าขั้นตอนการขายโน๊ตบุ๊คในอุบลฯ ให้ได้ราคาดีต้องทำอย่างไร
			</p>
		</header>

		<PriceGuide title={`ราคารับซื้อโน๊ตบุ๊คใน${localCity} อ้างอิง`} items={priceItems} />

		<section class="eeat-note">
			<h2>ประสบการณ์จากทีมรับซื้อในอุบลราชธานี</h2>
			<p>
				ชาวอุบลฯ ที่ขายโน๊ตบุ๊คกับเรามักนัดรับที่เซ็นทรัลอุบลฯ สุนีย์ทาวเวอร์ หรือปั๊มสายหลักระหว่างเมืองกับวารินชำราบ
				สิ่งที่ทำให้ดีลจบเร็วและราคาไม่โดนปรับหน้างานคือการส่ง<strong>ภาพหน้าจอ DxDiag หรือสติกเกอร์สเปกหลังเครื่อง</strong>พร้อมรูปตำหนิจริงตั้งแต่รอบแรก
				ไม่ใช่แค่บอกว่า “Core i5 แรง ๆ” — เพราะรุ่น CPU ต่างกันหลายพันบาท
			</p>
			<p>
				เครื่องที่พนักงาน ม.อุบลฯ หรือร้านค้าในเมืองนำมาขายบ่อยคือเกมมิ่งสเปกกลาง (GTX/RTX รุ่น 20 ขึ้นไป)
				หากแบตถอดปลั๊กแล้วดับเร็วผิดปกติ ควรแจ้งตั้งแต่ใน Line จะได้ไม่ต้องต่อรองทีหลังเมื่อถึงจุดนัดรับ
			</p>
		</section>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>พื้นที่ให้บริการนัดรับในจังหวัด{localCity}</h2>
			<p>
				เพื่อให้ลูกค้าได้รับความสะดวกสบายสูงสุด เรามีบริการนัดรับเครื่องตามจุดต่าง ๆ ทั่วเมืองอุบลฯ 
				โดยจุดที่ลูกค้านิยมเลือกนัดพบมีดังนี้:
			</p>
			<ul>
				<li><strong>เขตอำเภอเมือง:</strong> เซ็นทรัลอุบลราชธานี, สุนีย์ทาวเวอร์ (City Mall), ยูพาร์ค (U Park), หรือปั๊มน้ำมัน ปตท. วนารมย์</li>
				<li><strong>เขตวารินชำราบ:</strong> มหาวิทยาลัยอุบลราชธานี (ม.อุบลฯ), ตลาดวารินเจริญศรี, แม็คโครวารินฯ</li>
				<li><strong>พื้นที่อื่น ๆ:</strong> หากท่านอยู่ต่างอำเภอ เช่น พิบูลมังสาหาร หรือ ตระการพืชผล สามารถนัดรับที่จุดกึ่งกลางหรือคุยคิวงานล่วงหน้าได้ครับ</li>
			</ul>
			<p class="mt-4 text-sm leading-relaxed text-muted">
				<a href="/พื้นที่ให้บริการ/">เช็กพื้นที่รับซื้อสินค้าไอที</a>
				— รวมคู่มือ local อุบล ขอนแก่น อุดร โคราช และพื้นที่ใกล้เคียง
			</p>
		</section>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>ทำไมต้องขายโน๊ตบุ๊คกับเรา — ในมุมคนอุบลฯ</h2>
			<div class="highlight-box">
				<strong>เหตุผลหลัก:</strong> เราให้ราคาที่ "จริงใจ" และอิงจากราคาตลาดกลางของไทย 
				ไม่โดนกดราคาค่าพื้นที่เหมือนร้านในห้าง และบริการที่รวดเร็วถึงที่
			</div>
			
			<h3>1. ประเมินราคาผ่าน Line รู้ผลทันที</h3>
			<p>
				ไม่ต้องขับรถวนหาร้านทั่วเมืองให้เปลืองน้ำมัน แค่คุณทัก Line <a href="https://line.me/R/ti/p/@webuy">@webuy</a> 
				แล้วส่งรูปเครื่อง ทีมงานจะแจ้งช่วงราคาประเมินให้คุณทันที ภายใน 15-30 นาที 
				ทำให้คุณตัดสินใจได้ตั้งแต่ยังอยู่ที่บ้าน
			</p>

			<h3>2. นัดรับได้รวดเร็วในวันเดียว</h3>
			<p>
				เราเข้าใจว่าบางครั้งคุณต้องการใช้เงินเร่งด่วน ทีมงานในอุบลฯ ของเราพร้อมประสานงาน 
				เพื่อนัดตรวจรับเครื่องและจ่ายเงินให้คุณภายในวันที่ตกลงกัน 
				ไม่ต้องรอข้ามวันเหมือนการฝากขายตามร้าน
			</p>

			<h3>3. รับทุกแบรนด์ ทุกสภาพ</h3>
			<p>
				ไม่ว่าจะเป็น MacBook, Gaming Notebook (MSI, ASUS ROG, Acer Nitro), 
				หรือโน๊ตบุ๊คสายทำงาน (Dell Latitude, Lenovo ThinkPad) เรารับซื้อหมด 
				แม้เครื่องจะจอแตก แบตเสื่อม หรือบอร์ดเสีย เรายังรับประเมินเพื่อนำไปเป็นอะไหล่ครับ
			</p>
		</section>

		<ContactBox
			heading={`ชาว${localCity}พร้อมขายโน๊ตบุ๊คแล้วใช่ไหม?`}
			text="ส่งรูปเครื่องพร้อมสเปกมาประเมินราคาด่วนผ่าน Line ได้เลยครับ ทีมงานรอให้บริการอยู่"
			variant="primary"
		/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>ขั้นตอนง่าย ๆ ในการขายโน๊ตบุ๊คในอุบลฯ</h2>
			<ol>
				<li><strong>แอดไลน์ @webuy:</strong> หรือโทร 064-257-9353 เพื่อแจ้งรุ่นและสเปก</li>
				<li><strong>ส่งรูปภาพ:</strong> ถ่ายรูปเครื่องทุกมุม และรูปหน้าจอ About This Mac หรือ System Info</li>
				<li><strong>ตกลงราคา:</strong> เมื่อพอใจกับราคาประเมิน ก็นัดหมายสถานที่นัดรับในอุบลฯ</li>
				<li><strong>ตรวจเครื่องและรับเงิน:</strong> ทีมงานใช้เวลาตรวจเช็คประมาณ 10-15 นาที แล้วจ่ายเงินโอน/สดทันที</li>
			</ol>
		</section>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>เทคนิคขายโน๊ตบุ๊คในอุบลฯ ให้ได้ราคาสูง</h2>
			<p>
				เพื่อให้คุณได้ราคาดีที่สุดสำหรับการขายโน๊ตบุ๊คในพื้นที่{localCity} แนะนำให้ทำตามเคล็ดลับนี้:
			</p>
			<ul>
				<li><strong>เก็บกล่องและอุปกรณ์เสริม:</strong> หากยังมีกล่องเดิม ใบเสร็จ และอะแดปเตอร์แท้ จะช่วยเพิ่มราคาได้มาก</li>
				<li><strong>ทำความสะอาดเครื่อง:</strong> เช็ดฝุ่นและรอยนิ้วมือออกให้ดูใหม่ จะส่งผลต่อความประทับใจตอนตรวจเครื่อง</li>
				<li><strong>เตรียมข้อมูลแบตเตอรี่:</strong> หากเครื่องยังแบตอึด จะได้ราคาประเมินที่สูงกว่าเครื่องแบตเสื่อม</li>
			</ul>
		</section>

		<section>
			<h2>การประเมินราคาใน{localCity}</h2>
			<p>
