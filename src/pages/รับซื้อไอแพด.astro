---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';
import { isanIpadPages } from '../lib/isanLocalHubs';

const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อไอแพด/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const ipadShowcase = [
	{
		src: '/media/apple-local/ipad-mini-silver-back.webp',
		alt: 'ตัวอย่าง iPad mini สำหรับประกอบการประเมินราคารับซื้อ',
		caption: 'ภาพฝาหลัง iPad ช่วยดูรอยมุมเครื่อง รอยบุบ และสภาพบอดี้ได้ชัดเจนก่อนคุยราคา',
	},
	{
		src: '/media/apple-local/xiaomi-pad-front.webp',
		alt: 'ตัวอย่างภาพแท็บเล็ตด้านหน้าสำหรับแนวทางการส่งรูปประเมิน',
		caption: 'แม้จะเป็นแท็บเล็ต Android แต่ภาพลักษณะนี้ช่วยบอกแนวทางว่าควรถ่ายหน้าจอให้เห็นการแสดงผลเต็ม ๆ อย่างไร',
	},
	{
		src: '/media/apple-local/xiaomi-pad-back.webp',
		alt: 'ตัวอย่างภาพแท็บเล็ตด้านหลังสำหรับแนวทางการถ่ายรูปก่อนประเมิน',
		caption: 'ฝาหลังและมุมกล้องเป็นจุดที่ควรถ่ายให้ชัดทุกครั้ง ไม่ว่าจะเป็น iPad หรือแท็บเล็ตในหมวดใกล้เคียง',
	},
];

const priceItems = [
	{ model: 'iPad Pro (M4 / M5) - ทุกขนาด', price: '28,000 - 55,000+ บาท', note: 'ราคาสูงสุดขึ้นอยู่กับความจุ 1TB/2TB และ Nano-texture' },
	{ model: 'iPad Pro (M1 / M2) - 11" & 12.9"', price: '16,000 - 32,000 บาท', note: 'เครื่องสภาพสวย แบตเตอรี่เฮลท์ดี 90%+' },
	{ model: 'iPad Air (M2 / M3) - 11" & 13"', price: '14,000 - 24,000 บาท', note: 'เน้นสีเครื่องยอดนิยมและความจุ 128GB ขึ้นไป' },
	{ model: 'iPad mini (รุ่นที่ 6 / 7)', price: '10,000 - 18,000 บาท', note: 'ขนาดพกพาที่ตลาดต้องการสูง โดยเฉพาะรุ่นใส่ซิม' },
	{ model: 'iPad (Gen 9 / 10) - รุ่นประหยัด', price: '5,000 - 9,500 บาท', note: 'รับประเมินทุกสภาพ จอแตกหรือเครื่องงอก็รับซื้อ' },
];

const faqItems = [
	{
		q: 'รับซื้อ iPad รุ่นไหนบ้าง?',
		a: 'รับซื้อ iPad ทุกซีรีส์ที่ยังใช้งานได้ ได้แก่ iPad Pro, iPad Air, iPad mini และ iPad (รุ่นมาตรฐาน) ทุกเจเนอเรชัน โดยพิจารณาจากชิปประมวลผล (M-series / A-series), ความจุ, สถานะ Wi-Fi/Cellular และสภาพเครื่องจริง',
	},
	{
		q: 'iPad จอร้าวหรือทัชสกรีนเสียรับไหม?',
		a: 'รับซื้อครับ แม้หน้าจอจะแตกหรือระบบสัมผัสมีปัญหา ทีมงานจะประเมินราคาโดยหักลบค่าอะไหล่จออย่างเป็นธรรม แนะนำส่งรูปจุดที่แตกมาให้ชัดเจนเพื่อการตีราคาที่แม่นยำ',
	},
	{
		q: 'ติด iCloud หรือ Find My iPad รับซื้อไหม?',
		a: 'จำเป็นต้องปลด Apple ID และปิด Find My iPad ก่อนส่งมอบครับ เครื่องที่ติด Activation Lock จะไม่สามารถรีเซ็ตหรือโอนกรรมสิทธิ์ได้ตามปกติ ซึ่งกระทบราคาอย่างมาก หากลืมรหัสผ่าน ทีมงานสามารถแนะนำวิธีรีเซ็ตเบื้องต้นให้ได้',
	},
	{
		q: 'iPad เครื่องงอ (Bent) รับซื้อไหม?',
		a: 'รับซื้อครับ ปัญหาเครื่องงอมักพบในรุ่น Pro และ Air ที่บางมาก ทีมงานจะตรวจสอบว่าการงอนั้นส่งผลต่อการทำงานภายในหรือหน้าจอหรือไม่ และประเมินราคาตามสภาพจริง',
	},
	{
		q: 'Apple Pencil หรือคีย์บอร์ดขายรวมได้ไหม?',
		a: 'ได้เลยครับ หากขายรวมกับอุปกรณ์เสริมแท้ เช่น Apple Pencil (Gen 1, 2, Pro, USB-C) หรือ Magic Keyboard จะช่วยเพิ่มมูลค่ารับซื้อรวมได้ดีกว่าการแยกขาย',
	},
	{
		q: 'เช็คสุขภาพแบต iPad อย่างไร?',
		a: 'iPad ไม่มีเมนูเช็คสุขภาพแบตเหมือน iPhone แนะนำให้ใช้โปรแกรมอย่าง 3uTools หรือ iMazing บนคอมพิวเตอร์เพื่อดูค่า Battery Health หรือส่งเครื่องมาให้เราเช็คให้ได้ฟรีไม่มีค่าใช้จ่าย',
	},
	{
		q: 'จ่ายเงินอย่างไร?',
		a: 'จ่ายเงินสดทันทีหน้างาน หรือโอนเข้าบัญชีธนาคารทันทีหลังตรวจสอบเครื่องเสร็จ จบงานไว ไม่ต้องรอนาน',
	},
	{
		q: 'อยู่ต่างจังหวัดขายได้อย่างไร?',
		a: 'ส่งข้อมูลประเมินราคาทาง Line @webuy ก่อน เมื่อตกลงราคาแล้วส่งพัสดุมาให้ทีมงานตรวจรับ เมื่อได้รับของจะโอนเงินให้ทันทีในวันเดียวกัน',
	},
	{
		q: 'iPad เครื่องนอก (Model นอก) รับไหม?',
		a: 'รับซื้อครับ เครื่องนอกใช้งานในไทยได้ปกติ แต่อาจมีส่วนต่างราคาเล็กน้อยเมื่อเทียบกับเครื่องศูนย์ไทย (TH/A) ตามความต้องการของตลาดมือสอง',
	},
	{
		q: 'ติดต่อช่องทางไหนเร็วที่สุด?',
		a: 'แนะนำ Line @webuy ครับ ทีมงานตอบกลับเร็ว พร้อมรับรูปและข้อมูลสเปกเพื่อตีราคาได้ทันที 24 ชั่วโมง',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อ iPad มือสอง ทุกรุ่น ประเมินราคาโปร่งใส จ่ายเงินทันที',
		description:
			'WE BUY รับซื้อ iPad Pro, Air, mini, Gen ทุกรุ่น ทุกสภาพ ประเมินราคาฟรีจากสเปกและ Battery Health จ่ายเงินสด/โอนทันที บริการ 24 ชม. ติดต่อ Line @webuy',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อ iPad มือสอง ทุกซีรีส์ | คู่มือการเตรียมเครื่องและเช็คราคา iPad ก่อนขาย',
		description:
			'เจาะลึกเกณฑ์การประเมินราคา iPad มือสอง ความต่างของรุ่น Wi-Fi vs Cellular ปัญหาเครื่องงอ หน้าจอแตก และขั้นตอนการปลด iCloud อย่างปลอดภัย ทั่วประเทศ',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-05-27',
		image: [new URL('/og-default.png', site).toString()],
		keywords:
			'รับซื้อ ipad, รับซื้อไอแพด, ขาย ipad มือสอง, รับซื้อ ipad pro, รับซื้อ ipad air, รับซื้อ ipad mini, รับซื้อ ipad gen 10, ประเมินราคา ipad, รับซื้อไอแพดจอแตก, ขายไอแพดได้ราคาดี',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อ iPad', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อไอแพดมือสอง',
		description:
			'บริการรับซื้อ iPad ทุกรุ่น ทุกสภาพ ประเมินราคาโปร่งใส จ่ายเงินทันที นัดรับหรือส่งพัสดุ ติดต่อ Line @webuy ตลอด 24 ชั่วโมง',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อ iPad มือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขาย iPad มือสองให้ได้ราคาดีกับ WE BUY',
		description: 'ขั้นตอนการเตรียมเครื่องและขาย iPad อย่างมืออาชีพ',
		step: [
			{ '@type': 'HowToStep', name: 'ส่งข้อมูลประเมินราคา', text: 'ทัก Line @webuy ส่งรูปเครื่อง สเปกความจุ และสถานะประกัน' },
			{ '@type': 'HowToStep', name: 'เตรียมเครื่องและข้อมูล', text: 'สำรองข้อมูล ออกจาก Apple ID และปิด Find My iPad' },
			{ '@type': 'HowToStep', name: 'นัดรับหรือส่งมอบ', text: 'เลือกจุดนัดรับที่สะดวก หรือส่งพัสดุตามคำแนะนำทีมงาน' },
			{ '@type': 'HowToStep', name: 'ตรวจรับและรับเงิน', text: 'ตรวจสอบสภาพเครื่องจริงและรับเงินโอน/เงินสดทันที' },
		],
	},
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อ iPad มือสอง')}
	description="WE BUY รับซื้อ iPad มือสองทุกรุ่น ทุกสภาพ ประเมินราคาฟรีจากสเปกและ Battery Health จ่ายเงินสด/โอนทันที บริการ 24 ชม. ติดต่อ Line @webuy"
	pathname="/รับซื้อไอแพด/"
	type="article"
	jsonLd={articleJsonLd}
>
	<article class="container longform">

		<header class="article-head">
			<p class="kicker">Apple iPad Buyback Guide</p>
			<h1>รับซื้อไอแพด (iPad) ทุกรุ่น — บริการรับซื้อ iPad Pro, Air, mini, Gen มือสอง ประเมินโปร่งใส จ่ายเงินทันที</h1>
			<p class="intro">
				หากคุณมี iPad เครื่องเก่าที่ไม่ได้ใช้งาน หรือต้องการอัปเกรดเป็นรุ่นใหม่ล่าสุดแต่ไม่อยากยุ่งยากกับการลงขายเอง
				บริการ <strong>รับซื้อไอแพด</strong> ของเราพร้อมดูแลคุณ ไม่ว่าจะเป็น iPad Pro สเปกเทพ, iPad Air ที่คุ้มค่า,
				iPad mini ขนาดพกพา หรือ iPad รุ่นมาตรฐานสำหรับนักเรียน เรารับซื้อทุกสภาพ ตั้งแต่เครื่องสวยเหมือนใหม่
				ไปจนถึงเครื่องที่มีตำหนิ จอแตก หรือเครื่องงอ เราประเมินราคาตามจริง อิงสเปกและความต้องการของตลาด
				พร้อมจ่ายเงินทันที จบงานไวในวันเดียว สนใจประเมินราคา ทัก <a class="inline-contact" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">Line @webuy</a> หรือโทร <a class="phone-link" href="tel:0642579353">064-257-9353</a> ได้ตลอด 24 ชม.
			</p>
		</header>

			<PriceGuide title="ราคารับซื้อ iPad อ้างอิง (อัปเดต 2026)" items={priceItems} />

			<section class="highlight-box" style="margin-top: 1.5rem;">
				<h2>ตัวอย่างเครื่องจริงในหมวดแท็บเล็ต</h2>
				<p>
					เรานำภาพตัวอย่างจากเครื่องจริงมาใส่ไว้เพื่อให้เห็นว่าการประเมินราคาในหมวด iPad และแท็บเล็ตจะดูทั้งหน้าจอ
					ฝาหลัง มุมเครื่อง และความพร้อมใช้งานร่วมกัน ไม่ได้ดูแค่ชื่อรุ่นอย่างเดียว
				</p>
				<div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{ipadShowcase.map((item) => (
						<figure class="rounded-2xl border border-gray-200 bg-white p-3 shadow-sm">
							<img src={item.src} alt={item.alt} loading="lazy" decoding="async" class="w-full rounded-xl object-cover" />
							<figcaption class="mt-2 text-sm text-gray-600">{item.caption}</figcaption>
						</figure>
					))}
				</div>
			</section>

			<!-- ═══════════════════════════════════════════════════════════ -->
			<section>
			<h2>ทำไมต้องขาย iPad กับเรา</h2>
			<p>
				การขาย iPad มือสองให้ได้ราคาดีต้องอาศัยผู้รับซื้อที่เข้าใจรายละเอียดของอุปกรณ์ Apple อย่างแท้จริง
				เพราะ iPad มีความหลากหลายทั้งเรื่องชิปประมวลผล (M-series vs A-series) และระบบการเชื่อมต่อ (Wi-Fi vs Cellular)
				ที่ WE BUY เราให้ความสำคัญกับทุกรายละเอียดเพื่อมอบราคาที่ยุติธรรมที่สุดให้คุณ
			</p>

			<h3>ประเมินราคาด่วน รู้ผลใน 15 นาที</h3>
			<p>
				เพียงแค่คุณส่งรูปเครื่องและข้อมูลความจุมาให้เราทาง Line ทีมงานที่เชี่ยวชาญจะทำการตรวจสอบสเปก
				และแจ้งช่วงราคารับซื้อเบื้องต้นให้คุณทราบทันที ช่วยให้คุณตัดสินใจได้ง่ายโดยไม่ต้องเสียเวลาขับรถหาร้าน
			</p>

			<h3>รับซื้อถึงที่ จ่ายเงินทันที</h3>
			<p>
				เรามีทีมงานพร้อมนัดรับเครื่องในพื้นที่บริการหลัก และหากคุณอยู่ต่างจังหวัด เรามีระบบรับพัสดุที่ปลอดภัย
				เมื่อตรวจเช็กสภาพเครื่องเสร็จสิ้น เราจะทำการโอนเงินเข้าบัญชีของคุณทันทีหน้างานหรือทันทีที่ได้รับของ
				ไม่มีการผัดวันประกันพรุ่ง
			</p>
		</section>

		<ContactBox
			heading="เช็คราคา iPad ของคุณตอนนี้"
			text="ส่งรูปเครื่องและรุ่นมาให้เราประเมินราคาฟรี ไม่มีข้อผูกมัด ตอบกลับเร็วมาก"
			variant="primary"
		/>

		<!-- ═══════════════════════════════════════════════════════════ -->
		<section>
			<h2>เกณฑ์การประเมินราคา iPad ที่คุณควรรู้ก่อนส่งมอบ</h2>
			<p>
				การตีราคารับซื้อ iPad ในตลาดมือสองมีมาตรฐานและหลักเกณฑ์การตรวจสอบที่ชัดเจน การเข้าใจเกณฑ์เหล่านี้จะช่วยให้คุณเตรียมเครื่องและประเมินราคากลางด้วยตัวเองได้อย่างสมเหตุสมผล ซึ่งที่ WE BUY เราประเมินตามรายละเอียดชิ้นส่วนและความสมบูรณ์ของระบบอย่างยุติธรรม:
			</p>

			<h3>1. รุ่น เจเนอเรชัน และชิปประมวลผล (Model & Chipset)</h3>
			<p>
				หัวใจหลักในการกำหนดราคารากฐานคือ <strong>รุ่นและรุ่นชิปประมวลผล (SoC)</strong> อุปกรณ์ของ Apple มีอายุขัยการซัพพอร์ตซอฟต์แวร์ที่ยาวนาน แต่ตลาดจะให้ราคาที่แตกต่างกันตามประสิทธิภาพการใช้งานจริง:
			</p>
			<ul>
				<li><strong>ชิปตระกูล M-Series (M1, M2, M4):</strong> ถือเป็นรุ่นพรีเมียมขั้นสูง (iPad Pro และ iPad Air รุ่นใหม่) มีประสิทธิภาพความเร็วระดับเดียวกับเครื่องคอมพิวเตอร์ Mac ได้รับการซัพพอร์ตฟีเจอร์ใหม่อย่างเต็มที่ เช่น Stage Manager และ Apple Intelligence ทำให้ราคาขายต่อนิ่งและรักษามูลค่าได้ยอดเยี่ยมที่สุด</li>
				<li><strong>ชิปตระกูล A-Series (A12, A13, A14, A15, A17 Pro):</strong> อยู่ในกลุ่ม iPad รุ่นมาตรฐาน (Gen ต่าง ๆ), iPad mini และ iPad Air รุ่นเก่า แม้จะเป็นชิปรุ่นประหยัดพลังงาน แต่ก็ยังเป็นที่ต้องการสูงมากในกลุ่มนักเรียน นักศึกษา และผู้ที่ต้องการแท็บเล็ตสำหรับดูสื่อบันเทิงทั่วไป ทำให้มีสภาพคล่องในการขายออกค่อนข้างเร็ว</li>
			</ul>

			<h3>2. ระบบการเชื่อมต่อ (Wi-Fi Only vs. Wi-Fi + Cellular)</h3>
			<p>
				ความยืดหยุ่นในการเชื่อมต่ออินเทอร์เน็ตและการระบุตำแหน่งพิกัด มีผลต่อราคารับซื้ออย่างเห็นได้ชัด:
			</p>
			<ul>
				<li><strong>รุ่น Wi-Fi + Cellular (รุ่นใส่ซิมได้ / eSIM):</strong> มีชิปโมเด็มสำหรับเชื่อมต่อสัญญาณเซลลูลาร์ และที่สำคัญคือ <strong>มีชิปเสารับสัญญาณ GPS / GNSS ในตัว</strong> ซึ่งไม่มีในรุ่น Wi-Fi ล้วน (รุ่น Wi-Fi ล้วนระบุพิกัดโดยการอ้างอิงตำแหน่งจุดปล่อย Wi-Fi เท่านั้น ไม่สามารถใช้ระบุตำแหน่งออฟไลน์ที่แม่นยำได้) ด้วยคุณสมบัตินี้ ทำให้รุ่นใส่ซิมได้ราคาสูงกว่ารุ่น Wi-Fi Only ประมาณ 1,500 - 3,500 บาท ขึ้นอยู่กับปีและเจเนอเรชันของเครื่อง</li>
				<li><strong>รุ่น Wi-Fi Only:</strong> มีน้ำหนักเบากว่าเล็กน้อยและไม่มีแถบพลาสติกเสาอากาศด้านหลังเครื่อง เป็นรุ่นยอดนิยมสำหรับคนที่ใช้ทำงานในออฟฟิศ บ้าน หรือคาเฟ่ แม้ราคาจะถูกกว่ารุ่นใส่ซิมแต่มีปริมาณความต้องการในตลาดกว้างขวางมาก ทำให้อัตราการตกลงราคาค่อนข้างแคบ</li>
			</ul>

			<h3>3. สภาพหน้าจอและการแสดงผล (Display & Touch Integrity)</h3>
			<p>
				หน้าจอคือชิ้นส่วนที่สำคัญที่สุดและมีมูลค่าสูงที่สุดชิ้นหนึ่งของ iPad การตรวจสอบหน้าจอจึงเป็นจุดที่เข้มข้นที่สุด:
				<ul>
					<li><strong>การทำงานของระบบทัชสกรีน:</strong> ต้องตอบสนองฉับไว ทั่วทุกจุด ไม่มีอาการทัชรวน หรือจุดบอดสัมผัส (Dead Touch Zone)</li>
					<li><strong>คุณภาพของพาเนลหน้าจอ:</strong> หน้าจอไม่เบิร์น (OLED) ไม่มีอาการจอชมพู สีเพี้ยน หรือแสงรั่วตามขอบจอ (Backlight Bleeding) ไม่มีจุดสว่างผิดปกติ (Bright Spot) และไม่มีจุดพิกเซลดับ (Dead/Stuck Pixel)</li>
					<li><strong>เทคโนโลยี ProMotion (120Hz):</strong> ในรุ่น iPad Pro หน้าจอจะต้องรีเฟรชเรตได้ลื่นไหลเต็ม 120Hz ตามปกติ</li>
					<li><strong>รอยขีดข่วน:</strong> รอยขนแมวทั่วไปไม่มีผลต่อราคามากนัก แต่หากมีรอยลึกที่สัมผัสแล้วสะดุดเล็บ หรือจอร้าว/บิ่น ราคาจะถูกหักตามราคาค่าเปลี่ยนอะไหล่จอเป็นหลักการยุติธรรม</li>
				</ul>
			</p>

			<h3>4. ปัญหาเครื่องงอ (Bent Body) และโครงสร้างบอดี้ภายนอก</h3>
			<p>
				เนื่องจาก iPad เป็นอุปกรณ์ที่มีขนาดกว้างแต่บางเฉียบ (โดยเฉพาะรุ่น iPad Pro M4 หนาเพียง 5.1 มม.) โครงสร้างอลูมิเนียมจึงมีโอกาสโก่งหรืองอได้ง่ายเมื่อใส่ในกระเป๋าที่มีการเบียดเสียด หรือการใช้งานที่เกิดการกดทับเป็นระยะเวลานาน
			</p>
			<p>
				<strong>เราแบ่งเกรดการงอเพื่อประเมินราคารับซื้อดังนี้:</strong>
			</p>
			<ul>
				<li><strong>ระดับบอดี้ตรง (Perfect Frame):</strong> ตัวเครื่องราบไปกับโต๊ะ ไม่มีส่วนใดโก่งตัว ถือเป็นเกรดดีเยี่ยม ได้ราคาเต็มตามเพดานราคา</li>
				<li><strong>ระดับงอเล็กน้อย (Mild Bend):</strong> ตัวเครื่องบิดงอเล็กน้อย (ไม่เกิน 1.5 มม.) เมื่อวางราบกับกระจกจะเห็นช่องแสงผ่านได้เล็กน้อย โครงสร้างจอไม่เผยอ ขอบยางไม่ปริ และทุกฟังก์ชัน ปุ่มกดสัมผัส กล้องถ่ายภาพใช้งานได้ปกติ <em>เกรดนี้เรารับซื้อโดยหักลบส่วนต่างเพียงเล็กน้อย ไม่ปฏิเสธการรับซื้อแน่นอน</em></li>
				<li><strong>ระดับงอมาก (Severe Bend):</strong> ตัวเครื่องโค้งงอจนสังเกตเห็นชัดเจน จอบิ่นหรือขอบยางเผยอ บอร์ดภายในอาจได้รับแรงกดทับ <em>กรณีนี้เรายังรับซื้อตามสภาพจริง โดยจะประเมินค่าซ่อมแซมโครงสร้างภายนอกอย่างโปร่งใส เพื่อเซฟราคาให้ลูกค้าได้เงินกลับบ้านให้ได้มากที่สุด</em></li>
			</ul>

			<h3>5. สุขภาพแบตเตอรี่และรอบชาร์จสะสม (Battery Health & Cycle Count)</h3>
			<p>
				ระบบปฏิบัติการ iPadOS ไม่เปิดโอกาสให้ผู้ใช้งานทั่วไปตรวจสอบเปอร์เซ็นต์สุขภาพแบตเตอรี่ในเมนูการตั้งค่าได้ง่ายเหมือน iPhone
				ที่ WE BUY เราจึงใช้โปรแกรมลิขสิทธิ์เฉพาะทางและ Apple Diagnostics เพื่อดึงข้อมูลเชิงลึก 2 ค่าหลัก:
			</p>
			<ul>
				<li><strong>Battery Health (เปอร์เซ็นต์ความจุสูงสุดที่เก็บไฟได้):</strong> เครื่องที่ใช้งานปกติควรมีสุขภาพแบตเตอรี่สูงกว่า 80% หากต่ำกว่านี้จะเริ่มมีอาการแบตหมดเร็วหรือเครื่องดับเองขณะใช้งานหนัก</li>
				<li><strong>Cycle Count (จำนวนรอบการชาร์จเต็ม 100%):</strong> สะท้อนปริมาณการใช้งานสะสม โดยปกติแบตเตอรี่ iPad จะทำงานได้เต็มประสิทธิภาพสูงสุดภายใน 500 - 800 รอบชาร์จ</li>
			</ul>
			<p>
				หากเครื่องของคุณมีสุขภาพแบตเตอรี่เสื่อม (ต่ำกว่า 80%) หรือรอบชาร์จสูงมากจนต้องเปลี่ยนใหม่ เรายังรับซื้อตามปกติ โดยจะหักลดราคาตามค่าเปลี่ยนแบตเตอรี่ก้อนใหม่ตามจริงเท่านั้น
			</p>
		</section>

