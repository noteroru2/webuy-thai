---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleFigure from '../components/longform/ArticleFigure.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อคอมประกอบ/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'เซ็ตสเปก High-End (Intel i9 / Ryzen 9 + RTX 4080/4090)', price: '40,000 - 90,000+ บาท', note: 'ประเมินราคาแยกชิ้นส่วนอย่างละเอียด ให้ราคาสูงสุด' },
	{ model: 'เซ็ตสเปก Mid-Range (Intel i5 / Ryzen 5 + RTX 4060/3070)', price: '15,000 - 35,000 บาท', note: 'ตลาดต้องการสูง ออกไว ให้ราคาดี' },
	{ model: 'เซ็ตสเปก Entry (Intel i3 / Ryzen 3 + GTX 1660/RTX 3050)', price: '7,000 - 14,000 บาท', note: 'รับซื้อด่วน เหมายกเคส' },
	{ model: 'ขายแยกชิ้น (การ์ดจอ VGA, CPU, Mainboard)', price: 'ประเมินตามรุ่น', note: 'รับซื้อการ์ดจอแยก RTX 30/40 Series, RX 6000/7000 Series' },
];

const faqItems = [
	{
		q: 'รับซื้อคอมประกอบแบบยกเคส หรือรับแยกชิ้นด้วย?',
		a: 'รับทั้งสองแบบครับ! สะดวกสุดคือขายยกเคส ทีมงานประเมินราคาเหมาให้เสร็จสรรพ แต่ถ้าลูกค้าต้องการขายแยกเฉพาะบางชิ้น เช่น ขายเฉพาะการ์ดจอ (VGA) หรือ CPU ทางเราก็ยินดีรับซื้อครับ',
	},
	{
		q: 'คอมประกอบประเมินราคาอย่างไร?',
		a: 'ต่างจากโน๊ตบุ๊คครับ คอมประกอบเราจะให้ลูกค้าส่งสเปกมาเป็นรายชิ้น (List by item) เช่น CPU รุ่นอะไร, การ์ดจอรุ่นไหน, RAM เท่าไหร่ ทีมงานจะนำราคาอะไหล่มือสองแต่ละชิ้นมารวมกัน ทำให้ลูกค้าได้ราคาที่ตรงตามมูลค่าจริงที่สุดครับ',
	},
	{
		q: 'ไม่มีกล่องอุปกรณ์แล้ว รับซื้อไหม?',
		a: 'รับซื้อครับ! แต่หากลูกค้ามีกล่องอุปกรณ์ครบ โดยเฉพาะกล่องการ์ดจอและ CPU รวมถึงใบเสร็จที่ระบุระยะเวลาประกัน จะช่วยเพิ่มมูลค่าราคารับซื้อได้อีกครับ',
	},
	{
		q: 'ชุดน้ำเปิด (Custom Water Cooling) รับซื้อไหม?',
		a: 'รับซื้อครับ แต่คอมที่เป็นชุดน้ำเปิดจะมีความเสี่ยงในการขนย้ายและซ่อมบำรุง รบกวนแจ้งรายละเอียดและถ่ายรูปให้ทีมงานประเมินก่อนครับ',
	},
	{
		q: 'เครื่องติดไวรัส หรือเข้า Windows ไม่ได้ ขายได้ไหม?',
		a: 'ขายได้ครับ เราประเมินมูลค่าจากฮาร์ดแวร์ (อะไหล่) เป็นหลัก หากฮาร์ดแวร์ยังใช้งานได้ปกติ แค่ซอฟต์แวร์มีปัญหา ก็ได้ราคาตามปกติครับ (ทางเราล้างข้อมูลให้ใหม่ทั้งหมดอยู่แล้ว)',
	},
	{
		q: 'คอมหนักมาก มีบริการไปรับที่บ้านไหม?',
		a: 'มีบริการ On-site นัดรับถึงบ้าน หรือออฟฟิศครับ (ตามพื้นที่ให้บริการ) ทีมงานจะไปตรวจสอบสเปก เทสเครื่อง และโอนเงินให้หน้างาน ไม่ต้องแบกเคสหนักๆ ออกมาเองครับ',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อคอมประกอบ คอมพิวเตอร์เล่นเกมและทำงาน',
		description: 'WE BUY รับซื้อคอมประกอบ คอม PC เล่นเกม และคอมทำงานทุกสเปก Intel, AMD, NVIDIA ประเมินราคาจากสเปกชิ้นส่วน จ่ายเงินทันที',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
		about: { '@id': `${pageUrl}#service` }
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		'@id': `${pageUrl}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อคอมประกอบ', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${pageUrl}#faq`,
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${pageUrl}#service`,
		name: 'บริการรับซื้อคอมประกอบ',
		description: 'บริการรับซื้อคอมพิวเตอร์ประกอบ PC เล่นเกม คอมพิวเตอร์สำนักงาน ประเมินแยกตามชิ้นส่วนอย่างเป็นธรรม จ่ายเงินทันที',
		provider: { '@type': 'Organization', '@id': `${site}/#organization` },
		areaServed: {
			'@type': 'Country',
			name: 'TH'
		},
		serviceType: 'รับซื้อคอมพิวเตอร์ประกอบ',
		url: pageUrl,
	},
]
---

<BaseLayout
	title={formatPageTitle('รับซื้อคอมประกอบ เกมมิ่ง')}
	description="WE BUY รับซื้อคอมประกอบ (Custom PC) คอมเล่นเกม (Gaming PC) การ์ดจอ (VGA) มือสอง ประเมินราคารายชิ้น ให้ราคาสูง บริการรับถึงบ้าน ติดต่อ Line @webuy"
	pathname="/รับซื้อคอมประกอบ/"
	type="article"
	jsonLd={articleJsonLd}
>
	<div class="page">
		<header class="header">
			<h1>รับซื้อคอมประกอบเองมือสอง ประเมินราคาทุกชิ้นส่วน จ่ายเงินสดทันที</h1>
			<p class="subtitle">
				สายจัดสเปกคอมพิวเตอร์ที่ต้องการอัปเกรดเครื่องใหม่ หรือต้องการเปลี่ยนพีซีสเปกแรงที่ตั้งทิ้งไว้ให้กลายเป็นเงินทุน เรารับซื้อคอมพิวเตอร์ประกอบเอง (Custom PC) และเครื่องคอมพิวเตอร์เล่นเกม (Gaming PC) ทุกระดับสเปก ด้วยวิธีการประเมินราคาที่แตกต่างจากร้านรับซื้อทั่วไปอย่างสิ้นเชิง เราไม่ตีราคาเหมารวมทั้งเคสแบบกดราคา แต่เราใช้วิธีเจาะลึกประเมินราคารายชิ้นส่วน ไม่ว่าจะเป็นการ์ดจอระดับไฮเอนด์ ซีพียูตัวท็อป แรมความเร็วสูง หรือสตอเรจความจุเยอะ เพื่อให้คุณได้รับมูลค่ากลับคืนไปสูงสุดเท่าที่ตลาดจะให้ได้ พร้อมบริการขับรถไปรับเครื่องถึงหน้าบ้าน ไม่ต้องยกเคสหนักๆ ฝ่ารถติด จ่ายเงินสดเต็มจำนวนทันทีที่หน้างาน
			</p>
		</header>

		<section class="content">
			
			<TrustBadges className="mb-12 mt-8" />
			<RecentTradesSlider />
			<h2>ทำไมคอมประกอบเองถึงขายได้ราคาดีกว่าที่หลายคนคิด</h2>
			<p>หลายคนที่เคยเดินเอาคอมพิวเตอร์ประกอบเองยกเคสไปเสนอขายตามร้านตู้หรือร้านรับซื้อสินค้าไอทีทั่วไป มักจะต้องเจอกับความเจ็บปวดจากการถูกกดราคาแบบไม่เหลือชิ้นดี ร้านเหล่านั้นมักจะอ้างว่า "คอมประกอบขายยาก" หรือ "แบรนด์ไม่ชัดเจนเหมือนคอมแบรนด์เนม" และตีราคาเหมาๆ ให้ในราคาที่ต่ำกว่ามูลค่าจริงหลายพันบาท หรือบางครั้งก็ถูกหักราคาดื้อๆ เพียงเพราะเคสมีรอยขีดข่วนเล็กน้อย ทั้งที่หัวใจสำคัญอย่างการ์ดจอและซีพียูยังทำงานได้เต็มประสิทธิภาพ</p>
			<p>ในความเป็นจริงแล้ว ตลาดซื้อขายอะไหล่คอมพิวเตอร์ประกอบ (DIY PC Components) ในประเทศไทยมีความคึกคักและหมุนเวียนสูงมาก คอมพิวเตอร์หนึ่งเครื่องประกอบไปด้วยชิ้นส่วนหลักถึง 7-8 ชิ้น และแต่ละชิ้นก็มีความต้องการในตลาดมือสองที่แตกต่างกันออกไป บางคนต้องการหาซื้อเฉพาะการ์ดจอไปอัปเกรดเครื่องตัวเอง บางคนตามหาเมนบอร์ดรุ่นเก่าเพื่อซ่อมเครื่องเดิม การประเมินราคาคอมประกอบที่ถูกต้องและยุติธรรมที่สุด จึงต้องเป็นการประเมินแยกรายชิ้น (Part-by-Part Evaluation) แล้วนำตัวเลขมารวมกันเป็นราคาสุทธิ</p>
			<p>นี่คือจุดเด่นที่ทำให้ WE BUY แตกต่างจากผู้รับซื้อรายอื่น เรามีทีมงานสายเทคที่เข้าใจลึกซึ้งถึงสเปกและกลไกราคาของฮาร์ดแวร์แต่ละเจเนอเรชัน เรารู้ว่าแรม DDR5 บัส 6000MHz ต่างจากบัส 4800MHz อย่างไร เรารู้ว่าพาวเวอร์ซัพพลายระดับ 80 Plus Gold ยี่ห้อดังมีมูลค่ามากกว่าพาวเวอร์ซัพพลายแถมเคสหลายเท่าตัว ความเข้าใจเหล่านี้ทำให้เราสามารถถอดรหัสสเปกเครื่องของคุณ และตีราคาให้สูงกว่าร้านทั่วไปที่มองคอมประกอบเป็นแค่เหล็กสี่เหลี่ยม</p>
			<p>นอกจากเรื่องของราคาแล้ว ความเชี่ยวชาญของเรายังครอบคลุมไปถึงเรื่องความปลอดภัยของข้อมูลในฮาร์ดดิสก์และ SSD เมื่อคุณตกลงขายเครื่องให้กับเรา ทีมงานจะทำการฟอร์แมตระดับลึก (Secure Erase/Low-level Format) เพื่อทำลายข้อมูลทั้งหมดอย่างถาวร ป้องกันการกู้คืนด้วยซอฟต์แวร์กู้ข้อมูลทุกประเภท คุณจึงมั่นใจได้ว่าข้อมูลงานสำคัญ รูปภาพส่วนตัว หรือรหัสผ่านธุรกรรมการเงิน จะไม่รั่วไหลไปสู่บุคคลที่สามอย่างแน่นอน</p>
			<p>ดังนั้น หากคุณลงทุนเงินก้อนใหญ่ไปกับการประกอบคอมพิวเตอร์ในฝัน และถึงเวลาที่ต้องส่งต่อมันให้กับคนอื่น อย่าปล่อยให้ความพยายามในการคัดสรรชิ้นส่วนของคุณสูญเปล่า เลือกขายให้กับศูนย์รับซื้อที่มองเห็นมูลค่าที่แท้จริงของอุปกรณ์แต่ละชิ้น เพื่อให้ผลตอบแทนที่กลับคืนมาคุ้มค่าที่สุดเท่าที่จะเป็นไปได้</p>

			<h2>ชิ้นส่วนที่เราให้ราคาสูงที่สุด — การ์ดจอ, CPU, RAM</h2>
			<p>เมื่อพูดถึงคอมพิวเตอร์ประกอบเพื่อการเล่นเกมหรืองานกราฟิก "การ์ดจอ (Graphic Card / VGA)" คือชิ้นส่วนที่เป็นพระเอกและมีมูลค่าสูงสุดในเคสเสมอ การ์ดจอมักจะมีสัดส่วนราคาคิดเป็น 40-60% ของราคาเครื่องรวมทั้งหมด เรารับซื้อการ์ดจอทุกค่าย ไม่ว่าจะเป็นฝั่งเขียว NVIDIA GeForce ซีรีส์ RTX 40 (เช่น RTX 4090, 4080, 4070, 4060) หรือซีรีส์ RTX 30 รวมถึงฝั่งแดง AMD Radeon ซีรีส์ RX 7000 และ RX 6000 โดยราคาประเมินจะอิงจากประสิทธิภาพในการเล่นเกม การระบายความร้อน และความสวยงามของตัวการ์ด (เช่น รุ่นที่มีไฟ RGB หรือชุดพัดลม 3 ตัว)</p>
			<p>สิ่งที่ส่งผลต่อราคาการ์ดจออย่างมากคือ "การรับประกัน" เนื่องจากการ์ดจอเป็นอุปกรณ์ที่ทำงานหนักและมีความร้อนสะสมสูง หากหมดประกันไปแล้วและเกิดเสียขึ้นมา ค่าซ่อมมักจะไม่คุ้มค่า ดังนั้น การ์ดจอที่ยังมีสติกเกอร์รับประกันศูนย์ไทย (เช่น Synnex, Ascenti, JIB, Advice, Deva) ติดอยู่ และเหลือระยะเวลาประกันตั้งแต่ 6 เดือนขึ้นไป จะได้รับราคาประเมินที่สูงเป็นพิเศษ ยิ่งถ้าคุณเก็บ "กล่อง" ของการ์ดจอตัวนั้นไว้ด้วย ก็จะยิ่งบวกราคาเพิ่มขึ้นไปได้อีก</p>
			<p>รองลงมาคือ "หน่วยประมวลผลกลาง หรือ ซีพียู (CPU)" ซึ่งเป็นสมองของคอมพิวเตอร์ ซีพียูเป็นชิ้นส่วนที่เสียยากที่สุดในระบบ หากไม่ได้เกิดจากการใช้งานผิดประเภท (เช่น Overclock จนไหม้) หรือขา Socket หัก เรารับซื้อซีพียูทั้งจากค่าย Intel Core (i3, i5, i7, i9) ตั้งแต่เจนเนอเรชัน 12 ขึ้นไป (Alder Lake, Raptor Lake) และค่าย AMD Ryzen (Ryzen 3, 5, 7, 9) ซีรีส์ 5000 และ 7000 ขึ้นไป ซีพียูรุ่นใหม่ๆ ที่มีจำนวนคอร์และเทรดสูงๆ ย่อมเป็นที่ต้องการในตลาดอย่างต่อเนื่อง</p>
			<p>สำหรับ "หน่วยความจำ (RAM)" ในช่วงการเปลี่ยนผ่านเทคโนโลยีจาก DDR4 มาสู่ DDR5 แรมยังคงเป็นที่ต้องการของคนหาอัปเกรดเครื่อง หากเครื่องของคุณใช้แรม DDR5 ความจุสูง (เช่น 32GB หรือ 64GB) และเป็นรุ่นที่มีฮีตซิงค์ระบายความร้อนพร้อมไฟ RGB จากแบรนด์ดังอย่าง Corsair, G.Skill หรือ Kingston ราคาประเมินในส่วนนี้ก็จะพุ่งสูงขึ้นตามไปด้วย ส่วนระบบจัดเก็บข้อมูลอย่าง M.2 NVMe SSD ก็ได้รับความนิยมไม่แพ้กัน ยิ่งความจุเยอะและมีความเร็วในการอ่านเขียนสูง ก็ยิ่งมีมูลค่า</p>
			<p>สุดท้ายคือ "เมนบอร์ด (Motherboard)" และ "พาวเวอร์ซัพพลาย (Power Supply - PSU)" เมนบอร์ดชิปเซ็ตรุ่นท็อป (เช่น Z-Series สำหรับ Intel หรือ X-Series สำหรับ AMD) ที่รองรับการเชื่อมต่อครบครันและมีภาคจ่ายไฟที่แข็งแกร่ง จะช่วยดึงราคาคอมประกอบขึ้นได้อย่างมีนัยสำคัญ ควบคู่ไปกับ PSU ที่ได้รับมาตรฐาน 80 Plus Gold ขึ้นไป และมีกำลังวัตต์เพียงพอต่อการจ่ายไฟให้การ์ดจอรุ่นใหญ่ ทั้งสองสิ่งนี้คือรากฐานที่ทำให้คอมประกอบของคุณมีราคาที่เหนือกว่าคอมทั่วไป</p>

			
