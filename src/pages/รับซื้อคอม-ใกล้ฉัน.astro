---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactBox from '../components/ContactBox.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import PriceGuide from '../components/services/PriceGuide.astro';
import '../styles/longform.css';
import { formatPageTitle, getSiteOrigin, getSocialLinks } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';

const site = getSiteOrigin();
const socialLinks = getSocialLinks();
const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 4);
const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อคอม-ใกล้ฉัน/`;
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const priceItems = [
	{ model: 'Hi-End Gaming PC (RTX 5080/5090)', price: '60,000 - 150,000+ บาท', note: 'ประเมินจาก CPU, เมนบอร์ดเกรดบน และชุดน้ำ' },
	{ model: 'Mid-Range Gaming PC (RTX 4060/4070)', price: '15,000 - 35,000 บาท', note: 'ราคาสูงขึ้นหากมีกล่องชิ้นส่วนเดิมและประกันเหลือ' },
	{ model: 'คอมพิวเตอร์สายทำงาน / สตรีมเมอร์', price: '10,000 - 25,000 บาท', note: 'เน้นประเมิน CPU Multi-core และ RAM 32GB+' },
	{ model: 'คอมพิวเตอร์สำนักงาน (Office PC)', price: '3,000 - 8,000 บาท', note: 'รับประเมินทั้งแบบเครื่องเดียวและเหมาล็อตบริษัท' },
	{ model: 'ซากคอม / ชิ้นส่วน / จอคอมเก่า', price: '500 - 3,000 บาท', note: 'ประเมินตามอะไหล่ที่ยังนำไปใช้ประโยชน์ต่อได้' },
];

const faqItems = [
	{
		q: 'รับซื้อคอมพิวเตอร์ตั้งโต๊ะประเภทไหนบ้าง?',
		a: 'รับซื้อครบทุกประเภท ทั้งคอมประกอบเอง คอมแบรนด์เนม (Dell, HP, Lenovo, Acer) คอมเกมมิ่ง เวิร์กสเตชัน คอมสำนักงาน Mini PC All-in-One และเครื่องเซิร์ฟเวอร์บางรุ่น ประเมินจากสเปกจริงและสภาพการใช้งาน',
	},
	{
		q: 'คอมเก่ามากหรือสเปกต่ำยังขายได้ไหม?',
		a: 'ขายได้ หากยังมีชิ้นส่วนที่มีมูลค่าในตลาดมือสอง เช่น เคสคุณภาพดี พาวเวอร์ซัพพลายยี่ห้อดัง หรือ SSD ที่ยังสมบูรณ์ ทีมงานจะช่วยประเมินตามสภาพจริงและอธิบายเหตุผลราคาให้ชัดเจน',
	},
	{
		q: 'ต้องถอดชิ้นส่วนส่งแยกไหม?',
		a: 'ไม่ต้องถอดเลย ส่งมาทั้งเครื่องได้เลย ทีมงานมีอุปกรณ์ตรวจสอบครบและจะตรวจสเปกให้ทั้งหมด การถอดเองอาจทำให้ชิ้นส่วนเสียหายหรือสูญหายโดยไม่จำเป็น',
	},
	{
		q: 'ขายคอมต้องเตรียมอะไรบ้าง?',
		a: 'เตรียมข้อมูลสเปกเครื่อง เช่น รุ่น CPU, RAM, SSD/HDD, การ์ดจอ พร้อมถ่ายรูปเครื่องรอบด้านและภาพหน้าจอ BIOS หรือ System Information สำรองข้อมูลส่วนตัวให้เรียบร้อย แล้วทัก Line @webuy เพื่อประเมินราคาทันที',
	},
	{
		q: 'ราคาประเมินใช้เกณฑ์อะไร?',
		a: 'ดูจากหลายปัจจัยประกอบกัน ได้แก่ รุ่นและเจนของ CPU ขนาดและความเร็ว RAM ชนิดและความจุ Storage รุ่นการ์ดจอ คุณภาพพาวเวอร์ซัพพลาย สภาพเคสและเมนบอร์ด รวมถึงอายุการใช้งานและความต้องการของตลาดในขณะนั้น',
	},
	{
		q: 'รับซื้ออุปกรณ์ต่อพ่วงด้วยไหม เช่น จอ คีย์บอร์ด เมาส์?',
		a: 'รับซื้อครับ โดยเฉพาะจอมอนิเตอร์ที่ยังสภาพดี คีย์บอร์ดเมคานิคอล และเมาส์เกมมิ่ง หากขายพร้อมชุดคอมจะสะดวกในการประเมินและปิดดีลได้เร็วขึ้น',
	},
	{
		q: 'ให้บริการพื้นที่ไหนบ้าง?',
		a: 'ให้บริการหลักในกรุงเทพมหานคร ปริมณฑล และจังหวัดใหญ่ในภาคอีสาน เช่น อุบลราชธานี ขอนแก่น นครราชสีมา อุดรธานี สำหรับพื้นที่อื่นสามารถส่งรูปและสเปกมาประเมินออนไลน์ได้ก่อน แล้วค่อยนัดหมายส่งมอบ',
	},
	{
		q: 'ติดต่อช่องทางไหนเร็วที่สุด?',
		a: 'แนะนำทัก Line @webuy เพราะส่งรูป สเปก และวิดีโอเครื่องได้ทันที ทีมงานตอบกลับตลอด 24 ชั่วโมง หรือโทร 064-257-9353 หากต้องการคุยสดทันที',
	},
	{
		q: 'ขายคอมเกมมิ่งได้ราคาดีไหม?',
		a: 'คอมเกมมิ่งที่มีการ์ดจอแรง RAM เยอะ และ SSD ความจุสูง มักได้ราคาดีกว่าคอมสำนักงานทั่วไป เพราะมีความต้องการในตลาดมือสองสูง โดยเฉพาะเครื่องที่ดูแลรักษาดีและมีประวัติการใช้งานชัดเจน',
	},
	{
		q: 'ขายหลายเครื่องพร้อมกันได้ไหม?',
		a: 'ได้เลย ไม่ว่าจะเป็นบุคคลทั่วไปหรือบริษัทที่ต้องการเคลียร์คอมชุดเก่า ส่งรายการสเปคทั้งหมดมาทาง Line @webuy ได้เลย ทีมงานจะประเมินเป็นชุดและเสนอราคารวมให้ ช่วยประหยัดเวลาได้มาก',
	},
	{
		q: 'เช็กราคาคอมมือสองก่อนขายต้องส่งอะไร?',
		a: 'หน้าเช็กราคาก่อนขายมีรายการสเปก CPU RAM SSD GPU และรูปเครื่องที่แนะนำ ส่งผ่าน Line @webuy เพื่อรับช่วงราคาเบื้องต้นก่อนนัดตรวจจริง',
	},
	{
		q: 'ดูแนวราคากลางรับซื้อคอมได้ที่ไหน?',
		a: 'หน้าราคากลางรับซื้ออธิบายปัจจัยราคาคอมประกอบและแบรนด์เนม โดยไม่ใส่ตัวเลขมั่ว — ราคาสุดท้ายยืนยันหลังตรวจเครื่องตามสภาพจริง',
	},
];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: 'รับซื้อคอมพิวเตอร์มือสอง ใกล้ฉัน บริการรับถึงที่',
		description:
			'WE BUY รับซื้อคอมพิวเตอร์มือสองทุกประเภท คอมประกอบ คอมแบรนด์เนม Gaming PC Workstation ประเมินราคาโปร่งใส จ่ายเงินทันที ติดต่อ Line @webuy 24 ชม.',
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: 'รับซื้อคอม | รับซื้อคอมพิวเตอร์มือสอง PC ทุกรุ่น ได้ราคาดี ใกล้ฉัน ให้ราคาสูง จ่ายเงินสดทันที',
		description:
			'บริการรับซื้อคอมพิวเตอร์ตั้งโต๊ะมือสอง ครอบคลุมคอมประกอบ คอมแบรนด์เนม คอมเกมมิ่ง เวิร์กสเตชัน พร้อมคู่มือเตรียมเครื่องก่อนขายและเกณฑ์ประเมินราคาอย่างละเอียด',
		inLanguage: 'th-TH',
		author: { '@type': 'Organization', '@id': orgId, name: orgName },
		publisher: { '@type': 'Organization', '@id': orgId, name: orgName },
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': `${pageUrl}#webpage`,
		},
		datePublished: '2026-03-24',
		dateModified: '2026-03-24',
		keywords: 'รับซื้อคอม, ขายคอมมือสอง, รับซื้อคอมพิวเตอร์, รับซื้อคอมตั้งโต๊ะ, รับซื้อคอมเกมมิ่ง, รับซื้อ PC, ประเมินราคาคอม, ขายคอมเก่า, รับซื้อคอมสำนักงาน, รับซื้อเวิร์กสเตชัน, รับซื้อคอมพิวเตอร์ใกล้ฉัน, ร้านรับซื้อคอมพิวเตอร์ใกล้บ้าน, รับซื้อถึงที่',
		image: [new URL('/og-default.png', site).toString()],
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['h1', '.intro', '.faq'],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ ใกล้ฉัน บริการรับถึงที่', item: `${site}/รับซื้อ/` },
			{ '@type': 'ListItem', position: 3, name: 'รับซื้อคอม ใกล้ฉัน บริการรับถึงที่', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		mainEntity: faqItems.map((item) => ({
			'@type': 'Question',
			name: item.q,
			acceptedAnswer: { '@type': 'Answer', text: item.a },
		})),
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อคอมพิวเตอร์ ใกล้ฉัน บริการรับถึงที่',
		description:
			'บริการรับซื้อคอมพิวเตอร์มือสองทุกประเภท ทั้ง PC ประกอบ คอมแบรนด์เนม Gaming PC Workstation ประเมินราคาโปร่งใส จ่ายเงินทันที',
		provider: { '@type': 'Organization', '@id': orgId, name: orgName },
		areaServed: serviceAreas.map((area) => ({ '@type': 'AdministrativeArea', name: area })),
		serviceType: 'รับซื้อคอมพิวเตอร์มือสอง',
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'HowTo',
		name: 'วิธีขายคอมพิวเตอร์มือสองกับ WE BUY',
		description: 'ขั้นตอนง่าย ๆ ในการขายคอมมือสองให้ได้ราคาดี',
		step: [
			{
				'@type': 'HowToStep',
				name: 'ส่งข้อมูลเครื่อง',
				text: 'แอดไลน์ @webuy แล้วส่งรูปเครื่อง สเปก CPU, RAM, GPU และสภาพ',
			},
			{
				'@type': 'HowToStep',
				name: 'รับราคาประเมิน',
				text: 'ทีมงานตรวจสอบสเปกและแจ้งราคาประเมินเบื้องต้น',
			},
			{
				'@type': 'HowToStep',
				name: 'ยืนยันและนัดรับ',
				text: 'ตกลงราคา นัดหมายจุดรับ-ส่ง หรือจัดส่ง',
			},
			{
				'@type': 'HowToStep',
				name: 'รับเงินทันที',
				text: 'ตรวจสอบเครื่องจริงและรับเงินทันที',
			},
		],
	},
];

import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
---

<BaseLayout
	title={formatPageTitle('หาร้านรับซื้อคอมพิวเตอร์ PC ใกล้ฉัน ประเมินฟรี รับถึงที่')}
	description="หาร้านWE BUY รับซื้อคอมพิวเตอร์มือสองทุกประเภท คอมประกอบ คอมแบรนด์เนม Gaming PC Workstation ประเมินราคาโปร่งใส จ่ายเงินทันที ติดต่อ Line @webuy 24 ชม. ใกล้ฉัน? WE BUY บริการรับซื้อถึงบ้าน จ่ายเงินสดทันที ตีราคาไวใน 15 นาที"
	pathname="/รับซื้อคอม-ใกล้ฉัน/"
	type="article"
	jsonLd={articleJsonLd}
>
	<div class="page">
		<header class="header">
			<h1>หาร้านรับซื้อคอมพิวเตอร์ ตั้งโต๊ะ พีซีประกอบ และเกมมิ่ง PC ให้ราคาสูง จ่ายเงินสดทันที ใกล้ฉัน? เรารับซื้อถึงที่ จ่ายเงินสดทันที</h1>
			<p class="subtitle">
				ในโลกเทคโนโลยีที่ก้าวไปอย่างรวดเร็ว คอมพิวเตอร์ที่เราเพิ่งซื้อมาด้วยความภาคภูมิใจเมื่อไม่กี่ปีก่อน อาจเริ่มไม่ตอบโจทย์ความต้องการในปัจจุบัน ไม่ว่าคุณจะเป็นเกมเมอร์ตัวยงที่ต้องการเฟรมเรตสูงสุดในการเล่นเกมระดับ AAA, สตรีมเมอร์ที่ต้องการเครื่องที่แรงพอจะไลฟ์สดและเล่นเกมพร้อมกัน, นักสร้างสรรค์ผลงาน 3D ที่ต้องการพลังประมวลผลมหาศาล, หรือเพียงแค่คนทำงานที่อยากเปลี่ยนจากคอมพิวเตอร์ตั้งโต๊ะไปใช้โน้ตบุ๊กเพื่อความคล่องตัว การปล่อยให้เครื่องคอมพิวเตอร์เก่าตั้งฝุ่นจับอยู่เฉย ๆ คือการปล่อยให้มูลค่าของมันลดลงไปทุกวัน ที่ WE BUY เราเข้าใจมูลค่าของฮาร์ดแวร์ทุกชิ้น เรารับซื้อคอมพิวเตอร์มือสองทุกรูปแบบ ทั้งคอมประกอบ (Custom PC), คอมแบรนด์เนม (Branded PC อย่าง Dell, HP, Lenovo), คอมพิวเตอร์เกมมิ่ง (Gaming Desktop), คอมสำหรับงานออฟฟิศ (Office PC) ไปจนถึงเวิร์กสเตชัน (Workstation) ด้วยประสบการณ์ในวงการไอทีและการติดตามกลไกราคาตลาดอย่างใกล้ชิด เราสามารถประเมินราคาชิ้นส่วนทุกชิ้นได้อย่างแม่นยำ พร้อมเสนอราคาที่คุณจะต้องพึงพอใจ บริการของเราเน้นความสะดวก รวดเร็ว และให้ความมั่นใจด้วยการโอนเงินทันทีที่ตกลงกันเสร็จสิ้น
			</p>
		</header>
        <section class="content">
			<TrustBadges className="mb-12 mt-8" />
			<h2>หมดปัญหาหาร้านรับซื้อKWใกล้บ้าน เราวิ่งไปรับถึงที่</h2>
			<p>ในยุคนี้ความสะดวกและรวดเร็วคือสิ่งสำคัญที่สุด ใครที่กำลังเซิร์ชหาร้านรับซื้อKW ใกล้ฉัน คุณมาถูกที่แล้วครับ เรามีทีมงานที่พร้อมพุ่งตัวไปประเมินเครื่องและรับซื้อถึงหน้าประตูบ้านคุณ ไม่ต้องเหนื่อยเดินทาง</p>
