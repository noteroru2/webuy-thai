---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อ/`;

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#webpage`,
		name: 'รับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดี จ่ายเงินทันที',
		description: 'ศูนย์รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง และลำโพงแบรนด์เนมมือสอง ครบวงจร ประเมินราคาด่วน 24 ชม.',
		url: pageUrl,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อสินค้าไอทีมือสอง',
		description: 'รับซื้อโน้ตบุ๊ค, คอมพิวเตอร์, มือถือ และอุปกรณ์ไอทีทุกชนิด ให้ราคาสูง จ่ายเงินสดทันที',
		provider: { '@type': 'Organization', name: orgName },
		url: pageUrl,
	}
];

const preSaleLinks = [
	{
		href: '/เช็กราคาก่อนขาย/',
		title: 'เตรียมข้อมูลเช็กราคาก่อนขาย',
		desc: 'รายการข้อมูลและรูปที่ควรส่งก่อนทัก Line',
	},
	{
		href: '/ราคากลางรับซื้อ/',
		title: 'แนวราคากลางรับซื้อไอทีมือสอง',
		desc: 'ปัจจัยราคาตามหมวดสินค้า ไม่ใส่ตัวเลขมั่ว',
	},
	{
		href: '/ความน่าเชื่อถือ/',
		title: 'ศูนย์ความน่าเชื่อถือ WE BUY',
		desc: 'ขั้นตอนซื้อขายโปร่งใสและความปลอดภัยข้อมูล',
	},
];

const mainMoneyPages = [
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อ iPhone มือสอง', desc: 'ทุกรุ่น ประเมินตามสภาพจริง' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊คมือสอง', desc: 'โน้ตบุ๊คทุกยี่ห้อและสเปก' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook มือสอง', desc: 'Air / Pro ชิป Intel และ M-series' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมมือสอง', desc: 'PC ประกอบและแบรนด์เนม' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้องมือสอง', desc: 'DSLR Mirrorless และเลนส์' },
];

const categories = [
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊ค', desc: 'รับซื้อ Laptop ทุกยี่ห้อ ทั้งสายทำงาน และ Notebook เกมมิ่งแรง ๆ' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์', desc: 'PC แบรนด์เนม, All-in-One และคอมสำนักงาน' },
	{ href: '/รับซื้อคอมประกอบ/', title: 'รับซื้อคอมประกอบ', desc: 'Custom PC, Gaming PC, การ์ดจอ และอะไหล่แยกชิ้น' },
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อไอโฟน', desc: 'iPhone ทุกรุ่น ตั้งแต่รุ่นเก่าจนถึงรุ่นล่าสุด ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อไอแพด/', title: 'รับซื้อไอแพด', desc: 'iPad Pro, Air, mini และ iPad Gen ทุกรุ่น ทั้งแบบ Wi-Fi และใส่ซิม' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook', desc: 'MacBook Air / Pro ทั้งชิป Intel และตระกูล M1-M5 ให้ราคาสูง' },
	{ href: '/รับซื้อสมาร์ทโฟน-android/', title: 'รับซื้อสมาร์ทโฟน Android', desc: 'Samsung S/Z Series, ROG Phone และรุ่นเรือธงทุกค่าย' },
	{ href: '/รับซื้อ-apple-watch/', title: 'รับซื้อ Apple Watch', desc: 'Series ล่าสุด, Ultra, SE รับซื้อทุกสภาพ ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อเครื่องเกม/', title: 'รับซื้อเครื่องเกม', desc: 'PS5, Nintendo Switch, Steam Deck รับซื้อพร้อมแผ่นเกมและจอย' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้อง', desc: 'DSLR, Mirrorless, เลนส์ และอุปกรณ์ถ่ายภาพทุกประเภท' },
	{ href: '/รับซื้อลำโพง/', title: 'รับซื้อลำโพง', desc: 'Marshall, JBL และลำโพงบลูทูธแบรนด์เนมของแท้เท่านั้น' },
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อไอทีมือสอง | โน้ตบุ๊ค คอม ไอโฟน')}
	description="WE BUY ศูนย์รับซื้อสินค้าไอทีมือสองครบวงจร รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง ลำโพง ประเมินราคาโปร่งใส จ่ายเงินสดทันที ติดต่อ Line @webuy 24 ชม."
	pathname="/รับซื้อ/"
	jsonLd={jsonLd}
>
	<div class="container page">
		<header class="head">
			<p class="tech-eyebrow">WE BUY • Buyback Categories</p>
			<h1 class="tech-h2">บริการรับซื้อสินค้าไอทีมือสอง ทุกประเภท</h1>
			<p class="lead">
				เราคือผู้เชี่ยวชาญในการ <strong>รับซื้อสินค้าไอทีมือสอง</strong> ที่เน้นความโปร่งใสและยุติธรรมที่สุด 
				ไม่ว่าคุณจะมีเครื่องสภาพสวยเหมือนใหม่ หรือเครื่องที่มีตำหนิจากการใช้งาน 
				ทีมงานของเราพร้อมประเมินราคาให้คุณตามมูลค่าตลาดจริง เลือกหมวดสินค้าที่คุณต้องการขายด้านล่างนี้:
			</p>
		</header>

		<div class="grid">
			{categories.map((c) => (
				<a class="card" href={c.href}>
					<div class="card-content">
						<h2>{c.title}</h2>
						<p>{c.desc}</p>
					</div>
					<span class="more">ดูรายละเอียดราคา &rarr;</span>
				</a>
			))}
		</div>

		<section class="pre-sale-hub" aria-labelledby="pre-sale-hub-heading">
			<h2 id="pre-sale-hub-heading" class="tech-h2">ก่อนขาย เช็กราคาและความน่าเชื่อถือได้ก่อน</h2>
			<p class="pre-sale-lead">
				ส่งข้อมูลให้ครบก่อนทัก Line จะได้ช่วงราคาเบื้องต้นที่ชัดขึ้น — อ่านแนวทางและขั้นตอนจากลิงก์ด้านล่าง
				หรือ <a href="/คู่มือก่อนขาย/">อ่านคู่มือก่อนขาย</a> รวมบทความขายได้ไหม ราคา และความปลอดภัย
			</p>
			<div class="pre-sale-links">
				{preSaleLinks.map((link) => (
					<a class="pre-sale-card" href={link.href}>
						<h3>{link.title}</h3>
						<p>{link.desc}</p>
					</a>
				))}
			</div>
			<h3 class="pre-sale-sub">หมวดรับซื้อหลัก</h3>
			<div class="money-links">
				{mainMoneyPages.map((page) => (
					<a class="money-link" href={page.href}>
						<strong>{page.title}</strong>
						<span>{page.desc}</span>
					</a>
				))}
			</div>
		</section>

		<section class="trust-signals">
			<div class="trust-grid">
				<div class="trust-item">
					<div class="icon">💰</div>
					<h3>ให้ราคาสูง & เป็นธรรม</h3>
					<p>เราประเมินจากสเปกจริงและความต้องการของตลาดมือสอง ไม่มีการกดราคาเกินเหตุ</p>
				</div>
				<div class="trust-item">
					<div class="icon">⚡</div>
					<h3>ประเมินไวใน 15 นาที</h3>
					<p>แค่ส่งรูปและรุ่นมาทาง Line ทีมงานพร้อมตอบราคาเบื้องต้นให้คุณทันที</p>
				</div>
				<div class="trust-item">
					<div class="icon">💵</div>
					<h3>จ่ายเงินทันที</h3>
					<p>ตรวจเช็คเครื่องเสร็จ รับเงินสดหน้างานหรือโอนเข้าบัญชีทันใจ ไม่ต้องรอข้ามวัน</p>
				</div>
				<div class="trust-item">
					<div class="icon">🛡️</div>
					<h3>ข้อมูลปลอดภัย</h3>
					<p>เรามีบริการช่วยล้างข้อมูล (Format) และออกจากระบบบัญชีให้ เพื่อความเป็นส่วนตัว 100%</p>
				</div>
			</div>
		</section>

		<section class="process-summary">
			<h2 class="tech-h2">ขั้นตอนการขายง่าย ๆ กับ WE BUY</h2>
			<div class="steps">
				<div class="step">
					<span class="step-num">1</span>
					<p><strong>ส่งข้อมูล:</strong> ทักไลน์ <a href="https://line.me/R/ti/p/@webuy">@webuy</a> ส่งรูปและสเปกเครื่อง</p>
				</div>
				<div class="step">
					<span class="step-num">2</span>
					<p><strong>รับราคา:</strong> รอรับราคาประเมินเบื้องต้นภายในเวลาไม่กี่นาที</p>
				</div>
				<div class="step">
					<span class="step-num">3</span>
					<p>
						<strong>นัดรับ:</strong> นัดเจอในพื้นที่บริการ หรือส่งพัสดุตามความสะดวก —
						<a href="/พื้นที่ให้บริการ/">ดูพื้นที่ให้บริการรับซื้อ</a>
					</p>
				</div>
				<div class="step">
					<span class="step-num">4</span>
					<p><strong>รับเงิน:</strong> ตรวจสอบเครื่องจริงเสร็จ รับเงินทันที</p>
				</div>
			</div>
		</section>

		<section class="extra" aria-labelledby="more-cats">
			<h2 id="more-cats" class="tech-h2">สินค้าอื่น ๆ ที่เรายังรับซื้อ</h2>
			<p>
				นอกจากหมวดหลักด้านบนแล้ว เรายังรับซื้อมือถือ Android รุ่นท็อป, เครื่องเล่นเกม (PlayStation, Nintendo Switch), 
				การ์ดจอแยก, จอมอนิเตอร์, ทีวี Smart TV, และอุปกรณ์ไอทีเกรดพรีเมียมอื่น ๆ 
				หากคุณมีอุปกรณ์ที่ไม่ได้อยู่ในรายการ สามารถสอบถามก่อนได้ครับ
			</p>
			<div class="cta-row">
				<a class="btn-line" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">แอดไลน์ @webuy เพื่อประเมินราคา</a>
				<a class="btn-ghost" href="/contact/">ติดต่อสอบถามเพิ่มเติม</a>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.page {
		padding-block: 3rem 5rem;
	}
	.head {
		max-width: 800px;
		margin-bottom: 3rem;
	}
	.head h1 {
		margin: 0.5rem 0 1rem;
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		line-height: 1.2;
		font-weight: 800;
		color: var(--text);
	}
	.lead {
		margin: 0;
		color: var(--muted);
		font-size: 1.15rem;
		line-height: 1.7;
	}
	.grid {
		display: grid;
		gap: 1.5rem;
		margin-bottom: 4rem;
	}
	@media (min-width: 640px) {
		.grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1024px) {
		.grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.card {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		padding: 2rem;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.05);
		border-radius: 1rem;
		text-decoration: none;
		color: var(--text);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
		transition: all 0.3s ease;
	}
	.card:hover {
		border-color: var(--accent);
		transform: translateY(-5px);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		text-decoration: none;
	}
	.card h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
		font-weight: 700;
	}
	.card p {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.5;
	}
	.more {
		margin-top: 1.5rem;
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--accent);
	}

	.pre-sale-hub {
		margin-bottom: 4rem;
		padding: 2.5rem;
		background: linear-gradient(135deg, #fffbeb, #fff7ed);
		border: 1px solid rgba(180, 83, 9, 0.2);
		border-radius: 1.5rem;
	}
	.pre-sale-hub .tech-h2 {
		margin: 0 0 0.75rem;
	}
	.pre-sale-lead {
		margin: 0 0 1.75rem;
		max-width: 42rem;
		color: var(--muted);
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.pre-sale-links {
		display: grid;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	@media (min-width: 768px) {
		.pre-sale-links {
			grid-template-columns: repeat(3, 1fr);
		}
	}
	.pre-sale-card {
		display: block;
		padding: 1.25rem 1.5rem;
		background: #fff;
		border: 1px solid rgba(0, 0, 0, 0.06);
		border-radius: 1rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.pre-sale-card:hover {
		border-color: var(--accent);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.06);
		text-decoration: none;
	}
	.pre-sale-card h3 {
		margin: 0 0 0.5rem;
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--accent);
	}
	.pre-sale-card p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.5;
	}
	.pre-sale-sub {
		margin: 0 0 1rem;
		font-size: 1.1rem;
		font-weight: 700;
	}
	.money-links {
		display: grid;
		gap: 0.75rem;
	}
	@media (min-width: 640px) {
		.money-links {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.money-links {
			grid-template-columns: repeat(5, 1fr);
		}
	}
	.money-link {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 0.875rem 1rem;
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 0.75rem;
		font-size: 0.875rem;
		text-decoration: none;
		color: var(--text);
		transition: border-color 0.2s, background 0.2s;
	}
	.money-link:hover {
		border-color: var(--accent);
		background: #fff7ed;
		text-decoration: none;
	}
	.money-link strong {
		font-weight: 700;
	}
	.money-link span {
		font-size: 0.75rem;
		color: var(--muted);
		line-height: 1.4;
	}

	.trust-signals {
		margin-bottom: 5rem;
		padding: 3rem;
		background: #f8fafc;
		border-radius: 1.5rem;
	}
	.trust-grid {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 768px) {
		.trust-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1024px) {
		.trust-grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.trust-item {
		text-align: center;
	}
	.trust-item .icon {
		font-size: 2.5rem;
		margin-bottom: 1rem;
	}
	.trust-item h3 {
		font-size: 1.1rem;
		margin-bottom: 0.5rem;
	}
	.trust-item p {
		font-size: 0.9rem;
		color: var(--muted);
		line-height: 1.5;
	}

	.process-summary {
		margin-bottom: 5rem;
	}
	.steps {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
	}
	@media (min-width: 768px) {
		.steps {
			grid-template-columns: repeat(4, 1fr);
		}
	}
	.step {
		position: relative;
		padding: 1.5rem;
		background: #fff;
		border: 1px solid #e2e8f0;
		border-radius: 1rem;
	}
	.step-num {
		display: inline-block;
		width: 30px;
		height: 30px;
		background: var(--accent);
		color: #fff;
		border-radius: 50%;
		text-align: center;
		line-height: 30px;
		font-weight: 800;
		margin-bottom: 1rem;
	}

	.extra {
