---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import CtaBand from '../components/CtaBand.astro';
import ServiceCategoryGrid from '../components/ui/ServiceCategoryGrid.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

import SafeProcessBar from '../components/money-pages/SafeProcessBar.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อ/`;

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#webpage`,
		name: 'รับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดี ชำระเงินหลังยืนยันสภาพ',
		description: 'ศูนย์รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้องถ่ายรูปมือสอง ประเมินราคาเบื้องต้นตามรุ่น สเปก และสภาพจริงผ่าน LINE',
		url: pageUrl,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
		about: { '@id': `${site}/#organization` }
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		'@id': `${pageUrl}#breadcrumb`,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		'@id': `${pageUrl}#itemlist`,
		name: 'หมวดหมู่บริการรับซื้อไอทีหลัก',
		url: pageUrl,
		numberOfItems: 7,
		itemListElement: [
			{ '@type': 'ListItem', position: 1, url: `${site}/รับซื้อโน๊ตบุ๊ค/`, name: 'รับซื้อโน๊ตบุ๊ค' },
			{ '@type': 'ListItem', position: 2, url: `${site}/รับซื้อคอม/`, name: 'รับซื้อคอมพิวเตอร์' },
			{ '@type': 'ListItem', position: 3, url: `${site}/รับซื้อแมคบุ๊ค/`, name: 'รับซื้อ MacBook' },
			{ '@type': 'ListItem', position: 4, url: `${site}/รับซื้อไอโฟน/`, name: 'รับซื้อ iPhone' },
			{ '@type': 'ListItem', position: 5, url: `${site}/รับซื้อไอแพด/`, name: 'รับซื้อ iPad' },
			{ '@type': 'ListItem', position: 6, url: `${site}/รับซื้อกล้อง/`, name: 'รับซื้อกล้อง' },
			{ '@type': 'ListItem', position: 7, url: `${site}/รับซื้อคอม/`, name: 'รับซื้อคอมพิวเตอร์สำนักงาน/B2B' }
		]
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		'@id': `${pageUrl}#service`,
		name: 'บริการรับซื้อสินค้าไอทีมือสอง',
		description: 'รับซื้อโน้ตบุ๊ค, คอมพิวเตอร์, มือถือ และอุปกรณ์ไอทีทุกชนิด ประเมินตามสภาพจริง ตรวจรับและชำระเงินหลังยืนยันสภาพ',
		provider: { '@type': 'Organization', '@id': `${site}/#organization` },
		url: pageUrl,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'FAQPage',
		'@id': `${pageUrl}#faq`,
		mainEntity: [
			{
				'@type': 'Question',
				name: 'เครื่องติดล็อค iCloud หรือติดสัญญาเครือข่าย รับซื้อไหม?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'เรารับซื้อเครื่องในหลากหลายสภาพ แต่มีเงื่อนไขสำคัญคือ สำหรับเครื่อง Apple ต้องสามารถ Log out ออกจาก iCloud หรือ Apple ID ได้สมบูรณ์ก่อนส่งมอบ หากเครื่องติดล็อคขโมยมา เราขอสงวนสิทธิ์ไม่รับซื้อในทุกกรณี ส่วนเครื่องที่ติดสัญญาเครือข่าย เรารับพิจารณาเป็นเคสๆ ไป'
				}
			},
			{
				'@type': 'Question',
				name: 'เครื่องพัง หน้าจอแตก เปิดไม่ติด รับซื้อหรือไม่?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'รับซื้อครับ! เครื่องที่หน้าจอแตก, แบตเตอรี่เสื่อมจัด, หรือแม้กระทั่งเปิดไม่ติด (บอร์ดเสีย) เราก็รับซื้อเพื่อนำไปเป็นอะไหล่ แต่ราคาประเมินจะอ้างอิงจากชิ้นส่วนที่ยังสามารถใช้งานได้'
				}
			},
			{
				'@type': 'Question',
				name: 'จำเป็นต้องมีกล่องและอุปกรณ์แท้ครบไหม?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'ไม่จำเป็นครับ คุณสามารถขายเครื่องเปล่าๆ ให้เราได้เลย แต่หากคุณมีอุปกรณ์เสริมแท้ครบกล่อง ราคาที่คุณจะได้ก็จะสูงขึ้นตามไปด้วย'
				}
			},
			{
				'@type': 'Question',
				name: 'ถ้าประเมินราคาหน้างานแล้วไม่พอใจ ยกเลิกได้ไหม?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'ยกเลิกได้ตามที่แจ้ง ครับ เรายึดมั่นในความสบายใจของลูกค้าเป็นหลัก หากทีมงานไปตรวจเครื่องแล้วราคาปรับลดลง และคุณรู้สึกว่ายังไม่อยากขาย สามารถปฏิเสธการขายได้สะดวก โดยไม่มีค่าใช้จ่ายหรือข้อผูกมัดใดๆ'
				}
			},
			{
				'@type': 'Question',
				name: 'การโอนเงินใช้เวลานานแค่ไหน?',
				acceptedAnswer: {
					'@type': 'Answer',
					text: 'หลังจากตรวจเครื่องเสร็จและคุณตกลงขาย เราจะทำการโอนเงินผ่านระบบ Mobile Banking ทันทีแบบ Real-time คุณสามารถตรวจสอบยอดเงินเข้าบัญชีได้สะดวกก่อนส่งมอบเครื่อง'
				}
			}
		]
	}
];

const preSaleLinks = [
	{
		href: '/เช็กราคาก่อนขาย/',
		title: 'เตรียมข้อมูลเช็กราคาก่อนขาย',
		desc: 'รายการข้อมูลและรูปที่ควรส่งก่อนทัก Line',
	},
	{
		href: '/ราคากลางรับซื้อ/',
		title: 'แนวราคากลางรับซื้อไอทีมือสอง',
		desc: 'ปัจจัยราคาตามหมวดสินค้า ไม่ใส่ตัวเลขมั่ว',
	},
	{
		href: '/ความน่าเชื่อถือ/',
		title: 'ศูนย์ความน่าเชื่อถือ WE BUY',
		desc: 'ขั้นตอนซื้อขายโปร่งใสและความปลอดภัยข้อมูล',
	},
];

const mainMoneyPages = [
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อ iPhone มือสอง', desc: 'ทุกรุ่น ประเมินตามสภาพจริง' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊คมือสอง', desc: 'โน้ตบุ๊คทุกยี่ห้อและสเปก' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook มือสอง', desc: 'Air / Pro ชิป Intel และ M-series' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมมือสอง', desc: 'PC ประกอบและแบรนด์เนม' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้องมือสอง', desc: 'DSLR Mirrorless และเลนส์' },
];

const categories = [
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊ค', desc: 'รับซื้อ Laptop ทุกยี่ห้อ ทั้งสายทำงาน และ Notebook เกมมิ่งแรง ๆ' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์', desc: 'PC แบรนด์เนม, All-in-One และคอมสำนักงาน' },
	{ href: '/รับซื้อคอมประกอบ/', title: 'รับซื้อคอมประกอบ', desc: 'Custom PC, Gaming PC, การ์ดจอ และอะไหล่แยกชิ้น' },
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อไอโฟน', desc: 'iPhone ทุกรุ่น ตั้งแต่รุ่นเก่าจนถึงรุ่นล่าสุด ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อไอแพด/', title: 'รับซื้อไอแพด', desc: 'iPad Pro, Air, mini และ iPad Gen ทุกรุ่น ทั้งแบบ Wi-Fi และใส่ซิม' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook', desc: 'MacBook Air / Pro ชิป Intel และ M-series — ประเมินตามสเปกและสภาพ' },
	{ href: '/รับซื้อสมาร์ทโฟน-android/', title: 'รับซื้อสมาร์ทโฟน Android', desc: 'Samsung S/Z Series, ROG Phone และรุ่นเรือธงทุกค่าย' },
	{ href: '/รับซื้อ-apple-watch/', title: 'รับซื้อ Apple Watch', desc: 'Series ล่าสุด, Ultra, SE ประเมินตามสภาพและสุขภาพแบต' },
	{ href: '/รับซื้อเครื่องเกม/', title: 'รับซื้อเครื่องเกม', desc: 'PS5, Nintendo Switch, Steam Deck รับซื้อพร้อมแผ่นเกมและจอย' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้อง', desc: 'DSLR, Mirrorless, เลนส์ และอุปกรณ์ถ่ายภาพทุกประเภท' },
	{ href: '/รับซื้อลำโพง/', title: 'รับซื้อลำโพง', desc: 'Marshall, JBL และลำโพงบลูทูธแบรนด์เนมของแท้เท่านั้น' },
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อไอทีมือสอง | โน้ตบุ๊ค คอม ไอโฟน')}
	description="WE BUY ศูนย์รับซื้อสินค้าไอทีมือสองครบวงจร รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง ลำโพง ประเมินราคาโปร่งใส ตรวจรับและชำระเงินหลังยืนยันสภาพ ติดต่อ Line @webuy 24 ชม."
	pathname="/รับซื้อ/"
	jsonLd={jsonLd}
>
	<div class="container page">
		<header class="head">
			<p class="tech-eyebrow">WE BUY • Buyback Categories</p>
			<h1 class="tech-h2">บริการรับซื้อสินค้าไอทีมือสอง ครบทุกหมวด — ประเมินตามสภาพจริง</h1>
			<p class="lead">
				<strong>รับซื้อสินค้าไอทีมือสอง</strong> หลายหมวด — ส่งรูป รุ่น สเปก และสภาพเครื่องทาง LINE @webuy 
				เพื่อรับราคาประเมินเบื้องต้นก่อนตกลงขาย ตรวจรับและยืนยันสภาพก่อนชำระเงิน
			</p>
		</header>

		<ServiceCategoryGrid />

		<section class="sales-content prose" style="max-width: 100%;">
			
			<SafeProcessBar className="mb-12 mt-8" />
			<h2>ทำไมถึงควรขายสินค้าไอทีมือสองกับเรา</h2>
			<p>เมื่อคุณมีความคิดที่จะขายอุปกรณ์ไอทีมือสอง ไม่ว่าจะเป็นโน้ตบุ๊ค คอมพิวเตอร์ สมาร์ทโฟน หรือกล้องถ่ายรูป การมองหาศูนย์รับซื้อที่ไว้ใจได้คือสิ่งสำคัญมาก เราเข้าใจดีว่าอุปกรณ์ทุกชิ้นมีมูลค่าและมีความทรงจำของคุณอยู่ ดังนั้นเราจึงออกแบบบริการรับซื้อสินค้าไอทีมือสองให้ตอบโจทย์ผู้ขายมาก โดยเน้นไปที่ความรวดเร็ว ความปลอดภัย และราคาที่ยุติธรรมที่สุดในตลาด</p>
			
			<h3>ประเมินราคาโปร่งใส ไม่กดราคาหน้างาน</h3>
			<p>ปัญหาใหญ่ของการขายเครื่องมือสองคือการถูกกดราคาเมื่อไปถึงหน้างาน เราลบปัญหานั้นออกไปโดยสิ้นเชิงด้วยระบบการประเมินราคาออนไลน์ที่แม่นยำ เพียงคุณส่งรูปถ่ายที่ชัดเจน แจ้งตำหนิตามจริง และบอกสเปกเครื่องอย่างครบถ้วน ทีมงานของเราจะทำการเช็คราคาตลาด ณ วันนั้น และเสนอราคาตามสภาพตลาดให้คุณทันที หากเครื่องจริงที่คุณส่งมอบมีสภาพตรงตามที่คุยไว้ รับประกันได้เลยว่าคุณจะได้รับยอดเงินตามนั้นเป๊ะๆ ไม่มีหักค่าใช้จ่ายจุกจิกแอบแฝง</p>

			<h3>รับเงินสดหรือโอนเข้าบัญชีทันที</h3>
			<p>เวลาคือเงินคือทอง เราจึงจัดการทุกขั้นตอนให้รวดเร็วที่สุด เมื่อเราตรวจเช็คเครื่องเสร็จสิ้นและยืนยันสภาพว่าตรงตามที่ตกลงกัน เราพร้อมโอนเงินเข้าบัญชีธนาคารของคุณทันที หรือหากคุณสะดวกรับเป็นเงินสด เราก็พร้อมจ่ายหน้างานแบบเต็มจำนวน ไม่ต้องรอรอบโอน ไม่ต้องรอคิว ทำให้คุณสามารถนำเงินไปหมุนเวียนหรือใช้จ่ายต่อยอดสิ่งอื่นได้สะดวก</p>

			<h4>บริการรับ-ส่งถึงที่ สะดวกสบาย ไม่ต้องเดินทาง</h4>
			<p>หากคุณอยู่ในพื้นที่ให้บริการหลักของเรา คุณไม่จำเป็นต้องเดินทางมาหาเราเลย เรามีทีมงานมืออาชีพพร้อมวิ่งไปรับเครื่องถึงหน้าบ้าน หรือที่ทำงานของคุณตามที่คุณสะดวก ช่วยประหยัดเวลาและค่าเดินทางของคุณไปได้มาก สำหรับลูกค้าที่อยู่ต่างจังหวัด เราก็มีระบบรับซื้อผ่านการส่งพัสดุที่ปลอดภัยและตรวจสอบได้ทุกขั้นตอน</p>

			<h5>ประสบการณ์ยาวนาน ไว้ใจได้มากขึ้น</h5>
			<p>ด้วยประสบการณ์ในวงการไอทีมือสองมาอย่างยาวนาน ทำให้เราเข้าใจตลาดและเข้าใจความต้องการของลูกค้าเป็นอย่างดี เราจดทะเบียนและมีตัวตนชัดเจน ลูกค้าหลายพันรายให้ความไว้วางใจและกลับมาใช้บริการกับเราอย่างต่อเนื่อง ความซื่อสัตย์คือหัวใจหลักในการทำธุรกิจของเรา</p>


			<h2>เรารับซื้ออุปกรณ์ไอทีรุ่นไหนบ้าง และประเมินราคาจากอะไร</h2>
			<p>เราเปิดรับซื้ออุปกรณ์ไอทีครอบคลุมเกือบทุกประเภท ไม่จำกัดแค่แบรนด์ใดแบรนด์หนึ่ง เพื่อให้เราเป็นศูนย์รวมแบบ One-Stop Service สำหรับลูกค้าที่ต้องการเปลี่ยนอุปกรณ์ไอทีเป็นเงินทุน</p>

			<h3>หมวดหมู่สินค้าหลักที่เรารับซื้อ</h3>
			<p>เราพร้อมรับซื้ออุปกรณ์หลากหลายประเภท โดยมีจุดเด่นในกลุ่มสินค้าต่อไปนี้:</p>
			
			<h3>ประเมินราคาตามสเปกและสภาพจริง</h3>
			<p>เรามุ่งมั่นเสนอราคาประเมินเบื้องต้นที่สอดคล้องกับคุณสมบัติของตัวเครื่องจริง เพียงส่งรูปภาพ รายละเอียดรุ่น ตำหนิ และอาการเสีย (ถ้ามี) ผ่านทาง LINE ทีมงานจะเช็คราคาตลาดและประเมินราคากลางเบื้องต้นให้ทราบก่อนตกลงทำดีล เพื่อความโปร่งใสและตรวจสอบได้</p>

			<h3>ตรวจสอบและชำระเงินเมื่อตกลงขาย</h3>
			<p>เมื่อตรวจรับอุปกรณ์และยืนยันสภาพจริงเสร็จสิ้น เราจะดำเนินการชำระเงินหลังยืนยันสภาพตามช่องทางบัญชีธนาคารหรือข้อตกลงที่ตกลงกันไว้ล่วงหน้า ช่วยลดขั้นตอนความล่าช้าในการทำธุรกรรม</p>

			<h4>บริการจุดนัดรับในพื้นที่หลัก</h4>
			<p>หากคุณอยู่ในพื้นที่ให้บริการหลักของเรา คุณสามารถนัดหมายจุดนัดรับสำคัญเพื่อตรวจสอบเครื่องหน้างานอย่างรวดเร็ว สำหรับกรณีต่างจังหวัด สามารถส่งรูปตัวเครื่องและสเปกเพื่อประเมินเบื้องต้น และตกลงจัดส่งพัสดุตามขั้นตอนความปลอดภัยทางบัญชีได้</p>

			<h2>การประเมินราคาสินค้าแต่ละหมวดหมู่อ้างอิงจากอะไรบ้าง</h2>
			<p>เรามีการประเมินที่เป็นระบบตามประเภทสินค้า โดยครอบคลุมปัจจัยสำคัญที่มีผลต่อราคากลางมือสองดังนี้:</p>

			<h3>ปัจจัยหลักที่มีผลต่อราคาประเมิน</h3>
			
			<h5>สภาพภายนอกและรอยตำหนิ</h5>
			<p>เครื่องที่ไม่มีรอยบุบ รอยบิ่น หรือคราบฝังลึกจะมีมูลค่าที่ดีกว่าเนื่องจากมีโอกาสนำไปดูแลต่อได้ง่าย การรักษาสภาพเครื่องตั้งแต่แรกเริ่มใช้งานจึงมีส่วนสำคัญอย่างยิ่ง</p>

			<h5>อุปกรณ์แท้และกล่อง</h5>
			<p>การมีอุปกรณ์แท้ดั้งเดิมครบถ้วน เช่น อแดปเตอร์ชาร์จ สายเคเบิล และกล่องบรรจุภัณฑ์เดิม จะช่วยให้ได้ช่วงราคาที่ตรงตามโครงสร้างราคาเต็มของตลาดมือสอง</p>

			<h5>สุขภาพแบตเตอรี่ (Battery Health)</h5>
			<p>สำหรับอุปกรณ์พกพา เช่น iPhone, iPad, MacBook สุขภาพแบตเตอรี่และรอบการชาร์จ (Cycle Count) จะมีผลต่อราคาประเมินโดยตรง เนื่องจากบ่งบอกอายุการเสื่อมของชิ้นส่วนเคมีภายใน</p>

			<h5>การรับประกันของศูนย์</h5>
			<p>เครื่องที่ยังมีประกันศูนย์เหลืออยู่ หรือมีแพ็คเกจคุ้มครองพิเศษ จะได้รับการพิจารณาเพิ่มมูลค่าขึ้นตามระยะเวลาประกันที่เหลือจริง</p>
			
			<ComparisonTable />
			<StepCards />
			
			<h2>ข้อแนะนำก่อนส่งประเมินสินค้า</h2>
			<p>เพื่อช่วยให้ประเมินราคาได้อย่างรวดเร็วและถูกต้องตรงตามความจริง แนะนำให้เตรียมข้อมูลเบื้องต้นดังต่อไปนี้:</p>

			<h3>เช็ครายละเอียดระบบเบื้องต้น</h3>
			<p>ตรวจสอบการใช้งานพื้นฐานของระบบ เช่น การแสดงผลหน้าจอ (เช็ค Dead Pixel/แสงรั่ว), ลำโพง, กล้องหน้า-หลัง, การเชื่อมต่อสัญญาณ Wi-Fi และเซนเซอร์สแกนนิ้วหรือใบหน้า</p>

			<h3>เตรียมข้อมูลและภาพถ่ายตัวเครื่อง</h3>
			<p>ถ่ายภาพตัวเครื่องจริงในบริเวณที่มีแสงสว่างชัดเจนให้เห็นทุกมุม ทั้งด้านหน้า ด้านหลัง ขอบเครื่อง และเน้นจุดที่เป็นรอยตำหนิอย่างชัดเจน พร้อมแจ้งสเปก CPU, RAM, ความจุพื้นที่เก็บข้อมูล (Storage) ให้แอดมินทาง LINE</p>
			
			<DataPrivacyBlock />
			<h2>พื้นที่ให้บริการรับซื้อสินค้าไอทีและช่องทางการส่งมอบ</h2>
			<p>เราต้องการให้การขายอุปกรณ์ไอทีของคุณเป็นเรื่องง่าย เราจึงจัดเตรียมพื้นที่ให้บริการและช่องทางการส่งมอบที่ครอบคลุมและยืดหยุ่น เพื่อตอบสนองความต้องการของลูกค้าในทุกพื้นที่ทั่วประเทศไทย</p>

			<h3>ศูนย์รับซื้อหลักและจุดนัดรับ</h3>
			<p>เรามีฐานการให้บริการที่แข็งแกร่งในพื้นที่ยุทธศาสตร์สำคัญ เพื่อให้ลูกค้าสามารถนำเครื่องมาตรวจเช็คและรับเงินได้สะดวก</p>

			<h4>กรุงเทพมหานครและปริมณฑล</h4>
			<p>สำหรับลูกค้าในเขตกรุงเทพฯ และพื้นที่ใกล้เคียง เราครอบคลุมการให้บริการแบบทั่วถึง คุณสามารถนัดหมายให้ทีมงานแมสเซนเจอร์ของเราวิ่งเข้าไปตรวจสอบเครื่องถึงหน้าบ้าน หรือนัดเจอตามจุด Landmark สำคัญ หรือสถานีรถไฟฟ้า BTS/MRT เพื่อความสะดวกในการเดินทางของคุณ</p>

			<h4>อุบลราชธานีและโซนภาคอีสาน</h4>
			<p>เรามีศูนย์กลางการให้บริการขนาดใหญ่ในจังหวัดอุบลราชธานี ซึ่งเป็น Hub หลักในการดูแลลูกค้าโซนภาคตะวันออกเฉียงเหนือ ลูกค้าในอุบลฯ สามารถเข้ามาหน้าร้าน หรือนัดรับในตัวเมืองได้รวดเร็วทันใจ นอกจากนี้เรายังมีเครือข่ายจุดนัดรับในจังหวัดใกล้เคียง เช่น ขอนแก่น, นครราชสีมา (โคราช), และอุดรธานี อีกด้วย</p>

			<h3>ช่องทางการจัดส่งพัสดุสำหรับลูกค้าต่างจังหวัด</h3>
			<p>หากคุณไม่ได้อยู่ในพื้นที่นัดรับหลักของเรา ก็ไม่ต้องกังวลไป เรามีระบบการรับซื้อผ่านการส่งพัสดุที่ออกแบบมาอย่างรัดกุมและปลอดภัย:</p>
			
			<h5>ขั้นตอนการส่งพัสดุ</h5>
			<p>หลังจากตกลงราคาประเมินเบื้องต้นแล้ว คุณสามารถแพ็คสินค้าอย่างแน่นหนาและจัดส่งผ่านขนส่งชั้นนำ (เช่น Kerry, Flash, J&T, หรือ ไปรษณีย์ไทย) เมื่อพัสดุมาถึง เราจะทำการอัดคลิปวิดีโอตั้งแต่การแกะกล่อง ไปจนถึงการตรวจเช็คเครื่อง เพื่อความอย่างโปร่งใส และเมื่อเครื่องตรงตามสภาพที่ตกลงกันไว้ เราจะชำระเงินหลังยืนยันสภาพในวันเดียวกัน</p>

			<h3>นัดรับในเขตกรุงเทพฯ ปริมณฑล และสาขาหลัก</h3>
			<p>ลูกค้าสามารถนัดหมายเวลากับทีมงานล่วงหน้าในจุดบริการที่กำหนด เพื่อให้ตรวจรับสภาพสินค้าได้อย่างละเอียดและตกลงยืนยันราคาประเมินได้อย่างโปร่งใส</p>

			<h3>ระบบรับซื้อผ่านพัสดุสำหรับต่างจังหวัด</h3>
			<p>สำหรับลูกค้าต่างจังหวัด สามารถประสานงานประเมินราคาเบื้องต้น และดำเนินการส่งพัสดุผ่านขนส่งชั้นนำ เมื่อพัสดุมาถึงจะมีการถ่ายวิดีโอยืนยันขั้นตอนการเปิดกล่องตรวจสภาพเครื่อง เพื่อความอย่างครบถ้วน แก่ผู้ใช้บริการ</p>

			<h2>คำถามที่พบบ่อยเกี่ยวกับการขายสินค้าไอที</h2>
			<p>เพื่อให้คุณคลายข้อสงสัยและมีความมั่นใจก่อนทำการซื้อขายกับเรา เรารวบรวมคำถามสุดฮิตที่ลูกค้ามักจะสอบถามเข้ามาเป็นประจำ มาตอบให้เคลียร์กันตรงนี้เลย</p>

			<h3>เครื่องติดล็อค iCloud หรือติดสัญญาเครือข่าย รับซื้อไหม?</h3>
			<p>เรารับซื้อเครื่องในหลากหลายสภาพ แต่มีเงื่อนไขสำคัญคือ สำหรับเครื่อง Apple ต้องสามารถ Log out ออกจาก iCloud หรือ Apple ID ได้สมบูรณ์ก่อนส่งมอบ หากเครื่องติดล็อคขโมยมา เราขอสงวนสิทธิ์ไม่รับซื้อในทุกกรณี ส่วนเครื่องที่ติดสัญญาเครือข่าย (เครื่องติดโปรทรู, เอไอเอส, ดีแทค) เรารับพิจารณาเป็นเคสๆ ไป โดยราคาประเมินจะลดลงตามเงื่อนไขของตลาด</p>

			<h3>เครื่องพัง หน้าจอแตก เปิดไม่ติด รับซื้อหรือไม่?</h3>
			<p>รับซื้อครับ! เราเข้าใจว่าอุบัติเหตุเกิดขึ้นได้ เครื่องที่หน้าจอแตก, แบตเตอรี่เสื่อมจัด, หรือแม้กระทั่งเปิดไม่ติด (บอร์ดเสีย) เราก็รับซื้อเพื่อนำไปเป็นอะไหล่ แต่ราคาประเมินจะอ้างอิงจากชิ้นส่วนที่ยังสามารถใช้งานได้ แนะนำให้แจ้งอาการเสียอย่างละเอียดเพื่อให้เราตีราคาได้อย่างถูกต้อง</p>

			<h4>จำเป็นต้องมีกล่องและอุปกรณ์แท้ครบไหม?</h4>
			<p>ไม่จำเป็นครับ คุณสามารถขายเครื่องเปล่าๆ ให้เราได้เลย แต่ดังที่กล่าวไปแล้วว่า หากคุณมีอุปกรณ์เสริมแท้ครบกล่อง ราคาที่คุณจะได้ก็จะสูงขึ้นตามไปด้วย หากมีสายชาร์จหรืออแดปเตอร์เทียบ (ของปลอม) รบกวนแจ้งล่วงหน้าด้วยครับ</p>

			<h4>ถ้าประเมินราคาหน้างานแล้วไม่พอใจ ยกเลิกได้ไหม?</h4>
			<p>ยกเลิกได้ครับ เรายึดมั่นในความสบายใจของลูกค้าเป็นหลัก หากทีมงานไปตรวจเครื่องแล้วพบตำหนิที่คุณอาจไม่ได้แจ้งล่วงหน้า ทำให้ราคาต้องปรับลดลง และคุณรู้สึกว่ายังไม่อยากขายในราคานั้น คุณสามารถปฏิเสธการขายได้ โดยไม่มีค่าใช้จ่ายหรือข้อผูกมัดใดๆ ทั้งสิ้น</p>

			<h5>การโอนเงินใช้เวลานานแค่ไหน?</h5>
			<p>หลังตรวจรับและยืนยันสภาพครบถ้วน หากคุณตกลงขาย เราจะชำระเงินตามช่องทางที่แจ้งไว้ล่วงหน้า คุณสามารถตรวจสอบยอดเงินเข้าบัญชีก่อนส่งมอบเครื่องได้</p>


			<h2>สัญญาณเตือนว่าถึงเวลาที่ควรเปลี่ยนและขายเครื่องเก่าของคุณแล้ว</h2>
			<p>หลายคนมักลังเลว่าจะเก็บอุปกรณ์ไอทีเครื่องเก่าไว้ใช้งานต่อ หรือจะตัดใจขายทิ้งดี การเก็บไว้นานเกินไปมักจะทำให้มูลค่าของเครื่องลดลงอย่างรวดเร็ว (Depreciation) นี่คือสัญญาณสำคัญที่บอกว่า คุณควรนำเครื่องมาขายเปลี่ยนเป็นเงินสดกับเราได้แล้ว</p>

			<h3>เครื่องทำงานช้าลงอย่างเห็นได้ชัด</h3>
			<p>เมื่อซอฟต์แวร์และแอปพลิเคชันเวอร์ชันใหม่ๆ ต้องการทรัพยากรเครื่องที่สูงขึ้น หากโทรศัพท์หรือโน้ตบุ๊คของคุณเริ่มมีอาการค้าง โหลดแอปช้า หรือกระตุกเวลาเล่นเกม นั่นเป็นสัญญาณแรกที่บ่งบอกว่าฮาร์ดแวร์ของคุณเริ่มตามเทคโนโลยีปัจจุบันไม่ทันแล้ว การทนใช้ต่อไปอาจทำให้เสียสุขภาพจิต การขายแล้วนำเงินไปสมทบทุนซื้อรุ่นใหม่จึงเป็นทางออกที่ดีที่สุด</p>

			<h3>แบตเตอรี่เสื่อมสภาพ เก็บไฟไม่อยู่</h3>
			<p>หากคุณต้องพกพาวเวอร์แบงค์ติดตัวตลอดเวลา หรือต้องเสียบสายชาร์จโน้ตบุ๊คตลอดเวลาที่ใช้งาน แสดงว่าแบตเตอรี่ของคุณเสื่อมสภาพอย่างหนัก ค่าใช้จ่ายในการเปลี่ยนแบตเตอรี่แท้อาจสูงเกินไปเมื่อเทียบกับมูลค่าเครื่องที่เหลืออยู่ การขายเครื่องในสภาพปัจจุบันให้ศูนย์รับซื้อที่ตีราคาให้เป็นธรรม อาจคุ้มค่ากว่าการซ่อมบำรุงเอง</p>

			<h4>ไม่ได้รับการอัปเดตระบบปฏิบัติการอีกต่อไป</h4>
			<p>แบรนด์ผู้ผลิตมักจะหยุดปล่อยอัปเดตซอฟต์แวร์ (OS Update) ให้กับอุปกรณ์ที่มีอายุเกิน 4-5 ปี การใช้เครื่องที่ระบบปฏิบัติการล้าหลัง ไม่เพียงแต่จะทำให้ใช้งานแอปพลิเคชันใหม่ๆ ไม่ได้ แต่ยังเสี่ยงต่อช่องโหว่ด้านความปลอดภัย (Security Vulnerability) อีกด้วย หากเครื่องของคุณหยุดอยู่ที่ OS เวอร์ชันเก่า นี่คือช่วงเวลาสุดท้ายที่จะขายเพื่อให้ยังพอมีราคา</p>

			<h4>มีรุ่นใหม่ออกมา และรุ่นของคุณกำลังจะตกรุ่นหนัก</h4>
			<p>วัฏจักรสินค้าไอทีมักจะมีการเปิดตัวรุ่นใหม่ทุกๆ 1 ปี เมื่อรุ่นใหม่วางจำหน่าย ราคาของรุ่นเก่าในตลาดมือสองจะปรับตัวลดลงทันที หากคุณต้องการขายให้ได้ราคาแพงที่สุด ช่วงจังหวะที่ดีที่สุดคือก่อนที่รุ่นใหม่จะเปิดตัวอย่างเป็นทางการ 1-2 เดือน</p>
			
			<h3>เครื่องติดล็อก iCloud หรือ Find My รับซื้อหรือไม่?</h3>
			<p>เราไม่รับซื้อเครื่องที่ติดสถานะล็อกความปลอดภัยใด ๆ ลูกค้าจำเป็นต้องลงชื่อออกจากระบบ Apple ID, iCloud, หรือบัญชี Google ให้เรียบร้อยก่อนส่งมอบ ก่อนทำการส่งมอบสินค้า</p>

			<h3>เครื่องเสียหรือเปิดไม่ติดสามารถส่งมาประเมินได้ไหม?</h3>
			<p>เรายินดีรับพิจารณา โดยจะประเมินราคาตามสภาพชิ้นส่วนที่ยังสามารถนำไปใช้เป็นอะไหล่ได้จริง รบกวนแจ้งอาการเสียและรูปถ่ายโดยละเอียดเพื่อประเมินราคาเบื้องต้น</p>

			<h2>วิธีปกป้องข้อมูลส่วนตัวของคุณก่อนส่งมอบเครื่อง</h2>
			<p>เรื่องความปลอดภัยของข้อมูลส่วนตัวเป็นสิ่งที่ผู้ขายเครื่องมือสองทุกคนกังวลมาก ไม่ว่าจะเป็นรูปภาพ รหัสผ่าน หรือข้อมูลบัญชีธนาคาร เพื่อให้คุณขายเครื่องได้อย่างสบายใจแบบไร้กังวล เรามีคำแนะนำขั้นตอนการล้างข้อมูลอย่างถูกวิธีมาฝาก</p>

			<h3>หากราคาสรุปหน้างานไม่ตรงกับราคาคุยเบื้องต้น สามารถปฏิเสธได้ไหม?</h3>
			<p>ได้ครับ หากพบความต่างของสภาพที่ไม่ได้แจ้งไว้และมีความจำเป็นต้องปรับราคาประเมิน แต่ลูกค้าไม่ประสงค์จะดำเนินการต่อ สามารถปฏิเสธและยกเลิกข้อตกลงได้สะดวกโดยไม่มีเงื่อนไขผูกมัด</p>

			<h3>ออกจากระบบบัญชีทั้งหมด (Sign Out)</h3>
			<p>ขั้นตอนนี้สำคัญมากห้ามข้ามเด็ดขาด คุณต้องเข้าไปที่ตั้งค่าเพื่อลงชื่อออกจากระบบบัญชีหลัก:</p>
			<p>- <strong>สำหรับ Apple:</strong> ปิดการทำงานของ Find My iPhone และ Sign out ออกจาก Apple ID</p>
			<p>- <strong>สำหรับ Android:</strong> นำบัญชี Google Account (Gmail) ออกจากเครื่อง เพื่อป้องกันเครื่องติดล็อค FRP (Factory Reset Protection)</p>
			<p>- <strong>สำหรับ Windows/Mac:</strong> ลบแอคเคาท์ผู้ใช้ และลงชื่อออกจากบัญชี Microsoft หรือ Apple ID</p>

			<h4>ล้างข้อมูลและคืนค่าโรงงาน (Factory Reset)</h4>
			<p>หลังจากสำรองข้อมูลและออกจากบัญชีครบถ้วนแล้ว ให้ทำการรีเซ็ตเครื่องกลับคืนสู่การตั้งค่าดั้งเดิมจากโรงงาน (Erase All Content and Settings) ขั้นตอนนี้จะทำการลบไฟล์ แอปพลิเคชัน และรหัสผ่านทุกอย่างในเครื่องทิ้งอย่างถาวร เครื่องจะกลับไปอยู่ในสภาพหน้าจอเริ่มต้นเหมือนตอนซื้อมาใหม่ๆ</p>

			<h5>ถอดซิมการ์ดและเมมโมรี่การ์ดออก</h5>
			<p>นี่คือเรื่องตกม้าตายที่เกิดขึ้นบ่อยที่สุด! ลูกค้าหลายท่านล้างเครื่องเสร็จเรียบร้อย แต่ลืมถอดซิมการ์ดเบอร์ส่วนตัว หรือลืมถอด MicroSD Card ออกจากเครื่องก่อนส่งมอบ ตรวจสอบถาดใส่ซิมและช่องเสียบการ์ดให้ชัวร์อีกครั้งก่อนนำเครื่องใส่กล่องนะครับ</p>
			<p><em>หมายเหตุ: หากคุณไม่ชำนาญ หรือทำขั้นตอนไหนไม่เป็น ไม่ต้องตกใจไป ทีมงานของ WE BUY ยินดีช่วยแนะนำและจัดการล้างเครื่องต่อหน้าคุณอย่างหมดจดตามขั้นตอน รับรองว่าไม่มีข้อมูลใดๆ หลุดรอดไปได้แน่นอน</em></p>


			<h2>ช่องทางการติดต่อประเมินราคาฟรี ได้เงินไว</h2>
			<p>มาถึงตรงนี้ หากคุณพร้อมที่จะเปลี่ยนอุปกรณ์ไอทีที่ไม่ได้ใช้ เป็นยอดเงินสดเข้าบัญชีแล้ว อย่ารอช้า! ติดต่อทีมงาน WE BUY เข้ามาได้เลย เรามีช่องทางการสื่อสารที่รวดเร็ว พร้อมแอดมินคอยสแตนด์บายตอบแชทคุณตลอด 24 ชั่วโมง</p>

			<h3>ทักแชท LINE Official สะดวกและไวที่สุด</h3>
			<p>ช่องทางที่เรคคอมเมนด์ที่สุดคือการแอดไลน์บัญชีทางการของเรา พิมพ์ค้นหาไอดี <strong>@webuy</strong> (มีเครื่องหมาย @ ด้วยนะครับ) หรือคลิกที่ปุ่มแอดไลน์บนหน้าเว็บได้เลย ช่องทางนี้จะสะดวกมากในการส่งรูปถ่ายสเปกเครื่อง รูปตำหนิ และคุยรายละเอียดราคาได้อย่างชัดเจนที่สุด</p>

			<h3>โทรสายด่วน คุยรายละเอียดทันใจ</h3>
			<p>หากคุณมีข้อสงสัยเร่งด่วน ต้องการสอบถามเรื่องพื้นที่รับของ หรืออยากคุยรายละเอียดสเปกคอมพิวเตอร์แบบเจาะลึก สามารถโทรสายด่วนมาที่เบอร์ <strong>064-257-9353</strong> ทีมงานเราพร้อมรับสายด้วยความยินดี พูดคุยเป็นกันเอง ไม่ดุ ไม่กดดันครับ</p>

			<h4>เตรียมข้อมูลเหล่านี้ให้พร้อมก่อนทัก</h4>
