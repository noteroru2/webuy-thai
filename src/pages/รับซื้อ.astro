---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

import RecentTradesSlider from '../components/money-pages/RecentTradesSlider.astro';
import TrustBadges from '../components/money-pages/TrustBadges.astro';
import StepCards from '../components/money-pages/StepCards.astro';
import ComparisonTable from '../components/money-pages/ComparisonTable.astro';
import DataPrivacyBlock from '../components/money-pages/DataPrivacyBlock.astro';
import ProvincialGrid from '../components/money-pages/ProvincialGrid.astro';
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const websiteId = `${site}/#website`;
const pageUrl = `${site}/รับซื้อ/`;

const jsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'CollectionPage',
		'@id': `${pageUrl}#webpage`,
		name: 'รับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดี จ่ายเงินทันที',
		description: 'ศูนย์รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง และลำโพงแบรนด์เนมมือสอง ครบวงจร ประเมินราคาด่วน 24 ชม.',
		url: pageUrl,
		inLanguage: 'th-TH',
		isPartOf: { '@id': websiteId },
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'รับซื้อ', item: pageUrl },
		],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Service',
		name: 'บริการรับซื้อสินค้าไอทีมือสอง',
		description: 'รับซื้อโน้ตบุ๊ค, คอมพิวเตอร์, มือถือ และอุปกรณ์ไอทีทุกชนิด ให้ราคาสูง จ่ายเงินสดทันที',
		provider: { '@type': 'Organization', name: orgName },
		url: pageUrl,
	}
];

const preSaleLinks = [
	{
		href: '/เช็กราคาก่อนขาย/',
		title: 'เตรียมข้อมูลเช็กราคาก่อนขาย',
		desc: 'รายการข้อมูลและรูปที่ควรส่งก่อนทัก Line',
	},
	{
		href: '/ราคากลางรับซื้อ/',
		title: 'แนวราคากลางรับซื้อไอทีมือสอง',
		desc: 'ปัจจัยราคาตามหมวดสินค้า ไม่ใส่ตัวเลขมั่ว',
	},
	{
		href: '/ความน่าเชื่อถือ/',
		title: 'ศูนย์ความน่าเชื่อถือ WE BUY',
		desc: 'ขั้นตอนซื้อขายโปร่งใสและความปลอดภัยข้อมูล',
	},
];

const mainMoneyPages = [
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อ iPhone มือสอง', desc: 'ทุกรุ่น ประเมินตามสภาพจริง' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊คมือสอง', desc: 'โน้ตบุ๊คทุกยี่ห้อและสเปก' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook มือสอง', desc: 'Air / Pro ชิป Intel และ M-series' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมมือสอง', desc: 'PC ประกอบและแบรนด์เนม' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้องมือสอง', desc: 'DSLR Mirrorless และเลนส์' },
];

const categories = [
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊ค', desc: 'รับซื้อ Laptop ทุกยี่ห้อ ทั้งสายทำงาน และ Notebook เกมมิ่งแรง ๆ' },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์', desc: 'PC แบรนด์เนม, All-in-One และคอมสำนักงาน' },
	{ href: '/รับซื้อคอมประกอบ/', title: 'รับซื้อคอมประกอบ', desc: 'Custom PC, Gaming PC, การ์ดจอ และอะไหล่แยกชิ้น' },
	{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อไอโฟน', desc: 'iPhone ทุกรุ่น ตั้งแต่รุ่นเก่าจนถึงรุ่นล่าสุด ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อไอแพด/', title: 'รับซื้อไอแพด', desc: 'iPad Pro, Air, mini และ iPad Gen ทุกรุ่น ทั้งแบบ Wi-Fi และใส่ซิม' },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook', desc: 'MacBook Air / Pro ทั้งชิป Intel และตระกูล M1-M5 ให้ราคาสูง' },
	{ href: '/รับซื้อสมาร์ทโฟน-android/', title: 'รับซื้อสมาร์ทโฟน Android', desc: 'Samsung S/Z Series, ROG Phone และรุ่นเรือธงทุกค่าย' },
	{ href: '/รับซื้อ-apple-watch/', title: 'รับซื้อ Apple Watch', desc: 'Series ล่าสุด, Ultra, SE รับซื้อทุกสภาพ ประเมินตามสุขภาพแบต' },
	{ href: '/รับซื้อเครื่องเกม/', title: 'รับซื้อเครื่องเกม', desc: 'PS5, Nintendo Switch, Steam Deck รับซื้อพร้อมแผ่นเกมและจอย' },
	{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้อง', desc: 'DSLR, Mirrorless, เลนส์ และอุปกรณ์ถ่ายภาพทุกประเภท' },
	{ href: '/รับซื้อลำโพง/', title: 'รับซื้อลำโพง', desc: 'Marshall, JBL และลำโพงบลูทูธแบรนด์เนมของแท้เท่านั้น' },
];
---

<BaseLayout
	title={formatPageTitle('รับซื้อไอทีมือสอง | โน้ตบุ๊ค คอม ไอโฟน')}
	description="WE BUY ศูนย์รับซื้อสินค้าไอทีมือสองครบวงจร รับซื้อโน้ตบุ๊ค คอมพิวเตอร์ ไอโฟน ไอแพด กล้อง ลำโพง ประเมินราคาโปร่งใส จ่ายเงินสดทันที ติดต่อ Line @webuy 24 ชม."
	pathname="/รับซื้อ/"
	jsonLd={jsonLd}
>
	<div class="container page">
		<header class="head">
			<p class="tech-eyebrow">WE BUY • Buyback Categories</p>
			<h1 class="tech-h2">บริการรับซื้อสินค้าไอทีมือสอง ทุกประเภท ราคาดีที่สุด จ่ายเงินสดทันที</h1>
			<p class="lead">
				เราคือผู้เชี่ยวชาญในการ <strong>รับซื้อสินค้าไอทีมือสอง</strong> ที่เน้นความโปร่งใสและยุติธรรมที่สุด 
				ไม่ว่าคุณจะมีเครื่องสภาพสวยเหมือนใหม่ หรือเครื่องที่มีตำหนิจากการใช้งาน 
				ทีมงานของเราพร้อมประเมินราคาให้คุณตามมูลค่าตลาดจริง ติดต่อเราง่าย จบไว ได้เงินชัวร์
			</p>
		</header>

		<section class="sales-content prose" style="max-width: 100%;">
			
			<TrustBadges className="mb-12 mt-8" />
			<RecentTradesSlider />
			<h2>ทำไมถึงควรขายสินค้าไอทีมือสองกับเรา</h2>
			<p>เมื่อคุณมีความคิดที่จะขายอุปกรณ์ไอทีมือสอง ไม่ว่าจะเป็นโน้ตบุ๊ค คอมพิวเตอร์ สมาร์ทโฟน หรือกล้องถ่ายรูป การมองหาศูนย์รับซื้อที่ไว้ใจได้คือสิ่งสำคัญที่สุด เราเข้าใจดีว่าอุปกรณ์ทุกชิ้นมีมูลค่าและมีความทรงจำของคุณอยู่ ดังนั้นเราจึงออกแบบบริการรับซื้อสินค้าไอทีมือสองให้ตอบโจทย์ผู้ขายมากที่สุด โดยเน้นไปที่ความรวดเร็ว ความปลอดภัย และราคาที่ยุติธรรมที่สุดในตลาด</p>
			
			<h3>ประเมินราคาโปร่งใส ไม่กดราคาหน้างาน</h3>
			<p>ปัญหาใหญ่ของการขายเครื่องมือสองคือการถูกกดราคาเมื่อไปถึงหน้างาน เราลบปัญหานั้นออกไปโดยสิ้นเชิงด้วยระบบการประเมินราคาออนไลน์ที่แม่นยำ เพียงคุณส่งรูปถ่ายที่ชัดเจน แจ้งตำหนิตามจริง และบอกสเปกเครื่องอย่างครบถ้วน ทีมงานของเราจะทำการเช็คราคาตลาด ณ วันนั้น และเสนอราคาที่ดีที่สุดให้คุณทันที หากเครื่องจริงที่คุณส่งมอบมีสภาพตรงตามที่คุยไว้ รับประกันได้เลยว่าคุณจะได้รับยอดเงินตามนั้นเป๊ะๆ ไม่มีหักค่าใช้จ่ายจุกจิกแอบแฝง</p>

			<h3>รับเงินสดหรือโอนเข้าบัญชีทันที</h3>
			<p>เวลาคือเงินคือทอง เราจึงจัดการทุกขั้นตอนให้รวดเร็วที่สุด เมื่อเราตรวจเช็คเครื่องเสร็จสิ้นและยืนยันสภาพว่าตรงตามที่ตกลงกัน เราพร้อมโอนเงินเข้าบัญชีธนาคารของคุณทันที หรือหากคุณสะดวกรับเป็นเงินสด เราก็พร้อมจ่ายหน้างานแบบเต็มจำนวน ไม่ต้องรอรอบโอน ไม่ต้องรอคิว ทำให้คุณสามารถนำเงินไปหมุนเวียนหรือใช้จ่ายต่อยอดสิ่งอื่นได้ทันที</p>

			<h4>บริการรับ-ส่งถึงที่ สะดวกสบาย ไม่ต้องเดินทาง</h4>
			<p>หากคุณอยู่ในพื้นที่ให้บริการหลักของเรา คุณไม่จำเป็นต้องเดินทางมาหาเราเลย เรามีทีมงานมืออาชีพพร้อมวิ่งไปรับเครื่องถึงหน้าบ้าน หรือที่ทำงานของคุณตามที่คุณสะดวก ช่วยประหยัดเวลาและค่าเดินทางของคุณไปได้มาก สำหรับลูกค้าที่อยู่ต่างจังหวัด เราก็มีระบบรับซื้อผ่านการส่งพัสดุที่ปลอดภัยและตรวจสอบได้ทุกขั้นตอน</p>

			<h5>ประสบการณ์ยาวนาน ไว้ใจได้ 100%</h5>
			<p>ด้วยประสบการณ์ในวงการไอทีมือสองมาอย่างยาวนาน ทำให้เราเข้าใจตลาดและเข้าใจความต้องการของลูกค้าเป็นอย่างดี เราจดทะเบียนและมีตัวตนชัดเจน ลูกค้าหลายพันรายให้ความไว้วางใจและกลับมาใช้บริการกับเราอย่างต่อเนื่อง ความซื่อสัตย์คือหัวใจหลักในการทำธุรกิจของเรา</p>


			<h2>เรารับซื้ออุปกรณ์ไอทีรุ่นไหนบ้าง และประเมินราคาจากอะไร</h2>
			<p>เราเปิดรับซื้ออุปกรณ์ไอทีครอบคลุมเกือบทุกประเภท ไม่จำกัดแค่แบรนด์ใดแบรนด์หนึ่ง เพื่อให้เราเป็นศูนย์รวมแบบ One-Stop Service สำหรับลูกค้าที่ต้องการเปลี่ยนอุปกรณ์ไอทีเป็นเงินทุน</p>

			<h3>หมวดหมู่สินค้าหลักที่เรารับซื้อ</h3>
			<p>เราพร้อมรับซื้ออุปกรณ์หลากหลายประเภท โดยมีจุดเด่นในกลุ่มสินค้าต่อไปนี้:</p>
			
			<h4>รับซื้อสมาร์ทโฟนและแท็บเล็ต (iPhone, iPad, Android)</h4>
			<p>เรารับซื้อโทรศัพท์มือถือทุกแบรนด์ชั้นนำ โดยเฉพาะกลุ่ม Apple อย่าง iPhone และ iPad ทุกรุ่นย่อย ตั้งแต่รุ่นธรรมดา, Pro, Pro Max ไปจนถึง iPad Air และ iPad Mini รวมถึงฝั่ง Android ระดับเรือธง (Flagship) เช่น Samsung Galaxy S series, Z Fold, Z Flip, แบรนด์เกมมิ่งมิ่งโฟนต่างๆ เช่น ROG Phone เป็นต้น</p>

			<h4>รับซื้อคอมพิวเตอร์และโน้ตบุ๊ค (MacBook, PC, Gaming Laptop)</h4>
			<p>ตลาดคอมพิวเตอร์เป็นความเชี่ยวชาญพิเศษของเรา เรารับซื้อโน้ตบุ๊คทุกสเปก ตั้งแต่เครื่องใช้ทำงานทั่วไป โน้ตบุ๊คบางเบา ไปจนถึง Gaming Notebook สเปกแรงๆ สำหรับนักเล่นเกม รวมถึงตระกูล Apple เช่น MacBook Air, MacBook Pro, iMac ทั้งชิป Intel และตระกูล M-Series (M1, M2, M3, M4) และเรายังรับซื้อคอมพิวเตอร์ประกอบ (Custom PC) หรือแยกชิ้นอะไหล่ เช่น การ์ดจอ (VGA) จอคอมพิวเตอร์ อีกด้วย</p>

			<h4>รับซื้ออุปกรณ์ถ่ายภาพและเครื่องเสียง (กล้อง, เลนส์, ลำโพง)</h4>
			<p>สำหรับสายครีเอเตอร์ เรารับซื้อกล้อง DSLR, กล้อง Mirrorless จากแบรนด์ดังเช่น Sony, Canon, Nikon, Fujifilm รวมถึงเลนส์และอุปกรณ์เสริมต่างๆ นอกจากนี้เรายังรับซื้อลำโพงแบรนด์เนม เช่น Marshall, JBL, Harman Kardon ที่เป็นของแท้เท่านั้น</p>

			<h3>ปัจจัยสำคัญในการประเมินราคา</h3>
			<p>เรามีเกณฑ์การประเมินราคาที่ชัดเจนและเป็นมาตรฐาน เพื่อให้คุณได้รับข้อเสนอที่สมเหตุสมผลที่สุด:</p>
			
			<h5>สภาพภายนอกและรอยตำหนิ</h5>
			<p>ความสวยงามภายนอกมีผลอย่างมากต่อราคาขายต่อ เครื่องที่ไม่มีรอยบุบ รอยบิ่น หรือรอยขีดข่วนลึก จะได้ราคาที่สูงกว่าเครื่องที่มีตำหนิชัดเจน ดังนั้นการใส่เคสและติดฟิล์มกันรอยมาตลอดการใช้งาน จะช่วยรักษามูลค่าของเครื่องไว้ได้ดี</p>

			<h5>อุปกรณ์เสริมและกล่อง</h5>
			<p>เครื่องที่มีอุปกรณ์แท้ครบกล่อง (Full Box) เช่น สายชาร์จ อะแดปเตอร์ หูฟัง รวมถึงคู่มือ จะมีมูลค่าสูงกว่าเครื่องที่มีแต่ตัวเปล่า (Device only) เนื่องจากผู้ซื้อเครื่องมือสองส่วนใหญ่ต้องการอุปกรณ์ที่ครบถ้วนพร้อมใช้งาน</p>

			<h5>สุขภาพแบตเตอรี่ (Battery Health)</h5>
			<p>สำหรับอุปกรณ์พกพา เช่น iPhone, iPad, MacBook สุขภาพแบตเตอรี่คือตัวบ่งชี้อายุการใช้งานที่สำคัญ เครื่องที่มีสุขภาพแบตเตอรี่สูง (เช่น 85% ขึ้นไป) จะได้รับราคาประเมินที่ดีกว่าเครื่องที่แบตเตอรี่เสื่อมสภาพและต้องนำไปเปลี่ยนใหม่</p>

			<h5>ระยะเวลาการรับประกันที่เหลืออยู่</h5>
			<p>หากเครื่องของคุณยังมีประกันศูนย์เหลืออยู่ (Warranty) หรือมีประกันพิเศษอย่าง AppleCare+ จะช่วยเพิ่มมูลค่าการรับซื้อได้มาก เพราะเป็นการการันตีความอุ่นใจให้กับผู้ใช้งานคนต่อไป</p>


			
