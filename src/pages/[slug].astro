---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import ContactBox from '../components/ContactBox.astro';
import TrustBar from '../components/TrustBar.astro';
import LegacyRedirect from '../components/LegacyRedirect.astro';
import ImportantLocalServiceSection from '../components/local/ImportantLocalServiceSection.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildArticleLongform } from '../lib/article-longform';
import {
	buildImportantLocalServiceJsonLd,
	getImportantLocalServiceContext,
} from '../lib/local-service-pages';
import { isIntentArticle } from '../lib/intent-articles';
import { getPublishedPosts } from '../lib/posts';
import { formatPageTitle, getSiteOrigin } from '../lib/site';
import '../styles/article-prose.css';

export async function getStaticPaths() {
	const posts = await getPublishedPosts({ includeNoindex: true });
	return posts.map((post) => {
		const recentPosts = posts
			.filter((p) => p.id !== post.id)
			.slice(0, 4)
			.map((p) => ({ slug: p.data.slug, title: p.data.title }));

		return {
			params: { slug: post.data.slug },
			props: { entryId: post.id, recentPosts },
		};
	});
}

const { entryId, recentPosts } = Astro.props;
const post = await getEntry('posts', entryId);

if (!post) {
	return Astro.redirect('/404/', 302);
}

const plainTitle = post.data.title;
const plainExcerpt = post.data.description;
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const orgLogo = import.meta.env.PUBLIC_ORG_LOGO_URL ?? '/favicon.svg';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const publishedIso = post.data.pubDate.toISOString();
const modifiedIso = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const featuredUrl = post.data.heroImage;
const titleHtml = post.data.titleHtml?.trim() || plainTitle;
const heroAlt = post.data.heroImageAlt ?? plainTitle;
const orgId = `${site}/#organization`;
const articlePath = `/${post.data.slug}/`;
const articleUrl = `${site}${articlePath}`;
const canonicalPath = post.data.canonical?.trim() || articlePath;
const canonicalUrl = `${site}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const shouldRedirectAlias = post.data.noindex === true && canonicalPath !== articlePath;
const encodedCanonicalPath = encodeURI(canonicalPath);
const articleLongform = buildArticleLongform(plainTitle, post.data.slug, canonicalPath);
const localServiceContext = getImportantLocalServiceContext(plainTitle, post.data.slug);
const showIntentHubLinks = isIntentArticle(post.data.slug);

// --- Phase 2: detect page intent type ---
const slug = post.data.slug;
const isTransactional = slug.startsWith('รับซื้อ') || slug.startsWith('รับประมูล');

function getHubInfo(s: string): { path: string; label: string } {
	if (/iphone|ไอโฟน/i.test(s)) return { path: '/รับซื้อไอโฟน/', label: 'รับซื้อไอโฟน' };
	if (/macbook|แมคบุ๊ค|imac|ไอแมค/i.test(s)) return { path: '/รับซื้อแมคบุ๊ค/', label: 'รับซื้อแมคบุ๊ค' };
	if (/ipad|ไอแพด/i.test(s)) return { path: '/รับซื้อไอแพด/', label: 'รับซื้อไอแพด' };
	if (/โน๊ตบุ๊ค|notebook/i.test(s)) return { path: '/รับซื้อโน๊ตบุ๊ค/', label: 'รับซื้อโน๊ตบุ๊ค' };
	if (/คอม|computer|desktop|pc\b/i.test(s)) return { path: '/รับซื้อคอม/', label: 'รับซื้อคอม' };
	if (/กล้อง|camera|cctv|projector/i.test(s)) return { path: '/รับซื้อกล้อง/', label: 'รับซื้อกล้อง' };
	if (/server|ups|network|switch|router|storage/i.test(s)) return { path: '/รับซื้อ-server/', label: 'รับซื้อ Server & IT' };
	if (/ลำโพง|speaker|airpods|homepod|apple.tv/i.test(s)) return { path: '/รับซื้อลำโพง/', label: 'รับซื้อลำโพง' };
	return { path: '/รับซื้อ/', label: 'รับซื้อทุกหมวด' };
}
const hub = getHubInfo(slug);

const renderedEntry = shouldRedirectAlias ? null : await render(post);
const Content = renderedEntry?.Content;
const headings = renderedEntry?.headings || [];

const tocHeadings = headings.filter((h) => h.depth === 2);
const hasToc = tocHeadings.length > 0;

const faqItemsData = post.data.faqItems;
const faqJsonLd: Array<Record<string, unknown>> =
	faqItemsData && faqItemsData.length > 0
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'FAQPage',
					'@id': `${articleUrl}#faq`,
					mainEntity: faqItemsData.map((item) => ({
						'@type': 'Question',
						name: item.question,
						acceptedAnswer: {
							'@type': 'Answer',
							text: item.answer,
						},
					})),
				},
			]
		: [];

const localServiceJsonLd = localServiceContext
	? buildImportantLocalServiceJsonLd(localServiceContext, {
			articleUrl,
			canonicalUrl,
			description: plainExcerpt || `บริการ ${plainTitle}`,
			orgId,
			orgName,
			businessPhone,
			featuredUrl,
		})
	: [];

// Phase 1: breadcrumb — transactional pages point to hub, not /blog/
const breadcrumbMiddle = isTransactional
	? { name: hub.label, item: `${site}${hub.path}` }
	: { name: 'บทความ', item: `${site}/blog/` };

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		'@id': `${articleUrl}#article`,
		headline: plainTitle,
		description: plainExcerpt || `${isTransactional ? 'บริการรับซื้อ' : 'บทความ'} ${plainTitle}`,
		url: articleUrl,
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': canonicalUrl,
		},
		isAccessibleForFree: true,
		inLanguage: 'th-TH',
		articleSection: isTransactional ? 'บริการรับซื้อ' : 'บทความ',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['.article .title', '.article .content'],
		},
		datePublished: publishedIso,
		dateModified: modifiedIso,
		author: {
			'@type': 'Organization',
			name: orgName,
			'@id': orgId,
		},
		publisher: {
			'@type': 'Organization',
			name: orgName,
			'@id': orgId,
			logo: {
				'@type': 'ImageObject',
				url: new URL(orgLogo, site).toString(),
			},
			sameAs: ['https://line.me/R/ti/p/@webuy'],
		},
		image: featuredUrl
			? [
					{
						'@type': 'ImageObject',
						url: featuredUrl,
						width: 1200,
						height: 675,
						caption: plainTitle,
					},
				]
			: undefined,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: breadcrumbMiddle.name, item: breadcrumbMiddle.item },
			{ '@type': 'ListItem', position: 3, name: plainTitle, item: articleUrl },
		],
	},
	...localServiceJsonLd,
	...faqJsonLd,
];
---

{
	shouldRedirectAlias ? (
		<LegacyRedirect
			to={encodedCanonicalPath}
			from={articlePath}
			title={plainTitle}
			description={plainExcerpt}
		/>
	) : (
		<BaseLayout
			title={formatPageTitle(plainTitle)}
			description={
				plainExcerpt ||
				(isTransactional
					? `WE BUY รับซื้อ ${plainTitle} มือสอง ประเมินฟรีใน 15 นาที จ่ายเงินสดทันที ทัก Line @webuy`
					: `เพิ่มความรู้ ${plainTitle} จาก ${orgName} — แกนหลักรับซื้อโน๊ตบุ๊คและรับซื้อคอม`)
			}
			pathname={articlePath}
			canonicalPath={canonicalPath}
			type="article"
			ogImage={featuredUrl}
			ogImageAlt={heroAlt}
			publishedTime={publishedIso}
			modifiedTime={modifiedIso}
			jsonLd={articleJsonLd}
			noindex={post.data.noindex === true}
		>
			{isTransactional ? (
				<div class="sell-page">
					{/* Dark Hero Banner */}
					<div class="sell-hero">
						<div class="sell-hero-inner">
							<nav class="sell-breadcrumb" aria-label="breadcrumb">
								<a href="/">หน้าแรก</a>
								<span aria-hidden="true">›</span>
								<a href={hub.path}>{hub.label}</a>
								<span aria-hidden="true">›</span>
								<span>{plainTitle}</span>
							</nav>
							<h1 class="title" set:html={titleHtml} />
							<p class="sell-urgency">
								<span class="urgency-dot" aria-hidden="true"></span>
								<span>ประเมินฟรี 15 นาที</span>
								<span aria-hidden="true">·</span>
								<span>จ่ายเงินสดทันที</span>
								<span aria-hidden="true">·</span>
								<span>ไม่มีวันหยุด</span>
							</p>
						</div>
					</div>
					{featuredUrl && (
						<div class="sell-hero-img-wrap">
							<Image class="hero-img" src={featuredUrl} alt={heroAlt} width={900} height={450} loading="eager" decoding="async" fetchpriority="high" />
						</div>
					)}
					<div class="sell-cta-top">
						<div class="sell-cta-top-inner">
							<ContactBox heading={`ต้องการขาย ${plainTitle}?`} text="ส่งรูป รุ่น และสภาพเครื่องมาได้เลย ทีมงานประเมินราคาให้ฟรีใน 15 นาที จ่ายสดทันที" />
						</div>
					</div>
					<div class="sell-body">
						<aside class="sell-toc" aria-label="สารบัญเนื้อหา">
							<div class="sell-toc-inner">
								<p class="sell-toc-title">สารบัญ</p>
								{hasToc && (
									<nav>
										<ul class="sell-toc-list">
											{tocHeadings.map((h) => (
												<li><a href={`#${h.slug}`}>{h.text}</a></li>
											))}
										</ul>
									</nav>
								)}
								<div class="sell-toc-cta">
									<p style="font-size:0.8rem;color:#64748b;margin:0 0 0.5rem;text-align:center;">ประเมินราคาฟรี 24 ชม.</p>
									<a href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer" class="toc-line-btn">
										<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 10.304c0-5.369-5.383-9.738-12-9.738-6.616 0-12 4.369-12 9.738 0 4.814 4.269 8.846 10.038 9.608.391.084.922.258 1.057.592.121.303.047.753.023 1.057-.037.453-.238 1.417-.286 1.661-.081.408.392.656.711.458 1.157-.723 6.257-3.682 8.528-6.304C22.753 14.869 24 12.755 24 10.304z"/></svg>
										ทัก LINE @webuy
									</a>
								</div>
							</div>
						</aside>
						<main class="sell-main">
							{canonicalPath !== articlePath && (
								<p class="canonical-note">
									หน้านี้เป็นคู่มือรับซื้อตามพื้นที่ ลิงก์หลักของบริการอยู่ที่{' '}
									<a href={canonicalPath}>{canonicalPath}</a>
								</p>
							)}
							<TrustBar variant="orange" compact />
							<div class="article-prose">{Content && <Content />}</div>
							{localServiceContext && <ImportantLocalServiceSection context={localServiceContext} />}
							<div class="sell-cta-mid">
								<ContactBox heading="พร้อมขายแล้ว? ทัก Line @webuy ได้เลย" text="แจ้งรุ่น สเปก สภาพเครื่อง และรูปถ่ายจริง — ได้ราคาทันที ไม่ต้องเดินทางก่อน" variant="secondary" />
							</div>
							{faqItemsData && faqItemsData.length > 0 && (
								<section class="article-faq" aria-labelledby="article-faq-heading">
									<h2 id="article-faq-heading">คำถามที่พบบ่อย</h2>
									{faqItemsData.map((item) => (
										<details>
											<summary>{item.question}</summary>
											<p>{item.answer}</p>
										</details>
									))}
								</section>
							)}
							<NaturalSeoSections {...articleLongform} />
							<div class="sell-footer">
								<ContactBox heading="ขายด่วน ได้เงินทันที — ทัก Line @webuy" text="ส่งรูปมาเลย ไม่ต้องโทรก่อน ประเมินไว จ่ายสดทันที ทุกวัน 24 ชม." />
								<section style="margin-top:2rem;">
									<h2 style="font-size:1.1rem;font-weight:800;color:#0f172a;margin:0 0 1rem;">บริการรับซื้ออื่น ๆ</h2>
									<ul class="sell-service-links">
										<li><a href="/รับซื้อโน๊ตบุ๊ค/">รับซื้อโน๊ตบุ๊ค</a></li>
										<li><a href="/รับซื้อคอม/">รับซื้อคอม</a></li>
										<li><a href="/รับซื้อไอโฟน/">รับซื้อไอโฟน</a></li>
										<li><a href="/รับซื้อแมคบุ๊ค/">รับซื้อแมคบุ๊ค</a></li>
										<li><a href="/รับซื้อไอแพด/">รับซื้อไอแพด</a></li>
										<li><a href="/รับซื้อกล้อง/">รับซื้อกล้อง</a></li>
									</ul>
								</section>
								<section style="margin-top:2rem;">
									<h2 style="font-size:1.1rem;font-weight:800;color:#0f172a;margin:0 0 1rem;">หน้าบริการที่เกี่ยวข้อง</h2>
									<div class="sell-related-grid">
										{recentPosts && recentPosts.map((rp: { slug: string; title: string }) => (
											<a href={`/${rp.slug}/`} class="sell-related-card"><h3>{rp.title}</h3></a>
										))}
									</div>
									<div style="margin-top:1rem;text-align:center;"><a href={hub.path} style="color:var(--accent);font-size:0.9rem;font-weight:600;">ดูบริการทั้งหมดใน {hub.label} →</a></div>
								</section>
							</div>
						</main>
					</div>
					<div class="sell-mobile-cta">
						<a href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer" class="sell-mobile-cta-btn">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 10.304c0-5.369-5.383-9.738-12-9.738-6.616 0-12 4.369-12 9.738 0 4.814 4.269 8.846 10.038 9.608.391.084.922.258 1.057.592.121.303.047.753.023 1.057-.037.453-.238 1.417-.286 1.661-.081.408.392.656.711.458 1.157-.723 6.257-3.682 8.528-6.304C22.753 14.869 24 12.755 24 10.304z"/></svg>
							ประเมินราคาฟรีผ่าน LINE @webuy
						</a>
					</div>
				</div>
			) : (
				<article class="container article">
					<header class="article-head">
						<p class="back">
							<a href="/blog/">← กลับไปหน้าบทความ</a>
						</p>
						<p class="tech-eyebrow article-kicker">Article</p>
						<time class="date" datetime={publishedIso}>
							{
								post.data.pubDate.toLocaleDateString('th-TH', {
									year: 'numeric',
									month: 'long',
									day: 'numeric',
								})
							}
						</time>
						<h1 class="title" set:html={titleHtml} />
					</header>

					{
						featuredUrl && (
							<Image
								class="hero-img"
								src={featuredUrl}
								alt={heroAlt}
								width={1200}
								height={675}
								loading="eager"
								decoding="async"
								fetchpriority="high"
							/>
						)
					}

					{
						canonicalPath !== articlePath && (
							<p class="canonical-note">
								หน้านี้เป็นคู่มือรับซื้อตามพื้นที่ และลิงก์หลักของบริการอยู่ที่{' '}
								<a href={canonicalPath}>{canonicalPath}</a>
							</p>
						)
					}

					<div class="article-prose content">
						{Content && <Content />}
					</div>

					{localServiceContext && <ImportantLocalServiceSection context={localServiceContext} />}

					{
						showIntentHubLinks && (
							<section class="sell-intent-cta" aria-label="ต้องการขายเลย?">
								<p class="sell-intent-cta__heading">อยากขายจริง? ทัก Line @webuy ได้เลย</p>
								<p class="sell-intent-cta__sub">
									อ่านข้อมูลครบแล้ว — ทีมงานพร้อมประเมินราคาให้ฟรีใน 15 นาที ไม่ต้องเดินทาง
								</p>
								<a
									href="https://line.me/R/ti/p/@webuy"
									target="_blank"
									rel="noopener noreferrer"
									class="sell-intent-cta__btn"
								>
									<span aria-hidden="true">●</span> ทัก Line @webuy
								</a>
							</section>
						)
					}

					<NaturalSeoSections {...articleLongform} />

					{
						faqItemsData && faqItemsData.length > 0 && (
							<section class="article-faq" aria-labelledby="article-faq-heading">
								<h2 id="article-faq-heading">คำถามที่พบบ่อย</h2>
								{faqItemsData.map((item) => (
									<details>
										<summary>{item.question}</summary>
										<p>{item.answer}</p>
									</details>
								))}
							</section>
						)
					}

					{
						showIntentHubLinks && (
							<section class="mb-8 rounded-xl border border-amber-200/80 bg-amber-50/60 p-4 sm:p-5">
								<h2 class="text-lg font-bold text-gray-900">คู่มือและเช็กราคาก่อนขาย</h2>
								<p class="mt-2 text-sm leading-relaxed text-gray-600">
									อ่านบทความที่เกี่ยวข้องเพิ่ม หรือกลับไปดู hub รวมทุกหัวข้อก่อนทัก Line @webuy
								</p>
								<ul class="mt-3 flex flex-wrap gap-2 list-none p-0 m-0 text-sm">
									<li>
										<a
											href="/คู่มือก่อนขาย/"
											class="inline-block rounded-md border border-amber-200 bg-white px-3 py-1.5 font-medium text-gray-800 transition hover:border-brand-400 hover:text-brand-700"
										>
											คู่มือก่อนขาย
										</a>
									</li>
									<li>
										<a
											href="/เช็กราคาก่อนขาย/"
											class="inline-block rounded-md border border-amber-200 bg-white px-3 py-1.5 font-medium text-gray-800 transition hover:border-brand-400 hover:text-brand-700"
										>
											เช็กราคาก่อนขาย
										</a>
									</li>
									<li>
										<a
											href="/ราคากลางรับซื้อ/"
											class="inline-block rounded-md border border-amber-200 bg-white px-3 py-1.5 font-medium text-gray-800 transition hover:border-brand-400 hover:text-brand-700"
										>
											ราคากลางรับซื้อ
										</a>
									</li>
									<li>
										<a
											href="/ความน่าเชื่อถือ/"
											class="inline-block rounded-md border border-amber-200 bg-white px-3 py-1.5 font-medium text-gray-800 transition hover:border-brand-400 hover:text-brand-700"
										>
											ความน่าเชื่อถือ
										</a>
									</li>
								</ul>
							</section>
						)
					}

					<div class="post-footer">
						<section class="mb-10">
							<h2 class="text-xl font-bold mb-4">บริการรับซื้อ (Related Services)</h2>
							<p class="text-gray-600 mb-4 text-sm">
								หากคุณสนใจเปลี่ยนอุปกรณ์ไอทีเป็นเงินสด WE BUY พร้อมให้บริการประเมินราคาฟรี จ่ายเงินทันที:
							</p>
							<ul class="flex flex-wrap gap-3 list-none p-0 m-0">
								<li>
									<a
										href="/รับซื้อโน๊ตบุ๊ค/"
										class="inline-block bg-gray-50 hover:bg-brand-50 hover:text-brand-600 px-3 py-1.5 rounded-md text-sm font-medium transition-colors border border-gray-100"
										>รับซื้อโน๊ตบุ๊ค</a
									>
								</li>
								<li>
									<a
										href="/รับซื้อคอม/"
