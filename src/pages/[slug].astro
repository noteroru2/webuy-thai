---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedPosts } from '../lib/posts';
import { getSiteOrigin } from '../lib/site';
import { getEntry, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({
		params: { slug: post.data.slug },
		props: { entryId: post.id },
	}));
}

const { entryId } = Astro.props;
const post = await getEntry('posts', entryId);
if (!post) {
	return Astro.redirect('/404/', 302);
}

const { Content } = await render(post);

const plainTitle = post.data.title;
const plainExcerpt = post.data.description;
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const orgLogo = import.meta.env.PUBLIC_ORG_LOGO_URL ?? '/favicon.svg';
const publishedIso = post.data.pubDate.toISOString();
const modifiedIso = (post.data.updatedDate ?? post.data.pubDate).toISOString();
const featuredUrl = post.data.heroImage;
const titleHtml = post.data.titleHtml?.trim() || plainTitle;
const heroAlt = post.data.heroImageAlt ?? plainTitle;
const orgId = `${site}/#organization`;
const articlePath = `/${post.data.slug}/`;
const articleUrl = `${site}${articlePath}`;

const faqItemsData = post.data.faqItems;
const faqJsonLd: Array<Record<string, unknown>> =
	faqItemsData && faqItemsData.length > 0
		? [
				{
					'@context': 'https://schema.org',
					'@type': 'FAQPage',
					'@id': `${articleUrl}#faq`,
					mainEntity: faqItemsData.map((item) => ({
						'@type': 'Question',
						name: item.question,
						acceptedAnswer: {
							'@type': 'Answer',
							text: item.answer,
						},
					})),
				},
			]
		: [];

const articleJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'Article',
		'@id': `${articleUrl}#article`,
		headline: plainTitle,
		description: plainExcerpt || `บทความ ${plainTitle}`,
		url: articleUrl,
		mainEntityOfPage: {
			'@type': 'WebPage',
			'@id': articleUrl,
		},
		isAccessibleForFree: true,
		inLanguage: 'th-TH',
		articleSection: 'บทความ',
		speakable: {
			'@type': 'SpeakableSpecification',
			cssSelector: ['.article .title', '.article .content'],
		},
		datePublished: publishedIso,
		dateModified: modifiedIso,
		author: {
			'@type': 'Organization',
			name: orgName,
			'@id': orgId,
		},
		publisher: {
			'@type': 'Organization',
			name: orgName,
			'@id': orgId,
			logo: {
				'@type': 'ImageObject',
				url: new URL(orgLogo, site).toString(),
			},
			sameAs: ['https://line.me/R/ti/p/@webuy'],
		},
		image: featuredUrl
			? [
					{
						'@type': 'ImageObject',
						url: featuredUrl,
						width: 1200,
						height: 675,
						caption: plainTitle,
					},
				]
			: undefined,
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'บทความ', item: `${site}/blog/` },
			{ '@type': 'ListItem', position: 3, name: plainTitle, item: articleUrl },
		],
	},
	...faqJsonLd,
];
---

<BaseLayout
	title={`${plainTitle} | ${orgName}`}
	description={plainExcerpt || `เพิ่มความรู้ ${plainTitle} จาก ${orgName} — แกนหลักรับซื้อโน้ตบุ๊คและรับซื้อคอม`}
	pathname={articlePath}
	type="article"
	ogImage={featuredUrl}
	ogImageAlt={heroAlt}
	publishedTime={publishedIso}
	modifiedTime={modifiedIso}
	jsonLd={articleJsonLd}
	noindex={post.data.noindex === true}
>
	<article class="container article">
		<header class="article-head">
			<p class="back">
				<a href="/blog/">← กลับไปหน้าบทความ</a>
			</p>
			<p class="tech-eyebrow article-kicker">Article</p>
			<time class="date" datetime={publishedIso}>
				{post.data.pubDate.toLocaleDateString('th-TH', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				})}
			</time>
			<h1 class="title" set:html={titleHtml} />
		</header>

		{
			featuredUrl && (
				<img
					class="hero-img"
					src={featuredUrl}
					alt={heroAlt}
					width="1200"
					height="675"
					loading="eager"
					decoding="async"
					fetchpriority="high"
				/>
			)
		}

		<div class="prose content">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		padding-block: 2rem 4rem;
		max-width: 720px;
		margin-inline: auto;
		overflow-x: hidden;
	}
	.article-head {
		margin-bottom: 1.5rem;
	}
	.back {
		margin: 0 0 1rem;
		font-size: 0.9rem;
	}
	.back a {
		color: var(--muted);
	}
	.back a:hover {
		color: var(--accent);
	}
	.article-kicker {
		margin: 0 0 0.35rem;
	}
	.date {
		display: block;
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-bottom: 0.5rem;
	}
	.title {
		margin: 0;
		font-size: clamp(1.5rem, 3vw, 2rem);
		line-height: 1.25;
	}
	.hero-img {
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		margin-bottom: 2rem;
		border: 1px solid rgba(15, 23, 42, 0.08);
		box-shadow: var(--shadow-tech);
	}
	.content {
		font-size: 1.05rem;
	}
	.content :global(a) {
		word-break: break-word;
	}
	.content :global(img) {
		max-width: 100% !important;
		height: auto !important;
		display: block;
		margin-block: 1rem;
		box-sizing: border-box;
	}
	.content :global(img[style*='width']) {
		width: auto !important;
		max-width: 100% !important;
	}
	.content :global(figure) {
		max-width: 100% !important;
		width: auto !important;
		margin: 1rem 0;
		box-sizing: border-box;
	}
	.content :global(figure img) {
		margin-block: 0;
	}
	.content :global(.wp-block-image),
	.content :global(.wp-caption),
	.content :global(.alignnone),
	.content :global(.aligncenter),
	.content :global(.alignwide),
	.content :global(.alignfull) {
		max-width: 100% !important;
		width: auto !important;
		box-sizing: border-box;
	}
	.content :global(iframe) {
		max-width: 100%;
		border: 0;
	}
	.content :global(video) {
		max-width: 100%;
		height: auto;
	}
</style>
