---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import FeatureCard from '../components/landing/FeatureCard.astro';
import ProcessSection from '../components/landing/ProcessSection.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import SeoProseSection from '../components/home/SeoProseSection.astro';
import LocalAreaSection from '../components/home/LocalAreaSection.astro';
import FaqSectionPremium from '../components/home/FaqSectionPremium.astro';
import BlogPreviewMagazine from '../components/home/BlogPreviewMagazine.astro';
import { getPublishedPosts } from '../lib/posts';
import { getSiteOrigin } from '../lib/site';

const allPosts = await getPublishedPosts();
const recent = allPosts.slice(0, 6);
const site = getSiteOrigin();
const orgName = import.meta.env.PUBLIC_ORG_NAME ?? 'WE BUY | เรารับซื้อ';
const orgLogo = import.meta.env.PUBLIC_ORG_LOGO_URL ?? '/favicon.svg';
const socialRaw = import.meta.env.PUBLIC_ORG_SAME_AS ?? '';
const socialLinks = socialRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = businessPhone.replace(/^\+66/, '0').replace(/-/g, '');
const telHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;
const openingHours = import.meta.env.PUBLIC_OPENING_HOURS ?? 'ทุกวัน 24 ชั่วโมง';
const mapEmbedSrc =
	import.meta.env.PUBLIC_GOOGLE_MAP_EMBED ??
	'https://www.google.com/maps?q=13.7563,100.5018&z=12&output=embed';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ยโสธร,ขอนแก่น,นครราชสีมา,อุดรธานี,มหาสารคาม,สุรินทร์';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);
const mapUrl =
	import.meta.env.PUBLIC_GOOGLE_MAP_URL ??
	'https://maps.google.com/?q=13.7563,100.5018';
const lineUrl = 'https://line.me/R/ti/p/@webuy';

const techPillars = [
	{
		title: 'เน้นรับซื้อโน้ตบุ๊คและคอม',
		text: 'ประเมินโน้ตบุ๊คและคอมพิวเตอร์จากสเปก สภาพ และตลาดรับซื้อ อธิบายเกณฑ์ราคาก่อนตกลง',
		icon: 'scale' as const,
	},
	{
		title: 'รองรับหน้าร้านและออนไลน์',
		text: 'นัดรับ ประสานงาน และส่งข้อมูลผ่าน LINE ได้สะดวกตามรูปแบบบริการในแต่ละพื้นที่',
		icon: 'store' as const,
	},
	{
		title: 'ทีมงานมีประสบการณ์',
		text: 'คุ้นเคยกับสินค้าไอทีหลากหมวด ช่วยลดความเสี่ยงจากข้อมูลไม่ครบ',
		icon: 'award' as const,
	},
	{
		title: 'ตรวจเช็กสินค้าอย่างละเอียด',
		text: 'ดูสภาพจริงก่อนสรุปดีล ลดช่องว่างระหว่างข้อมูลกับของจริง',
		icon: 'search' as const,
	},
	{
		title: 'บริการรวดเร็ว',
		text: 'ตอบกลับไวในช่วงเวลาทำงานที่กำหนด และแจ้งขั้นตอนถัดไปให้ชัดเจน',
		icon: 'bolt' as const,
	},
	{
		title: 'รองรับลูกค้าทั่วพื้นที่',
		text: 'ให้บริการและประสานงานในหลายจังหวัดที่เปิดรับ รวมถึงโซนอุบลราชธานีและใกล้เคียง',
		icon: 'map' as const,
	},
];

const processSteps = [
	{
		title: 'ส่งข้อมูลเครื่องทาง LINE',
		description:
			'แนบรุ่น สภาพ รูปหลายมุม และอุปกรณ์ที่มี ให้สอดคล้องของจริง เพื่อประเมินได้แม่นและลดการปรับราคาทีหลัง',
	},
	{
		title: 'รับการประเมินราคาและเงื่อนไข',
		description:
			'ทีมงานแจ้งช่วงราคา แนวทางตรวจสอบ และข้อควรรู้ก่อนตกลง โดยไม่บังคับจนกว่าคุณจะพร้อมตัดสินใจ',
	},
	{
		title: 'ยืนยันดีลและนัดรับหรือจัดส่ง',
		description:
			'เลือกวันเวลาและวิธีส่งมอบที่สะดวก พร้อมสรุปข้อตกลงเพื่อความชัดเจนและตรวจสอบย้อนหลังได้',
	},
	{
		title: 'ตรวจรับและชำระเงินทันที',
		description:
			'เมื่อตรวจสอบตรงตามที่แจ้ง ชำระเงินตามช่องทางที่ตกลง จบดีลอย่างมืออาชีพ',
	},
];

const processBullets = [
	'แกนหลักคือรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์ — มีหมวดรับซื้ออื่นและบริการเสริมตามขอบเขต',
	'สื่อสารเป็นลายลักษณ์อักษรเพื่อความโปร่งใส',
	'มีบทความช่วยเตรียมข้อมูลก่อนติดต่อ',
];

const faqItems = [
	{
		question: 'รับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์มือสองประเมินราคาอย่างไร?',
		answer:
			'โดยทั่วไปจะดูจากรุ่น สเปก อายุการใช้งาน สภาพจอและบอดี้ อุปกรณ์ที่มี และสภาวะตลาดรับซื้อ ทั้งโน้ตบุ๊คและเครื่องตั้งโต๊ะ จากนั้นแจ้งช่วงราคาเบื้องต้นก่อนนัดตรวจของจริง',
	},
	{
		question: 'รับซื้อ MacBook รุ่นเก่าหรือไม่?',
		answer:
			'รับประเมินหลายรุ่น โดยราคาขึ้นกับสภาพแบตเตอรี่ รุ่นชิป RAM/SSD และความต้องการในตลาดมือสอง แนะนำส่งรายละเอียดทาง LINE เพื่อเช็กเคสจริง',
	},
	{
		question: 'โน้ตบุ๊กเสียสามารถนำมาขายได้ไหม?',
		answer:
			'ได้ในกรณีที่ยังมีมูลค่าตามสภาพ ทางเลือกอาจเป็นการขายตามอาการหรือทำสละบางชิ้นส่วน ขึ้นกับการประเมิน',
	},
	{
		question: 'ซ่อมคอมพิวเตอร์ใช้เวลานานไหม?',
		answer:
			'ขึ้นกับอาการและอะไหล่ หลังตรวจเบื้องต้นจะแจ้งกรอบเวลาโดยประมาณ และแจ้งหากมีความล่าช้าจากเหตุพิเศษ',
	},
	{
		question: 'มีบริการรับซื้อถึงที่หรือไม่?',
		answer:
			'สามารถสอบถามนัดรับและเงื่อนไขพื้นที่ได้ทาง LINE โดยขึ้นกับคิวงานและระยะทาง',
	},
	{
		question: 'ต้องเตรียมอะไรบ้างก่อนนำเครื่องมาขาย?',
		answer:
			'แนะนำเตรียมข้อมูลรุ่น อุปกรณ์ที่มี รูปสภาพจริง และบัญชีผู้ใช้ที่จำเป็นต้องล็อกอินเพื่อตรวจเครื่องหากเกี่ยวข้อง',
	},
	{
		question: 'รับประเมินราคาสินค้าผ่านช่องทางใด?',
		answer:
			'ส่งข้อมูลผ่าน LINE @webuy พร้อมรูปและรายละเอียดเครื่อง ทีมงานจะตอบกลับตามลำดับคิว',
	},
	{
		question: 'ติดต่อช่วงเวลาไหนได้บ้าง?',
		answer: 'ช่องทาง LINE เปิดให้ส่งข้อความได้ตลอด 24 ชั่วโมง สำหรับการตอบกลับขึ้นกับคิวงานของทีม',
	},
	{
		question: 'อยู่ต่างจังหวัดใช้บริการได้ไหม?',
		answer:
			'ได้ในหลายพื้นที่ที่ประกาศให้บริการ โดยอาจมีการประสานนัดหมายหรือจัดส่งตามข้อตกลง',
	},
	{
		question: 'หลังตกลงราคาแล้วจ่ายเงินอย่างไร?',
		answer:
			'ชำระเมื่อตรวจรับและยืนยันสภาพครบถ้วน ช่องทางการโอนหรือเงินสดจะแจ้งให้ทราบก่อนทุกครั้ง',
	},
];

const homeServices = [
	{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน้ตบุ๊ก', description: 'โน้ตบุ๊กหลากแบรนด์และสเปก — แกนหลักของเรา', icon: 'buyNb' as const },
	{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์มือสอง', description: 'PC สำนักงาน เล่นเกม Workstation — ประเมินตามสภาพ', icon: 'buyPc' as const },
	{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook / iMac', description: 'อุปกรณ์ Apple สาย Mac', icon: 'buyMac' as const },
	{ href: '/contact/', title: 'ซ่อมคอมพิวเตอร์', description: 'วินิจฉัยและแนะนำแนวทางซ่อมที่คุ้มค่า — สอบถามทางติดต่อเรา', icon: 'repairPc' as const },
	{ href: '/contact/', title: 'ซ่อมโน้ตบุ๊ก', description: 'จอ แบต คีย์บอร์ดและอาการฮาร์ดแวร์ — นัดประเมินผ่านช่องทางติดต่อ', icon: 'repairNb' as const },
	{ href: '/รับซื้อ/', title: 'รับซื้อ iPhone / iPad', description: 'ดูหมวดไอโฟนและไอแพดพร้อมรายละเอียด', icon: 'buyMobile' as const },
	{ href: '/บริการ/', title: 'จำหน่ายคอมพิวเตอร์มือสอง', description: 'สอบถามสต็อกและเงื่อนไขการจำหน่าย', icon: 'sellUsed' as const },
	{ href: '/contact/', title: 'บริการสำหรับองค์กร', description: 'งานหมู่คณะ สำรองเครื่อง และข้อตกลงเฉพาะ', icon: 'corp' as const },
];

const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const addressLocality = import.meta.env.PUBLIC_ADDRESS_LOCALITY ?? 'ประเทศไทย';
const addressRegion = import.meta.env.PUBLIC_ADDRESS_REGION ?? 'ประเทศไทย';
const postalCode = import.meta.env.PUBLIC_POSTAL_CODE ?? '10200';
const geoLat = Number(import.meta.env.PUBLIC_GEO_LAT ?? '13.7563');
const geoLon = Number(import.meta.env.PUBLIC_GEO_LON ?? '100.5018');
const rawMetaKw = import.meta.env.PUBLIC_META_KEYWORDS;
const metaKeywords =
	typeof rawMetaKw === 'string' && rawMetaKw.trim() !== ''
		? rawMetaKw.trim()
		: 'รับซื้อโน้ตบุ๊ค,รับซื้อคอม,รับซื้อคอมพิวเตอร์,รับซื้อโน๊ตบุ๊ค,บริการไอทีครบวงจร,รับซื้อ MacBook,ซ่อมคอมพิวเตอร์,ซ่อมโน้ตบุ๊ก,ร้านคอมพิวเตอร์มือสอง,รับซื้อ iPhone,อุบลราชธานี,WE BUY';

const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;
const faqId = `${site}/#faq`;
const localId = `${site}/#localbusiness`;

const homeTitle = `รับซื้อโน้ตบุ๊ค รับซื้อคอมมือสอง | ${siteName}`;
const homeDescription = `${orgName} — แกนหลักคือรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์มือสอง ประเมินยุติธรรม โปร่งใส มีหมวดรับซื้ออื่นและบริการซ่อม/จำหน่ายเสริม ติดต่อ LINE @webuy โทร ${phoneDisplay}`;

const homeJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: siteName,
			url: site,
			inLanguage: 'th-TH',
			description: homeDescription,
			publisher: { '@id': orgId },
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${site}/blog/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': 'Organization',
			'@id': orgId,
			name: orgName,
			url: site,
			logo: {
				'@type': 'ImageObject',
				url: new URL(orgLogo, site).toString(),
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				telephone: businessPhone,
				availableLanguage: ['Thai'],
			},
			address: {
				'@type': 'PostalAddress',
				addressLocality,
				addressRegion,
				postalCode,
				addressCountry: 'TH',
			},
			sameAs: socialLinks.length > 0 ? socialLinks : undefined,
		},
		{
			'@type': 'WebPage',
			'@id': `${site}/#webpage`,
			url: `${site}/`,
			name: homeTitle,
			description: homeDescription,
			inLanguage: 'th-TH',
			isPartOf: { '@id': websiteId },
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			isPartOf: { '@id': websiteId },
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		},
		{
			'@type': 'LocalBusiness',
			'@id': localId,
			name: siteName,
			url: site,
			image: [new URL('/hero-soft.svg', site).toString()],
			description: `${orgName} — เน้นรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์มือสอง พร้อมบริการไอทีเสริม ครอบคลุมหลายพื้นที่ในประเทศไทย ติดต่อ Line @webuy`,
			telephone: businessPhone,
			priceRange: '$$',
			parentOrganization: { '@id': orgId },
			aggregateRating: {
				'@type': 'AggregateRating',
				ratingValue: '4.9',
				reviewCount: '158',
			},
			review: [
				{
					'@type': 'Review',
					reviewRating: {
						'@type': 'Rating',
						ratingValue: '5',
						bestRating: '5',
					},
					author: {
						'@type': 'Person',
						name: 'ลูกค้าทั่วไป',
					},
					reviewBody: 'ส่งข้อมูลทางไลน์แล้วได้คำตอบชัดเจน รู้ว่าประเมินจากอะไรบ้างก่อนตกลง',
				},
				{
					'@type': 'Review',
					reviewRating: {
						'@type': 'Rating',
						ratingValue: '5',
						bestRating: '5',
					},
					author: {
						'@type': 'Person',
						name: 'ลูกค้าองค์กร / SME',
					},
					reviewBody: 'ชอบที่อธิบายเป็นขั้น ๆ ไม่เร่งให้ตัดสินใจทันที',
				},
			],
			address: {
				'@type': 'PostalAddress',
				addressLocality,
				addressRegion,
				postalCode,
				addressCountry: 'TH',
			},
			geo: {
				'@type': 'GeoCoordinates',
				latitude: geoLat,
				longitude: geoLon,
			},
			areaServed: serviceAreas.map((area) => ({
				'@type': 'AdministrativeArea',
				name: area,
			})),
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: [
						'Monday',
						'Tuesday',
						'Wednesday',
						'Thursday',
						'Friday',
						'Saturday',
						'Sunday',
					],
					opens: '00:00',
					closes: '23:59',
				},
			],
			contactPoint: [
				{
					'@type': 'ContactPoint',
					contactType: 'customer support',
					availableLanguage: ['Thai'],
					url: 'https://line.me/R/ti/p/@webuy',
					telephone: businessPhone,
				},
			],
			hasMap: mapUrl,
			sameAs: socialLinks.length > 0 ? socialLinks : undefined,
		},
	],
};
---

<BaseLayout title={homeTitle} description={homeDescription} keywords={metaKeywords} pathname="/" jsonLd={homeJsonLd}>
	<div class="font-sans bg-[#FAFAFA] text-text antialiased">
		<Hero />
		{
			recent.length === 0 && (
				<div class="mx-auto max-w-[1200px] px-4 pb-6 sm:px-6 lg:px-8">
					<div class="rounded-2xl border border-amber-200/80 bg-brand-50 px-4 py-3 text-sm text-text shadow-sm" role="status">
						<strong class="font-semibold text-brand-700">ยังไม่มีบทความในเว็บนี้</strong>
						<p class="mt-1 text-text-muted">
							ใส่ไฟล์ Markdown ใน <code class="rounded-md bg-white px-1.5 py-0.5 text-[0.85em]">src/content/posts/</code> หรือรัน{' '}
							<code class="rounded-md bg-white px-1.5 py-0.5 text-[0.85em]">npm run export:wp</code>
						</p>
					</div>
				</div>
			)
		}

		<section
			class="border-b border-gray-200/80 bg-gradient-to-b from-white to-[#FAFAFA]/80 py-12 sm:py-14 md:py-16"
			aria-label="พาร์ทเนอร์"
		>
			<div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
				<p class="text-center text-[11px] font-bold uppercase tracking-[0.2em] text-muted">พาร์ทเนอร์และภาคธุรกิจที่เกี่ยวข้อง</p>
				<div class="mt-7 flex flex-wrap items-center justify-center gap-2.5 sm:gap-3">
					{['Tech retail', 'SME', 'Logistics', 'Education', 'Enterprise IT', 'Local service'].map((label) => (
						<span class="rounded-full border border-gray-200/90 bg-white px-4 py-2 text-xs font-semibold text-text-muted shadow-sm">
							{label}
						</span>
					))}
				</div>
