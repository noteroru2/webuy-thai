const faqId = `${site}/#faq`;
const localId = `${site}/#localbusiness`;

const homeTitle = formatPageTitle('รับซื้อโน๊ตบุ๊ค รับซื้อคอมมือสอง');
const homeDescription =
	'WE BUY รับซื้อสินค้าไอทีมือสอง โน๊ตบุ๊ค iPhone MacBook คอม กล้อง ประเมินโปร่งใส นัดรับสะดวก จ่ายหลังตรวจเครื่อง ทัก Line @webuy เช็กราคาเบื้องต้น';

const homeJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: siteName,
			url: site,
			inLanguage: 'th-TH',
			description: homeDescription,
			publisher: { '@id': orgId },
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${site}/blog/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': 'WebPage',
			'@id': `${site}/#webpage`,
			url: `${site}/`,
			name: homeTitle,
			description: homeDescription,
			inLanguage: 'th-TH',
			isPartOf: { '@id': websiteId },
			about: { '@id': `${site}/#organization` }
		},
		{
			'@type': 'FAQPage',
			'@id': faqId,
			isPartOf: { '@id': websiteId },
			mainEntity: faqItems.map((item) => ({
				'@type': 'Question',
				name: item.question,
				acceptedAnswer: {
					'@type': 'Answer',
					text: item.answer,
				},
			})),
		}
	],
};
---

<BaseLayout title={homeTitle} description={homeDescription} keywords={metaKeywords} pathname="/" jsonLd={homeJsonLd}>
	<div class="font-sans bg-white text-text antialiased">

		<!-- 1. HERO -->
		<Hero />

		<!-- 2. SERVICE CATEGORIES GRID -->
		<ServiceCategoryGrid />

		<!-- 3. HOW IT WORKS -->
		<ProcessSection
			id="process-heading"
			eyebrow="ขั้นตอนการบริการ"
			heading="กระบวนการชัดเจน — รับซื้อโน้ตบุ๊คและคอมแบบมืออาชีพ"
			intro="เราออกแบบลำดับงานให้เข้าใจง่าย เหมาะทั้งลูกค้าทั่วไปและองค์กรที่ต้องการความรวดเร็วในการสื่อสาร"
			bulletPoints={processBullets}
			steps={processSteps}
		/>

		<!-- 4. PRICE FACTORS -->
		<section class="price-factors-section" aria-labelledby="price-factors-heading">
			<div class="price-factors-container">
				<div class="price-factors-header">
					<p class="price-factors-eyebrow">ปัจจัยกำหนดราคา</p>
					<h2 id="price-factors-heading" class="price-factors-heading">
						ราคารับซื้อขึ้นกับอะไรบ้าง?
					</h2>
					<p class="price-factors-intro">
						ก่อนส่งข้อมูล ควรเข้าใจว่าราคาประเมินมาจากหลายปัจจัย —
						ยิ่งข้อมูลครบ ยิ่งประเมินได้แม่น
					</p>
				</div>
				<div class="price-factors-grid">
					{priceFactors.map((factor) => (
						<div class="price-factor-card">
							<div class="price-factor-icon" set:html={factor.icon} aria-hidden="true" />
							<h3 class="price-factor-label">{factor.label}</h3>
							<p class="price-factor-desc">{factor.desc}</p>
						</div>
					))}
				</div>
				<div class="price-factors-cta">
					<a href="/ราคากลางรับซื้อ/" class="price-factors-link">
						ดูแนวทางราคากลางรับซื้อ →
					</a>
					<a href="/เช็กราคาก่อนขาย/" class="price-factors-link">
						วิธีเตรียมข้อมูลก่อนส่ง →
					</a>
				</div>
			</div>
		</section>

		<!-- 5. TRUST / ABOUT (AMPHON TRADING) -->
		<section class="trust-section" aria-labelledby="trust-intro-heading">
			<div class="trust-container">
				<div class="trust-grid">
					<div class="trust-text">
						<p class="trust-eyebrow">WE BUY · AMPHON TRADING</p>
						<h2 id="trust-intro-heading" class="trust-heading">
							ประเมินตามรุ่น สเปก และสภาพจริง
						</h2>
						<p class="trust-sub">
							โปร่งใสทุกขั้นตอน ตั้งแต่รับข้อมูลจนถึงยืนยันราคา
						</p>
						<ul class="trust-list">
							<li class="trust-item">
								<span class="trust-dot" aria-hidden="true"></span>
								<span>แจ้งราคาประเมินเบื้องต้นก่อนตกลงขาย — ไม่บังคับตัดสินใจ</span>
							</li>
							<li class="trust-item">
								<span class="trust-dot" aria-hidden="true"></span>
								<span>ตรวจรับและยืนยันสภาพก่อนชำระเงิน — ลดช่องว่างราคา</span>
							</li>
							<li class="trust-item">
								<span class="trust-dot" aria-hidden="true"></span>
								<span>แนะนำการล้างข้อมูลก่อนส่งมอบ เพื่อความเป็นส่วนตัว</span>
							</li>
							<li class="trust-item">
								<span class="trust-dot" aria-hidden="true"></span>
								<span>ดำเนินงานในเครือ AMPHON TRADING — มีประสบการณ์สินค้าไอทีหลากหมวด</span>
							</li>
						</ul>
						<div class="trust-action">
							<a
								href={lineUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="trust-line-btn"
							>
								<svg class="trust-line-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
								</svg>
								ส่งรูปประเมินทาง LINE
							</a>
							<a href="/ความน่าเชื่อถือ/" class="trust-secondary-link">
								อ่านนโยบายและขั้นตอน →
							</a>
						</div>
					</div>

					<div class="trust-card-panel" aria-hidden="true">
						<div class="trust-card">
							<div class="trust-card-icon">
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
								</svg>
							</div>
							<p class="trust-card-title">รับซื้อสินค้าไอทีมือสอง</p>
							<p class="trust-card-sub">โน๊ตบุ๊ค · คอมพิวเตอร์ · MacBook · iPhone · iPad · กล้อง</p>
							<div class="trust-card-stats">
								<div class="trust-stat-box">
									<p class="trust-stat-label">LINE</p>
									<p class="trust-stat-value">@webuy</p>
								</div>
								<div class="trust-stat-box">
									<p class="trust-stat-label">บริษัท</p>
									<p class="trust-stat-value">AMPHON TRADING</p>
								</div>
								<div class="trust-stat-box">
									<p class="trust-stat-label">พื้นที่บริการ</p>
									<p class="trust-stat-value">{serviceAreas.length}+ จังหวัด</p>
								</div>
							</div>
						</div>
					</div>
				</div>

				<!-- Feature pillars -->
				<div class="trust-pillars">
					{techPillars.map((pillar) => (
						<FeatureCard title={pillar.title} text={pillar.text} icon={pillar.icon} />
					))}
				</div>
			</div>
		</section>

		<!-- 6. BLOG / KNOWLEDGE PREVIEW -->
		{recent.length > 0 && <BlogPreviewMagazine posts={recent} />}

		{
			recent.length === 0 && (
				<div class="mx-auto max-w-[1200px] px-4 pb-6 sm:px-6 lg:px-8">
					<div class="rounded-2xl border border-amber-200/80 bg-brand-50 px-4 py-3 text-sm text-text shadow-sm" role="status">
						<strong class="font-semibold text-brand-700">ยังไม่มีบทความในเว็บนี้</strong>
						<p class="mt-1 text-text-muted">
							ใส่ไฟล์ Markdown ใน <code class="rounded-md bg-white px-1.5 py-0.5 text-[0.85em]">src/content/posts/</code> หรือรัน{' '}
							<code class="rounded-md bg-white px-1.5 py-0.5 text-[0.85em]">npm run export:wp</code>
						</p>
					</div>
				</div>
			)
		}

		<!-- 7. PRE-SALE LINKS + MAIN MONEY PAGES -->
		<section
			class="presale-section"
			aria-labelledby="pre-sale-heading"
		>
			<div class="presale-container">
				<h2 id="pre-sale-heading" class="presale-heading">
					ก่อนขาย เช็กราคาได้ก่อน
				</h2>
				<p class="presale-sub">
					เตรียมข้อมูลให้ครบก่อนทัก LINE — อ่านแนวทางจากลิงก์ด้านล่าง หรือเปิด{' '}
					<a class="font-semibold text-brand-700 hover:underline" href="/คู่มือก่อนขาย/">คู่มือก่อนขาย</a>
				</p>
				<div class="presale-links">
					{
						preSaleLinks.map((link) => (
							<a
								href={link.href}
								class="presale-link-card"
							>
								<h3 class="presale-link-title">{link.title}</h3>
								<p class="presale-link-desc">{link.description}</p>
							</a>
						))
					}
				</div>
				<h3 class="presale-subheading">หมวดรับซื้อหลัก</h3>
				<div class="presale-money-pages">
					{
						mainMoneyPages.map((page) => (
							<a
								href={page.href}
								class="presale-money-card"
							>
								<span class="block font-semibold text-text">{page.title}</span>
								<span class="mt-1 block text-xs font-normal text-text-muted">{page.description}</span>
							</a>
						))
					}
				</div>
				<p class="presale-more">
					ดูหมวดรับซื้อทั้งหมดได้ที่{' '}
					<a class="font-semibold text-brand-600 hover:underline" href="/รับซื้อ/">หน้ารับซื้อสินค้าไอทีมือสอง</a>
				</p>
			</div>
		</section>

		<!-- 8. SEO PROSE -->
		<SeoProseSection />

		<!-- 9. TRUST BADGES -->
		<div class="border-t border-[#E8ECF1] bg-white py-12">
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<TrustBadges className="mb-8" />
			</div>
		</div>

		<!-- 10. SERVICES GRID -->
		<section
			class="border-t border-[#E8ECF1] bg-[#F5F7FA] py-16 sm:py-20 lg:py-24"
			aria-labelledby="services-grid-heading"
		>
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<h2 id="services-grid-heading" class="text-[clamp(1.5rem,2.8vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
					บริการยอดนิยม
				</h2>
				<p class="mt-4 max-w-[34rem] text-base leading-[1.7] text-text-muted">
					แกนหลักคือรับซื้อโน้ตบุ๊คและคอม — ดูภาพรวมที่{' '}
					<a class="font-bold text-brand-600 underline decoration-brand-500/30 underline-offset-2 hover:text-brand-700" href="/บริการ/">หน้าบริการ</a>
				</p>
				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:items-stretch">
					{homeServices.map((s) => (
						<ServiceCard href={s.href} title={s.title} description={s.description} icon={s.icon} />
					))}
				</div>
			</div>
		</section>

		<!-- 11. LOCAL AREA -->
		<LocalAreaSection
			areas={serviceAreas}
			phoneLabel={phoneDisplay}
			telHref={telHref}
			lineUrl={lineUrl}
			openingHours={openingHours}
			siteName={siteName}
			mapEmbedSrc={mapEmbedSrc}
		/>

		<!-- 12. FAQ -->
		<FaqSectionPremium items={faqItems} />

		<!-- 13. FINAL CTA -->
		<CtaBand />

	</div>
</BaseLayout>

<style>
/* ===== PRICE FACTORS SECTION ===== */
.price-factors-section {
	background: #f5f7fa;
	border-bottom: 1px solid #e8ecf1;
	padding-block: 5rem;
}
@media (min-width: 640px) { .price-factors-section { padding-block: 5.5rem; } }
@media (min-width: 1024px) { .price-factors-section { padding-block: 6.5rem; } }

.price-factors-container {
	max-width: 75rem;
	margin-inline: auto;
	padding-inline: 1rem;
}
@media (min-width: 640px) { .price-factors-container { padding-inline: 1.5rem; } }
@media (min-width: 1024px) { .price-factors-container { padding-inline: 2rem; } }

.price-factors-header {
	text-align: center;
	margin-bottom: 3rem;
}
.price-factors-eyebrow {
	display: inline-block;
	font-size: 0.6875rem;
	font-weight: 700;
	letter-spacing: 0.2em;
	text-transform: uppercase;
	color: #f59e0b;
	background: rgba(245, 158, 11, 0.1);
	border: 1px solid rgba(245, 158, 11, 0.25);
	border-radius: 999px;
	padding: 0.3rem 0.875rem;
	margin-bottom: 1.25rem;
}
.price-factors-heading {
	font-size: clamp(1.5rem, 2.8vw + 1rem, 2.25rem);
	font-weight: 800;
	letter-spacing: -0.02em;
	color: #0b1f3a;
	margin: 0 0 1rem;
}
.price-factors-intro {
	font-size: 1.0625rem;
	line-height: 1.7;
	color: #4b5563;
	max-width: 36rem;
	margin-inline: auto;
}

.price-factors-grid {
	display: grid;
	grid-template-columns: repeat(2, 1fr);
	gap: 1rem;
}
@media (min-width: 640px) {
	.price-factors-grid { grid-template-columns: repeat(3, 1fr); }
}
@media (min-width: 1024px) {
	.price-factors-grid { grid-template-columns: repeat(6, 1fr); gap: 1.25rem; }
}

.price-factor-card {
	background: #fff;
	border: 1px solid #e8ecf1;
	border-radius: 1rem;
	padding: 1.5rem 1.25rem;
	text-align: center;
	transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
}
.price-factor-card:hover {
	border-color: rgba(245, 158, 11, 0.3);
	box-shadow: 0 8px 24px rgba(245, 158, 11, 0.08), 0 2px 8px rgba(11, 31, 58, 0.06);
	transform: translateY(-2px);
}
.price-factor-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 2.75rem;
	height: 2.75rem;
	margin-inline: auto;
	margin-bottom: 1rem;
	border-radius: 0.75rem;
	background: rgba(11, 31, 58, 0.06);
	color: #0b1f3a;
}
.price-factor-icon :global(svg) {
	width: 1.375rem;
	height: 1.375rem;
}
.price-factor-label {
	font-size: 0.875rem;
	font-weight: 700;
	color: #0b1f3a;
	margin: 0 0 0.5rem;
}
.price-factor-desc {
	font-size: 0.8125rem;
	line-height: 1.55;
	color: #6b7280;
	margin: 0;
}

.price-factors-cta {
	display: flex;
	flex-wrap: wrap;
	justify-content: center;
	gap: 1.5rem;
	margin-top: 2.5rem;
}
.price-factors-link {
	font-size: 0.9375rem;
	font-weight: 600;
	color: #0b1f3a;
	text-decoration: none;
	border-bottom: 2px solid rgba(245, 158, 11, 0.4);
	padding-bottom: 0.1rem;
	transition: border-color 0.15s ease, color 0.15s ease;
}
.price-factors-link:hover {
	border-color: #f59e0b;
	color: #d97706;
}

/* ===== TRUST SECTION ===== */
.trust-section {
	background: #fff;
	border-bottom: 1px solid #e8ecf1;
	padding-block: 5rem;
}
@media (min-width: 640px) { .trust-section { padding-block: 5.5rem; } }
@media (min-width: 1024px) { .trust-section { padding-block: 6.5rem; } }

.trust-container {
	max-width: 75rem;
	margin-inline: auto;
	padding-inline: 1rem;
}
@media (min-width: 640px) { .trust-container { padding-inline: 1.5rem; } }
@media (min-width: 1024px) { .trust-container { padding-inline: 2rem; } }

.trust-grid {
	display: grid;
	gap: 3rem;
	margin-bottom: 4rem;
}
@media (min-width: 1024px) {
	.trust-grid { grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center; }
}

.trust-eyebrow {
	font-size: 0.6875rem;
	font-weight: 700;
	letter-spacing: 0.2em;
	text-transform: uppercase;
	color: #f59e0b;
	margin: 0 0 0.875rem;
}
.trust-heading {
	font-size: clamp(1.5rem, 2.5vw + 1rem, 2rem);
	font-weight: 800;
	letter-spacing: -0.02em;
	color: #0b1f3a;
	margin: 0 0 0.875rem;
}
.trust-sub {
	font-size: 1rem;
	line-height: 1.7;
	color: #4b5563;
	max-width: 34rem;
	margin: 0 0 1.75rem;
}
.trust-list {
	list-style: none;
	padding: 0;
	margin: 0 0 2rem;
	display: flex;
	flex-direction: column;
	gap: 0.875rem;
}
.trust-item {
	display: flex;
	align-items: flex-start;
	gap: 0.75rem;
	font-size: 0.9375rem;
	line-height: 1.6;
	color: #374151;
}
.trust-dot {
	flex-shrink: 0;
	margin-top: 0.475rem;
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: #14b8a6;
	box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.2);
}

.trust-action {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 1rem;
}
.trust-line-btn {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	min-height: 48px;
	padding: 0.75rem 1.5rem;
	border-radius: 999px;
	background: #f59e0b;
	font-size: 0.9375rem;
	font-weight: 700;
	color: #0b1f3a !important;
	text-decoration: none;
	box-shadow: 0 4px 16px rgba(245, 158, 11, 0.35);
	transition: background 0.2s ease, transform 0.2s ease;
}
.trust-line-btn:hover { background: #d97706; transform: translateY(-1px); }
.trust-line-btn-icon { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
.trust-secondary-link {
	font-size: 0.9375rem;
	font-weight: 600;
	color: #374151;
	text-decoration: none;
	border-bottom: 1px solid #d1d5db;
	transition: color 0.15s ease, border-color 0.15s ease;
}
.trust-secondary-link:hover { color: #0b1f3a; border-color: #0b1f3a; }

/* Trust card panel (right side) */
.trust-card-panel {
	display: flex;
	align-items: center;
	justify-content: center;
}
@media (max-width: 1023px) { .trust-card-panel { display: none; } }

.trust-card {
	width: 100%;
	max-width: 22rem;
	background: linear-gradient(135deg, #f8fafc, #fff);
	border: 1px solid #e8ecf1;
	border-radius: 1.5rem;
	padding: 2rem;
	text-align: center;
	box-shadow: 0 4px 24px rgba(11, 31, 58, 0.06), 0 1px 4px rgba(11, 31, 58, 0.04);
}
.trust-card-icon {
	display: flex;
	align-items: center;
	justify-content: center;
	width: 4.5rem;
	height: 4.5rem;
	margin-inline: auto;
	margin-bottom: 1.25rem;
	border-radius: 1.125rem;
	background: linear-gradient(135deg, #0b1f3a, #1e3a5f);
	color: #fff;
	box-shadow: 0 8px 24px rgba(11, 31, 58, 0.2);
}
.trust-card-icon :global(svg) {
	width: 2rem;
	height: 2rem;
}
.trust-card-title {
