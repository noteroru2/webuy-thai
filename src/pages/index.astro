							<span class="font-serif text-5xl font-bold leading-none text-brand-100" aria-hidden="true">&ldquo;</span>
							<p class="flex gap-0.5 text-brand-500" aria-label="ให้คะแนน 5 ดาว">
								{[1, 2, 3, 4, 5].map(() => (
									<svg class="h-4 w-4 fill-current" viewBox="0 0 20 20" aria-hidden="true">
										<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
									</svg>
								))}
							</p>
						</div>
						<p class="relative z-[1] mt-5 flex-1 text-[0.9375rem] leading-[1.75] text-text-muted">
							&ldquo;ชอบที่อธิบายเป็นขั้น ๆ ไม่เร่งให้ตัดสินใจทันที&rdquo;
						</p>
						<footer class="mt-6 border-t border-gray-100 pt-5">
							<p class="text-sm font-bold text-text">ลูกค้าองค์กร / SME</p>
							<cite class="mt-0.5 block text-xs font-medium not-italic text-muted">กรุงเทพมหานคร</cite>
						</footer>
					</blockquote>
				</div>
			</div>
		</section>

		<LocalAreaSection
			areas={serviceAreas}
			phoneLabel={phoneDisplay}
			telHref={telHref}
			lineUrl={lineUrl}
			openingHours={openingHours}
			siteName={siteName}
			mapEmbedSrc={mapEmbedSrc}
		/>

		<FaqSectionPremium items={faqItems} />

		{recent.length > 0 && <BlogPreviewMagazine posts={recent} />}
	</div>
</BaseLayout>
