---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ProcessSection from '../components/landing/ProcessSection.astro';
import ServiceCategoryGrid from '../components/ui/ServiceCategoryGrid.astro';
import CtaBand from '../components/CtaBand.astro';
import { isSafeHomePreviewPost } from '../lib/claim-filter';
import { getPublishedPosts } from '../lib/posts';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const allPosts = await getPublishedPosts();
const recent = allPosts.filter((post) => isSafeHomePreviewPost(post.data)).slice(0, 4);
const site = getSiteOrigin();
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = businessPhone.replace(/^\+66/, '0').replace(/-/g, '');
const telHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;

const mapEmbedSrc =
	import.meta.env.PUBLIC_GOOGLE_MAP_EMBED ??
	'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3849.0251066841015!2d104.83948708529402!3d15.266426622549128!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x311687b7ef0583c9%3A0x90ad9a37b84af3a!2z4Lit4Liz4Lie4LilIOC5gOC4l-C4o-C4lOC4lOC4tOC5ieC4hyAtIOC4o-C4seC4muC4i-C4t-C5ieC4rSDguILguLLguKIg4LiL4LmI4Lit4LihIOC4hOC4reC4oeC4nuC4tOC4p-C5gOC4leC4reC4o-C5jCDguKHguLfguK3guJbguLfguK0g4LiB4Lil4LmJ4Lit4LiHIOC4peC4s-C5guC4nuC4hyDguKrguLTguJnguITguYnguLLguYTguK3guJfguLXguJfguLjguIHguIrguJnguLTguJQ!5e0!3m2!1sth!2sth!4v1781512837717!5m2!1sth!2sth';
const mapUrl =
	import.meta.env.PUBLIC_GOOGLE_MAP_URL ??
	'https://maps.app.goo.gl/LjeWLrvhDhcsgRYCA';
const lineUrl = 'https://line.me/R/ti/p/@webuy';

const processSteps = [
	{
		title: 'ส่งรูปและข้อมูลสินค้า',
		description: 'แนบรุ่น สเปก ภาพถ่าย และข้อมูลอุปกรณ์เสริมจริงผ่านช่องทาง LINE @webuy',
	},
	{
		title: 'รับช่วงราคาประเมินเบื้องต้น',
		description: 'ทีมงานวิเคราะห์และแจ้งช่วงราคาประเมินให้พิจารณาก่อนตัดสินใจขาย',
	},
	{
		title: 'นัดหมายหรือจัดส่งตามตกลง',
		description: 'เลือกบริการนัดรับเครื่องหน้างานถึงที่ หรือจัดส่งพัสดุตามความสะดวก',
	},
	{
		title: 'ตรวจสภาพจริง',
		description: 'เจ้าหน้าที่ตรวจเช็กตัวเครื่องจริงอย่างละเอียดตามจุดต่างๆ เพื่อความโปร่งใส',
	},
	{
		title: 'ยืนยันราคาและรับเงิน',
		description: 'สรุปราคาซื้อขายอย่างตรงไปตรงมา และทำการโอนเงินเข้าบัญชีทันทีหลังตกลงกัน',
	},
];

const processBullets = [
	'แกนหลักคือรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์ — มีหมวดรับซื้ออื่นและบริการเสริมตามขอบเขต',
	'สื่อสารเป็นลายลักษณ์อักษรเพื่อความโปร่งใสในดีล',
	'ยินดีให้คำแนะนำการเตรียมเครื่องและเตรียมสเปกก่อนเสนอราคาจริง',
];

const homeTitle = formatPageTitle('รับซื้อโน๊ตบุ๊ค รับซื้อคอมมือสอง');
const homeDescription =
	'WE BUY รับซื้อสินค้าไอทีมือสอง โน๊ตบุ๊ค iPhone MacBook คอม กล้อง ประเมินโปร่งใส นัดรับสะดวก จ่ายหลังตรวจเครื่อง ทัก Line @webuy เช็กราคาเบื้องต้น';

const orgId = `${site}/#organization`;
const websiteId = `${site}/#website`;

const homeJsonLd: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'WebSite',
			'@id': websiteId,
			name: siteName,
			url: site,
			inLanguage: 'th-TH',
			description: homeDescription,
			publisher: { '@id': orgId },
			potentialAction: {
				'@type': 'SearchAction',
				target: {
					'@type': 'EntryPoint',
					urlTemplate: `${site}/blog/?q={search_term_string}`,
				},
				'query-input': 'required name=search_term_string',
			},
		},
		{
			'@type': 'WebPage',
			'@id': `${site}/#webpage`,
			url: `${site}/`,
			name: homeTitle,
			description: homeDescription,
			inLanguage: 'th-TH',
			isPartOf: { '@id': websiteId },
			about: { '@id': orgId }
		}
	],
};
---

<BaseLayout title={homeTitle} description={homeDescription} pathname="/" jsonLd={homeJsonLd}>
	<div class="font-sans bg-[#F5F7FA] text-text antialiased">
		<!-- Section 2: Hero -->
		<Hero />

		<!-- Section 3: Trust Strip -->
		<section class="border-y border-[#E8ECF1] bg-white py-6" aria-label="ข้อมูลประกอบความน่าเชื่อถือ">
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<div class="grid grid-cols-1 gap-y-4 sm:grid-cols-2 md:grid-cols-4 sm:gap-x-6 sm:gap-y-6 md:gap-y-0 text-center sm:text-left">
					{[
						{ title: 'ประเมินจากข้อมูลจริง', text: 'ประเมินตามรุ่น สเปก และสภาพจริง', icon: '📋' },
						{ title: 'เสนอราคาชัดเจน', text: 'แจ้งช่วงราคาเบื้องต้นก่อนตัดสินใจ', icon: '💰' },
						{ title: 'โปร่งใสในดีล', text: 'ตรวจรับสินค้าจริงก่อนยืนยันราคา', icon: '🔍' },
						{ title: 'ติดต่อได้มีตัวตน', text: 'มีหน้าร้านและช่องทางติดต่อชัดเจน', icon: '📍' },
					].map((item) => (
						<div class="flex flex-col sm:flex-row items-center gap-3">
							<span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-xl text-brand-700" aria-hidden="true">
								{item.icon}
							</span>
							<div>
								<p class="text-sm font-bold text-text">{item.title}</p>
								<p class="mt-0.5 text-xs text-text-muted">{item.text}</p>
							</div>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Section 4: Service Category Grid -->
		<ServiceCategoryGrid />

		<!-- Section 5: How it works -->
		<ProcessSection
			id="process-heading"
			eyebrow="ขั้นตอนการบริการ"
			heading="กระบวนการรับซื้อและประเมินสเปกอย่างตรงไปตรงมา"
			intro="เราจัดลำดับขั้นตอนการตรวจเช็กและประเมินราคาให้ชัดเจนตั้งแต่แรก เพื่อความสะดวกและสบายใจสูงสุดของผู้ขาย"
			bulletPoints={processBullets}
			steps={processSteps}
		/>

		<!-- Section 6: Price Factors -->
		<section class="border-b border-[#E8ECF1] bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="price-factors-heading">
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<div class="text-center">
					<p class="text-xs font-bold uppercase tracking-[0.22em] text-brand-600">เกณฑ์การประเมิน</p>
					<h2 id="price-factors-heading" class="mt-4 text-[clamp(1.5rem,3vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
						ปัจจัยหลักที่มีผลต่อราคาประเมิน
					</h2>
					<p class="mx-auto mt-3 max-w-[36rem] text-sm leading-relaxed text-text-muted">
						ราคาอ้างอิงและประเมินจะแปรผันตามรายละเอียดของแต่ละอุปกรณ์อย่างยุติธรรมตามสภาพจริง
					</p>
				</div>
				<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
					{[
						{ title: 'รุ่นและปีที่ผลิต', desc: 'ปีเปิดตัวและโมเดลของแต่ละอุปกรณ์ ซึ่งเป็นฐานอ้างอิงราคาตลาดมือสองหลัก', icon: '📅' },
						{ title: 'สเปกและความจุหลัก', desc: 'ขนาดของหน่วยความจำ RAM พื้นที่จัดเก็บข้อมูล SSD/ROM และชิปหน่วยประมวลผล', icon: '⚡' },
						{ title: 'สภาพบอดี้ภายนอก', desc: 'ความสวยงามรอบตัวเครื่อง รอยขีดข่วน รอยกระแทก หรือรอยแตกร้าวภายนอก', icon: '🔍' },
						{ title: 'จอภาพ แบตเตอรี่ และระบบ', desc: 'สุขภาพและรอบการชาร์จแบตเตอรี่ การแสดงผลสีสันบนหน้าจอ และฟังก์ชันภายใน', icon: '🔋' },
						{ title: 'อุปกรณ์เสริมเดิมแท้', desc: 'ความครบถ้วนของสายชาร์จ อะแดปเตอร์ กล่อง ปากกา และคีย์บอร์ดที่ให้มา', icon: '🔌' },
						{ title: 'ระยะประกันศูนย์', desc: 'การรับประกันศูนย์ที่ยังเหลืออยู่และหลักฐานใบเสร็จซื้อขายซึ่งช่วยยืนยันอายุเครื่อง', icon: '📄' },
						{ title: 'ดีมานด์ตลาดมือสอง', desc: 'ความนิยมและสภาพแวดล้อมราคาซื้อขายของรุ่นนั้นๆ ในปัจจุบัน', icon: '📈' },
						{ title: 'สถานะความปลอดภัย', desc: 'การลงชื่อออกจากบัญชีผู้ใช้ iCloud, Google Account หรือการปลดล็อครหัสผ่านหน้าจอ', icon: '🔒' }
					].map((item) => (
						<div class="rounded-2xl border border-gray-100 bg-[#FAFAFA]/70 p-6 shadow-sm hover:border-brand-500/20 hover:bg-white transition-all">
							<span class="text-3xl" aria-hidden="true">{item.icon}</span>
							<h3 class="mt-4 text-base font-bold text-text">{item.title}</h3>
							<p class="mt-2 text-xs leading-relaxed text-text-muted">{item.desc}</p>
						</div>
					))}
				</div>
			</div>
		</section>

		<!-- Section 7: Why users choose WE BUY -->
		<section class="border-b border-[#E8ECF1] bg-[#F5F7FA] py-16 sm:py-20 lg:py-24" aria-labelledby="why-choose-heading">
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-2 lg:items-center lg:gap-16">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.22em] text-brand-600">ทำไมต้องขายกับเรา</p>
						<h2 id="why-choose-heading" class="mt-4 text-[clamp(1.5rem,3vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
							ทางเลือกที่ชัดเจนและตรวจสอบได้จริง
						</h2>
						<p class="mt-4 text-base leading-[1.75] text-text-muted">
							เราเน้นแนวปฏิบัติตามมาตรฐาน อธิบายหลักเกณฑ์การตรวจรับอย่างละเอียด และยึดความถูกต้องตามจริง
						</p>
						<ul class="mt-8 space-y-4">
							{[
								{ title: 'อธิบายหลักเกณฑ์ราคาอย่างละเอียด', desc: 'ระบุทุกประเด็นการคำนวณและประเมินราคารายจุดอย่างสมเหตุสมผล' },
								{ title: 'แจ้งช่วงราคาประเมินล่วงหน้า', desc: 'แจ้งช่วงราคากลางอ้างอิงตามข้อมูลจริงทางแชท ให้ลูกค้าได้พิจารณาก่อนตัดสินใจ' },
								{ title: 'ตรวจเช็กหน้างานด้วยมาตรฐาน', desc: 'กระบวนการตรวจวิเคราะห์ความถูกต้องทางฮาร์ดแวร์ต่อหน้าลูกค้าอย่างโปร่งใส' },
								{ title: 'ข้อมูลธุรกิจและตัวตนที่โปร่งใส', desc: 'มีชื่อที่ตั้ง บริษัทจำกัด และหน้าร้านทางกายภาพที่ตรวจสอบข้อมูลได้จริง' },
								{ title: 'ให้คำแนะนำการล้างข้อมูลผู้ใช้', desc: 'แนะนำวิธีการ Backup ข้อมูล และช่วยดำเนินการรีเซ็ตลบข้อมูลผู้ใช้อย่างหมดจด' },
								{ title: 'รองรับการรับซื้อทุกประเภท', desc: 'ยินดีรับซื้อและประเมินราคาทั้งลูกค้ารายย่อยทั่วไป และเครื่องเหมาล็อตจากบริษัท' },
							].map((item) => (
								<li class="flex items-start gap-3">
									<span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-brand-500" aria-hidden="true" />
									<div>
										<p class="text-sm font-bold text-text">{item.title}</p>
										<p class="mt-1 text-xs text-text-muted leading-relaxed">{item.desc}</p>
									</div>
								</li>
							))}
						</ul>
					</div>
					<div class="relative flex items-center justify-center lg:justify-end" aria-hidden="true">
						<div class="w-full max-w-sm rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
							<div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-brand-600 text-white shadow-lg shadow-brand-900/10">
								<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
									<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 013.138-3.138z" />
								</svg>
							</div>
							<p class="mt-5 text-base font-bold text-text">WE BUY · AMPHON TRADING</p>
							<p class="mt-2 text-xs leading-relaxed text-text-muted">บริการประเมินราคาและรับซื้อสินค้าไอทีที่ตรวจสอบได้จริง</p>
							<div class="mt-6 space-y-2.5 border-t border-gray-100 pt-5 text-xs text-text-muted">
								<p class="flex justify-between"><span>ผู้ดำเนินการ</span> <strong class="text-text font-semibold">หจก. อำพล เทรดดิ้ง</strong></p>
								<p class="flex justify-between"><span>ที่ตั้งหน้าร้าน</span> <strong class="text-text font-semibold">จ.อุบลราชธานี</strong></p>
								<p class="flex justify-between"><span>เวลาทำการตอบแชท</span> <strong class="text-text font-semibold">09:00 - 21:00 น.</strong></p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 8: Real business / entity trust section -->
		<section class="border-b border-[#E8ECF1] bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="business-trust-heading">
			<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
				<div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
					<div class="lg:col-span-5">
						<p class="text-xs font-bold uppercase tracking-[0.22em] text-brand-600">ตัวตนและขั้นตอนที่ตรวจสอบได้</p>
						<h2 id="business-trust-heading" class="mt-4 text-[clamp(1.5rem,2.8vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
							บริการภายใต้ AMPHON TRADING
						</h2>
						<p class="mt-4 text-base leading-relaxed text-text-muted">
							WE BUY ดำเนินการโดย **บริษัท อำพล เทรดดิ้ง จำกัด** จดทะเบียนพาณิชย์และหน้าร้านที่ชัดเจน อุ่นใจตลอดกระบวนการ
						</p>
						
						<div class="mt-8 space-y-4 text-sm text-text-muted">
							<div class="flex items-start gap-3">
								<span class="text-xl" aria-hidden="true">📍</span>
								<div>
									<p class="font-bold text-text">ที่ตั้งหน้าร้าน</p>
									<p class="mt-1">740/8 ถนนชยางกูร ต.ในเมือง อ.เมืองอุบลราชธานี จ.อุบลราชธานี 34000</p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<span class="text-xl" aria-hidden="true">📞</span>
								<div>
									<p class="font-bold text-text">เบอร์โทรศัพท์</p>
									<p class="mt-1"><a href={telHref} class="hover:underline text-text font-semibold">{phoneDisplay}</a></p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<span class="text-xl" aria-hidden="true">💬</span>
								<div>
									<p class="font-bold text-text">LINE ID</p>
									<p class="mt-1"><a href={lineUrl} target="_blank" rel="noopener noreferrer" class="hover:underline text-text font-semibold">@webuy</a></p>
								</div>
							</div>
							<div class="flex items-start gap-3">
								<span class="text-xl" aria-hidden="true">⏰</span>
								<div>
									<p class="font-bold text-text">เวลาทำการประสานงาน</p>
									<p class="mt-1">ส่งข้อความผ่านแชทได้ตลอด 24 ชั่วโมง (ตอบกลับประเมินราคารวดเร็ว 09:00 - 21:00 น. ทุกวัน)</p>
								</div>
							</div>
						</div>

						<div class="mt-8 flex flex-wrap gap-4">
							<a
								href="/ความน่าเชื่อถือ/"
								class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand-600 px-6 py-2.5 text-sm font-bold text-white shadow-md shadow-brand-600/25 transition hover:-translate-y-0.5 hover:bg-brand-700"
							>
								ดูข้อมูลความน่าเชื่อถือ
							</a>
							<a
								href={mapUrl}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex min-h-11 items-center justify-center rounded-full border border-gray-200 bg-white px-6 py-2.5 text-sm font-semibold text-text-muted hover:border-brand-500/20 hover:text-brand-700 transition"
							>
								ดูแผนที่ Google Maps
							</a>
						</div>
					</div>
					
					<div class="lg:col-span-7">
						<div class="overflow-hidden rounded-[1.375rem] border border-gray-200/90 bg-white p-2 shadow-sm">
							<iframe
								src={mapEmbedSrc}
								width="100%"
								height="380"
								style="border:0;"
								allowfullscreen=""
								loading="lazy"
								referrerpolicy="no-referrer-when-downgrade"
								class="rounded-xl"
								title="แผนที่ตั้งร้าน บริษัท อำพล เทรดดิ้ง จำกัด"
							></iframe>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 9: Useful preparation checklist -->
		<section class="border-b border-[#E8ECF1] bg-[#FFFBEB]/45 py-16 sm:py-20 lg:py-24" aria-labelledby="prep-checklist-heading">
			<div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
				<div class="rounded-3xl border border-amber-200/80 bg-white p-8 sm:p-10 shadow-sm">
					<div class="text-center">
						<span class="text-4xl" aria-hidden="true">📋</span>
						<h2 id="prep-checklist-heading" class="mt-4 text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
							เตรียมข้อมูลอะไรบ้างก่อนส่งประเมิน
						</h2>
						<p class="mt-2 text-sm text-text-muted">
							เตรียมข้อมูลเหล่านี้ให้ครบถ้วนเพื่อความรวดเร็วและแม่นยำสูงสุดในการตีราคากลางล่วงหน้า
						</p>
					</div>
					
					<ul class="mt-8 grid gap-4 sm:grid-cols-2 text-sm text-text">
						{[
							{ title: 'รูปถ่ายชัดเจน', desc: 'รูปตัวเครื่องด้านหน้า ด้านหลัง และตามมุมมองที่มี' },
							{ title: 'ยี่ห้อและชื่อรุ่น', desc: 'ชื่อแบรนด์ รุ่นสินค้า และรหัสโมเดลบนตัวเครื่อง' },
							{ title: 'ข้อมูลสเปก/ความจุ', desc: 'ขนาดของหน่วยความจำ RAM, SSD/ROM และตัวโปรเซสเซอร์' },
							{ title: 'สภาพเครื่องจริง', desc: 'ข้อมูลความสวยงามของตัวบอดี้และรอยขีดข่วน' },
							{ title: 'อาการขัดข้องขัดใจ', desc: 'ระบุจุดตำหนิ หรืออาการเปิดไม่ติด ชาร์จเข้าช้า (ถ้ามี)' },
							{ title: 'ความครบครันอุปกรณ์', desc: 'สายชาร์จ อะแดปเตอร์ กล่อง ปากกา คีย์บอร์ดเดิม' },
							{ title: 'ใบรับประกันศุนย์/ใบเสร็จ', desc: 'ใบเสร็จรับเงิน หรือระยะเวลาประกันศุนย์ที่เหลืออยู่จริง' }
						].map((item) => (
							<li class="flex items-start gap-3 p-3 rounded-xl bg-brand-50/20 border border-brand-500/5">
								<span class="mt-0.5 text-lg" aria-hidden="true">✅</span>
								<div>
									<p class="font-bold text-text">{item.title}</p>
									<p class="mt-0.5 text-xs text-text-muted leading-relaxed">{item.desc}</p>
								</div>
							</li>
						))}
					</ul>
					
					<div class="mt-10 text-center">
						<a
							href={lineUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex min-h-11 items-center justify-center gap-2.5 rounded-full bg-line-refined px-8 py-3 text-base font-bold !text-white shadow-lg shadow-emerald-950/20 transition hover:-translate-y-0.5 hover:bg-line-refined-hover"
						>
							<svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
								<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
							</svg>
							<span>ส่งข้อมูลทาง LINE @webuy</span>
						</a>
						
						<p class="mt-4 text-xs text-text-muted">
							อ่านคำแนะนำการตรวจเช็กสเปกของเครื่องตามแต่ละระบบปฏิบัติการได้ที่ <a href="/คู่มือก่อนขาย/" class="font-semibold text-brand-700 hover:underline">คู่มือก่อนขาย</a>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- Section 10: Helpful articles -->
		{recent.length > 0 && (
			<section class="border-b border-[#E8ECF1] bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="recent-posts-heading">
				<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
					<div class="text-center">
						<p class="text-xs font-bold uppercase tracking-[0.22em] text-brand-600">ฐานความรู้และการเตรียมตัว</p>
						<h2 id="recent-posts-heading" class="mt-4 text-[clamp(1.5rem,2.5vw+1rem,2rem)] font-extrabold tracking-tight text-text">
							บทความที่เป็นประโยชน์สำหรับผู้ขาย
						</h2>
						<p class="mx-auto mt-3 max-w-[36rem] text-sm leading-relaxed text-text-muted">
							คำแนะนำ วิธีการตรวจสอบสเปก และข้อควรระวังก่อนตัดสินใจส่งมอบเครื่อง
						</p>
					</div>
					
					<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
						{recent.map((post) => (
							<article class="group flex flex-col overflow-hidden rounded-[var(--radius-card,1rem)] border border-gray-200/90 bg-white shadow-sm transition hover:shadow-md hover:border-brand-500/20">
								<div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
									<img
										src={post.data.heroImage ?? '/og-default.png'}
										alt={post.data.heroImageAlt ?? post.data.title}
										width="320"
										height="200"
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover transition duration-300 group-hover:scale-102"
									/>
								</div>
								<div class="flex flex-1 flex-col p-5">
									<h3 class="line-clamp-2 text-sm font-bold leading-snug text-text group-hover:text-brand-700">
										<a href={`/${post.data.slug}/`}>
											{post.data.title}
										</a>
									</h3>
									<p class="mt-2 line-clamp-2 flex-1 text-xs leading-relaxed text-text-muted">
										{post.data.description}
									</p>
									<span class="mt-4 inline-flex items-center text-xs font-semibold text-brand-600 transition group-hover:text-brand-700">
										อ่านต่อ →
									</span>
								</div>
							</article>
						))}
					</div>
					
					<div class="mt-10 text-center">
						<a href="/blog/" class="text-sm font-semibold text-brand-600 hover:text-brand-700 hover:underline">
							ดูบทความและคู่มือทั้งหมด
						</a>
					</div>
				</div>
			</section>
		)}

		<!-- Section 11: Final CTA band -->
		<CtaBand
			heading="พร้อมส่งข้อมูลเพื่อประเมินราคาเบื้องต้นหรือยัง"
			text="ส่งรูป รุ่น สเปก สภาพ และอุปกรณ์ที่มีทาง LINE ทีมงานจะตอบกลับตามลำดับในเวลาทำการ"
		/>
	</div>
</BaseLayout>
