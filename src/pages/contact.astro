---
import BaseLayout from '../layouts/BaseLayout.astro';
import NaturalSeoSections from '../components/longform/NaturalSeoSections.astro';
import { formatPageTitle, getSiteOrigin } from '../lib/site';

const site = getSiteOrigin();
const siteName = import.meta.env.PUBLIC_SITE_NAME ?? 'เรารับซื้อ.com';
const addressLocality = import.meta.env.PUBLIC_ADDRESS_LOCALITY ?? 'กรุงเทพมหานคร';
const addressRegion = import.meta.env.PUBLIC_ADDRESS_REGION ?? 'ประเทศไทย';
const postalCode = import.meta.env.PUBLIC_POSTAL_CODE ?? '10200';
const mapEmbedSrc =
	import.meta.env.PUBLIC_GOOGLE_MAP_EMBED ??
	'https://www.google.com/maps?q=13.7563,100.5018&z=12&output=embed';
const mapUrl =
	import.meta.env.PUBLIC_GOOGLE_MAP_URL ??
	'https://maps.google.com/?q=13.7563,100.5018';
const businessPhone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const openingHours = import.meta.env.PUBLIC_OPENING_HOURS ?? 'เปิดบริการทุกวัน 24 ชั่วโมง';
const serviceAreasRaw =
	import.meta.env.PUBLIC_SERVICE_AREAS ??
	'กรุงเทพมหานคร,ปริมณฑล,อุบลราชธานี,ขอนแก่น,นครราชสีมา,อุดรธานี';
const serviceAreas = serviceAreasRaw
	.split(',')
	.map((item) => item.trim())
	.filter(Boolean);

const geoLat = Number(import.meta.env.PUBLIC_GEO_LAT ?? '13.7563');
const geoLon = Number(import.meta.env.PUBLIC_GEO_LON ?? '100.5018');
const orgId = `${site}/#organization`;
const localId = `${site}/#localbusiness`;

const contactJsonLd: Array<Record<string, unknown>> = [
	{
		'@context': 'https://schema.org',
		'@type': 'ContactPage',
		name: `ติดต่อเรา | ${siteName}`,
		url: `${site}/contact/`,
		mainEntity: {
			'@type': 'LocalBusiness',
			'@id': localId,
			name: siteName,
			parentOrganization: { '@id': orgId },
			telephone: businessPhone,
			areaServed: serviceAreas.map((area) => ({
				'@type': 'AdministrativeArea',
				name: area,
			})),
			hasMap: mapUrl,
			geo: {
				'@type': 'GeoCoordinates',
				latitude: geoLat,
				longitude: geoLon,
			},
			openingHoursSpecification: [
				{
					'@type': 'OpeningHoursSpecification',
					dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
					opens: '00:00',
					closes: '23:59',
				},
			],
			address: {
				'@type': 'PostalAddress',
				addressLocality,
				addressRegion,
				postalCode,
				addressCountry: 'TH',
			},
			contactPoint: {
				'@type': 'ContactPoint',
				contactType: 'customer support',
				availableLanguage: ['Thai'],
				url: 'https://line.me/R/ti/p/@webuy',
				telephone: businessPhone,
			},
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${site}/` },
			{ '@type': 'ListItem', position: 2, name: 'ติดต่อเรา', item: `${site}/contact/` },
		],
	},
];
const rawMetaKw = import.meta.env.PUBLIC_META_KEYWORDS;
const contactKeywords =
	typeof rawMetaKw === 'string' && rawMetaKw.trim() !== ''
		? `ติดต่อ,${rawMetaKw.trim()}`
		: 'ติดต่อ,รับซื้อโน๊ตบุ๊ค,รับซื้อคอม,Line @webuy,WE BUY';
---

<BaseLayout
	title={formatPageTitle('ติดต่อเรา')}
	description="ติดต่อทีมงาน WE BUY | เรารับซื้อ — รับซื้อโน้ตบุ๊ค รับซื้อคอม LINE @webuy โทร 064-2579353 พร้อมแผนที่และพื้นที่ให้บริการ"
	keywords={contactKeywords}
	pathname="/contact/"
	jsonLd={contactJsonLd}
>
	<section class="container contact">
		<div class="contact-head">
			<p class="tech-eyebrow">ติดต่อทีมงาน</p>
			<h1>ช่องทางติดต่อ — เรารับซื้อ.com</h1>
			<p>
				ต้องการประเมินราคารับซื้อโน้ตบุ๊คหรือรับซื้อคอม (หรือสอบถามบริการอื่น) ติดต่อเราผ่าน LINE ได้ทันที
				พร้อมทีมงานตอบกลับต่อเนื่อง
			</p>
		</div>

		<div class="contact-grid">
			<article class="tech-card">
				<h2>ติดต่อด่วน</h2>
				<p class="line-box">
					Line:
					<a href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">@webuy</a>
				</p>
				<p>โทรศัพท์: <a href={`tel:${businessPhone.replace(/\s+/g, '')}`}>{businessPhone}</a></p>
				<p>เวลาทำการ: {openingHours}</p>
				<a class="btn" href="https://line.me/R/ti/p/@webuy" target="_blank" rel="noopener noreferrer">
					แชท LINE ตอนนี้
				</a>
			</article>

			<article class="tech-card">
				<h2>พื้นที่ให้บริการ</h2>
				<ul>
					{serviceAreas.map((area) => (
						<li>{area}</li>
					))}
				</ul>
				<p class="mt-4 text-sm leading-relaxed text-muted">
					<a href="/พื้นที่ให้บริการ/">คู่มือรับซื้อตามพื้นที่</a>
					— ลิงก์ไปหน้าคู่มือ local ที่มีอยู่จริงบนเว็บไซต์
				</p>
			</article>
		</div>

		<section class="map-wrap" aria-label="แผนที่">
			<h2 class="tech-h2">แผนที่</h2>
		<iframe
			title="แผนที่ตำแหน่งบริการ"
			src={mapEmbedSrc}
			width="960"
			height="400"
			loading="lazy"
			referrerpolicy="no-referrer-when-downgrade"
		></iframe>
		</section>

		<NaturalSeoSections
			theme="ช่องทางติดต่อและการนัดประเมินก่อนขาย"
			audience="คนที่ต้องการเช็กราคา นัดรับ ส่งรูป หรือคุยเงื่อนไขก่อนขายอุปกรณ์ไอทีมือสอง"
			geo={serviceAreas.join(', ')}
			emphasis="เริ่มจากการส่งข้อมูลที่ถูกต้องก่อน เพื่อให้การนัดหมายและการประเมินไม่เสียรอบ"
			prepareItems={[
				'ส่งรุ่น สเปก ความจุ หรือประเภทของอุปกรณ์ให้ครบตั้งแต่ข้อความแรก',
				'ถ่ายรูปสภาพจริงหลายมุม รวมถึงตำหนิที่มีผลต่อราคา',
				'แจ้งพื้นที่หรือจังหวัดคร่าว ๆ เพื่อให้ประเมินรูปแบบนัดรับหรือจัดส่งได้เหมาะสม',
				'แจ้งอาการผิดปกติ บัญชีผู้ใช้ หรือข้อจำกัดเรื่องเวลาให้ตรงตั้งแต่ต้น',
			]}
			valueFactors={[
				'การใช้ LINE หรือช่องทางที่ย้อนดูรายละเอียดได้เมื่อเทียบกับการคุยปากเปล่า',
				'การระบุพื้นที่ให้บริการอย่างตรงไปตรงมา ไม่เขียนเหมือนมีหน้าร้านทุกจังหวัด',
				'การมีแผนที่ เบอร์โทร และข้อมูลธุรกิจที่เชื่อมกันสอดคล้อง',
				'การคุยจากข้อมูลจริงก่อน แล้วค่อยขยับไปเรื่องนัดหมายหรือราคาสุดท้าย',
			]}
			commonMistakes={[
				'ทักมาด้วยคำว่า “ขายครับ” หรือ “ให้เท่าไร” โดยไม่มีรุ่นและรูปประกอบเลย',
				'ไม่แจ้งว่ามีตำหนิหรือมีปัญหาเรื่องบัญชี ทำให้ตอนนัดจริงต้องเสียเวลาเพิ่ม',
				'เข้าใจว่าพื้นที่ให้บริการหมายถึงมีทีมออกไปรับถึงบ้านทุกอำเภอแบบทันที',
				'เปรียบเทียบราคาข้ามประเภทสินค้าโดยไม่ดูสเปกและสภาพจริงของเครื่องตัวเอง',
			]}
			internalLinks={[
				{ href: '/เช็กราคาก่อนขาย/', label: 'ดูรายการข้อมูลที่ควรส่งก่อนเช็กราคา' },
				{ href: '/พื้นที่ให้บริการ/', label: 'ดูพื้นที่ให้บริการและคู่มือ local' },
				{ href: '/ความน่าเชื่อถือ/', label: 'อ่านขั้นตอนซื้อขายและความปลอดภัยข้อมูล' },
			]}
			density="full"
		/>
	</section>
</BaseLayout>

<style>
	.contact {
		padding-top: 2rem;
	}
	.contact-head h1 {
		margin: 0.2rem 0 0.65rem;
		font-size: clamp(1.5rem, 3.4vw, 2.1rem);
	}
	.contact-head p {
		margin: 0;
		max-width: 62ch;
		color: var(--muted);
	}
	.contact-grid {
		margin-top: 1.25rem;
		display: grid;
		gap: 1rem;
	}
	@media (min-width: 820px) {
		.contact-grid {
			grid-template-columns: 1.3fr 1fr;
		}
	}
	.contact-grid .tech-card {
		padding: 1.1rem 1.25rem 1.1rem 1.35rem;
	}
	.contact-grid .tech-card h2 {
		margin: 0 0 0.6rem;
		font-size: 1.1rem;
	}
	.contact-grid .tech-card p {
		margin: 0.4rem 0;
	}
	.line-box {
		font-size: 1.08rem;
		font-weight: 700;
	}
	.btn {
		display: inline-block;
		margin-top: 0.7rem;
		padding: 0.55rem 0.9rem;
		background: #06c755;
		color: #fff;
		border-radius: 8px;
		font-weight: 700;
		text-decoration: none;
	}
	.btn:hover {
		background: #04b84d;
		text-decoration: none;
	}
	.contact-grid .tech-card ul {
		margin: 0;
		padding-left: 1rem;
		display: grid;
		gap: 0.25rem;
	}
	.map-wrap {
		margin-top: 1.2rem;
	}
	.map-wrap h2 {
		margin: 0 0 0.55rem;
		font-size: 1.2rem;
	}
	.map-wrap iframe {
		width: 100%;
		min-height: 340px;
		border: 1px solid rgba(15, 23, 42, 0.1);
		border-radius: var(--radius);
		background: #f1f5f9;
		box-shadow: var(--shadow-tech);
	}
</style>
