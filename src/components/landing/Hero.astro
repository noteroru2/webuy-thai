---
import ButtonLink from './ButtonLink.astro';

interface Props {
	lineUrl?: string;
	servicesPath?: string;
	contactPath?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	servicesPath = '/บริการ/',
	contactPath = '/contact/',
} = Astro.props;
---

<section
	class="relative overflow-hidden border-b border-gray-200/70 bg-gradient-to-b from-white via-[#FAFAFA] to-[#FFF7ED]/35"
	aria-labelledby="hero-heading"
>
	<div class="pointer-events-none absolute inset-0" aria-hidden="true">
		<div
			class="absolute -left-[20%] -top-[10%] h-[28rem] w-[28rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.14)_0%,rgba(255,243,232,0.4)_42%,transparent_68%)] blur-3xl"
		>
		</div>
		<div
			class="absolute -bottom-[20%] -right-[15%] h-[24rem] w-[24rem] rounded-full bg-[radial-gradient(circle_at_center,rgba(249,115,22,0.09)_0%,transparent_55%)] blur-3xl"
		>
		</div>
	</div>

	<div
		class="relative mx-auto grid max-w-[1200px] gap-10 px-4 py-14 sm:gap-12 sm:px-6 sm:py-16 md:py-20 lg:grid-cols-2 lg:items-center lg:gap-14 lg:px-8 lg:py-20 xl:gap-16 xl:py-24"
	>
		<div class="flex min-w-0 flex-col justify-center">
			<p
				class="mb-4 inline-flex w-fit items-center rounded-full border border-brand-500/20 bg-brand-50/90 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-700 sm:text-xs"
			>
				IT Core · รับซื้อโน้ตบุ๊ค · รับซื้อคอม
			</p>
			<h1
				id="hero-heading"
				class="text-[clamp(1.75rem,4vw+1rem,3rem)] font-extrabold leading-[1.18] tracking-tight text-text lg:leading-[1.15]"
			>
				รับซื้อโน้ตบุ๊คและคอมพิวเตอร์มือสอง ประเมินราคายุติธรรม พร้อมบริการไอทีครบวงจร
			</h1>
			<p class="mt-6 max-w-[38rem] text-base leading-[1.75] text-text-muted sm:text-lg">
				เน้นรับซื้อโน้ตบุ๊คและรับซื้อคอมพิวเตอร์ทุกสเปก โดยทีมงานมืออาชีพ — มีหมวดรับซื้ออุปกรณ์อื่น บริการซ่อม/จำหน่าย และช่องทาง LINE โปร่งใสทุกขั้นตอน
			</p>
			<div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center lg:max-w-xl">
				<ButtonLink href={contactPath} variant="primary" class="justify-center sm:justify-center">ติดต่อเรา</ButtonLink>
				<ButtonLink href={lineUrl} variant="secondary" target="_blank" rel="noopener noreferrer" class="justify-center">
					ประเมินราคาฟรี
				</ButtonLink>
				<ButtonLink
					href={servicesPath}
					variant="secondary"
					class="justify-center !border-gray-200 !text-text-muted hover:!border-brand-500/30 hover:!bg-white hover:!text-brand-700"
				>
					ดูบริการทั้งหมด
				</ButtonLink>
			</div>
			<dl class="mt-12 grid gap-6 border-t border-gray-200/90 pt-10 sm:grid-cols-3">
				<div>
					<dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">ช่องทางหลัก</dt>
					<dd class="mt-1.5 font-semibold text-brand-700">
						<a
							href={lineUrl}
							class="underline decoration-brand-500/35 underline-offset-4 transition hover:decoration-brand-600"
							target="_blank"
							rel="noopener noreferrer">LINE @webuy</a
						>
					</dd>
				</div>
				<div>
					<dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">การตอบกลับ</dt>
					<dd class="mt-1.5 font-semibold text-text">ภายในไม่กี่ชั่วโมง</dd>
				</div>
				<div>
					<dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-muted">ความน่าเชื่อถือ</dt>
					<dd class="mt-1.5 font-semibold text-text">ตรวจเช็กละเอียดก่อนสรุปราคา</dd>
				</div>
			</dl>
		</div>

		<div class="relative flex justify-center lg:justify-end">
			<div
				class="absolute -inset-4 rounded-[1.75rem] bg-gradient-to-br from-brand-500/12 via-transparent to-brand-600/5 blur-2xl lg:-inset-6"
				aria-hidden="true"
			>
			</div>
			<div
				class="relative w-full max-w-lg overflow-hidden rounded-[1.375rem] border border-brand-500/15 bg-white p-7 shadow-[0_1px_2px_rgba(15,23,42,0.05),0_24px_48px_-20px_rgba(15,23,42,0.14)] ring-1 ring-black/[0.04] sm:p-9"
			>
				<div
					class="pointer-events-none absolute inset-0 bg-gradient-to-br from-brand-500/[0.07] via-white/80 to-transparent"
					aria-hidden="true"
				>
				</div>
				<div class="relative flex flex-wrap items-center gap-2">
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-gray-200/80 bg-[#FAFAFA] px-2.5 py-1 text-[11px] font-semibold text-text-muted"
					>
						<svg class="h-3.5 w-3.5 text-brand-600" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
							<path
								fill-rule="evenodd"
								d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
								clip-rule="evenodd"></path>
						</svg>
						ตรวจสอบก่อนสรุปราคา
					</span>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-brand-500/25 bg-brand-50/80 px-2.5 py-1 text-[11px] font-bold text-brand-800"
					>
						ประเมินฟรี
					</span>
					<span
						class="inline-flex items-center gap-1.5 rounded-full border border-gray-200/80 bg-white px-2.5 py-1 text-[11px] font-semibold text-text-muted"
					>
						หน้าร้าน · ออนไลน์
					</span>
				</div>
				<p class="relative mt-5 text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">ประเมินอย่างมืออาชีพ</p>
				<p class="relative mt-2 text-lg font-bold leading-snug text-text sm:text-xl">
					เตรียมข้อมูลสั้น ๆ เพื่อให้ได้ราคาที่แม่นขึ้น
				</p>
				<ul class="relative mt-6 space-y-3.5 text-sm leading-[1.65] text-text-muted sm:text-[0.9375rem]">
					<li class="flex gap-3">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
						<span>รุ่นเครื่อง · สเปก · สภาพโดยรวม</span>
					</li>
					<li class="flex gap-3">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
						<span>รูปถ่ายหลายมุม สะท้อนสภาพจริง</span>
					</li>
					<li class="flex gap-3">
						<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
						<span>อุปกรณ์ครบ กล่อง หรือใบเสร็จ (ถ้ามี)</span>
					</li>
				</ul>
				<div
					class="relative mt-8 rounded-2xl border border-gray-100 bg-gradient-to-b from-[#F8F8F8] to-white p-5 shadow-inner shadow-gray-900/[0.03]"
				>
					<p class="text-sm font-bold text-text">เริ่มได้ทันที</p>
					<p class="mt-1.5 text-sm leading-relaxed text-text-muted">
						แอด LINE ส่งข้อมูลมาได้เลย — ประเมินเบื้องต้นไม่มีค่าใช้จ่าย
					</p>
					<div class="mt-4">
						<ButtonLink href={lineUrl} variant="line" class="w-full sm:w-auto" target="_blank" rel="noopener noreferrer">
							คุยกับทีมงาน
						</ButtonLink>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
