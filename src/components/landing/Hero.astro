---
interface Props {
	lineUrl?: string;
	servicesPath?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	servicesPath = '/รับซื้อ/',
} = Astro.props;
---

<section class="hero-section relative overflow-hidden" aria-labelledby="hero-heading">
	<!-- Gradient background -->
	<div class="hero-bg" aria-hidden="true"></div>
	<div class="hero-orb hero-orb-1" aria-hidden="true"></div>
	<div class="hero-orb hero-orb-2" aria-hidden="true"></div>
	<div class="hero-orb hero-orb-3" aria-hidden="true"></div>

	<div class="hero-container">
		<!-- Left Column: Content -->
		<div class="hero-content">
			<div class="hero-eyebrow">
				<span class="hero-eyebrow-dot" aria-hidden="true"></span>
				<span>WE BUY · รับซื้อสินค้าไอทีมือสอง</span>
			</div>

			<h1 id="hero-heading" class="hero-h1">
				รับซื้อสินค้าไอทีมือสอง<br />
				<span class="hero-h1-accent">ประเมินราคาเบื้องต้นก่อนได้</span>
			</h1>

			<p class="hero-sub">
				โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้อง<br class="hidden sm:block" />
				ส่งรูป รุ่น สเปก และสภาพมาประเมินเบื้องต้นทาง LINE
			</p>

			<div class="hero-ctas">
				<a
					href={lineUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="hero-btn hero-btn-primary"
				>
					<svg class="hero-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
					</svg>
					ส่งรูปประเมินทาง LINE
				</a>
				<a href={servicesPath} class="hero-btn hero-btn-secondary">
					ดูหมวดสินค้าทั้งหมด
					<svg class="hero-btn-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
					</svg>
				</a>
			</div>

			<ul class="hero-trust-list" aria-label="จุดเด่นบริการ">
				<li class="hero-trust-item">
					<span class="hero-trust-dot" aria-hidden="true"></span>
					<span>ประเมินเบื้องต้นฟรี</span>
				</li>
				<li class="hero-trust-item">
					<span class="hero-trust-dot" aria-hidden="true"></span>
					<span>ตรวจรับก่อนชำระเงิน</span>
				</li>
				<li class="hero-trust-item">
					<span class="hero-trust-dot" aria-hidden="true"></span>
					<span>บริการทั่วประเทศ</span>
				</li>
			</ul>
		</div>

		<!-- Right Column: Floating Cards Panel -->
		<div class="hero-cards-panel" aria-hidden="true">
			<div class="hero-main-card">
				<div class="hero-main-card-icon">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7m0 10a2 2 0 002 2h2a2 2 0 002-2V7a2 2 0 00-2-2h-2a2 2 0 00-2 2" />
					</svg>
				</div>
				<div>
					<p class="hero-main-card-title">รับซื้อสินค้าไอทีมือสอง</p>
					<p class="hero-main-card-sub">โน๊ตบุ๊ค · คอม · MacBook · iPhone · iPad · กล้อง</p>
				</div>
			</div>

			<div class="hero-feature-cards">
				<div class="hero-feature-card hero-feature-card--teal">
					<div class="hero-feature-card-icon hero-feature-card-icon--teal">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
						</svg>
					</div>
					<div>
						<p class="hero-feature-card-title">ตรวจตามสภาพจริง</p>
						<p class="hero-feature-card-sub">ประเมินตามรุ่น สเปก และสภาพ</p>
					</div>
				</div>

				<div class="hero-feature-card hero-feature-card--navy">
					<div class="hero-feature-card-icon hero-feature-card-icon--navy">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
						</svg>
					</div>
					<div>
						<p class="hero-feature-card-title">ประเมินก่อนตัดสินใจ</p>
						<p class="hero-feature-card-sub">แจ้งราคาเบื้องต้นก่อนตกลง</p>
					</div>
				</div>

				<div class="hero-feature-card hero-feature-card--orange">
					<div class="hero-feature-card-icon hero-feature-card-icon--orange">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
						</svg>
					</div>
					<div>
						<p class="hero-feature-card-title">ดำเนินการโดย</p>
						<p class="hero-feature-card-sub">AMPHON TRADING</p>
					</div>
				</div>
			</div>

			<div class="hero-contact-card">
				<div class="hero-contact-item">
					<svg class="hero-contact-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
					</svg>
					<span>LINE @webuy</span>
				</div>
				<div class="hero-contact-divider" aria-hidden="true"></div>
				<div class="hero-contact-item">
					<svg class="hero-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
						<path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
					</svg>
					<a href="tel:0642579353" class="hero-contact-phone">064-257-9353</a>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Stats bar -->
<div class="hero-stats-bar">
	<div class="hero-stats-inner">
		<dl class="hero-stats-grid">
			<div class="hero-stat">
				<dt>ช่องทางหลัก</dt>
				<dd>LINE @webuy</dd>
			</div>
			<div class="hero-stat-divider" aria-hidden="true"></div>
			<div class="hero-stat">
				<dt>โทรศัพท์</dt>
				<dd><a href="tel:0642579353">064-257-9353</a></dd>
			</div>
			<div class="hero-stat-divider" aria-hidden="true"></div>
			<div class="hero-stat">
				<dt>ดำเนินงานโดย</dt>
				<dd>AMPHON TRADING</dd>
			</div>
			<div class="hero-stat-divider" aria-hidden="true"></div>
			<div class="hero-stat">
				<dt>ให้บริการ</dt>
				<dd>ทั่วประเทศ</dd>
			</div>
		</dl>
	</div>
</div>

<style>
.hero-section {
	position: relative;
	padding-block: 5rem 6rem;
	border-bottom: 1px solid rgba(232, 236, 241, 0.5);
}
@media (min-width: 768px) {
	.hero-section { padding-block: 6rem 7rem; }
}
.hero-bg {
	position: absolute;
	inset: 0;
	background: linear-gradient(135deg, #0b1f3a 0%, #132d4f 40%, #0d4a5a 75%, #0b3347 100%);
	z-index: 0;
}
.hero-orb {
	position: absolute;
	border-radius: 50%;
	filter: blur(80px);
	pointer-events: none;
	z-index: 0;
}
.hero-orb-1 {
	width: 500px; height: 500px;
	top: -100px; right: -80px;
	background: radial-gradient(circle, rgba(20,184,166,.18) 0%, transparent 70%);
}
.hero-orb-2 {
	width: 400px; height: 400px;
	bottom: -80px; left: -60px;
	background: radial-gradient(circle, rgba(245,158,11,.12) 0%, transparent 70%);
}
.hero-orb-3 {
	width: 300px; height: 300px;
	top: 40%; left: 35%;
	background: radial-gradient(circle, rgba(255,255,255,.04) 0%, transparent 70%);
}
.hero-container {
	position: relative;
	z-index: 1;
	max-width: 75rem;
	margin-inline: auto;
	padding-inline: 1rem;
	display: grid;
	gap: 3rem;
	align-items: center;
}
@media (min-width: 640px) { .hero-container { padding-inline: 1.5rem; } }
@media (min-width: 1024px) {
	.hero-container {
		grid-template-columns: 1fr 1fr;
		gap: 4rem;
		padding-inline: 2rem;
	}
}
.hero-content { color: #fff; }
.hero-eyebrow {
	display: inline-flex;
	align-items: center;
	gap: .5rem;
	background: rgba(255,255,255,.1);
	border: 1px solid rgba(255,255,255,.2);
	backdrop-filter: blur(4px);
	border-radius: 999px;
	padding: .375rem .875rem;
	font-size: .6875rem;
	font-weight: 700;
	letter-spacing: .14em;
	text-transform: uppercase;
	color: rgba(255,255,255,.9);
	margin-bottom: 1.25rem;
}
.hero-eyebrow-dot {
	width: 6px; height: 6px;
	border-radius: 50%;
	background: #14b8a6;
	flex-shrink: 0;
	animation: pulse-dot 2s ease-in-out infinite;
}
@keyframes pulse-dot {
	0%,100% { opacity:1; transform:scale(1); }
	50% { opacity:.6; transform:scale(.85); }
}
.hero-h1 {
	font-size: clamp(2rem, 4vw + 1rem, 3.25rem);
	font-weight: 800;
	line-height: 1.15;
	letter-spacing: -.02em;
	color: #fff;
	margin-bottom: 1.25rem;
}
.hero-h1-accent { color: #f59e0b; }
.hero-sub {
	font-size: 1.0625rem;
	line-height: 1.75;
	color: rgba(255,255,255,.75);
	max-width: 30rem;
	margin-bottom: 2rem;
}
.hero-ctas {
	display: flex;
	flex-direction: column;
	gap: .875rem;
	margin-bottom: 1.75rem;
}
@media (min-width: 480px) {
	.hero-ctas { flex-direction: row; flex-wrap: wrap; align-items: center; }
}
.hero-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: .5rem;
	min-height: 48px;
	padding: .75rem 1.625rem;
	border-radius: 999px;
	font-size: .9375rem;
	font-weight: 700;
	text-decoration: none !important;
	transition: transform .2s ease, box-shadow .2s ease, background-color .2s ease, border-color .2s ease;
	white-space: nowrap;
}
.hero-btn:hover { transform: translateY(-2px); text-decoration: none !important; }
.hero-btn-icon { width: 1.125rem; height: 1.125rem; flex-shrink: 0; }
.hero-btn-arrow { width: 1rem; height: 1rem; flex-shrink: 0; transition: transform .2s ease; }
.hero-btn-secondary:hover .hero-btn-arrow { transform: translateX(3px); }
.hero-btn-primary {
	background: #f59e0b;
	color: #0b1f3a !important;
	box-shadow: 0 4px 16px rgba(245,158,11,.4);
}
.hero-btn-primary:hover {
	background: #d97706;
	box-shadow: 0 8px 24px rgba(245,158,11,.45);
}
.hero-btn-secondary {
	background: rgba(255,255,255,.1);
	border: 1.5px solid rgba(255,255,255,.3);
	color: #fff !important;
	backdrop-filter: blur(4px);
}
.hero-btn-secondary:hover {
	background: rgba(255,255,255,.18);
	border-color: rgba(255,255,255,.5);
}
.hero-trust-list {
	display: flex;
	flex-wrap: wrap;
	gap: .5rem 1.25rem;
	list-style: none;
	padding: 1.25rem 0 0;
	margin: 0;
	border-top: 1px solid rgba(255,255,255,.12);
}
.hero-trust-item {
	display: flex;
	align-items: center;
	gap: .5rem;
	font-size: .875rem;
	color: rgba(255,255,255,.75);
}
.hero-trust-dot {
	width: 6px; height: 6px;
	border-radius: 50%;
	background: #14b8a6;
	flex-shrink: 0;
}
.hero-cards-panel {
	display: none;
	flex-direction: column;
	gap: 1rem;
}
@media (min-width: 1024px) { .hero-cards-panel { display: flex; } }
.hero-main-card {
	display: flex;
	align-items: center;
	gap: 1rem;
	background: rgba(255,255,255,.97);
	border: 1px solid rgba(255,255,255,.8);
	border-radius: 1.125rem;
	padding: 1.25rem 1.5rem;
	box-shadow: 0 8px 32px rgba(11,31,58,.2), 0 2px 8px rgba(11,31,58,.1);
}
.hero-main-card-icon {
	flex-shrink: 0;
	width: 3rem; height: 3rem;
	display: flex;
	align-items: center;
	justify-content: center;
	background: linear-gradient(135deg, #0b1f3a, #1e3a5f);
	border-radius: .75rem;
	color: #fff;
}
.hero-main-card-icon svg { width: 1.5rem; height: 1.5rem; }
.hero-main-card-title { font-size: .9375rem; font-weight: 700; color: #1f2937; margin: 0 0 .25rem; }
.hero-main-card-sub { font-size: .8125rem; color: #6b7280; margin: 0; }
.hero-feature-cards {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: .75rem;
}
.hero-feature-card:last-child { grid-column: 1 / -1; }
.hero-feature-card {
	display: flex;
	align-items: center;
	gap: .875rem;
	background: rgba(255,255,255,.97);
	border-radius: 1rem;
	padding: 1rem 1.125rem;
	box-shadow: 0 4px 16px rgba(11,31,58,.15), 0 1px 4px rgba(11,31,58,.08);
	transition: transform .2s ease;
}
.hero-feature-card:hover { transform: translateY(-2px); }
.hero-feature-card-icon {
	flex-shrink: 0;
	width: 2.5rem; height: 2.5rem;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: .625rem;
}
.hero-feature-card-icon svg { width: 1.25rem; height: 1.25rem; }
.hero-feature-card-icon--teal { background: rgba(20,184,166,.12); color: #0d9488; }
.hero-feature-card-icon--navy { background: rgba(11,31,58,.08); color: #0b1f3a; }
.hero-feature-card-icon--orange { background: rgba(245,158,11,.12); color: #d97706; }
.hero-feature-card-title { font-size: .8125rem; font-weight: 700; color: #1f2937; margin: 0 0 .15rem; }
.hero-feature-card-sub { font-size: .75rem; color: #6b7280; margin: 0; }
.hero-contact-card {
	display: flex;
	align-items: center;
	gap: 1rem;
	background: rgba(255,255,255,.1);
	border: 1px solid rgba(255,255,255,.2);
	border-radius: .875rem;
	padding: .875rem 1.25rem;
	backdrop-filter: blur(8px);
}
.hero-contact-item {
	display: flex;
	align-items: center;
	gap: .5rem;
	font-size: .875rem;
	font-weight: 600;
	color: rgba(255,255,255,.9);
}
.hero-contact-icon { width: 1rem; height: 1rem; flex-shrink: 0; opacity: .8; }
.hero-contact-divider {
	width: 1px; height: 1.25rem;
	background: rgba(255,255,255,.2);
	flex-shrink: 0;
}
.hero-contact-phone { color: rgba(255,255,255,.9) !important; text-decoration: none; transition: color .15s ease; }
.hero-contact-phone:hover { color: #f59e0b !important; }
.hero-stats-bar { background: #0b1f3a; border-bottom: 1px solid rgba(255,255,255,.06); }
.hero-stats-inner {
	max-width: 75rem;
	margin-inline: auto;
	padding: 1rem 1rem;
}
@media (min-width: 640px) { .hero-stats-inner { padding: 1rem 1.5rem; } }
@media (min-width: 1024px) { .hero-stats-inner { padding: 1rem 2rem; } }
.hero-stats-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: .75rem 1rem;
	align-items: center;
}
@media (min-width: 640px) {
	.hero-stats-grid {
		grid-template-columns: auto 1px auto 1px auto 1px auto;
		gap: 0;
		justify-content: center;
	}
}
.hero-stat { text-align: center; }
.hero-stat dt {
	font-size: .625rem;
	font-weight: 600;
	letter-spacing: .18em;
	text-transform: uppercase;
	color: rgba(255,255,255,.45);
	margin-bottom: .2rem;
}
.hero-stat dd { font-size: .875rem; font-weight: 700; color: #fff; }
.hero-stat dd a { color: #fff; text-decoration: none; transition: color .15s ease; }
.hero-stat dd a:hover { color: #f59e0b; }
.hero-stat-divider { display: none; }
@media (min-width: 640px) {
	.hero-stat-divider {
		display: block;
		width: 1px; height: 2rem;
		background: rgba(255,255,255,.12);
		margin-inline: 2rem;
	}
}
</style>
