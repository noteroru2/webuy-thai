---
import ButtonLink from './ButtonLink.astro';

interface Props {
	lineUrl?: string;
	servicesPath?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	servicesPath = '/รับซื้อ/',
} = Astro.props;

const heroImage = '/media/notebook-showcase/shop-owner-ubon-showroom.webp';
---

<section class="relative overflow-hidden border-b border-[#E8ECF1]" aria-labelledby="hero-heading">
	<div class="absolute inset-0" aria-hidden="true">
		<img
			src={heroImage}
			alt=""
			width="1600"
			height="900"
			fetchpriority="high"
			decoding="async"
			class="h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A]/82 via-[#0B1F3A]/58 to-[#0B1F3A]/35"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-[#0B1F3A]/45 via-transparent to-transparent"></div>
	</div>

	<div class="relative mx-auto max-w-[var(--width-container,75rem)] px-4 py-10 sm:px-6 sm:py-12 md:py-14 lg:px-8 lg:py-16">
		<div
			class="max-w-xl rounded-[var(--radius-card-lg,1.125rem)] border border-white/90 bg-white/97 p-6 shadow-[var(--shadow-card)] backdrop-blur-sm sm:max-w-2xl sm:p-8"
		>
			<p class="mb-3 inline-flex w-fit items-center rounded-full border border-brand-500/25 bg-brand-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-brand-700 sm:text-xs">
				WE BUY · รับซื้อสินค้าไอทีมือสอง
			</p>
			<h1
				id="hero-heading"
				class="text-[clamp(1.625rem,3.5vw+0.75rem,2.5rem)] font-extrabold leading-[1.2] tracking-tight text-navy"
			>
				รับซื้อสินค้าไอทีมือสอง<br class="hidden sm:inline" />
				<span class="sm:ml-0">ประเมินราคาเบื้องต้นก่อนได้</span>
			</h1>
			<p class="mt-4 max-w-[34rem] text-[0.9375rem] leading-[1.7] text-text-muted sm:text-base sm:leading-[1.75]">
				โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้อง<br class="hidden sm:inline" />
				ส่งรูป รุ่น สเปก และสภาพ เพื่อประเมินเบื้องต้นทาง LINE
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap sm:items-center">
				<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer" class="!min-h-11 justify-center">
					ส่งรูปประเมินทาง LINE
				</ButtonLink>
				<ButtonLink
					href={servicesPath}
					variant="secondary"
					class="!min-h-11 justify-center !border-[#E5E7EB] !bg-white !text-text-muted hover:!border-brand-500/35 hover:!text-brand-700"
				>
					ดูหมวดสินค้าที่รับซื้อ
				</ButtonLink>
			</div>
			<ul class="mt-6 grid gap-2.5 border-t border-[#E8ECF1] pt-5 text-sm text-text-muted sm:grid-cols-3 sm:gap-3">
				<li class="flex items-center gap-2">
					<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-teal ring-4 ring-teal/15" aria-hidden="true"></span>
					<span>ประเมินเบื้องต้นฟรี</span>
				</li>
				<li class="flex items-center gap-2">
					<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-teal ring-4 ring-teal/15" aria-hidden="true"></span>
					<span>ตรวจรับก่อนจ่าย</span>
				</li>
				<li class="flex items-center gap-2">
					<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-teal ring-4 ring-teal/15" aria-hidden="true"></span>
					<span>ทั่วประเทศ</span>
				</li>
			</ul>
		</div>
	</div>
</section>

<div class="border-b border-white/[0.06] bg-navy">
	<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 py-4 sm:px-6 lg:px-8">
		<dl class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4 sm:gap-4">
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-white/50">ช่องทางหลัก</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">LINE @webuy</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-white/50">โทรศัพท์</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">
					<a href="tel:0642579353" class="text-white transition hover:text-brand-400">064-257-9353</a>
				</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-white/50">ดำเนินงานโดย</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">AMPHON TRADING</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-white/50">ให้บริการ</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">ทั่วประเทศ</dd>
			</div>
		</dl>
	</div>
</div>
