---
import ButtonLink from './ButtonLink.astro';

interface Props {
	lineUrl?: string;
	servicesPath?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	servicesPath = '/รับซื้อ/',
} = Astro.props;

const heroImage = '/media/notebook-showcase/shop-owner-ubon-showroom.webp';
---

<section class="relative overflow-hidden border-b border-[#E8ECF1]" aria-labelledby="hero-heading">
	<div class="absolute inset-0" aria-hidden="true">
		<img
			src={heroImage}
			alt=""
			width="1600"
			height="900"
			fetchpriority="high"
			decoding="async"
			class="h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-[#0B1F3A]/82 via-[#0B1F3A]/58 to-[#0B1F3A]/35"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-[#0B1F3A]/45 via-transparent to-transparent"></div>
	</div>

	<div class="relative mx-auto max-w-[var(--width-container,75rem)] px-4 py-12 sm:px-6 sm:py-16 md:py-20 lg:px-8 lg:py-24">
		<div
			class="max-w-xl rounded-[var(--radius-card-lg,1.125rem)] border border-white/90 bg-white/97 p-6 shadow-[var(--shadow-card)] backdrop-blur-sm sm:max-w-2xl sm:p-8"
		>
			<p class="mb-3 inline-flex w-fit items-center rounded-full border border-brand-500/25 bg-brand-50 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.14em] text-brand-700 sm:text-xs">
				WE BUY — บริการรับซื้อสินค้าไอทีมือสอง
			</p>
			<h1
				id="hero-heading"
				class="text-[clamp(1.625rem,3.5vw+0.75rem,2.5rem)] font-extrabold leading-[1.2] tracking-tight text-navy"
			>
				รับซื้อสินค้าไอทีมือสอง<br class="hidden sm:inline" />
				ประเมินราคาเบื้องต้นก่อนได้
			</h1>
			<p class="mt-4 max-w-[34rem] text-[0.9375rem] leading-[1.7] text-text-muted sm:text-base sm:leading-[1.75]">
				รับซื้อโน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad กล้อง และอุปกรณ์ไอที ส่งรูป รุ่น สเปก สภาพ และอุปกรณ์ที่มีทาง LINE เพื่อประเมินเบื้องต้นก่อนตัดสินใจขาย
			</p>
			<div class="mt-6 flex flex-col gap-3 sm:mt-7 sm:flex-row sm:flex-wrap sm:items-center">
				<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer" class="!min-h-11 justify-center">
					ส่งรูปประเมินทาง LINE
				</ButtonLink>
				<ButtonLink
					href={servicesPath}
					variant="secondary"
					class="!min-h-11 justify-center !border-[#E5E7EB] !bg-white !text-text-muted hover:!border-brand-500/35 hover:!text-brand-700"
				>
					ดูหมวดสินค้าที่รับซื้อ
				</ButtonLink>
			</div>
			
			<div class="mt-6 border-t border-[#E8ECF1] pt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 text-xs text-text-muted">
				<span class="flex items-center gap-1.5 font-medium">
					<span class="h-1.5 w-1.5 rounded-full bg-brand-500" aria-hidden="true"></span>
					ดำเนินการโดย บริษัท อำพล เทรดดิ้ง จำกัด
				</span>
				<span class="text-right sm:text-right font-medium text-brand-700">
					*ราคาสุดท้ายขึ้นอยู่กับรุ่น สเปก อุปกรณ์ และสภาพที่ตรวจพบจริง
				</span>
			</div>
		</div>
	</div>
</section>
