---
import ButtonLink from './ButtonLink.astro';

interface Props {
	lineUrl?: string;
	servicesPath?: string;
	contactPath?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	servicesPath = '/รับซื้อ/',
	contactPath = '/contact/',
} = Astro.props;

const heroImage = '/media/notebook-showcase/shop-owner-ubon-showroom.webp';
---

<section class="relative overflow-hidden border-b border-gray-200/70" aria-labelledby="hero-heading">
	<!-- Background image -->
	<div class="absolute inset-0" aria-hidden="true">
		<img
			src={heroImage}
			alt=""
			width="1600"
			height="900"
			fetchpriority="high"
			decoding="async"
			class="h-full w-full object-cover object-center"
		/>
		<div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40 sm:from-white/92 sm:via-white/70 sm:to-white/20"></div>
		<div class="absolute inset-0 bg-gradient-to-t from-white/60 via-transparent to-transparent sm:hidden"></div>
	</div>

	<div class="relative mx-auto max-w-[1200px] px-4 py-10 sm:px-6 sm:py-14 md:py-16 lg:px-8 lg:py-20">
		<div class="grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-12">
			<!-- Left: text (mobile-first) -->
			<div class="flex min-w-0 flex-col justify-center">
				<p class="mb-3 inline-flex w-fit items-center rounded-full border border-brand-500/20 bg-white/90 px-3 py-1.5 text-[11px] font-bold uppercase tracking-[0.16em] text-brand-700 backdrop-blur-sm sm:text-xs">
					WE BUY · รับซื้อสินค้าไอทีมือสอง
				</p>
				<h1
					id="hero-heading"
					class="text-[clamp(1.75rem,4vw+1rem,2.75rem)] font-extrabold leading-[1.18] tracking-tight text-text lg:leading-[1.15]"
				>
					ส่งรูปประเมินราคารับซื้อสินค้าไอที
				</h1>
				<p class="mt-4 max-w-[38rem] text-base leading-[1.75] text-text-muted sm:text-lg">
					โน๊ตบุ๊ค คอมพิวเตอร์ MacBook iPhone iPad และกล้อง — ส่งรูป รุ่น สเปก และสภาพเพื่อประเมินเบื้องต้นก่อนได้
				</p>
				<div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
					<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer" class="justify-center">
						ส่งรูปประเมินทาง LINE
					</ButtonLink>
					<ButtonLink
						href={servicesPath}
						variant="secondary"
						class="justify-center !border-gray-200 !bg-white/90 !text-text-muted hover:!border-brand-500/30 hover:!text-brand-700"
					>
						ดูหมวดสินค้าที่รับซื้อ
					</ButtonLink>
				</div>
			</div>

			<!-- Right: floating white card -->
			<div class="relative flex justify-center lg:justify-end">
				<div
					class="w-full max-w-md overflow-hidden rounded-2xl border border-white/80 bg-white/95 p-6 shadow-[0_8px_40px_-12px_rgba(15,23,42,0.18)] backdrop-blur-md sm:p-8"
				>
					<p class="text-[11px] font-bold uppercase tracking-[0.2em] text-brand-600">ส่งข้อมูลเพื่อรับราคาเบื้องต้น</p>
					<p class="mt-2 text-lg font-bold leading-snug text-text">เตรียมข้อมูลสั้น ๆ เพื่อให้ได้ราคาที่แม่นขึ้น</p>
					<ul class="mt-5 space-y-3 text-sm leading-[1.65] text-text-muted">
						<li class="flex gap-3">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
							<span>รุ่นเครื่อง · สเปก · สภาพโดยรวม</span>
						</li>
						<li class="flex gap-3">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
							<span>รูปถ่ายหลายมุม สะท้อนสภาพจริง</span>
						</li>
						<li class="flex gap-3">
							<span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500 ring-4 ring-brand-500/15" aria-hidden="true"></span>
							<span>อุปกรณ์ครบ กล่อง หรือใบเสร็จ (ถ้ามี)</span>
						</li>
					</ul>
					<div class="mt-6 rounded-xl border border-brand-100 bg-brand-50/60 p-4">
						<p class="text-sm font-bold text-text">เริ่มได้ทันที</p>
						<p class="mt-1 text-sm text-text-muted">แอด LINE ส่งข้อมูลมาได้เลย — ประเมินเบื้องต้นไม่มีค่าใช้จ่าย</p>
						<div class="mt-3">
							<ButtonLink href={lineUrl} variant="line" class="w-full justify-center sm:w-auto" target="_blank" rel="noopener noreferrer">
								คุยกับทีมงาน
							</ButtonLink>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<!-- Navy trust strip -->
<div class="border-b border-white/[0.06] bg-[#0f172a]">
	<div class="mx-auto max-w-[1200px] px-4 py-4 sm:px-6 lg:px-8">
		<dl class="grid grid-cols-2 gap-x-4 gap-y-3 sm:grid-cols-4 sm:gap-4">
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">ช่องทางหลัก</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">LINE @webuy</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">โทรศัพท์</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">
					<a href="tel:0642579353" class="text-white hover:text-brand-400 transition">064-257-9353</a>
				</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">ดำเนินงานโดย</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">AMPHON TRADING</dd>
			</div>
			<div class="text-center">
				<dt class="text-[10px] font-semibold uppercase tracking-widest text-gray-400">ให้บริการ</dt>
				<dd class="mt-0.5 text-sm font-bold text-white">ทั่วประเทศ</dd>
			</div>
		</dl>
	</div>
</div>
