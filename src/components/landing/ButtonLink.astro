---
// primary / line: !text-white — BaseLayout มี a { color: accent } แบบ global จะทับสีข้อความบนปุ่ม
interface Props {
	href: string;
	variant?: 'primary' | 'secondary' | 'line';
	class?: string;
	target?: string;
	rel?: string;
}

const { href, variant = 'primary', class: className = '', target, rel } = Astro.props;

const base =
	'inline-flex min-h-11 items-center justify-center gap-2 rounded-full px-5 py-2.5 text-sm font-semibold transition-all duration-[var(--transition-normal)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 sm:px-6 sm:py-3 sm:text-base';

const variants: Record<NonNullable<Props['variant']>, string> = {
	primary:
		'bg-[var(--color-orange)] !text-white shadow-md shadow-amber-950/10 hover:-translate-y-0.5 hover:bg-[var(--color-orange-dark)] hover:!text-white hover:shadow-lg focus-visible:outline-[var(--color-orange-dark)] active:translate-y-0',
	secondary:
		'border-2 border-[var(--color-orange)] bg-white !text-[var(--color-navy-soft)] shadow-sm hover:-translate-y-0.5 hover:bg-[var(--color-orange-soft)] hover:shadow-md focus-visible:outline-[var(--color-orange)] active:translate-y-0',
	line:
		'bg-[var(--color-line)] !text-white shadow-md shadow-emerald-950/10 hover:-translate-y-0.5 hover:bg-[var(--color-line-hover)] hover:!text-white hover:shadow-lg focus-visible:outline-[var(--color-line)] active:translate-y-0',
};
---

<a href={href} class:list={[base, variants[variant], className]} target={target} rel={rel}>
	<slot />
</a>
