---
import BrandLogo from '../BrandLogo.astro';
import ButtonLink from './ButtonLink.astro';

const phone = import.meta.env.PUBLIC_BUSINESS_PHONE ?? '+66-64-257-9353';
const phoneDisplay = phone.replace(/^\+66/, '0').replace(/-/g, '');
const telHref = `tel:${phoneDisplay.replace(/\D/g, '')}`;
const lineHref = 'https://line.me/R/ti/p/@webuy';

const navLinkClass =
	'inline-flex min-h-11 items-center rounded-lg px-3 py-2 text-[0.9375rem] font-semibold text-text-muted transition-colors duration-[var(--transition-normal)] hover:bg-[var(--color-bg-warm)] hover:text-[var(--color-orange-dark)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-orange)]';

const navItems = [
	{ href: '/', label: 'หน้าแรก' },
	{ href: '/รับซื้อ/', label: 'รับซื้อ' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', label: 'โน๊ตบุ๊ค' },
	{ href: '/รับซื้อคอม/', label: 'คอมพิวเตอร์' },
	{ href: '/รับซื้อไอโฟน/', label: 'iPhone' },
	{ href: '/contact/', label: 'ติดต่อเรา' },
];

const mobileExtraNavItems = [
	{ href: '/รับซื้อแมคบุ๊ค/', label: 'MacBook' },
	{ href: '/รับซื้อไอแพด/', label: 'iPad' },
	{ href: '/รับซื้อกล้อง/', label: 'กล้อง' },
	{ href: '/พื้นที่ให้บริการ/', label: 'พื้นที่ให้บริการ' },
	{ href: '/ราคากลางรับซื้อ/', label: 'ราคากลางรับซื้อ' },
	{ href: '/ความน่าเชื่อถือ/', label: 'ความน่าเชื่อถือ' },
];

const mobileNavItems = [...navItems, ...mobileExtraNavItems];
---

<header
	id="site-header"
	class="site-header sticky top-0 z-[60] border-b border-[#E8ECF1] bg-white"
	role="banner"
>
	<div class="mx-auto flex h-[4.75rem] max-w-[var(--width-container,75rem)] items-center gap-4 px-4 sm:px-6 lg:h-[5.25rem] lg:gap-6 lg:px-8">
		<div class="min-w-0 shrink-0 lg:mr-2">
			<BrandLogo />
		</div>

		<nav class="hidden min-w-0 flex-1 items-center justify-center gap-0.5 lg:flex" aria-label="หลัก">
			{
				navItems.map((item) => (
					<a class={navLinkClass} href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="ml-auto flex shrink-0 items-center gap-2 sm:gap-2.5">
			<div class="hidden items-center gap-2 lg:flex">
				<a
					href={telHref}
					class="inline-flex min-h-11 min-w-11 items-center justify-center gap-2 rounded-full border border-[#E5E7EB] bg-white px-4 py-2.5 text-sm font-semibold text-navy transition hover:border-brand-500/40 hover:bg-brand-50 hover:text-brand-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500"
				>
					<svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path
							stroke-linecap="round"
							stroke-linejoin="round"
							stroke-width="2"
							d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
						></path>
					</svg>
					<span>โทร</span>
				</a>
				<ButtonLink
					href={lineHref}
					variant="line"
					target="_blank"
					rel="noopener noreferrer"
					class="!min-h-11 !px-5 !py-2.5 !text-sm"
				>
					ส่งรูปทาง LINE
				</ButtonLink>
			</div>

			<div class="flex items-center gap-2 lg:hidden" aria-label="ทางลัดมือถือ">
				<ButtonLink
					href={lineHref}
					variant="line"
					target="_blank"
					rel="noopener noreferrer"
					class="!min-h-11 !px-3 !py-2.5 text-xs sm:!px-4 sm:text-sm"
				>
					ส่งรูป LINE
				</ButtonLink>

				<button
					id="mobile-menu-open"
					class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#E5E7EB] bg-white p-3 text-navy shadow-sm transition hover:border-brand-500/35 hover:text-brand-700"
					aria-label="เปิดเมนู"
					aria-expanded="false"
					aria-controls="mobile-drawer"
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</div>
	</div>
</header>

<!-- Mobile Drawer Slide-over -->
<div
	id="mobile-drawer"
	class="fixed inset-0 z-[100] invisible"
	role="dialog"
	aria-modal="true"
	aria-label="เมนูหลัก"
>
	<!-- Backdrop overlay -->
	<div
		id="mobile-drawer-backdrop"
		class="fixed inset-0 bg-[#0B1F3A]/45 opacity-0 transition-opacity duration-300 ease-out"
	></div>

	<!-- Drawer Panel -->
	<div
		id="mobile-drawer-panel"
		class="fixed bottom-0 right-0 top-0 z-10 w-full max-w-[18rem] translate-x-full bg-white p-6 shadow-2xl transition-transform duration-300 ease-out flex flex-col"
	>
		<!-- Drawer Header -->
		<div class="flex items-center justify-between pb-5 border-b border-gray-100">
			<BrandLogo />
			<button
				id="mobile-menu-close"
				class="flex h-10 w-10 items-center justify-center rounded-xl border border-gray-200 bg-white text-navy transition hover:border-brand-500/35 hover:text-brand-700"
				aria-label="ปิดเมนู"
			>
				<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>

		<!-- Drawer Navigation List -->
		<nav class="mt-6 flex-1 overflow-y-auto space-y-1.5" aria-label="มือถือ">
			{
				mobileNavItems.map((item) => (
					<a
						class="flex min-h-11 items-center rounded-xl px-3 py-2.5 text-sm font-semibold text-text transition-colors hover:bg-[#F5F7FA] hover:text-brand-700"
						href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<!-- Drawer CTAs -->
		<div class="mt-auto pt-6 border-t border-[var(--color-gray-200)] space-y-3">
			<a
				class="flex min-h-11 items-center justify-center rounded-xl border border-[var(--color-gray-200)] px-3 py-2.5 text-sm font-semibold text-[var(--color-navy)] transition hover:bg-[var(--color-bg-warm)]"
				href={telHref}
			>
				โทร {phoneDisplay}
			</a>
			<a
				class="flex min-h-11 items-center justify-center rounded-xl bg-[var(--color-line)] px-3 py-2.5 text-center text-sm font-bold !text-white shadow-md transition hover:bg-[var(--color-line-hover)]"
				href={lineHref}
				target="_blank"
				rel="noopener noreferrer"
			>
				ส่งรูปทาง LINE
			</a>
		</div>
	</div>
</div>

<style>
	.site-header {
		transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
	}
	.site-header.is-scrolled {
		border-color: var(--color-gray-200);
		box-shadow: var(--shadow-header);
	}
</style>

<script is:inline>
	(() => {
		const header = document.getElementById('site-header');
		if (!header) return;

		// Scroll shadow logic
		const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 6);
		onScroll();
		window.addEventListener('scroll', onScroll, { passive: true });

		// Drawer logic
		const openBtn = document.getElementById('mobile-menu-open');
		const closeBtn = document.getElementById('mobile-menu-close');
		const drawer = document.getElementById('mobile-drawer');
		const backdrop = document.getElementById('mobile-drawer-backdrop');
		const panel = document.getElementById('mobile-drawer-panel');

		if (!openBtn || !drawer || !backdrop || !panel || !closeBtn) return;

		const openDrawer = () => {
			drawer.classList.remove('invisible');
			document.body.style.overflow = 'hidden';
			openBtn.setAttribute('aria-expanded', 'true');
			
			// Force reflow for transitions
			void drawer.offsetWidth;
			
			backdrop.classList.remove('opacity-0');
			backdrop.classList.add('opacity-100');
			panel.classList.remove('translate-x-full');
			panel.classList.add('translate-x-0');

			// Focus close button
			closeBtn.focus();
		};

		const closeDrawer = () => {
			backdrop.classList.remove('opacity-100');
			backdrop.classList.add('opacity-0');
			panel.classList.remove('translate-x-0');
			panel.classList.add('translate-x-full');
			
			openBtn.setAttribute('aria-expanded', 'false');
			document.body.style.overflow = '';
			
			// Wait for transition end to hide container
			setTimeout(() => {
				if (panel.classList.contains('translate-x-full')) {
					drawer.classList.add('invisible');
				}
			}, 300);
		};

		openBtn.addEventListener('click', openDrawer);
		closeBtn.addEventListener('click', closeDrawer);
		backdrop.addEventListener('click', closeDrawer);

		// ESC Key support
		window.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !drawer.classList.contains('invisible')) {
				closeDrawer();
				openBtn.focus();
			}
		});
	})();
</script>
