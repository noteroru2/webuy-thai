---
import BrandLogo from '../BrandLogo.astro';
import ButtonLink from './ButtonLink.astro';

const navLinkClass =
	'text-[0.9375rem] font-semibold text-text-muted transition-colors duration-200 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:rounded-sm focus-visible:outline-brand-500';

const lineHref = 'https://line.me/R/ti/p/@webuy';

const navItems = [
	{ href: '/', label: 'หน้าแรก' },
	{ href: '/บริการ/', label: 'บริการ' },
	{ href: '/บริการ/#คู่มืออุบล', label: 'คู่มืออุบล' },
	{ href: '/รับซื้อ/', label: 'รับซื้อ' },
	{ href: '/blog/', label: 'บทความ' },
	{ href: '/เกี่ยวกับเรา/', label: 'เกี่ยวกับเรา' },
	{ href: '/contact/', label: 'ติดต่อเรา' },
];
---

<header
	class="sticky top-0 z-[60] border-b border-gray-200/80 bg-white/90 shadow-[0_1px_0_rgba(15,23,42,0.04),0_10px_36px_-22px_rgba(15,23,42,0.09)] backdrop-blur-md backdrop-saturate-150"
	role="banner"
>
	<div
		class="mx-auto flex min-h-[4.5rem] max-w-[1200px] items-center justify-between gap-3 px-4 py-2.5 sm:px-6 lg:min-h-[4.75rem] lg:px-8"
	>
		<div class="min-w-0 shrink">
			<BrandLogo />
		</div>

		<nav class="hidden items-center gap-0.5 lg:flex lg:gap-1 xl:gap-1.5" aria-label="หลัก">
			{
				navItems.map((item) => (
					<a class:list={[navLinkClass, 'whitespace-nowrap rounded-lg px-2 py-2 lg:px-2.5 xl:px-3']} href={item.href}>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-2.5">
			<ButtonLink
				href="/contact/"
				variant="secondary"
				class="hidden !px-3.5 !py-2 text-xs !shadow-none lg:inline-flex lg:!px-4 lg:!py-2.5 lg:text-sm"
			>
				ติดต่อเรา
			</ButtonLink>
			<ButtonLink
				href={lineHref}
				variant="primary"
				target="_blank"
				rel="noopener noreferrer"
				class="hidden !px-4 !py-2 text-xs sm:inline-flex sm:!px-5 sm:!py-2.5 sm:text-sm lg:!py-2.5"
			>
				ประเมินราคาฟรี
			</ButtonLink>

			<ButtonLink
				href={lineHref}
				variant="line"
				target="_blank"
				rel="noopener noreferrer"
				class="!px-3 !py-2 text-xs sm:hidden"
				aria-label="ติดต่อผ่าน LINE"
			>
				<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .628.285.628.63 0 .349-.282.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .63.285.63.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.138h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.63.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.084.923.258 1.058.59.12.301.086.766.062 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"
					></path>
				</svg>
			</ButtonLink>

			<details class="relative lg:hidden">
				<summary
					class="flex cursor-pointer list-none items-center justify-center rounded-xl border border-gray-200/90 bg-white p-2.5 text-text shadow-sm transition duration-200 hover:border-brand-500/40 hover:text-brand-600 [&::-webkit-details-marker]:hidden"
					aria-label="เปิดเมนู"
				>
					<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
						<path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</summary>
				<div
					class="absolute right-0 z-[70] mt-2 max-h-[80vh] w-[min(100vw-2rem,18rem)] origin-top-right overflow-y-auto rounded-2xl border border-gray-200/90 bg-white/95 p-2 shadow-2xl shadow-gray-900/15 backdrop-blur-md"
					role="menu"
				>
					{
						navItems.map((item) => (
							<a
								class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-text transition-colors hover:bg-brand-50"
								href={item.href}
								role="menuitem"
							>
								{item.label}
							</a>
						))
					}
					<a
						class="mt-1 block rounded-xl border border-gray-100 bg-[#FAFAFA] px-3 py-2.5 text-center text-sm font-semibold text-text hover:bg-gray-100"
						href="/contact/"
						role="menuitem"
					>
						ติดต่อเรา
					</a>
					<a
						class="mt-1 block rounded-xl bg-brand-600 px-3 py-3 text-center text-sm font-semibold !text-white shadow-md shadow-brand-700/25 transition hover:bg-brand-700 hover:!text-white [text-shadow:0_1px_0_rgba(0,0,0,0.12)]"
						href={lineHref}
						target="_blank"
						rel="noopener noreferrer"
						role="menuitem"
					>
						ประเมินราคาฟรี
					</a>
				</div>
			</details>
		</div>
	</div>
</header>
