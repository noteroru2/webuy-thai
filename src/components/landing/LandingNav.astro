---
import BrandLogo from '../BrandLogo.astro';
import ButtonLink from './ButtonLink.astro';

const navLinkClass =
	'text-[0.9375rem] font-semibold text-text-muted transition-colors duration-200 hover:text-brand-600 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:rounded-sm focus-visible:outline-brand-500';

const lineHref = 'https://line.me/R/ti/p/@webuy';

const navItems = [
	{ href: '/', label: 'หน้าแรก' },
	{ href: '/รับซื้อ/', label: 'รับซื้อ' },
	{ href: '/รับซื้อโน๊ตบุ๊ค/', label: 'โน๊ตบุ๊ค' },
	{ href: '/รับซื้อคอม/', label: 'คอมพิวเตอร์' },
	{ href: '/รับซื้อแมคบุ๊ค/', label: 'MacBook' },
	{ href: '/รับซื้อไอโฟน/', label: 'iPhone' },
	{ href: '/รับซื้อไอแพด/', label: 'iPad' },
	{ href: '/รับซื้อกล้อง/', label: 'กล้อง' },
	{ href: '/พื้นที่ให้บริการ/', label: 'พื้นที่ให้บริการ' },
	{ href: '/contact/', label: 'ติดต่อเรา' },
];

const mobileExtraNavItems = [
	{ href: '/ราคากลางรับซื้อ/', label: 'ราคากลางรับซื้อ' },
	{ href: '/ความน่าเชื่อถือ/', label: 'ความน่าเชื่อถือ' },
];

const mobileNavItems = [...navItems, ...mobileExtraNavItems];
---

<header
	class="sticky top-0 z-[60] border-b border-gray-200/80 bg-white/90 shadow-[0_1px_0_rgba(15,23,42,0.04),0_10px_36px_-22px_rgba(15,23,42,0.09)] backdrop-blur-md backdrop-saturate-150"
	role="banner"
>
	<div
		class="mx-auto flex min-h-[4.5rem] max-w-[1200px] flex-col gap-2 px-4 py-2.5 sm:px-6 lg:min-h-[4.75rem] lg:flex-row lg:items-center lg:justify-between lg:gap-3 lg:px-8"
	>
		<div class="flex w-full min-w-0 items-start justify-between gap-3 lg:w-auto lg:max-w-none lg:flex-1 lg:items-center lg:justify-start lg:gap-3">
			<div class="min-w-0 flex-1 lg:flex-initial">
				<BrandLogo />
			</div>

			<div class="flex shrink-0 items-center gap-2 sm:gap-2.5 lg:hidden" aria-label="ทางลัดมือถือ">
				<ButtonLink
					href={lineHref}
					variant="primary"
					target="_blank"
					rel="noopener noreferrer"
					class="!max-w-[min(100%,11rem)] !px-2.5 !py-2 text-center text-[0.6875rem] leading-tight sm:!max-w-none sm:!px-4 sm:!py-2.5 sm:text-sm"
				>
					ประเมินราคาฟรี
				</ButtonLink>

				<details class="relative">
					<summary
						class="flex cursor-pointer list-none items-center justify-center rounded-xl border border-gray-200/90 bg-white p-2.5 text-text shadow-sm transition duration-200 hover:border-brand-500/40 hover:text-brand-600 [&::-webkit-details-marker]:hidden"
						aria-label="เปิดเมนู"
					>
						<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
							<path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
						</svg>
					</summary>
					<div
						class="absolute right-0 z-[70] mt-2 max-h-[80vh] w-[min(100vw-2rem,18rem)] origin-top-right overflow-y-auto rounded-2xl border border-gray-200/90 bg-white/95 p-2 shadow-2xl shadow-gray-900/15 backdrop-blur-md"
						role="menu"
					>
						{
							mobileNavItems.map((item) => (
								<a
									class="block rounded-xl px-3 py-2.5 text-sm font-semibold text-text transition-colors hover:bg-brand-50"
									href={item.href}
									role="menuitem"
								>
									{item.label}
								</a>
							))
						}
						<a
							class="mt-1 block rounded-xl bg-brand-600 px-3 py-3 text-center text-sm font-semibold !text-white shadow-md shadow-brand-700/25 transition hover:bg-brand-700 hover:!text-white [text-shadow:0_1px_0_rgba(0,0,0,0.12)]"
							href={lineHref}
							target="_blank"
							rel="noopener noreferrer"
							role="menuitem"
						>
							ประเมินราคาฟรี
						</a>
					</div>
				</details>
			</div>
		</div>

		<nav class="hidden min-w-0 items-center gap-0.5 lg:flex lg:gap-0.5 xl:gap-1" aria-label="หลัก">
			{
				navItems.map((item) => (
					<a
						class:list={[
							navLinkClass,
							'whitespace-nowrap rounded-lg px-1.5 py-2 text-sm lg:px-2 xl:px-2.5 xl:text-[0.9375rem]',
						]}
						href={item.href}
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="hidden shrink-0 items-center gap-2 sm:gap-2.5 lg:flex">
			<ButtonLink
				href={lineHref}
				variant="primary"
				target="_blank"
				rel="noopener noreferrer"
				class="!px-4 !py-2 text-xs sm:!px-5 sm:!py-2.5 sm:text-sm lg:!py-2.5"
			>
				ประเมินราคาฟรี
			</ButtonLink>
		</div>
	</div>
</header>
