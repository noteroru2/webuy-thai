---
interface Props {
	heading?: string;
	text?: string;
	variant?: 'primary' | 'secondary' | 'hero';
}

const {
	heading = 'อยากขายสินค้า? ติดต่อเราเลย',
	text = 'ส่งรูป รุ่น สเปก และสภาพเครื่องมาได้เลย ทีมงานพร้อมประเมินให้เร็วที่สุด',
	variant = 'primary',
} = Astro.props;
---

<aside class:list={['cta-box', variant]} aria-label="ช่องทางติดต่อ">
	<div class="cta-inner">
		<h4 class="cta-heading">{heading}</h4>
		<p class="cta-text">{text}</p>
		<div class="cta-actions">
			<a
				class="cta-line"
				href="https://line.me/R/ti/p/@webuy"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="ติดต่อ Line @webuy"
			>
				<svg class="line-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.281.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
				</svg>
				<span>ทัก Line @webuy</span>
			</a>
			<a class="cta-phone" href="tel:0642579353" aria-label="โทร 064-257-9353">
				<svg class="phone-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
					<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.72 12 19.79 19.79 0 0 1 1.64 3.4 2 2 0 0 1 3.61 1.21h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.83a16 16 0 0 0 6 6l.95-.95a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
				</svg>
				<span>064-257-9353</span>
			</a>
		</div>
		<p class="cta-sub">
			<span class="cta-dot-live" aria-hidden="true"></span>
			ออนไลน์ตลอด 24 ชั่วโมง · ไม่มีวันหยุด
		</p>
	</div>
</aside>

<style>
	.cta-box {
		border-radius: 14px;
		padding: 1.5rem 1.4rem;
		margin-block: 1.5rem;
		position: relative;
		overflow: hidden;
	}
	.cta-box.primary {
		background: linear-gradient(135deg, #fff8ed 0%, #ffecd4 60%, #ffd9a8 100%);
		border: 1.5px solid rgba(234, 88, 12, 0.25);
		box-shadow:
			0 4px 24px rgba(249, 115, 22, 0.1),
			0 1px 4px rgba(249, 115, 22, 0.06);
	}
	.cta-box.secondary {
		background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
		border: 1.5px solid rgba(6, 199, 85, 0.25);
		box-shadow:
			0 4px 20px rgba(6, 199, 85, 0.08),
			0 1px 4px rgba(6, 199, 85, 0.04);
	}
	.cta-box.hero {
		background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
		border: 1.5px solid rgba(249, 115, 22, 0.3);
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
	}
	.cta-inner {
		display: grid;
		gap: 0.7rem;
	}
	.cta-heading {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		line-height: 1.35;
		color: #1a0f00;
	}
	.secondary .cta-heading {
		color: #14532d;
	}
	.hero .cta-heading {
		color: #fff;
	}
	.cta-text {
		margin: 0;
		color: #4e3010;
		font-size: 0.97rem;
		line-height: 1.6;
	}
	.secondary .cta-text {
		color: #166534;
	}
	.hero .cta-text {
		color: #cbd5e1;
	}
	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.15rem;
	}
	.cta-line,
	.cta-phone {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1.25rem;
		border-radius: 10px;
		font-weight: 700;
		font-size: 1rem;
		text-decoration: none;
		transition:
			background 0.15s,
			transform 0.1s,
			box-shadow 0.15s;
		white-space: nowrap;
	}
	.cta-line {
		background: #06c755;
		color: #fff;
		box-shadow: 0 3px 12px rgba(6, 199, 85, 0.35);
		flex: 1;
		justify-content: center;
		min-width: 160px;
	}
	.cta-line:hover {
		background: #05b04c;
		transform: translateY(-1px);
		box-shadow: 0 5px 16px rgba(6, 199, 85, 0.45);
		text-decoration: none;
	}
	.cta-line:active {
		transform: translateY(0);
	}
	.cta-phone {
		background: rgba(15, 23, 42, 0.08);
		color: #1e293b;
		border: 1.5px solid rgba(15, 23, 42, 0.12);
	}
	.secondary .cta-phone {
		background: rgba(6, 199, 85, 0.1);
		color: #166534;
		border-color: rgba(6, 199, 85, 0.2);
	}
	.hero .cta-phone {
		background: rgba(255, 255, 255, 0.1);
		color: #fff;
		border-color: rgba(255, 255, 255, 0.15);
	}
	.cta-phone:hover {
		background: rgba(15, 23, 42, 0.12);
		transform: translateY(-1px);
		text-decoration: none;
	}
	.line-icon {
		width: 22px;
		height: 22px;
		flex-shrink: 0;
	}
	.phone-icon {
		width: 18px;
		height: 18px;
		flex-shrink: 0;
	}
	.cta-sub {
		margin: 0;
		font-size: 0.8rem;
		letter-spacing: 0.03em;
		color: #78716c;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.secondary .cta-sub {
		color: #166534;
		opacity: 0.75;
	}
	.hero .cta-sub {
		color: #94a3b8;
	}
	.cta-dot-live {
		display: inline-block;
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #06c755;
		animation: live-pulse 2s ease-in-out infinite;
		flex-shrink: 0;
	}
	@keyframes live-pulse {
		0%, 100% { opacity: 1; transform: scale(1); }
		50% { opacity: 0.55; transform: scale(0.85); }
	}

	/* Mobile: full-width LINE button */
	@media (max-width: 480px) {
		.cta-box {
			padding: 1.25rem 1.1rem;
		}
		.cta-line {
			width: 100%;
			font-size: 1.05rem;
			padding: 0.75rem 1rem;
		}
		.cta-actions {
			flex-direction: column;
		}
		.cta-phone {
			justify-content: center;
		}
	}
</style>
