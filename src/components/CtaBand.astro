---
interface Props {
	heading?: string;
	text?: string;
	btnText?: string;
	btnHref?: string;
	secondaryBtnText?: string;
	secondaryBtnHref?: string;
}

const {
	heading = 'พร้อมประเมินราคาสินค้าของคุณหรือยัง?',
	text = 'ส่งรูป รุ่น สเปก และสภาพสินค้ามาทาง LINE ทีมงานจะประเมินตามข้อมูลจริง แจ้งราคาเบื้องต้นก่อนตัดสินใจ',
	btnText = 'ส่งรูปทาง LINE',
	btnHref = 'https://line.me/R/ti/p/@webuy',
	secondaryBtnText = 'ดูวิธีเตรียมข้อมูล',
	secondaryBtnHref = '/เช็กราคาก่อนขาย/',
} = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-heading">
	<div class="cta-band-glow cta-band-glow-1" aria-hidden="true"></div>
	<div class="cta-band-glow cta-band-glow-2" aria-hidden="true"></div>
	<div class="cta-band-inner">
		<div class="cta-band-icon-wrap" aria-hidden="true">
			<svg class="cta-band-icon-svg" viewBox="0 0 24 24" fill="currentColor">
				<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
			</svg>
		</div>
		<div class="cta-band-content">
			<h2 id="cta-band-heading" class="cta-band-heading">{heading}</h2>
			<p class="cta-band-text">{text}</p>
		</div>
		<div class="cta-band-actions">
			<a
				href={btnHref}
				target="_blank"
				rel="noopener noreferrer"
				class="cta-band-btn cta-band-btn-primary"
			>
				<svg class="cta-band-btn-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 2C6.48 2 2 6.06 2 11.05c0 2.81 1.35 5.32 3.47 6.98L4.5 22l4.2-2.13c1.07.3 2.19.46 3.3.46 5.52 0 10-4.06 10-9.05C22 6.06 17.52 2 12 2z"/>
				</svg>
				{btnText}
			</a>
			<a href={secondaryBtnHref} class="cta-band-btn cta-band-btn-secondary">
				{secondaryBtnText}
			</a>
		</div>
	</div>
</section>

<style>
.cta-band {
	position: relative;
	overflow: hidden;
	background: linear-gradient(135deg, #0b1f3a 0%, #1e3a5f 45%, #0d4a5a 100%);
	padding: 5rem 1rem;
}

@media (min-width: 640px) {
	.cta-band { padding: 5.5rem 1.5rem; }
}
@media (min-width: 1024px) {
	.cta-band { padding: 6rem 2rem; }
}

.cta-band-glow {
	position: absolute;
	border-radius: 50%;
	pointer-events: none;
}
.cta-band-glow-1 {
	width: 600px; height: 600px;
	top: -200px; right: -100px;
	background: radial-gradient(circle, rgba(245, 158, 11, 0.15) 0%, transparent 70%);
	filter: blur(60px);
}
.cta-band-glow-2 {
	width: 400px; height: 400px;
	bottom: -100px; left: -60px;
	background: radial-gradient(circle, rgba(20, 184, 166, 0.12) 0%, transparent 70%);
	filter: blur(60px);
}

.cta-band-inner {
	position: relative;
	max-width: 72rem;
	margin-inline: auto;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 2rem;
	text-align: center;
}

@media (min-width: 900px) {
	.cta-band-inner {
		flex-direction: row;
		align-items: center;
		text-align: left;
		gap: 3rem;
	}
}

.cta-band-icon-wrap {
	flex-shrink: 0;
	width: 4rem;
	height: 4rem;
	display: flex;
	align-items: center;
	justify-content: center;
	border-radius: 1rem;
	background: rgba(245, 158, 11, 0.2);
	border: 1px solid rgba(245, 158, 11, 0.3);
	color: #f59e0b;
}
.cta-band-icon-svg {
	width: 1.75rem;
	height: 1.75rem;
}

@media (max-width: 899px) {
	.cta-band-icon-wrap { display: none; }
}

.cta-band-content {
	flex: 1;
	min-width: 0;
}
.cta-band-heading {
	margin: 0 0 0.75rem;
	font-size: clamp(1.5rem, 3vw + 0.5rem, 2.25rem);
	font-weight: 800;
	line-height: 1.2;
	color: #fff;
	letter-spacing: -0.02em;
}
.cta-band-text {
	margin: 0;
	font-size: 1.0625rem;
	line-height: 1.7;
	color: rgba(255, 255, 255, 0.72);
	max-width: 36rem;
}

@media (max-width: 899px) {
	.cta-band-text { margin-inline: auto; }
}

.cta-band-actions {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	align-items: center;
	flex-shrink: 0;
}

@media (min-width: 480px) {
	.cta-band-actions { flex-direction: row; }
}
@media (min-width: 900px) {
	.cta-band-actions { flex-direction: column; align-items: stretch; }
}

.cta-band-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	min-height: 52px;
	padding: 0.875rem 1.875rem;
	border-radius: 999px;
	font-size: 1rem;
	font-weight: 700;
	text-decoration: none !important;
	transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
	white-space: nowrap;
}
.cta-band-btn:hover { transform: translateY(-2px); }

.cta-band-btn-icon {
	width: 1.125rem;
	height: 1.125rem;
	flex-shrink: 0;
}

.cta-band-btn-primary {
	background: #f59e0b;
	color: #0b1f3a !important;
	box-shadow: 0 4px 18px rgba(245, 158, 11, 0.45);
}
.cta-band-btn-primary:hover {
	background: #d97706;
	box-shadow: 0 8px 28px rgba(245, 158, 11, 0.5);
}

.cta-band-btn-secondary {
	background: rgba(255, 255, 255, 0.1);
	border: 1.5px solid rgba(255, 255, 255, 0.3);
	color: rgba(255, 255, 255, 0.9) !important;
	backdrop-filter: blur(4px);
}
.cta-band-btn-secondary:hover {
	background: rgba(255, 255, 255, 0.18);
	border-color: rgba(255, 255, 255, 0.5);
}
</style>
