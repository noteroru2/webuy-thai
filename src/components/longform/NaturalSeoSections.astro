---
type LinkItem = {
	href: string;
	label: string;
};

interface Props {
	theme: string;
	audience: string;
	locationContext?: string;
	emphasis: string;
	prepareItems: string[];
	valueFactors: string[];
	commonMistakes: string[];
	internalLinks?: LinkItem[];
	density?: 'full' | 'medium';
}

const {
	theme,
	audience,
	locationContext = 'ลูกค้าในหลายพื้นที่',
	emphasis,
	prepareItems,
	valueFactors,
	commonMistakes,
	internalLinks = [],
	density = 'full',
} = Astro.props as Props;

const isFull = density === 'full';
---

<section class="natural-longform" aria-label={`รายละเอียดเพิ่มเติมสำหรับผู้ที่ต้องการอ่านเงื่อนไข — ${theme}`}>
	<div class="natural-wrap">
		<details class="natural-details" open>
			<summary class="natural-summary">
				<h2 class="natural-summary-title">รายละเอียดเพิ่มเติมสำหรับผู้ที่ต้องการอ่านเงื่อนไข</h2>
				<p class="natural-summary-hint">ข้อมูลเชิงลึกเกี่ยวกับ {theme} — อ่านได้ทั้งหมดโดยไม่ซ่อนเนื้อหา</p>
			</summary>
			<div class="natural-details-body">
		<section class="natural-block">
			<h2>ทำไมหน้า {theme} ควรอ่านให้จบก่อนตัดสินใจ</h2>
			<p>
				หลายคนค้นหาหน้าแนว <strong>{theme}</strong> เพราะต้องการคำตอบที่ชัดกว่าแค่ประโยคว่า “รับซื้อครับ” หรือ “ทักไลน์มาได้เลย”
				แต่สิ่งที่ช่วยให้ตัดสินใจได้จริงมักเป็นรายละเอียดระหว่างทาง เช่น ควรเตรียมข้อมูลอะไรบ้าง ร้านมองปัจจัยไหนก่อนให้ราคา
				ควรขายตามสภาพหรือซ่อมก่อน และถ้าอยู่ในพื้นที่อย่าง <strong>{locationContext}</strong> ควรคุยเรื่องนัดรับหรือตรวจเครื่องอย่างไรถึงจะไม่เสียเวลา
				หน้านี้จึงไม่ได้ถูกทำมาเพื่อยัดคีย์เวิร์ด แต่ทำมาเพื่อให้คนที่กำลังจะขายหรือเช็กราคาสามารถใช้เป็นคู่มือก่อนคุยจริง
				และทำให้การประเมินของ {audience} เป็นธรรมชาติมากขึ้นตั้งแต่รอบแรก
			</p>
			<p>
				แนวคิดหลักของ WE BUY คือ <strong>{emphasis}</strong> เราให้ความสำคัญกับการเตรียมข้อมูลที่ชัดเจนและเข้าใจง่ายสำหรับลูกค้า
				เพื่อให้ทุกคนได้รับคำตอบที่ต้องการอย่างรวดเร็ว พร้อมรายละเอียดบริการที่ครบถ้วนและครอบคลุมพื้นที่ให้บริการต่างๆ เพื่อช่วยในการตัดสินใจได้ง่ายและถูกต้องยิ่งขึ้น
			</p>
		</section>

		<section class="natural-block">
			<h2>ใครเหมาะกับการใช้หน้านี้มาก</h2>
			<p>
				หน้านี้เหมาะกับคนที่อยู่ในกลุ่ม {audience} โดยเฉพาะคนที่ยังลังเลระหว่าง “ขายเลยดีไหม”, “ควรเช็กราคากี่ร้าน”, “มีตำหนิแบบนี้ยังพอขายได้หรือไม่”
				หรือ “ถ้าอยู่ {locationContext} ควรเริ่มคุยจากข้อความแบบไหนก่อนนัดจริง” เพราะปัญหาส่วนใหญ่ไม่ได้อยู่ที่ตัวสินค้าอย่างเดียว แต่เกิดจากการส่งข้อมูลไม่ครบ
				คาดหวังราคาจากข้อมูลไม่พอ หรือเลือกหน้าที่ intent ไม่ตรงกับสิ่งที่ตัวเองต้องการจริง
			</p>
			<p>
				อีกกลุ่มที่ได้ประโยชน์คือคนที่มีอุปกรณ์หลายชิ้นในรอบเดียว เช่น มีทั้งเครื่องหลัก อุปกรณ์เสริม กล่องเดิม หรือมีสินค้าอีกประเภทที่กำลังจะปล่อยพร้อมกัน
				การอ่านข้อมูลแบบเป็นขั้นตอนจะช่วยให้จัดลำดับได้ว่าควรส่งอะไรให้ร้านดูก่อน อะไรคือข้อมูลขั้นต่ำที่ควรมี และควรเตรียมตัวอย่างไรเพื่อให้คุยราคาใกล้เคียงของจริงมากขึ้น
			</p>
		</section>

		<section class="natural-block">
			<h2>ข้อมูลที่ควรเตรียมก่อนทักหรือส่งประเมิน</h2>
			<p>
				ถ้าต้องการให้การประเมินเร็วและตรง สิ่งที่สำคัญมากไม่ใช่การพิมพ์ว่าของ “สวยมาก” หรือ “ใช้งานได้ปกติ” แต่คือข้อมูลที่ตรวจสอบได้
				ยิ่งหน้าประเภท {theme} มีการแข่งขันสูงเท่าไร ร้านที่ทำงานจริงจังยิ่งต้องใช้ข้อมูลจริงในการให้ช่วงราคา
				รายการด้านล่างคือแกนกลางที่มักช่วยให้คุยกันได้ไวขึ้นและลดการถามกลับหลายรอบ
			</p>
			<ul>
				{prepareItems.map((item) => <li>{item}</li>)}
			</ul>
			<p>
				เมื่อข้อมูลพื้นฐานครบแล้ว ร้านจะสามารถประเมินได้ใกล้ความจริงกว่าเดิมมาก และที่สำคัญคือช่วยลดช่องว่างระหว่าง “ช่วงราคาในแชต” กับ “ราคาหลังตรวจจริง”
				ซึ่งเป็นจุดที่ทำให้หลายคนรู้สึกไม่ดีเวลาเจอประสบการณ์ซื้อขายมือสอง ถ้าคุณเตรียมข้อมูลครบตั้งแต่ต้น การคุยเรื่องนัดหมาย เงื่อนไข และเวลาในการตรวจเครื่องจะง่ายขึ้นตามไปด้วย
			</p>
		</section>

		<section class="natural-block">
			<h2>อะไรคือปัจจัยที่ทำให้การประเมินหรือราคาต่างกัน</h2>
			<p>
				ไม่ว่าจะเป็นหน้ารับซื้อ หน้าเช็กราคา หรือหน้าคู่มือเชิงพื้นที่ หลักการประเมินที่ดีควรยึดกับปัจจัยที่ส่งผลต่อการใช้งานและการส่งต่อจริง
				หลายครั้งผู้ขายกับร้านคุยกันคนละภาษา ผู้ขายมองจากราคาตอนซื้อหรือความรู้สึกว่าเครื่องยังดี ขณะที่ร้านต้องมองจากต้นทุน ความเสี่ยง และความต้องการของตลาดในช่วงนั้น
				รายการด้านล่างคือปัจจัยที่มักส่งผลกับการคุยราคาหรือการตัดสินใจมาก
			</p>
			<ul>
				{valueFactors.map((item) => <li>{item}</li>)}
			</ul>
			<p>
				การเข้าใจปัจจัยเหล่านี้ช่วยให้การคุยเป็นธรรมชาติมากขึ้น เพราะทั้งสองฝ่ายใช้ข้อมูลชุดเดียวกัน ไม่ต้องอาศัยการเดา และไม่ต้องโยนคำอธิบายกว้าง ๆ ที่ฟังดูดีแต่ไม่มีหลักฐานพอ
				เพื่อให้ลูกค้าได้รับข้อมูลที่ถูกต้องและครอบคลุมสำหรับนำไปใช้ประกอบการตัดสินใจและช่วยให้ได้ราคาที่แม่นยำที่สุด
			</p>
		</section>

		<section class="natural-block">
			<h2>ข้อผิดพลาดที่ทำให้ดีลยากหรือรู้สึกว่าโดนกดราคา</h2>
			<p>
				หลายเคสที่จบไม่ดีไม่ได้เกิดจากร้านไม่รับซื้อหรือผู้ขายตั้งใจปิดบัง แต่เกิดจากการสื่อสารต้นทางไม่ครบ ทำให้ตอนตรวจจริงต้องกลับมาแก้เงื่อนไขกันใหม่
				เราจึงพยายามแนะนำ "ข้อผิดพลาดที่พบบ่อย" เพื่อให้ลูกค้าเตรียมตัวได้อย่างถูกต้อง และประเมินราคาได้อย่างราบรื่นที่สุด
			</p>
			<ul>
				{commonMistakes.map((item) => <li>{item}</li>)}
			</ul>
			<p>
				ถ้าคุณหลีกเลี่ยงจุดเหล่านี้ได้ โอกาสที่การประเมินจะจบเร็วและไม่ต้องแก้ราคาหลายรอบจะสูงขึ้นมาก และยังช่วยให้ตอบคำถามเรื่องการให้บริการในแต่ละพื้นที่ได้ดียิ่งขึ้น
				เพราะลูกค้าในพื้นที่อย่าง {locationContext} มักต้องการรู้ด้วยว่าเมื่อคุยกับร้านจริงแล้ว ขั้นตอนจะเดินต่ออย่างไร ไม่ใช่แค่รู้ว่าเว็บนี้มีบริการอะไรบ้าง
			</p>
		</section>



		{
			isFull && (
				<section class="natural-block">
					<h2>ถ้าต้องการให้ได้ราคาตามสภาพขึ้น ควรเตรียมตัวแบบไหน</h2>
					<p>
						หลายคนโฟกัสที่คำถามว่า “ร้านไหนให้ราคาดีที่สุด” แต่ในทางปฏิบัติสิ่งที่ทำให้ราคาดีขึ้นจริงมักเริ่มจากความพร้อมของผู้ขายเอง
						เช่น การถ่ายรูปให้เห็นสภาพจริงทุกมุม การแจ้งรุ่นย่อยให้ถูกต้อง การบอกตำหนิตั้งแต่แรก และการแยกให้ออกว่าข้อไหนเป็นเรื่องของสภาพ
						ข้อไหนเป็นเรื่องของอุปกรณ์ที่มีหรือไม่มี สิ่งเหล่านี้ช่วยให้การประเมินตรงขึ้น และทำให้ร้านกล้าเสนอช่วงราคาที่ใกล้ของจริงมากกว่าเดิม
					</p>
					<p>
						ในกรณีที่เป็นสินค้าที่มีรายละเอียดเฉพาะทาง เช่น เครื่อง Apple, โน๊ตบุ๊คเกมมิ่ง, คอมประกอบ, กล้อง หรือสมาร์ทโฟนจอพับ
						การแนบภาพหน้าจอสเปก ภาพแบตเตอรี่ ภาพอาการเสีย หรือข้อมูลยืนยันรุ่น จะช่วยลดภาระการถามกลับหลายรอบได้มาก
						นี่เป็นเหตุผลว่าทำไมหน้าประเภท {theme} จึงควรมีคำอธิบายลึกพอให้ผู้ใช้เตรียมข้อมูลได้เอง ไม่ใช่มีแค่ปุ่มให้ทักอย่างเดียว
					</p>
					<p>
						ถ้าคุณอยู่ในพื้นที่อย่าง <strong>{locationContext}</strong> การเตรียมข้อมูลให้ครบก่อนนัดยังช่วยเรื่องเวลาและการเดินทางอีกด้วย
						เพราะเมื่อร้านเห็นข้อมูลพอแล้ว การคุยเรื่องจุดนัดรับ ช่วงเวลา และเงื่อนไขการตรวจเครื่องจริงจะเป็นขั้นตอนที่สั้นและชัดเจนขึ้น
						ผู้ขายจึงไม่ต้องเสียรอบโดยไม่จำเป็น และยังคุมความคาดหวังเรื่องราคาได้ตั้งแต่ต้น
					</p>
				</section>
			)
		}

		{
			isFull && (
				<section class="natural-block">
					<h2>สิ่งที่คนค้นหามักอยากรู้ แต่หลายหน้าไม่ค่อยตอบให้ชัด</h2>
					<p>
						ประสบการณ์ของผู้ใช้ในสายซื้อขายมือสองมักมีคำถามซ้ำกันอยู่ไม่กี่แบบ เช่น ถ้าเครื่องมีตำหนิยังขายได้ไหม ควรซ่อมก่อนหรือขายตามสภาพ
						ถ้ากล่องหายจะโดนหักมากไหม ต้องล้างข้อมูลตรงไหนบ้าง และราคาที่ได้ในแชตกับราคาหลังตรวจจริงต่างกันเพราะอะไร
						คำถามพวกนี้ดูเหมือนพื้นฐาน แต่กลับเป็นจุดที่ทำให้คนตัดสินใจไม่ขาดมาก โดยเฉพาะในหมวด {theme}
					</p>
					<p>
						เนื้อหาที่ตั้งใจทำให้ดีจริงจึงควรตอบทั้งเชิงเหตุผลและเชิงปฏิบัติ ไม่ใช่ตอบแบบกว้าง ๆ ว่า “ขึ้นอยู่กับสภาพ”
						เพราะคำตอบลักษณะนั้นช่วยให้เว็บติดคำค้นบางชุดได้ แต่ไม่ได้ช่วยให้ผู้ใช้รู้ว่าจะต้องทำอะไรต่อ
						หน้าแบบนี้จึงพยายามอธิบายเป็นภาษาคน ใช้บริบทจริงของการขาย และหลีกเลี่ยงการย้ำคีย์เวิร์ดแบบเดิมซ้ำไปซ้ำมา
					</p>
					<p>
						การให้ข้อมูลที่สั้น กระชับ และตรงประเด็น จะช่วยให้ลูกค้าเข้าใจเงื่อนไขและรายละเอียดการบริการได้ดียิ่งขึ้น
						โดยไม่ต้องอ่านคำอธิบายที่ยาวและซ้ำซ้อน ซึ่งช่วยอำนวยความสะดวกให้ผู้ขายสามารถเริ่มเตรียมข้อมูลเพื่อประเมินราคาได้ทันที
					</p>
				</section>
			)
		}

		<section class="natural-block">
			<h2>ถ้าจะเริ่มตอนนี้ ควรทำอะไรต่อ</h2>
			<p>
				วิธีที่ดีที่สุดคืออ่านหน้านี้ให้เข้าใจว่าอะไรคือข้อมูลสำคัญของ {theme} จากนั้นเตรียมรูป รุ่น สเปก สภาพ และจุดที่มีผลต่อการประเมินให้ครบที่สุด
				เมื่อคุยกับทีมงานแล้วจะได้เข้าสู่การประเมินแบบที่ไม่เสียรอบ และถ้าคุณยังไม่แน่ใจว่าควรดูหมวดไหนต่อ สามารถไปต่อจากลิงก์ด้านล่างที่เชื่อมกับเจตนาค้นหาใกล้เคียงกัน
			</p>
			{
				internalLinks.length > 0 && (
					<ul class="natural-links">
						{internalLinks.map((item) => (
							<li>
								<a href={item.href}>{item.label}</a>
							</li>
						))}
					</ul>
				)
			}
		</section>
			</div>
		</details>
	</div>
</section>

<style>
	.natural-longform {
		border-top: 1px solid rgba(15, 23, 42, 0.08);
		background: linear-gradient(180deg, rgba(255, 250, 245, 0.95), #fff);
	}
	.natural-wrap {
		margin-inline: auto;
		max-width: 42rem;
		padding: 2.5rem 1rem;
	}
	.natural-details {
		border: 1px solid rgba(15, 23, 42, 0.08);
		border-radius: 1rem;
		background: #fff;
		padding: 0;
	}
	.natural-summary {
		cursor: pointer;
		list-style: none;
		padding: 1.25rem 1.5rem;
		border-bottom: 1px solid rgba(15, 23, 42, 0.06);
	}
	.natural-summary::-webkit-details-marker {
		display: none;
	}
	.natural-summary-title {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 800;
		color: #111827;
	}
	.natural-summary-hint {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		color: #6b7280;
