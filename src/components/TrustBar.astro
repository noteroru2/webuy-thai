---
interface Props {
	variant?: 'light' | 'dark' | 'orange';
	compact?: boolean;
}
const { variant = 'light', compact = false } = Astro.props;

const stats = [
	{ icon: '📦', value: '5,000+', label: 'เครื่องที่รับซื้อ' },
	{ icon: '⚡', value: '15 นาที', label: 'ประเมินราคา' },
	{ icon: '💵', value: 'จ่ายสด', label: 'ทันทีทุกวัน' },
	{ icon: '⭐', value: '4.9 / 5', label: 'รีวิวจากลูกค้า' },
];
---

<div class:list={['trust-bar', variant, { compact }]} aria-label="ตัวเลขความน่าเชื่อถือ">
	{stats.map((s) => (
		<div class="trust-item">
			<span class="trust-icon" aria-hidden="true">{s.icon}</span>
			<div class="trust-copy">
				<strong class="trust-value">{s.value}</strong>
				<span class="trust-label">{s.label}</span>
			</div>
		</div>
	))}
</div>

<style>
	.trust-bar {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0;
		border-radius: 12px;
		overflow: hidden;
		margin-block: 1.25rem;
		border: 1px solid rgba(15, 23, 42, 0.08);
	}

	/* Light variant */
	.trust-bar.light {
		background: #fff;
		box-shadow: 0 2px 12px rgba(15, 23, 42, 0.06);
	}
	.trust-bar.light .trust-item {
		border-right: 1px solid rgba(15, 23, 42, 0.07);
	}
	.trust-bar.light .trust-value {
		color: #ea580c;
	}
	.trust-bar.light .trust-label {
		color: #64748b;
	}

	/* Orange variant */
	.trust-bar.orange {
		background: linear-gradient(135deg, #fff8ed 0%, #ffecd4 100%);
		border-color: rgba(234, 88, 12, 0.18);
		box-shadow: 0 3px 16px rgba(249, 115, 22, 0.1);
	}
	.trust-bar.orange .trust-item {
		border-right: 1px solid rgba(234, 88, 12, 0.12);
	}
	.trust-bar.orange .trust-value {
		color: #c2410c;
	}
	.trust-bar.orange .trust-label {
		color: #78350f;
	}

	/* Dark variant */
	.trust-bar.dark {
		background: #0f172a;
		border-color: rgba(249, 115, 22, 0.2);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
	}
	.trust-bar.dark .trust-item {
		border-right: 1px solid rgba(255, 255, 255, 0.06);
	}
	.trust-bar.dark .trust-value {
		color: #f97316;
	}
	.trust-bar.dark .trust-label {
		color: #94a3b8;
	}

	.trust-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		padding: 0.85rem 0.5rem;
		text-align: center;
	}
	.trust-item:last-child {
		border-right: none;
	}
	.trust-icon {
		font-size: 1.3rem;
		line-height: 1;
	}
	.trust-copy {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}
	.trust-value {
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}
	.trust-label {
		font-size: 0.72rem;
		font-weight: 500;
		line-height: 1.3;
	}

	/* Compact mode */
	.trust-bar.compact .trust-item {
		padding: 0.6rem 0.35rem;
	}
	.trust-bar.compact .trust-value {
		font-size: 0.92rem;
	}
	.trust-bar.compact .trust-label {
		font-size: 0.65rem;
	}
	.trust-bar.compact .trust-icon {
		font-size: 1.1rem;
	}

	@media (max-width: 560px) {
		.trust-bar {
			grid-template-columns: repeat(2, 1fr);
		}
		.trust-item:nth-child(2) {
			border-right: none;
		}
		.trust-item:nth-child(1),
		.trust-item:nth-child(2) {
			border-bottom: 1px solid rgba(15, 23, 42, 0.07);
		}
		.trust-bar.dark .trust-item:nth-child(1),
		.trust-bar.dark .trust-item:nth-child(2) {
			border-bottom-color: rgba(255, 255, 255, 0.06);
		}
	}
</style>
