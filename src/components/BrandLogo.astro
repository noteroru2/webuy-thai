---
interface Props {
	variant?: 'default' | 'footer';
}

const { variant = 'default' } = Astro.props;
const isFooter = variant === 'footer';
---

<a class:list={['brand', isFooter && 'brand--footer']} href="/" aria-label="WE BUY เรารับซื้อ — หน้าแรก">
	<span class="brand-icon" aria-hidden="true">
		<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" class="brand-icon-svg">
			<rect x="1" y="1" width="46" height="46" rx="12" fill="url(#brand-icon-bg)" />
			<rect x="1" y="1" width="46" height="46" rx="12" stroke="rgba(245,158,11,0.35)" stroke-width="1.2" />
			<path
				fill="url(#brand-w-fill)"
				d="M8 12 L16 36 L24 18 L32 36 L40 12 L34.5 12 L29 30 L24 22 L19 30 L13.5 12 Z"
			/>
			<defs>
				<linearGradient id="brand-icon-bg" x1="24" y1="2" x2="24" y2="46" gradientUnits="userSpaceOnUse">
					<stop stop-color="#0B1F3A" />
					<stop offset="1" stop-color="#132D4F" />
				</linearGradient>
				<linearGradient id="brand-w-fill" x1="24" y1="12" x2="24" y2="36" gradientUnits="userSpaceOnUse">
					<stop stop-color="#FCD34D" />
					<stop offset="0.45" stop-color="#F59E0B" />
					<stop offset="1" stop-color="#D97706" />
				</linearGradient>
			</defs>
		</svg>
	</span>
	<span class="brand-text">
		<span class="brand-wordmark">WE BUY</span>
		<span class="brand-subtitle">เรารับซื้อ</span>
		{isFooter && <span class="brand-operator">ดำเนินการโดย AMPHON TRADING</span>}
	</span>
</a>

<style>
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		line-height: 1.15;
		min-width: 0;
		padding: 0.125rem 0;
		transition: opacity 0.2s ease;
	}
	.brand:hover {
		text-decoration: none;
		opacity: 0.92;
	}
	.brand-icon {
		flex-shrink: 0;
		width: clamp(44px, 10vw, 52px);
		height: clamp(44px, 10vw, 52px);
		display: block;
	}
	.brand-icon-svg {
		width: 100%;
		height: 100%;
		display: block;
		filter: drop-shadow(0 2px 8px rgba(245, 158, 11, 0.18));
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}
	.brand-wordmark {
		font-size: clamp(1.05rem, 2.4vw, 1.25rem);
		font-weight: 800;
		letter-spacing: 0.06em;
		color: var(--color-navy, #0b1f3a);
		line-height: 1.1;
	}
	.brand-subtitle {
		font-size: clamp(0.8125rem, 2vw, 0.9375rem);
		font-weight: 600;
		color: var(--color-text-muted, #4b5563);
		letter-spacing: 0.01em;
	}
	.brand--footer .brand-wordmark {
		color: #ffffff;
	}
	.brand--footer .brand-subtitle {
		color: rgba(255, 255, 255, 0.72);
	}
	.brand-operator {
		font-size: 0.6875rem;
		font-weight: 500;
		color: rgba(255, 255, 255, 0.48);
		letter-spacing: 0.02em;
		margin-top: 0.05rem;
		white-space: nowrap;
	}
	.brand--footer .brand-icon-svg {
		filter: drop-shadow(0 2px 10px rgba(0, 0, 0, 0.25));
	}
</style>
