---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 to-slate-800 border border-slate-700 my-10 p-8 md:p-10 ${className}`}>
  <!-- Decorative background elements -->
  <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-emerald-400 via-teal-500 to-blue-500"></div>
  <div class="absolute -right-20 -top-20 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl"></div>
  
  <div class="relative z-10 flex flex-col md:flex-row items-center gap-8">
    <div class="flex-shrink-0">
      <div class="w-24 h-24 rounded-2xl bg-slate-800 border border-slate-600 shadow-xl flex items-center justify-center relative">
        <div class="absolute inset-0 bg-emerald-400/20 animate-pulse rounded-2xl"></div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
      </div>
    </div>
    
    <div class="flex-1 text-center md:text-left">
      <h3 class="text-2xl font-bold text-white mb-2 flex items-center justify-center md:justify-start gap-2">
        การันตีความปลอดภัยของข้อมูล (Secure Data Wipe) <span class="bg-emerald-500/20 text-emerald-400 text-xs px-2 py-1 rounded-full border border-emerald-500/30 uppercase tracking-wider font-bold">Certified</span>
      </h3>
      <p class="text-slate-300 mb-4 leading-relaxed">
        ข้อมูลส่วนตัวของคุณคือเรื่องสำคัญระดับสูงสุด! เรามีกระบวนการ <strong class="text-emerald-400 font-semibold">ล้างข้อมูล (Format & Reset) ลึกถึงระดับบิต</strong> ด้วยมาตรฐานระดับองค์กร ต่อหน้าคุณทันทีเมื่อรับเครื่อง รับประกันว่าจะไม่มีรูปภาพ รหัสผ่าน หรือไฟล์งานใดๆ หลุดรอดออกไปอย่างเด็ดขาด 1,000,000%
      </p>
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 text-sm font-medium text-slate-400">
        <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> ล็อกเอาท์ iCloud / Google</div>
        <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> คืนค่าโรงงาน (Factory Reset)</div>
        <div class="flex items-center gap-1.5"><svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> ล้างฮาร์ดดิสก์แบบถาวร</div>
      </div>
    </div>
  </div>
</div>
