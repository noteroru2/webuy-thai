---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`grid grid-cols-2 md:grid-cols-4 gap-4 py-8 border-y border-white/10 ${className}`}>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">10,000+</div>
    <div class="text-xs text-gray-400">เครื่องที่รับซื้อแล้ว</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">15 นาที</div>
    <div class="text-xs text-gray-400">ประเมินราคาไวสุด</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">100%</div>
    <div class="text-xs text-gray-400">ล้างข้อมูลปลอดภัย</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">77</div>
    <div class="text-xs text-gray-400">จังหวัดที่ให้บริการ</div>
  </div>
</div>
