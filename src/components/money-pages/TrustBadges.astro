---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`grid grid-cols-2 md:grid-cols-4 gap-3 py-6 ${className}`}>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-brand-50/80 border border-brand-100">
    <div class="text-lg font-bold text-brand-700 mb-1">ส่งรูปประเมินได้</div>
    <div class="text-xs text-gray-600">แนบรุ่น สเปก และสภาพ</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-brand-50/80 border border-brand-100">
    <div class="text-lg font-bold text-brand-700 mb-1">ตอบกลับในเวลาทำการ</div>
    <div class="text-xs text-gray-600">ผ่าน LINE @webuy</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-brand-50/80 border border-brand-100">
    <div class="text-lg font-bold text-brand-700 mb-1">ตรวจตามสภาพจริง</div>
    <div class="text-xs text-gray-600">ยืนยันก่อนชำระเงิน</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-brand-50/80 border border-brand-100">
    <div class="text-lg font-bold text-brand-700 mb-1">ประเมินออนไลน์ทั่วไทย</div>
    <div class="text-xs text-gray-600">ส่งข้อมูลหรือจัดส่งตามสะดวก</div>
  </div>
</div>
