---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`grid grid-cols-2 md:grid-cols-4 gap-4 py-8 border-y border-white/10 ${className}`}>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">10,000+</div>
    <div class="text-xs text-gray-400">เครื่องที่รับซื้อแล้ว</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">LINE</div>
    <div class="text-xs text-gray-400">ส่งรูปประเมินเบื้องต้น</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">PDPA</div>
    <div class="text-xs text-gray-400">แนะนำล้างข้อมูลก่อนส่งมอบ</div>
  </div>
  <div class="flex flex-col items-center justify-center text-center p-4 rounded-xl bg-white/[0.02] border border-white/5">
    <div class="text-3xl font-bold text-brand-400 mb-1">หลายพื้นที่</div>
    <div class="text-xs text-gray-400">นัดรับและประเมินออนไลน์</div>
  </div>
</div>
