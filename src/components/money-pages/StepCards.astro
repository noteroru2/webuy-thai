---
export interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<div class={`grid grid-cols-1 md:grid-cols-3 gap-6 my-10 ${className}`}>
  <div class="relative bg-white/[0.03] border border-white/10 rounded-2xl p-6 overflow-hidden group hover:border-brand-500/50 transition-colors">
    <div class="absolute top-0 right-0 p-4 opacity-10 text-6xl font-black italic group-hover:text-brand-500 transition-colors">1</div>
    <div class="w-12 h-12 rounded-full bg-brand-500/20 flex items-center justify-center mb-4 border border-brand-500/30 text-brand-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">ประเมินราคาเบื้องต้น</h3>
    <p class="text-gray-400 text-sm">แอดไลน์ @webuy ส่งรูปและสเปก ทีมงานแจ้งราคาประเมินเบื้องต้นก่อนตกลงขาย ตอบกลับในเวลาทำการ</p>
  </div>
  
  <div class="relative bg-white/[0.03] border border-white/10 rounded-2xl p-6 overflow-hidden group hover:border-brand-500/50 transition-colors">
    <div class="absolute top-0 right-0 p-4 opacity-10 text-6xl font-black italic group-hover:text-brand-500 transition-colors">2</div>
    <div class="w-12 h-12 rounded-full bg-brand-500/20 flex items-center justify-center mb-4 border border-brand-500/30 text-brand-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">นัดหมายสถานที่</h3>
    <p class="text-gray-400 text-sm">ตกลงช่วงราคาเบื้องต้นแล้ว เลือกจุดนัดพบที่สะดวก หรือประสานงานนัดรับตามพื้นที่ที่เปิดให้บริการ</p>
  </div>
  
  <div class="relative bg-white/[0.03] border border-white/10 rounded-2xl p-6 overflow-hidden group hover:border-brand-500/50 transition-colors">
    <div class="absolute top-0 right-0 p-4 opacity-10 text-6xl font-black italic group-hover:text-brand-500 transition-colors">3</div>
    <div class="w-12 h-12 rounded-full bg-brand-500/20 flex items-center justify-center mb-4 border border-brand-500/30 text-brand-400">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
    </div>
    <h3 class="text-xl font-bold text-white mb-2">ตรวจรับและชำระเงิน</h3>
    <p class="text-gray-400 text-sm">ตรวจรับและยืนยันสภาพก่อนชำระเงิน เงื่อนไขขึ้นอยู่กับการตรวจรับสินค้าจริง ชำระตามช่องทางที่ตกลง</p>
  </div>
</div>
