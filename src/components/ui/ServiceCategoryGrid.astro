---
interface Category {
	href: string;
	title: string;
	desc: string;
	image?: string;
	imageAlt?: string;
	icon?: string;
	gradient?: string;
}

interface Props {
	heading?: string;
	subheading?: string;
	categories?: Category[];
}

const {
	heading = 'หมวดสินค้าที่รับซื้อ',
	subheading = 'เลือกหมวดที่ตรงกับสินค้าของคุณ แล้วส่งรูปและสเปกมาประเมินเบื้องต้น',
	categories = [
		{ href: '/รับซื้อโน๊ตบุ๊ค/', title: 'รับซื้อโน๊ตบุ๊ค', desc: 'โน๊ตบุ๊กทุกยี่ห้อ สายทำงานและเกมมิ่ง', image: '/media/notebook-showcase/asus-tuf-gaming-a15.webp', imageAlt: 'โน๊ตบุ๊คเกมมิ่ง', gradient: 'from-sky-500 to-blue-700', icon: '💻' },
		{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมพิวเตอร์', desc: 'PC แบรนด์เนม คอมประกอม คอมสำนักงาน', image: '/media/category/generic_desktop_pc_1781509169636.png', imageAlt: 'คอมพิวเตอร์ตั้งโต๊ะ', gradient: 'from-cyan-500 to-teal-700', icon: '🖥️' },
		{ href: '/รับซื้อแมคบุ๊ค/', title: 'รับซื้อ MacBook', desc: 'MacBook Air / Pro ชิป Intel และ M-series', image: '/media/notebook-showcase/macbook-air-on-box.webp', imageAlt: 'MacBook', gradient: 'from-slate-500 to-slate-800', icon: '🍎' },
		{ href: '/รับซื้อไอโฟน/', title: 'รับซื้อ iPhone', desc: 'ทุกรุ่น ประเมินตามสภาพและแบต', image: '/media/apple-local/iphone15-black-front.webp', imageAlt: 'iPhone', gradient: 'from-indigo-500 to-violet-700', icon: '📱' },
		{ href: '/รับซื้อไอแพด/', title: 'รับซื้อ iPad', desc: 'iPad Pro, Air, mini ทุกรุ่น', image: '/media/apple-local/ipad-mini-silver-back.webp', imageAlt: 'iPad', gradient: 'from-blue-400 to-sky-600', icon: '📲' },
		{ href: '/รับซื้อกล้อง/', title: 'รับซื้อกล้อง', desc: 'DSLR, Mirrorless และเลนส์', image: '/media/category/generic_camera_1781509181019.png', imageAlt: 'กล้องถ่ายรูป', gradient: 'from-emerald-500 to-teal-700', icon: '📷' },
		{ href: '/รับซื้อคอม/', title: 'รับซื้อคอมสำนักงาน / ล็อตบริษัท', desc: 'รับซื้อคอมหลายเครื่องจากองค์กร', image: '/media/notebook-showcase/bulk-gaming-notebooks-lot.webp', imageAlt: 'คอมหลายเครื่อง', gradient: 'from-amber-500 to-orange-600', icon: '🏢' },
	],
} = Astro.props;
---

<section class="border-b border-[#E8ECF1] bg-[#F5F7FA] py-16 sm:py-20 lg:py-24" aria-labelledby="service-grid-heading">
	<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<h2 id="service-grid-heading" class="text-[clamp(1.5rem,2.5vw+1rem,2rem)] font-extrabold tracking-tight text-text">
				{heading}
			</h2>
			<p class="mx-auto mt-3 max-w-[36rem] text-base leading-relaxed text-text-muted">{subheading}</p>
		</div>
		<div class="mt-12 grid auto-rows-fr gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
			{
				categories.map((cat) => (
					<a
						href={cat.href}
						class="group flex h-full min-h-[17.5rem] flex-col overflow-hidden rounded-[var(--radius-card,1rem)] border border-[#E8ECF1] bg-white shadow-[var(--shadow-card)] transition hover:-translate-y-0.5 hover:border-brand-500/28 hover:shadow-[var(--shadow-card-hover)]"
					>
						<div class={`relative aspect-[16/10] shrink-0 overflow-hidden bg-gradient-to-br ${cat.gradient ?? 'from-brand-500 to-brand-700'}`}>
							{cat.image ? (
								<img
									src={cat.image}
									alt={cat.imageAlt ?? cat.title}
									width="320"
									height="200"
									loading="lazy"
									decoding="async"
									class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
									onerror="this.style.display='none'"
								/>
							) : null}
							<div class="pointer-events-none absolute inset-0 flex items-center justify-center text-4xl opacity-90" aria-hidden="true">
								{cat.icon}
							</div>
						</div>
						<div class="flex flex-1 flex-col p-5">
							<h3 class="line-clamp-2 text-base font-bold leading-snug text-text group-hover:text-brand-700">{cat.title}</h3>
							<p class="mt-2 line-clamp-2 flex-1 text-sm leading-relaxed text-text-muted">{cat.desc}</p>
							<span class="mt-4 inline-flex min-h-11 items-center text-sm font-semibold text-brand-600 transition group-hover:text-brand-700">
								ดูรายละเอียด →
							</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
