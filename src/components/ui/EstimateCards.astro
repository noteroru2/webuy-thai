---
interface Card {
	category: string;
	title: string;
	detail: string;
	price: string;
}

interface Props {
	cards?: Card[];
	lineUrl?: string;
}

const {
	lineUrl = 'https://line.me/R/ti/p/@webuy',
	cards = [
		{
			category: 'โน๊ตบุ๊ค',
			title: 'Notebook i5/Ryzen 5 สภาพดี',
			detail: 'แบตดี ไม่มีรอยแตก พร้อม Adapter',
			price: '~8,000–16,000 บาท',
		},
		{
			category: 'MacBook',
			title: 'MacBook Air M1/M2 สภาพดี',
			detail: 'ไม่มีตำหนิ แบตดี มี Adapter',
			price: '~20,000–32,000 บาท',
		},
		{
			category: 'iPhone',
			title: 'iPhone 14 / 15 สภาพดี',
			detail: 'แบตสุขภาพดี ไม่มีรอยแตก ไม่ติด iCloud',
			price: '~12,000–22,000 บาท',
		},
	],
} = Astro.props;
---

<section class="border-b border-[#E8ECF1] bg-white py-16 sm:py-20 lg:py-24" aria-labelledby="estimate-cards-heading">
	<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
		<div class="text-center">
			<p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">ตัวอย่างอ้างอิงเท่านั้น</p>
			<h2 id="estimate-cards-heading" class="mt-3 text-[clamp(1.5rem,2.5vw+1rem,2rem)] font-extrabold tracking-tight text-text">
				ตัวอย่างเคสประเมินราคา
			</h2>
			<p class="mx-auto mt-3 max-w-[36rem] text-sm leading-relaxed text-text-muted">
				ราคาอ้างอิงตามรุ่น สเปก สภาพ และการตรวจรับจริง
			</p>
		</div>
		<div class="mt-12 grid gap-6 sm:grid-cols-3">
			{
				cards.map((card) => (
					<div class="flex min-h-[18rem] flex-col overflow-hidden rounded-[var(--radius-card,1rem)] border border-[#E8ECF1] bg-white shadow-[var(--shadow-card)] transition hover:shadow-[var(--shadow-card-hover)]">
						<div class="flex h-14 items-center justify-center bg-gradient-to-r from-navy to-navy-soft">
							<p class="text-xs font-bold uppercase tracking-widest text-white">{card.category}</p>
						</div>
						<div class="flex flex-1 flex-col p-6">
							<p class="line-clamp-2 text-base font-bold text-text">{card.title}</p>
							<p class="mt-1 line-clamp-2 text-xs text-text-muted">{card.detail}</p>
							<p class="mt-4 text-2xl font-extrabold text-brand-600">{card.price}</p>
							<p class="mt-1 text-xs text-text-muted">ราคาอ้างอิง ขึ้นกับรุ่นและสภาพจริง</p>
							<div class="mt-auto pt-5">
								<a
									href={lineUrl}
									target="_blank"
									rel="noopener noreferrer"
									class="flex min-h-11 w-full items-center justify-center rounded-xl bg-line-refined text-sm font-bold !text-white transition hover:bg-line-refined-hover"
								>
									ส่งรูปประเมิน
								</a>
							</div>
						</div>
					</div>
				))
			}
		</div>
		<p class="mt-6 text-center text-xs text-text-muted">
			* ราคาอ้างอิงเท่านั้น ราคาจริงขึ้นอยู่กับรุ่น สเปก สภาพ อุปกรณ์ครบชุด และการตรวจรับจริง ณ วันที่ดีล
		</p>
	</div>
</section>
