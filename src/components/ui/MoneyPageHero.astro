---
import ButtonLink from '../landing/ButtonLink.astro';

interface Props {
	kicker?: string;
	title: string;
	intro: string;
	lineUrl?: string;
}

const {
	kicker = 'WE BUY · ประเมินราคาเบื้องต้น',
	title,
	intro,
	lineUrl = 'https://line.me/R/ti/p/@webuy',
} = Astro.props;
---

<header class="money-hero" aria-labelledby="money-hero-heading">
	<div class="money-hero-inner">
		<p class="money-hero-kicker">{kicker}</p>
		<h1 id="money-hero-heading" class="money-hero-title">{title}</h1>
		<p class="money-hero-intro">{intro}</p>
		<div class="money-hero-cta">
			<ButtonLink href={lineUrl} variant="line" target="_blank" rel="noopener noreferrer">
				ส่งรูปประเมินทาง LINE
			</ButtonLink>
		</div>
	</div>
</header>

<style>
	.money-hero {
		background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
		color: #fff;
		padding: 2.5rem 1rem 2rem;
		border-radius: 0 0 1.25rem 1.25rem;
		margin-bottom: 1.5rem;
	}
	.money-hero-inner {
		max-width: 820px;
		margin-inline: auto;
		text-align: center;
	}
	.money-hero-kicker {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.75);
	}
	.money-hero-title {
		margin: 0.6rem 0 0;
		font-size: clamp(1.5rem, 4vw, 2.1rem);
		font-weight: 800;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}
	.money-hero-intro {
		margin: 1rem auto 0;
		max-width: 42rem;
		font-size: 1rem;
		line-height: 1.75;
		color: rgba(255, 255, 255, 0.9);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.money-hero-cta {
		margin-top: 1.5rem;
		display: flex;
		justify-content: center;
	}
	@media (min-width: 640px) {
		.money-hero {
			padding: 3rem 1.5rem 2.5rem;
		}
	}
</style>
