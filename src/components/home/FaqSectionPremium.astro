---
interface FaqItem {
	question: string;
	answer: string;
}

interface Props {
	id?: string;
	heading?: string;
	intro?: string;
	items: FaqItem[];
}

const {
	id = 'faq-heading',
	heading = 'คำถามที่พบบ่อย',
	intro = 'ตอบคำถามที่ลูกค้าพบบ่อย เพื่อความเข้าใจที่ง่ายและรวดเร็ว — หากเคสซับซ้อนแนะนำติดต่อทีมงานโดยตรง',
	items,
} = Astro.props;
---

<section
	class="relative border-t border-gray-100 bg-gradient-to-b from-white via-[#FAFAFA]/50 to-white py-16 sm:py-20 lg:py-24"
	aria-labelledby={id}
>
	<div class="mx-auto max-w-[48rem] px-4 sm:px-6 lg:px-8">
		<h2 id={id} class="text-[clamp(1.5rem,2.5vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
			{heading}
		</h2>
		<p class="mt-4 max-w-[40rem] text-base leading-[1.7] text-text-muted">{intro}</p>
		<div class="mt-10 space-y-3.5">
			{
				items.map((item) => (
					<details class="group overflow-hidden rounded-[1.125rem] border border-gray-200/90 bg-white shadow-sm transition duration-200 open:border-brand-500/25 open:bg-brand-50/[0.35] open:shadow-[0_12px_36px_-24px_rgba(15,23,42,0.14)] hover:border-brand-500/20 hover:bg-brand-50/25">
						<summary class="cursor-pointer list-none px-5 py-4 transition-colors sm:px-6 sm:py-5 [&::-webkit-details-marker]:hidden">
							<span class="flex items-start justify-between gap-4">
								<span class="text-base font-semibold leading-snug text-text">{item.question}</span>
								<span
									class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-50 !text-brand-700 transition group-open:rotate-180 group-open:bg-brand-600 group-open:!text-white"
									aria-hidden="true"
								>
									<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
										<path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
									</svg>
								</span>
							</span>
						</summary>
						<p class="border-t border-gray-100/90 px-5 pb-5 pt-3 text-[0.9375rem] leading-[1.75] text-text-muted sm:px-6 sm:pb-6">
							{item.answer}
						</p>
					</details>
				))
			}
		</div>
	</div>
</section>
