---
interface Props {
	areas: string[];
	phoneLabel: string;
	telHref: string;
	lineUrl: string;
	openingHours: string;
	siteName: string;
	mapEmbedSrc: string;
	mapTitle?: string;
	/** ลิงก์เปิด Google Maps / นำทาง */
	directionsUrl?: string;
}

const {
	areas,
	phoneLabel,
	telHref,
	lineUrl,
	openingHours,
	siteName,
	mapEmbedSrc,
	mapTitle = 'แผนที่ร้าน / จุดบริการ',
	directionsUrl = import.meta.env.PUBLIC_GOOGLE_MAP_URL ?? 'https://maps.app.goo.gl/LjeWLrvhDhcsgRYCA',
} = Astro.props;
---

<section
	class="border-t border-gray-200/80 bg-gradient-to-b from-[#FAFAFA] to-white py-16 sm:py-20 lg:py-24"
	aria-labelledby="local-areas-heading"
>
	<div class="mx-auto max-w-[1200px] px-4 sm:px-6 lg:px-8">
		<h2 id="local-areas-heading" class="text-[clamp(1.5rem,2.8vw+1rem,2.25rem)] font-extrabold tracking-tight text-text">
			พื้นที่ให้บริการ
		</h2>
		<p class="mt-4 max-w-[42rem] text-base leading-[1.75] text-text-muted sm:text-lg">
			ค้นหาเช่น &ldquo;รับซื้อโน้ตบุ๊คใกล้ฉัน&rdquo; &ldquo;ร้านรับซื้อคอมพิวเตอร์ใกล้ฉัน&rdquo; <span class="whitespace-nowrap">หรือ</span>
			&ldquo;ร้านซ่อมคอมพิวเตอร์ อุบลราชธานี&rdquo; — เราให้บริการและประสานงานในหลายพื้นที่
			รวมถึง <strong class="font-semibold text-text">อุบลราชธานี ยโสธร</strong> และจังหวัดใกล้เคียงตามที่ระบุด้านล่าง
			(รายละเอียดการนัดหมายขึ้นกับประเภทงานและคิวทีมงาน)
			ดู <a class="font-semibold text-brand-700 hover:underline" href="/พื้นที่ให้บริการ/">พื้นที่ให้บริการ</a>
			รวมคู่มือรับซื้อตามจังหวัด
		</p>
		<p class="mt-3 max-w-[42rem] text-sm leading-relaxed text-muted">
			พื้นที่ให้บริการ: แนะนำระบุจังหวัดและรุ่นเครื่องเมื่อติดต่อ เพื่อให้ทีมงานตอบได้ตรงพื้นที่และคิวงาน
		</p>

		<ul class="mt-8 flex flex-wrap gap-2" aria-label="รายชื่อพื้นที่">
			{
				areas.slice(0, 16).map((area) => {
					const href = area === 'อุบลราชธานี' 
						? '/รับซื้อโน๊ตบุ๊คอุบล-notebook-laptop-จ/' 
						: `/รับซื้อโน๊ตบุ๊ค-${area}/`;
					return (
					<li>
						<a href={href} class="inline-flex items-center rounded-full border border-gray-200/90 bg-white px-3.5 py-1.5 text-sm font-medium text-text-muted shadow-sm hover:border-primary/50 hover:bg-gray-50 hover:text-primary transition-colors">
							{area}
						</a>
					</li>
					);
				})
			}
		</ul>

		<div
			class="mt-12 overflow-hidden rounded-[1.375rem] border border-gray-200/90 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04),0_20px_48px_-28px_rgba(15,23,42,0.12)] ring-1 ring-black/[0.03] lg:grid lg:grid-cols-2 lg:gap-0"
		>
			<div class="border-b border-gray-100 p-7 sm:p-9 lg:border-b-0 lg:border-r lg:border-gray-100">
				<h3 class="text-lg font-extrabold text-text">ข้อมูลร้าน · NAP</h3>
				<dl class="mt-6 space-y-4 text-[0.9375rem] leading-relaxed text-text-muted">
					<div>
						<dt class="text-xs font-bold uppercase tracking-wider text-muted">ชื่อร้าน / แบรนด์</dt>
						<dd class="mt-1 font-semibold text-text">{siteName}</dd>
					</div>
					<div>
						<dt class="text-xs font-bold uppercase tracking-wider text-muted">โทรศัพท์</dt>
						<dd class="mt-1">
							<a
								class="font-semibold text-brand-600 underline decoration-brand-500/30 underline-offset-2 hover:text-brand-700"
								href={telHref}>{phoneLabel}</a
							>
						</dd>
					</div>
					<div>
						<dt class="text-xs font-bold uppercase tracking-wider text-muted">LINE</dt>
						<dd class="mt-1">
							<a
								class="font-semibold text-brand-600 underline decoration-brand-500/30 underline-offset-2 hover:text-brand-700"
								href={lineUrl}
								target="_blank"
								rel="noopener noreferrer">@webuy</a
							>
						</dd>
					</div>
					<div>
						<dt class="text-xs font-bold uppercase tracking-wider text-muted">เวลาเปิดให้บริการ</dt>
						<dd class="mt-1 font-medium text-text">{openingHours}</dd>
					</div>
				</dl>
				<div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
					<a
						class="inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-2.5 text-sm font-bold !text-white shadow-md shadow-brand-700/25 transition hover:-translate-y-0.5 hover:bg-brand-700 hover:!text-white [text-shadow:0_1px_0_rgba(0,0,0,0.12)]"
						href={directionsUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						นำทาง Google Maps
					</a>
					<a
						class="inline-flex items-center justify-center rounded-full border-2 border-brand-500/30 bg-white px-5 py-2.5 text-sm font-bold !text-brand-800 transition hover:-translate-y-0.5 hover:bg-brand-50 hover:!text-brand-900"
						href={lineUrl}
						target="_blank"
						rel="noopener noreferrer"
					>
						สอบถามทาง LINE
					</a>
				</div>
			</div>

			<div class="relative flex min-h-0 flex-col bg-[#F3F4F6]/40">
				<p class="border-b border-gray-100/90 px-6 py-4 text-sm font-bold text-text sm:px-8">{mapTitle}</p>
				<div class="relative flex-1 p-3 sm:p-4">
					<div
						class="relative h-full min-h-[220px] overflow-hidden rounded-xl shadow-inner ring-1 ring-black/[0.04] sm:min-h-[280px] lg:min-h-[320px]"
					>
						<iframe
							title={mapTitle}
							src={mapEmbedSrc}
							class="absolute inset-0 h-full w-full bg-gray-100"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
						></iframe>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
