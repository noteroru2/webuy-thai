---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
const displayPosts = posts.slice(0, 4);
---

<section
	class="border-t border-[#E8ECF1] bg-[#F5F7FA] py-16 sm:py-20 lg:py-24"
	aria-labelledby="magazine-blog-heading"
>
	<div class="mx-auto max-w-[var(--width-container,75rem)] px-4 sm:px-6 lg:px-8">
		<div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
			<div class="max-w-xl">
				<h2 id="magazine-blog-heading" class="text-[clamp(1.5rem,2.5vw+1rem,2rem)] font-extrabold tracking-tight text-text">
					บทความแนะนำ
				</h2>
				<p class="mt-3 max-w-[32rem] text-base leading-[1.7] text-text-muted">
					อ่านสั้น ๆ ก่อนขายโน๊ตบุ๊คหรือคอม — เช็กสเปก สภาพ และแนวทางก่อนติดต่อ
				</p>
			</div>
			<a
				class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border-2 border-brand-600 bg-white px-6 py-3 text-sm font-bold !text-brand-800 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-brand-600 hover:!text-white hover:shadow-md"
				href="/blog/"
			>
				ดูบทความทั้งหมด
			</a>
		</div>

		<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
			{
				displayPosts.map((post) => {
					const img = post.data.heroImage;
					const imgAlt = post.data.heroImageAlt?.trim() || 'ภาพประกอบบทความ';
					const titleHtml = post.data.titleHtml?.trim() || post.data.title;
					const excerpt = post.data.description;
					const href = `/${post.data.slug}/`;
					const dateLabel = post.data.pubDate.toLocaleDateString('th-TH', {
						year: 'numeric',
						month: 'short',
						day: 'numeric',
					});
					return (
						<article class="group flex h-full min-h-[18rem] flex-col overflow-hidden rounded-[var(--radius-card,1rem)] border border-[#E8ECF1] bg-white shadow-[var(--shadow-card)] transition duration-300 hover:-translate-y-0.5 hover:border-brand-500/25 hover:shadow-[var(--shadow-card-hover)]">
							<div class="relative aspect-[16/10] shrink-0 overflow-hidden bg-gradient-to-br from-brand-50 to-[#F5F7FA]">
								{img ? (
									<a href={href} class="block h-full w-full">
										<img
											src={img}
											alt={imgAlt}
											class="h-full w-full object-cover transition duration-500 ease-out group-hover:scale-[1.04]"
											width="640"
											height="400"
											loading="lazy"
											decoding="async"
										/>
									</a>
								) : (
									<div class="flex h-full w-full items-center justify-center text-sm font-semibold text-brand-600">บทความ</div>
								)}
							</div>
							<div class="flex flex-1 flex-col p-5 sm:p-6">
								<time class="text-xs font-medium text-muted" datetime={post.data.pubDate.toISOString()}>
									{dateLabel}
								</time>
								<h3 class="mt-2 text-base font-extrabold leading-snug text-text sm:text-lg">
									<a href={href} class="line-clamp-2 transition hover:text-brand-600" set:html={titleHtml} />
								</h3>
								{excerpt && <p class="mt-2 line-clamp-2 flex-1 text-sm leading-[1.65] text-text-muted">{excerpt}</p>}
								<a
									href={href}
									class="mt-auto inline-flex min-h-11 items-center pt-4 text-sm font-bold text-brand-600 transition hover:text-brand-700"
								>
									อ่านต่อ →
								</a>
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>
