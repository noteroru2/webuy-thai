---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	post: CollectionEntry<'posts'>;
	headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const img = post.data.heroImage;
const imgAlt = post.data.heroImageAlt ?? post.data.title;
const excerptText = post.data.description;
const titleHtml = post.data.titleHtml?.trim() || post.data.title;
const HeadingTag = headingLevel;
---

<article class="card">
	{img && (
		<a href={`/${post.data.slug}/`} class="thumb-wrap">
			<Image src={img} alt={imgAlt} class="thumb" loading="lazy" width={400} height={225} />
		</a>
	)}
	<div class="body">
		<time class="date" datetime={post.data.pubDate.toISOString()}>
			{post.data.pubDate.toLocaleDateString('th-TH', {
				year: 'numeric',
				month: 'long',
				day: 'numeric',
			})}
		</time>
		<HeadingTag class="title">
			<a href={`/${post.data.slug}/`} set:html={titleHtml} />
		</HeadingTag>
		{excerptText && <p class="excerpt">{excerptText}</p>}
		<a class="read" href={`/${post.data.slug}/`}>อ่านต่อ</a>
	</div>
</article>

<style>
	.card {
		display: grid;
		gap: 1rem;
		background: var(--surface);
		border-radius: var(--radius);
		overflow: hidden;
		border: 1px solid var(--color-gray-200);
		box-shadow: var(--shadow-sm);
		transition: border-color var(--transition-normal), box-shadow var(--transition-normal), transform var(--transition-spring);
	}
	.card:hover {
		border-color: rgba(245, 158, 11, 0.25);
		box-shadow: var(--shadow-card-hover);
		transform: translateY(-2px);
	}
	@media (min-width: 640px) {
		.card:has(.thumb-wrap) {
			grid-template-columns: minmax(0, 280px) 1fr;
		}
	}
	.thumb-wrap {
		display: block;
		line-height: 0;
	}
	.thumb {
		width: 100%;
		height: 100%;
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}
	.body {
		padding: 1.25rem 1.5rem 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.date {
		font-size: 0.875rem;
		color: var(--muted);
	}
	.title {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.35;
	}
	.title :global(a) {
		color: var(--text);
		text-decoration: none;
	}
	.title :global(a:hover) {
		color: var(--accent);
	}
	.excerpt {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.read {
		margin-top: auto;
		font-weight: 600;
		font-size: 0.9rem;
	}
</style>
