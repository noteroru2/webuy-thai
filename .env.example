# EXPORT_WP_TIMEOUT_MS=120000
# EXPORT_WP_MAX_PAGES=0
#
# (หยุดใช้แล้ว) PUBLIC_WP_TRY_CONTENT_SRCSET — เคยใช้กับรูปในบทความจาก WP

